---
import { GLOSSARY_CATEGORY_META, type GlossaryTerm } from "../lib/glossary.ts";

interface Props {
  term: GlossaryTerm;
}

const { term: t } = Astro.props;
const meta = GLOSSARY_CATEGORY_META[t.category];

function host(url?: string): string {
  if (!url) return "";
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
}

const searchText = `${t.term} ${(t.aliases ?? []).join(" ")} ${t.ja} ${t.note ?? ""}`.toLowerCase();
---

<article
  class="gl-card"
  data-gl-term
  data-gl-text={searchText}
  style={`--cat-color:${meta.color}`}
>
  <div class="gl-card-top">
    <span class="gl-icon" aria-hidden="true">{meta.emoji}</span>
    <div class="gl-card-headwrap">
      <div class="gl-card-head">
        <h3 class="gl-term">{t.term}</h3>
        {t.trending && <span class="gl-trend" title="トレンド">▲ trending</span>}
      </div>
      {t.aliases && t.aliases.length > 0 && (
        <div class="gl-aliases">{t.aliases.join(" · ")}</div>
      )}
      <span class="gl-cat-tag">{meta.label}</span>
    </div>
  </div>
  <p class="gl-def">{t.ja}</p>
  {t.note && <p class="gl-note">{t.note}</p>}
  {t.link && (
    <a class="gl-link" href={t.link} target="_blank" rel="noopener noreferrer">
      {host(t.link)} ↗
    </a>
  )}
</article>

<style>
  .gl-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 0.75rem 0.85rem 0.8rem;
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    border-left: 3px solid color-mix(in srgb, var(--cat-color, #c4b5fd) 70%, var(--border));
    border-radius: 11px;
    background: var(--bg-2, rgba(148, 163, 184, 0.04));
  }
  /* A class-level `display` would otherwise beat the UA [hidden] rule. */
  .gl-card[hidden] {
    display: none;
  }
  .gl-card-top {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .gl-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    line-height: 1;
    background:
      radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--cat-color, #c4b5fd) 50%, transparent), transparent 70%),
      color-mix(in srgb, var(--cat-color, #c4b5fd) 14%, rgba(20, 20, 22, 0.55));
    border: 1px solid color-mix(in srgb, var(--cat-color, #c4b5fd) 38%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 9%, transparent);
  }
  .gl-card-headwrap {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }
  .gl-card-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .gl-term {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text, #f5f5f4);
  }
  .gl-trend {
    flex-shrink: 0;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-color, #c4b5fd) 22%, transparent);
    color: color-mix(in srgb, var(--cat-color, #c4b5fd) 88%, #fff);
    letter-spacing: 0.02em;
  }
  .gl-aliases {
    font-size: 0.7rem;
    color: var(--text-muted, #94a3b8);
  }
  .gl-cat-tag {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.06rem 0.4rem;
    border-radius: 6px;
    color: color-mix(in srgb, var(--cat-color, #c4b5fd) 85%, #fff);
    background: color-mix(in srgb, var(--cat-color, #c4b5fd) 14%, transparent);
  }
  .gl-def {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-2, #d6d3d1);
  }
  .gl-note {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--text-muted, #94a3b8);
    padding-left: 0.5rem;
    border-left: 2px solid color-mix(in srgb, var(--cat-color, #c4b5fd) 40%, transparent);
  }
  .gl-link {
    align-self: flex-start;
    margin-top: 0.05rem;
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--cat-color, #c4b5fd) 90%, #fff);
    text-decoration: none;
  }
  .gl-link:hover {
    text-decoration: underline;
  }
</style>
