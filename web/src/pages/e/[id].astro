---
import Portal from "../../layouts/Portal.astro";
import Sidebar from "../../components/Sidebar.astro";
import CategoryThumb from "../../components/CategoryThumb.astro";
import ArticleLike from "../../components/ArticleLike.astro";
import LanguageFallbackBadge from "../../components/LanguageFallbackBadge.astro";
import { SITE_URL } from "../../lib/site.ts";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  WORKER_HEALTH,
  adjacentInCategory,
  entriesBySource,
  entriesByTag,
  categoryImportanceStanding,
  effectiveTitleLanguage,
  importanceLabel,
  isArxivEntry,
  relatedEntries,
  relativeTime,
  sourceAvgImportance,
  summaryForLang,
  summaryForLangWithFallback,
  tagHref,
  titleForLang,
  titleForLangWithFallback,
  trendingTags,
  type NormalizedEntry,
} from "../../lib/data.ts";
import { articleBodyState, bodyForEntry } from "../../lib/bodies.ts";
import { ARCHIVE_WARM_ENTRIES } from "../../lib/archive.ts";
import { sourceFaviconUrl, sourceHost } from "../../lib/favicon.ts";
import { REACTION_CONTRACT_EN, REACTION_CONTRACT_JA } from "../../lib/reaction-copy.ts";
import {
  SOURCE_META,
  canonicalSourceUrl,
  sourceAuthority,
  sourceLabel,
} from "../../lib/source-meta.ts";
import { normalizeTagKey } from "../../lib/tag-normalize.ts";
import { sourceExcerptForEntry } from "../../lib/source-excerpt.ts";
import SourceExcerpt from "../../components/SourceExcerpt.astro";

export function getStaticPaths() {
  const entriesById = new Map(ALL_ENTRIES.map((entry) => [entry.id, entry]));
  for (const entry of ARCHIVE_WARM_ENTRIES) {
    if (!entriesById.has(entry.id)) entriesById.set(entry.id, entry);
  }
  return [...entriesById.values()].map((e) => ({
    params: { id: e.id },
    props: { entry: e },
  }));
}

interface Props { entry: NormalizedEntry; }
const { entry } = Astro.props as Props;

const titleJa = titleForLang(entry, "ja");
const titleEn = titleForLang(entry, "en");
const titleJaResult = titleForLangWithFallback(entry, "ja");
const titleEnResult = titleForLangWithFallback(entry, "en");
const titleProvenanceId = titleJaResult.isFallback || titleEnResult.isFallback
  ? "article-title-provenance"
  : undefined;
const titleDisplay = titleJaResult.text;
const effectiveTitleLang = effectiveTitleLanguage(entry);
const likeTitleJa = titleJaResult;
const likeTitleEn = titleEnResult;
const summaryJaResult = summaryForLangWithFallback(entry, "ja");
const summaryJa = summaryJaResult.text;
const summaryEn = summaryForLangWithFallback(entry, "en");
const indexedSummaryJa = summaryForLang(entry, "ja");
const indexedSummaryEn = summaryForLang(entry, "en");
const indexedTagKeys = [...new Set(entry.tags.map(normalizeTagKey).filter(Boolean))];
// "Summary pending" only when there is no usable summary in ANY language.
// summaryForLangWithFallback cross-falls-back and blanks boilerplate / title
// echoes, so an English-source entry with a real EN summary is NOT treated as
// pending just because its JA summary has not been generated yet (LL-074).
const summaryAbsent = !summaryJa && !summaryEn.text;
const sourceExcerpt = summaryAbsent ? sourceExcerptForEntry(entry, 320) : "";
// Body lives in data/bodies.json (LL-113), not on the entry. Render prose only
// when a real long-form body exists; otherwise the summary-first digest +
// read-original view is shown. Bodies are generated by a separate cloud worker
// (opus-4.8); entries without one simply have no key here.
const body = bodyForEntry(entry.id);
const hasRealBody = body !== null;
const bodyState = articleBodyState(entry.id, body, WORKER_HEALTH?.bodyMergePendingIds);

const catMeta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = catMeta?.color ?? "#8a847e";
const catName = catMeta?.name ?? entry.category;
const catEmoji = catMeta?.emoji ?? "\u{1F4C4}";
const entryIsArxiv = isArxivEntry(entry);
const laneHref = entryIsArxiv ? "/arxiv/" : `/c/${entry.category}`;
const laneName = entryIsArxiv ? "arXiv" : catName;
const laneEmoji = entryIsArxiv ? "📄" : catEmoji;

const srcMeta = SOURCE_META.find((s) => s.id === entry.source);
const sourceUrl = canonicalSourceUrl(entry.url);
const collectionSourceDisplay = sourceLabel(entry.source);
const srcDisplay = sourceLabel(entry.source, entry.url);
const sourceRedirected = sourceUrl !== entry.url;
const srcTier = srcMeta?.tier;
const srcAuthority = sourceAuthority(entry.source, entry.sourceType);
const srcAuthorityBadgeClass = ["badge", "authority", srcAuthority.kind].join(" ");
const srcAuthorityTitle = `${srcAuthority.en} source (${srcAuthority.ja})${srcTier ? ` · registry tier ${srcTier}` : ""}`;
const srcAvgImp = sourceAvgImportance(entry, 30);
const srcAvgTitle = `Average importance of this source's last 30 listed entries: ${srcAvgImp.toFixed(1)} out of 3 (1=Info, 2=Medium, 3=High)`;

const entryFavicon = sourceFaviconUrl(sourceUrl);
const collectionFavicon = sourceFaviconUrl(entry.url);

function splitJaPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[。！？])\s*/).map((x) => x.trim()).filter(Boolean);
}
function splitEnPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[.!?])\s+/).map((x) => x.trim()).filter(Boolean);
}
const pointsJa = summaryAbsent || summaryJaResult.isFallback ? [] : splitJaPoints(summaryJa);
const pointsEn = summaryAbsent ? [] : splitEnPoints(summaryEn.text);

const sourceTypeLabel: Record<NormalizedEntry["sourceType"], { ja: string; en: string }> = {
  release: { ja: "リリース", en: "Release" },
  changelog: { ja: "変更履歴", en: "Changelog" },
  paper: { ja: "論文", en: "Paper" },
  blog: { ja: "ブログ", en: "Blog" },
  community: { ja: "コミュニティ", en: "Community" },
};
const importanceMeta = importanceLabel(entry.importance);
const halfLifeLabel: Record<string, { ja: string; en: string; emoji: string; color: string }> = {
  news: { ja: "短命 (ニュース)", en: "Short-lived (news)", emoji: "⏱️", color: "#f87171" },
  tutorial: { ja: "中期 (チュートリアル)", en: "Medium-term (tutorial)", emoji: "📘", color: "#fbbf24" },
  architecture: { ja: "長期 (アーキテクチャ)", en: "Long-term (architecture)", emoji: "🏛️", color: "#60a5fa" },
  fundamental: { ja: "永続 (基礎知識)", en: "Evergreen (fundamentals)", emoji: "🌱", color: "#4ade80" },
};

const now = new Date();
const rel = relativeTime(entry.publishedAt, now);
const sameSource = entriesBySource(entry, 5);
const sameTag = entriesByTag(entry, 5);
const tags = trendingTags(12);
const { prev, next } = adjacentInCategory(entry);
const adjacentIds = new Set(
  [prev?.id, next?.id].filter((id): id is string => Boolean(id)),
);
const sameCategory = relatedEntries(entry, 8)
  .filter((candidate) => !adjacentIds.has(candidate.id))
  .slice(0, 6);
const categoryStanding = categoryImportanceStanding(entry);
const localizedTitles = (item: NormalizedEntry) => ({
  ja: titleForLangWithFallback(item, "ja"),
  en: titleForLangWithFallback(item, "en"),
});
const prevTitles = prev ? localizedTitles(prev) : null;
const nextTitles = next ? localizedTitles(next) : null;

const bodyChars = (body?.bodyJa ?? "").length;
const readMinutes = bodyChars > 0 ? Math.max(1, Math.round(bodyChars / 500)) : 0;

// Split body and build TOC headings (use first ~24 chars of each paragraph as label).
const paragraphsJa: string[] = body?.bodyJa
  ? body.bodyJa.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];
const paragraphsEn: string[] = body?.bodyEn
  ? body.bodyEn.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];

function tocLabelJa(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^。．.!?！？]{1,40}[。．.!?！？]/);
  const label = (m?.[0] ?? trimmed).slice(0, 30);
  return label.length < trimmed.length ? label.replace(/[。．.!?！？]$/, "") + "…" : label;
}
function tocLabelEn(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^.!?]{1,80}[.!?]/);
  const label = (m?.[0] ?? trimmed).slice(0, 60);
  return label.length < trimmed.length ? label.replace(/[.!?]$/, "") + "…" : label;
}

// Highlight tag mentions in body — server-side regex replace.
function escapeHtml(s: string): string {
  return s.replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] || c,
  );
}
function escapeRegex(s: string): string {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}
function highlightTags(html: string, tagList: string[]): string {
  if (tagList.length === 0) return html;
  // Sort by length desc to avoid prefix collisions.
  const sorted = [...new Set(tagList.map((t) => t.trim()).filter(Boolean))]
    .sort((a, b) => b.length - a.length);
  let out = html;
  for (const tag of sorted) {
    if (tag.length < 2) continue;
    const re = new RegExp(`\\b${escapeRegex(tag)}\\b`, "gi");
    const href = tagHref(tag);
    out = out.replace(re, (match) => `<a class="kw" href="${escapeHtml(href)}">${escapeHtml(match)}</a>`);
  }
  return out;
}

const renderedJa = paragraphsJa.map((p, i) => ({
  id: `p-ja-${i + 1}`,
  label: tocLabelJa(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
const renderedEn = paragraphsEn.map((p, i) => ({
  id: `p-en-${i + 1}`,
  label: tocLabelEn(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
const breadcrumb = [
  { label: "Home", href: "/" },
  { label: laneName, href: laneHref },
  { label: titleDisplay },
];
const pageTitle = `${titleDisplay} — TECH Dashboard`;
const pendingDescription = {
  ja: "AI 要約は準備中です。共有前にタイトル、カテゴリ、元記事を確認してください。",
  en: "AI summary pending. Check the title, category, and original article before sharing.",
} as const;
const pageDesc = (
  summaryAbsent
    ? pendingDescription.ja
    : summaryJa || summaryEn.text || entry.title
).slice(0, 160);
const ogImage = entry.image?.src ?? "";
const canonicalUrl = `${SITE_URL}/e/${entry.id}/`;
const importanceStandingJa =
  `${laneName} ${categoryStanding.total}件中、同等以上 ${categoryStanding.sameOrHigher}件`;
const importanceStandingEn =
  `${categoryStanding.sameOrHigher} of ${categoryStanding.total} ${laneName} entries are equal or higher`;
const tldrTitleJa = pointsJa.length > 1
    ? `${Math.min(pointsJa.length, 4)} 点サマリ`
    : "要点サマリ";
const tldrTitleEn = pointsEn.length > 1
    ? `${Math.min(pointsEn.length, 4)} key points`
    : "Summary highlight";
const hasGeneratedSummaryJa = Boolean(indexedSummaryJa);
const hasGeneratedSummaryEn = Boolean(indexedSummaryEn);
const summaryLanguageScope = hasGeneratedSummaryJa && hasGeneratedSummaryEn
  ? "bilingual"
  : hasGeneratedSummaryJa
    ? "ja-only"
    : "en-only";
const generationDisclosureJa = hasGeneratedSummaryJa && hasGeneratedSummaryEn
  ? `本ページの${hasRealBody ? "本文と要約" : "要約"}は AI による自動生成です。日本語版と英語版は言語ごとに独立して生成されるため、表現や詳しさが異なる場合があります。正確性は元記事 (${sourceHost(sourceUrl)}) をご確認ください。`
  : hasGeneratedSummaryJa
    ? `現在利用できる AI 要約は日本語版のみです。英語要約は準備中で、英語表示では日本語要約を翻訳せず表示します。${hasRealBody ? "本文も AI による自動生成です。" : ""} 正確性は元記事 (${sourceHost(sourceUrl)}) をご確認ください。`
    : `日本語要約は準備中です。現在は AI 生成された英語要約を翻訳せず表示しています。${hasRealBody ? "本文も AI による自動生成です。" : ""} 正確性は元記事 (${sourceHost(sourceUrl)}) をご確認ください。`;
const generationDisclosureEn = hasGeneratedSummaryJa && hasGeneratedSummaryEn
  ? `The ${hasRealBody ? "body and summaries are" : "summaries are"} AI-generated independently for each language, so wording and detail may differ. Verify accuracy at the original source (${sourceHost(sourceUrl)}).`
  : hasGeneratedSummaryJa
    ? `The English summary is not yet available. The AI-generated Japanese summary is shown without translation.${hasRealBody ? " The body is also AI-generated." : ""} Verify accuracy at the original source (${sourceHost(sourceUrl)}).`
    : `Only the AI-generated English summary is currently available.${hasRealBody ? " The body is also AI-generated." : ""} Verify accuracy at the original source (${sourceHost(sourceUrl)}).`;

function fmtDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat("ja-JP", {
      timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit",
      day: "2-digit", hour: "2-digit", minute: "2-digit",
    }).format(new Date(iso));
  } catch { return iso; }
}

const halfLifeMeta = entry.halfLife ? halfLifeLabel[entry.halfLife] : null;
const structuredHeadline = effectiveTitleLang === "ja"
  ? titleJaResult.text
  : titleEnResult.text;
const structuredDescription = summaryAbsent
  ? pendingDescription[effectiveTitleLang]
  : effectiveTitleLang === "ja"
    ? indexedSummaryJa || structuredHeadline
    : indexedSummaryEn || structuredHeadline;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: structuredHeadline,
  description: structuredDescription,
  url: canonicalUrl,
  datePublished: entry.publishedAt,
  inLanguage: effectiveTitleLang === "ja" ? "ja-JP" : "en",
  image: ogImage || undefined,
  author: { "@type": "Organization", name: srcDisplay, url: sourceUrl },
  publisher: { "@type": "Organization", name: "TECH Dashboard", url: SITE_URL },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  articleSection: catName,
  keywords: entry.tags.join(", "),
};
---

<Portal
  title={pageTitle}
  description={pageDesc}
  pageKey={entryIsArxiv ? "arxiv" : "timeline"}
  breadcrumb={breadcrumb}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titleDisplay} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={titleDisplay} />
    <meta name="twitter:description" content={pageDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta property="article:section" content={catName} />
    <meta property="article:published_time" content={entry.publishedAt} />
    {entry.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta data-pagefind-meta="title[content]" content={titleDisplay} />
    {titleJa && <meta data-pagefind-meta="titleJa[content]" content={titleJa} />}
    {titleEn && <meta data-pagefind-meta="titleEn[content]" content={titleEn} />}
    {indexedSummaryJa && <meta data-pagefind-meta="summaryJa[content]" content={indexedSummaryJa} />}
    {indexedSummaryEn && <meta data-pagefind-meta="summaryEn[content]" content={indexedSummaryEn} />}
    {entry.tags.length > 0 && <meta data-pagefind-meta="tags[content]" content={entry.tags.join(" ")} />}
    {indexedTagKeys.map((tag) => <meta data-pagefind-filter="tag[content]" content={tag} />)}
    <meta data-pagefind-filter="category[content]" content={catName} />
    <meta data-pagefind-filter="source[content]" content={srcDisplay} />
    <meta data-pagefind-filter="sourceType[content]" content={entry.sourceType} />
    <meta data-pagefind-filter="authority[content]" content={srcAuthority.kind} />
    <meta data-pagefind-filter="importance[content]" content={String(entry.importance)} />
    <meta data-pagefind-filter="publishedDay[content]" content={entry.publishedAt.slice(0, 10)} />
    <meta data-pagefind-sort="published[content]" content={String(Date.parse(entry.publishedAt) || 0)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Reading progress bar */}
  <div class="ed-progress" id="ed-progress" style={`--cat-color:${catColor}`}>
    <div class="ed-progress-bar"></div>
  </div>

  <div class="layout">
    <Sidebar active={entryIsArxiv ? undefined : entry.category} />

    <main class="entry-main" id="entry-main">
      <article
        class="entry-detail"
        data-pagefind-body
        data-body-state={bodyState}
        data-summary-state={summaryAbsent ? "pending" : "ready"}
        style={`--cat-color:${catColor}`}
      >
        {/* HERO */}
        <div class="ed-hero" id="ed-hero">
          {entry.image?.src ? (
            <>
              <div class="ed-hero-skeleton"></div>
              <img
                class="ed-hero-img"
                src={entry.image.src}
                alt={entry.image.alt || titleDisplay}
                width={entry.image.width || 1200}
                height={entry.image.height || 630}
                loading="eager"
                decoding="async"
                onload="this.parentElement.classList.add('ed-hero-loaded')"
                onerror="this.parentElement.classList.add('ed-hero-failed')"
              />
              <div class="ed-hero-fallback">
                <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
              </div>
            </>
          ) : (
            <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
          )}
          <div class="ed-hero-overlay">
            <a class="ed-cat-pill" href={laneHref}>
              <span aria-hidden="true">{laneEmoji}</span>
              <span>{laneName}</span>
            </a>
          </div>
        </div>

        {/* TITLE */}
        <header class="ed-head">
          {(titleJaResult.isFallback || titleEnResult.isFallback) && (
            <div class="ed-title-provenance" id={titleProvenanceId}>
              {titleJaResult.isFallback && titleJaResult.fallbackLang && (
                <span class="i18n-ja">
                  <LanguageFallbackBadge fallbackLang={titleJaResult.fallbackLang} variant="title" />
                </span>
              )}
              {titleEnResult.isFallback && titleEnResult.fallbackLang && (
                <span class="i18n-en" lang="en">
                  <LanguageFallbackBadge fallbackLang={titleEnResult.fallbackLang} variant="title" />
                </span>
              )}
            </div>
          )}
          <h1 class="ed-title" aria-describedby={titleProvenanceId}>
            <span
              class="i18n-ja"
              lang={titleJaResult.isFallback ? titleJaResult.fallbackLang : "ja"}
              data-title-fallback={titleJaResult.isFallback ? titleJaResult.fallbackLang : undefined}
            >
              <span class="ed-title-text">{titleJaResult.text}</span>
            </span>
            <span
              class="i18n-en"
              lang={titleEnResult.isFallback ? titleEnResult.fallbackLang : "en"}
              data-title-fallback={titleEnResult.isFallback ? titleEnResult.fallbackLang : undefined}
            >
              <span class="ed-title-text">{titleEnResult.text}</span>
            </span>
          </h1>
          <div class="ed-byline">
            {entryFavicon && (
              <img class="ed-favicon" src={entryFavicon} alt="" width="16" height="16" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
            )}
            <span class="ed-src-name">{srcDisplay}</span>
            <span
              class={srcAuthorityBadgeClass}
              data-source-authority={srcAuthority.kind}
              data-source-type={entry.sourceType}
              title={srcAuthorityTitle}
            >
              <span class="i18n-ja">{srcAuthority.ja}</span>
              <span class="i18n-en" lang="en">{srcAuthority.en}</span>
            </span>
            <span class="sep">·</span>
            <span class="ed-host">{sourceHost(sourceUrl)}</span>
            <span class="sep">·</span>
            <time class="ed-published" datetime={entry.publishedAt}>
              <span class="mono">{fmtDate(entry.publishedAt)}</span>
              <span class="sep">·</span>
              <span class="ed-rel" data-relative-time data-datetime={entry.publishedAt}>{rel}</span>
            </time>
            {readMinutes > 0 && (<>
              <span class="sep">·</span>
              <span class="ed-read">📖 {readMinutes} min</span>
            </>)}
          </div>
          <div class="ed-action-strip">
            <a class="ed-header-cta" href={sourceUrl} target="_blank" rel="noopener nofollow">
              <span class="ed-header-cta-copy">
                <span class="i18n-ja">元記事を読む</span>
                <span class="i18n-en" lang="en">Read original article</span>
                <small>{sourceHost(sourceUrl)}</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
            <button
              class="ed-share-btn"
              type="button"
              data-share-copy
              data-title={titleDisplay}
              data-title-ja={titleJaResult.text}
              data-title-en={titleEnResult.text}
              data-url={canonicalUrl}
            >
              <span aria-hidden="true">⧉</span>
              <span class="i18n-ja">タイトルと URL をコピー</span>
              <span class="i18n-en" lang="en">Copy title + URL</span>
            </button>
          </div>
          <section
            class="ed-reaction-panel"
            data-reaction-surface
            aria-labelledby="ed-reaction-heading"
            hidden
          >
            <div class="ed-reaction-copy" data-reaction-explainer>
              <strong id="ed-reaction-heading">
                <span class="i18n-ja">この記事は参考になりましたか？</span>
                <span class="i18n-en" lang="en">Was this article useful?</span>
              </strong>
              <p>
                <span class="i18n-ja">
                {REACTION_CONTRACT_JA}
                  <a href="/about#reactions-privacy">仕組みとプライバシー</a>
                </span>
                <span class="i18n-en" lang="en">
                {REACTION_CONTRACT_EN}
                  <a href="/about#reactions-privacy">How it works and privacy</a>
                </span>
              </p>
            </div>
            <ArticleLike
              entryId={entry.id}
              variant="detail"
              articleTitleJa={likeTitleJa.text}
              articleTitleEn={likeTitleEn.text}
              articleTitleJaLang={likeTitleJa.isFallback ? likeTitleJa.fallbackLang : "ja"}
              articleTitleEnLang={likeTitleEn.isFallback ? likeTitleEn.fallbackLang : "en"}
            />
          </section>
        </header>

        {summaryAbsent && (
          <section class="ed-pending-summary" aria-labelledby="pending-summary-heading">
            <strong id="pending-summary-heading">
              <span class="i18n-ja">AI 要約 準備待ち</span>
              <span class="i18n-en" lang="en">Summary pending</span>
            </strong>
            <p>
              <span class="i18n-ja">{pendingDescription.ja}</span>
              <span class="i18n-en" lang="en">{pendingDescription.en}</span>
            </p>
            {sourceExcerpt && (
              <SourceExcerpt
                entryId={entry.id}
                excerpt={sourceExcerpt}
                lang={entry.lang}
                variant="detail"
              />
            )}
          </section>
        )}

        {/* TL;DR */}
        {!summaryAbsent && ((pointsJa.length > 0 || summaryJa) || (pointsEn.length > 0 || summaryEn.text)) && (
          <section
            class="ed-tldr"
            data-en-summary-fallback={summaryEn.isFallback ? summaryEn.fallbackLang : undefined}
          >
            <div class="ed-tldr-label">
              <span class="ai-badge">AI</span>
              <span class="ed-tldr-title i18n-ja">{tldrTitleJa}</span>
              <span class="ed-tldr-title i18n-en" lang="en">{tldrTitleEn}</span>
            </div>
            <div
              class="ed-tldr-body i18n-ja"
              lang={summaryJaResult.fallbackLang === "en" ? "en" : "ja"}
            >
              {summaryJaResult.isFallback && summaryJaResult.fallbackLang && (
                <LanguageFallbackBadge fallbackLang={summaryJaResult.fallbackLang} variant="summary" />
              )}
              {pointsJa.length > 1 ? (
                <ul class="ed-tldr-list">
                  {pointsJa.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              ) : (
                <p class="ed-tldr-single">{summaryJa}</p>
              )}
            </div>
            <div
              class="ed-tldr-body i18n-en"
              lang={summaryEn.fallbackLang === "ja" ? "ja" : "en"}
            >
              {summaryEn.isFallback && summaryEn.fallbackLang && (
                <LanguageFallbackBadge fallbackLang={summaryEn.fallbackLang} variant="summary" />
              )}
              {pointsEn.length > 1 ? (
                <ul class="ed-tldr-list">
                  {pointsEn.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              ) : (
                <p class="ed-tldr-single">{summaryEn.text}</p>
              )}
            </div>
          </section>
        )}

        {/* BODY */}
        {hasRealBody && (renderedJa.length > 0 || renderedEn.length > 0) ? (
          <section class="ed-body">
            <p class="ed-body-origin" data-body-source="summary-and-collection-metadata">
              <span class="ai-badge" aria-hidden="true">AI</span>
              <span class="i18n-ja">要約と収集メタデータをもとに生成した AI 解説本文です。元記事全文の転載・翻訳ではありません。</span>
              <span class="i18n-en" lang="en">This AI explainer is generated from the summaries and collected metadata, not from a reproduction or translation of the full source article.</span>
            </p>
            {renderedJa.length > 0 && (
              <div class="ed-body-prose i18n-ja" lang="ja">
                {renderedJa.map((p, i) => {
                  const mid = Math.floor(renderedJa.length / 2);
                  const showQuote = pointsJa.length > 1 && i === mid && renderedJa.length >= 4;
                  const quote = pointsJa.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · 本記事のポイント</figcaption>
                        </figure>
                      )}
                      {i < renderedJa.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            )}
            {renderedEn.length > 0 && (
              <div class="ed-body-prose i18n-en" lang="en">
                {renderedEn.map((p, i) => {
                  const mid = Math.floor(renderedEn.length / 2);
                  const showQuote = pointsEn.length > 1 && i === mid && renderedEn.length >= 4 && !summaryEn.isFallback;
                  const quote = pointsEn.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · Key takeaway</figcaption>
                        </figure>
                      )}
                      {i < renderedEn.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            )}
            {renderedJa.length === 0 && renderedEn.length > 0 && (
              <p class="ed-body-note i18n-ja">※ 日本語の要点は上記サマリをご参照ください。全文は元記事をご覧ください。</p>
            )}
            {renderedEn.length === 0 && renderedJa.length > 0 && (
              <p class="ed-body-note i18n-en" lang="en">※ See the summary above; the full article is at the original source.</p>
            )}
          </section>
        ) : bodyState === "queued" && !summaryAbsent ? (
          <aside class="ed-summary-only ed-body-queued">
            <div class="ed-summary-only-head">
              <span class="ai-badge">AI</span>
              <span class="i18n-ja">AI解説本文を Queue に投入済み</span>
              <span class="i18n-en" lang="en">AI explainer queued</span>
            </div>
            <p class="ed-summary-only-note">
              <span class="i18n-ja">本文生成 Queue への投入を確認済みです。完了時刻は確約せず、現在は上記の AI 要約と元記事を案内しています。</span>
              <span class="i18n-en" lang="en">This article is confirmed in the body-generation queue. No completion time is promised; use the AI summary above or open the original source.</span>
            </p>
          </aside>
        ) : !summaryAbsent ? (
          <aside class="ed-summary-only">
            <div class="ed-summary-only-head">
              <span class="ai-badge">AI</span>
              <span class="i18n-ja">本文は元記事で確認</span>
              <span class="i18n-en" lang="en">Full article at source</span>
            </div>
            <p class="ed-summary-only-note">
              <span class="i18n-ja">このページには AI 要約のみを収録しています。技術的な詳細・コード・図表は、ページ上部の「元記事を読む」から確認できます。</span>
              <span class="i18n-en" lang="en">This page contains an AI summary only. Open the original article from the action above for full detail, code, and figures.</span>
            </p>
          </aside>
        ) : null}

        {/* TAGS */}
        {entry.tags.length > 0 && (
          <nav class="ed-topics" aria-label="Related topics">
            <span class="ed-topics-label">
              <span class="i18n-ja">関連トピック</span>
              <span class="i18n-en" lang="en">Related topics</span>
            </span>
            <span class="ed-topic-links">
              {entry.tags.map((t) => (
                <a href={tagHref(t)}>{t}</a>
              ))}
            </span>
          </nav>
        )}

        {/* META STRIP */}
        <ul class="ed-meta-strip">
          <li><span class="k"><span class="i18n-ja">出典</span><span class="i18n-en" lang="en">Source</span></span><span class="v">{srcDisplay}
            <span
              class="pill"
              data-source-authority={srcAuthority.kind}
              data-source-type={entry.sourceType}
              title={srcAuthorityTitle}
              aria-label={srcAuthorityTitle}
            >
              <span class="pill-authority-label">
                <span class="i18n-ja">{srcAuthority.ja}</span>
                <span class="i18n-en" lang="en">{srcAuthority.en}</span>
              </span>
            </span>
          </span></li>
          {sourceRedirected && (
            <li data-collection-source>
              <span class="k">
                <span class="i18n-ja">収集元feed</span>
                <span class="i18n-en" lang="en">Collected via</span>
              </span>
              <span class="v">{collectionSourceDisplay}</span>
            </li>
          )}
          <li>
            <span class="k">
              <span class="i18n-ja">直近30件の平均重要度</span>
              <span class="i18n-en" lang="en">Avg importance, last 30</span>
            </span>
            <span class="v" title={srcAvgTitle} aria-label={srcAvgTitle}>
