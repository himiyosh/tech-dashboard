            const items: any[] = [];
            if (!pagefindLookupPromise) return { items, error: null };
            try {
              const [searchResult, tagSearchResult] =
                await pagefindLookupPromise;
              if (tagIntent && tagSearchResult.status === "rejected") {
                throw tagSearchResult.reason;
              }
              if (!tagIntent && searchResult.status === "rejected") {
                throw searchResult.reason;
              }
              const search = searchResult.status === "fulfilled"
                ? searchResult.value
                : { results: [] };
              const tagSearch = tagSearchResult.status === "fulfilled"
                ? tagSearchResult.value
                : { results: [] };
              const batchSize = 30;
              const minimumCandidateScan = 90;
              const candidates: Array<{
                result: any;
                intentMatch: boolean;
                intentKind?: "tag";
              }> = [
                ...tagSearch.results.slice(0, 12).map((result: any) => ({
                  result,
                  intentMatch: true,
                  intentKind: "tag" as const,
                })),
                ...search.results.slice(0, 300).map((result: any) => ({
                  result,
                  intentMatch: false,
                })),
              ];
              for (
                let offset = 0;
                offset < candidates.length;
                offset += batchSize
              ) {
                const remainingMs = searchDeadline - performance.now();
                if (remainingMs <= 0) break;
                const batch = await Promise.allSettled(
                  candidates
                    .slice(offset, offset + batchSize)
                    .map(async ({ result, intentMatch, intentKind }) => {
                      const item = await withDeadline(
                        Promise.resolve(result.data()),
                        Math.max(
                          1,
                          Math.min(tagIntent ? 3500 : 2500, remainingMs),
                        ),
                        "A search result took too long to load.",
                      );
                      return intentMatch
                        ? { ...item, intentMatch: true, intentKind }
                        : item;
                    }),
                );
                if (!isCurrentRequest(generation)) {
                  return { items: [], error: null };
                }
                items.push(
                  ...batch.flatMap((result) =>
                    result.status === "fulfilled" ? [result.value] : []
                  ),
                );
                const exactPagefindArticleCount = items.filter(
                  (item) =>
                    classifyResult(item).className === "article"
                    && isExactResult(item, q),
                ).length;
                const scannedCandidateCount = Math.min(
                  offset + batchSize,
                  candidates.length,
                );
                if (
                  scannedCandidateCount >= minimumCandidateScan
                  && exactPagefindArticleCount >= 12
                ) {
                  break;
                }
              }
              if (items.length === 0 && candidates.length > 0) {
                throw new Error("Search results could not be loaded in time.");
              }
              return { items, error: null };
            } catch (error) {
              return { items, error };
            }
          })();
          let directTagRendered = false;
          void pagefindItemsPromise.then(({ items }) => {
            if (
              directTagRendered
              || items.length === 0
              || !isCurrentRequest(generation)
            ) {
              return;
            }
            renderResolvedItems(items, false);
          });
          let coldArchiveLookup: ColdArchiveLookup | null = null;
          const requestedEntryId = searchParams.get("entry")?.toLowerCase() ?? "";
          let directTagEntryId = tagIntent && /^[a-f0-9]{16}$/.test(requestedEntryId)
            ? requestedEntryId
            : "";
          if (directTagEntryId) {
            try {
              const recoveryMap = await withDeadline(
                tagRecoveryMap(),
                2500,
                "Tag recovery validation took too long.",
              );
              if (!isCurrentRequest(generation)) return;
              if (recoveryMap[tagIntent] !== directTagEntryId) directTagEntryId = "";
            } catch {
              directTagEntryId = "";
            }
          }
          if (directTagEntryId) {
            coldArchiveLookup = await coldArchiveLookupPromise;
            if (!isCurrentRequest(generation)) return;
          }
          if (
            directTagEntryId
            && (
              !coldArchiveLookup?.available
              || coldArchiveLookup.matches.length > 0
            )
          ) {
            directTagEntryId = "";
          }
          if (directTagEntryId) {
            directTagRendered = true;
            panel.removeAttribute("aria-busy");
            setExpanded(true);
            const direct = {
              url: `/e/${directTagEntryId}/`,
              meta: {
                titleJa: `#${q} に一致する記事`,
                titleEn: `Article matching #${q}`,
              },
              filters: { tag: [tagIntent] },
              intentMatch: true,
              intentKind: "tag",
            };
            const type = classifyResult(direct);
            const heading = `<span class="i18n-ja"><strong>${escapeHtml(q)}</strong> の検索結果</span><span class="i18n-en" lang="en">Results for <strong>${escapeHtml(q)}</strong></span>`;
            const rankingNote = `<small class="search-ranking-note"><span class="i18n-ja">このタグに一致する唯一の記事です。</span><span class="i18n-en" lang="en">This is the only article matching this tag.</span></small>`;
            panel.innerHTML = `
              <div class="search-results-heading">${heading}${rankingNote}</div>
              <a class="search-hit search-hit-article" data-match-scope="tag" id="search-hit-${directTagEntryId}" role="option" aria-selected="false" href="${direct.url}">
                <div class="search-hit-topline">
                  <span class="search-hit-type ${type.badgeClass}">${type.label}</span>
                  ${matchMarkup("tag")}
                  <span class="search-hit-meta">${escapeHtml(hitMeta(direct, type))}</span>
                </div>
                <div class="search-hit-title">${resultTitleMarkup(direct)}</div>
              </a>`;
            clearActive();
            return;
          }
          if (!pf) {
            coldArchiveLookup ??= await coldArchiveLookupPromise;
            if (!isCurrentRequest(generation)) return;
          }
          if (!pf && coldArchiveLookup.matches.length === 0) {
            panel.removeAttribute("aria-busy");
            panel.innerHTML = `
              <div class="search-empty">
                <strong><span class="i18n-ja">${pagefindLoadSettled ? "検索indexを利用できません。" : "検索indexを読み込み中..."}</span><span class="i18n-en" lang="en">${pagefindLoadSettled ? "Search index is not ready." : "Loading search index..."}</span></strong>
                <p><span class="i18n-ja">${pagefindLoadSettled
                  ? "検索indexが利用できるまでカテゴリまたはStatusをご利用ください。"
                  : "入力した検索語はindexの読み込み中も保持されます。"}</span><span class="i18n-en" lang="en">${pagefindLoadSettled
                  ? "Use categories or status until the search index is available."
                  : "Your query is preserved while the local search index loads."}</span></p>
                <div class="search-empty-actions">
                  <a href="/categories"><span class="i18n-ja">カテゴリを見る</span><span class="i18n-en" lang="en">Browse categories</span></a>
                  <a href="/status"><span class="i18n-ja">sourceを確認</span><span class="i18n-en" lang="en">Check sources</span></a>
                </div>
              </div>`;
            return;
          }
          const pagefindOutcome = await pagefindItemsPromise;
          if (!isCurrentRequest(generation)) return;
          const items = [...pagefindOutcome.items];
          const pagefindError = pagefindOutcome.error;
          coldArchiveLookup ??= await coldArchiveLookupPromise;
          if (!isCurrentRequest(generation)) return;
          items.push(
            ...coldArchiveLookup.matches.map(coldArchiveRecordToSearchItem),
          );
          if (pagefindError && items.length === 0) {
            panel.removeAttribute("aria-busy");
            panel.innerHTML = `
              <div class="search-empty">
                <strong><span class="i18n-ja">検索を一時的に利用できません。</span><span class="i18n-en" lang="en">Search temporarily failed.</span></strong>
                <p><span class="i18n-ja">通信状態を確認して、もう一度お試しください。</span><span class="i18n-en" lang="en">${escapeHtml(pagefindError instanceof Error ? pagefindError.message : "Pagefind could not return results.")}</span></p>
                <div class="search-empty-actions">
                  <a href="/categories"><span class="i18n-ja">カテゴリを見る</span><span class="i18n-en" lang="en">Browse categories instead</span></a>
                  <a href="/status"><span class="i18n-ja">sourceを確認</span><span class="i18n-en" lang="en">Check sources</span></a>
                </div>
              </div>`;
            return;
          }
          function renderResolvedItems(
            resolvedItems: any[],
            settled: boolean,
          ): void {
            if (!isCurrentRequest(generation)) return;
            if (settled) panel.removeAttribute("aria-busy");
            setExpanded(true);
            let items = [...resolvedItems];
          const normalizedQuery = normalizeSearchText(q);
          const categoryIntent = categoryMeta.find((entry) =>
            entry.aliases.some((alias) => normalizeSearchText(alias) === normalizedQuery),
          );
          const intentSlug = categoryIntent?.slug;
          const categorySlugForItem = (item: any) => {
            const path = String(item.url ?? "").replace(/^https?:\/\/[^/]+/, "");
            return path.match(/^\/c\/([^/]+)(?:\/page\/\d+)?\/?$/)?.[1] ?? "";
          };
          const seenCategorySlugs = new Set<string>();
          items = items
            .map((item) => {
              const slug = categorySlugForItem(item);
              return slug ? { ...item, url: `/c/${slug}/` } : item;
            })
            .filter((item) => {
              const slug = categorySlugForItem(item);
              if (!slug) return true;
              if (seenCategorySlugs.has(slug)) return false;
              seenCategorySlugs.add(slug);
              return true;
            });
          if (categoryIntent) {
            items = items.filter((item) => categorySlugForItem(item) !== intentSlug);
            items.unshift({
              url: `/c/${categoryIntent.slug}/`,
              meta: { title: categoryIntent.label },
              filters: { category: [categoryIntent.slug] },
              intentMatch: true,
              intentKind: "category",
            });
          }
          const seenUrls = new Set<string>();
          items = items.filter((item) => {
            const url = String(item.url ?? "").replace(/^https?:\/\/[^/]+/, "");
            if (!url || seenUrls.has(url)) return false;
            seenUrls.add(url);
            return true;
          });
          const rankedExactItems = items
            .map((item, index) => ({ item, index, type: classifyResult(item) }))
            .filter(({ item }) => Boolean(item.url) && isExactResult(item, q))
            .sort((a, b) => {
              const explicitIntentOrder =
                Number(b.item.intentMatch === true)
                - Number(a.item.intentMatch === true);
              if (explicitIntentOrder) return explicitIntentOrder;
              const intentOrder =
                Number(categorySlugForItem(b.item) === intentSlug)
                - Number(categorySlugForItem(a.item) === intentSlug);
              if (intentOrder) return intentOrder;
              const coldArchiveOrder =
                Number(a.item.resultKind === "cold-archive")
                - Number(b.item.resultKind === "cold-archive");
              if (coldArchiveOrder) return coldArchiveOrder;
              const typeOrder = Number(b.type.className === "article") - Number(a.type.className === "article");
              if (typeOrder) return typeOrder;
              if (a.type.className === "article" && b.type.className === "article") {
                const publishedAtA = Date.parse(filterValue(a.item, "publishedDay")) || 0;
                const publishedAtB = Date.parse(filterValue(b.item, "publishedDay")) || 0;
                const ageTier = (publishedAt: number): number => {
                  const ageDays = Math.max(0, Math.floor((Date.now() - publishedAt) / 86400000));
                  return ageDays <= 7 ? 0 : ageDays <= 30 ? 1 : 2;
                };
                const recencyTier = ageTier(publishedAtA) - ageTier(publishedAtB);
                if (recencyTier) return recencyTier;
                const authority =
                  (authorityOrder[filterValue(a.item, "authority")] ?? 9) -
                  (authorityOrder[filterValue(b.item, "authority")] ?? 9);
                if (authority) return authority;
                const importance =
                  Number(filterValue(b.item, "importance") || 0)
                  - Number(filterValue(a.item, "importance") || 0);
                if (importance) return importance;
                const published =
                  publishedAtB - publishedAtA;
                if (published) return published;
              }
              return a.index - b.index;
            });
          const exactItems = rankedExactItems.slice(0, 10);
          const normalizedTagQuery = normalizeTagKey(q);
          const coldTagMatch = rankedExactItems.find(({ item }) =>
            item.resultKind === "cold-archive"
            && filterValues(item, "tag")
              .some((tag) => normalizeTagKey(tag) === normalizedTagQuery),
          );
          if (
            coldTagMatch
            && !exactItems.some(({ item }) => item === coldTagMatch.item)
          ) {
            if (exactItems.length >= 10) exactItems.pop();
            exactItems.push(coldTagMatch);
          }
          if (exactItems.length === 0) {
            panel.innerHTML = `
              <div class="search-empty">
                <strong><span class="i18n-ja">${escapeHtml(q)} に一致する結果はありません</span><span class="i18n-en" lang="en">No results for ${escapeHtml(q)}</span></strong>
                <p><span class="i18n-ja">短い語句にする、sourceやカテゴリ名を外す、別の言語で検索する方法をお試しください。</span><span class="i18n-en" lang="en">Try a shorter keyword, remove source/category words, or search in the other language (JA/EN).</span></p>
                <div class="search-empty-actions">
                  <a href="/categories"><span class="i18n-ja">カテゴリを見る</span><span class="i18n-en" lang="en">Browse categories</span></a>
                  <a href="/status"><span class="i18n-ja">sourceを確認</span><span class="i18n-en" lang="en">Check sources</span></a>
                  <a href="/archive"><span class="i18n-ja">月別Archiveを見る</span><span class="i18n-en" lang="en">Browse by month</span></a>
                </div>
              </div>`;
            return;
          }
          const heading = `<span class="i18n-ja"><strong>${escapeHtml(q)}</strong> の検索結果</span><span class="i18n-en" lang="en">Results for <strong>${escapeHtml(q)}</strong></span>`;
          const rankingNote = `<small class="search-ranking-note"><span class="i18n-ja">カテゴリ・タグの完全一致を先頭に固定。記事は公開時期、出典、重要度の順で比較します。</span><span class="i18n-en" lang="en">Exact category and tag intents are pinned. Articles are grouped by recency, then source authority and importance.</span></small>`;
          panel.innerHTML = `<div class="search-results-heading">${heading}${rankingNote}</div>` + exactItems
            .map(({ item: d, type }) => {
              const scope = matchScope(d, q, type);
              return `
              <a class="search-hit search-hit-${type.className}" data-result-kind="${escapeHtml(d.resultKind ?? type.className)}" data-match-scope="${scope}" id="search-hit-${Math.random().toString(36).slice(2)}" role="option" aria-selected="false" href="${escapeHtml(d.url)}">
                <div class="search-hit-topline">
                  <span class="search-hit-type ${type.badgeClass}">${type.label}</span>
                  ${matchMarkup(scope)}
                  ${authorityMarkup(d, type)}
                  <span class="search-hit-meta">${escapeHtml(hitMeta(d, type))}</span>
                </div>
                <div class="search-hit-title">${resultTitleMarkup(d)}</div>
                ${resultExcerpt(d) ? `<div class="search-hit-excerpt">${resultExcerpt(d)}</div>` : ""}
              </a>`;
            })
            .join("");
          clearActive();
          }
          renderResolvedItems(items, true);
        };

        document.addEventListener("techdb:languagechange", () => {
          syncSearchOverlayPosition();
          const query = input.value.trim();
          if (!searchRoot.classList.contains("is-open") || !query) return;
          void renderResults(query, nextRequestGeneration());
        });

        let t: number | undefined;
        input.addEventListener("input", () => {
          const q = input.value.trim();
          syncSearchRoute(q);
          const generation = nextRequestGeneration();
          window.clearTimeout(t);
          t = window.setTimeout(() => renderResults(q, generation), 120);
        });
        input.addEventListener("focus", () => {
          const generation = nextRequestGeneration();
          establishSearchState();
          if (input.value.trim()) renderResults(input.value.trim(), generation);
          else renderSearchHelp();
        });
        searchTriggers.forEach((trigger) => {
          trigger.addEventListener("click", () => openSearch(trigger));
        });
        document.addEventListener("keydown", (e) => {
          const isTextInput = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement;
          const wantsSearch = e.key === "/" || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k");
          if (wantsSearch && !isTextInput) {
            e.preventDefault();
            const activeElement = document.activeElement;
            openSearch(activeElement instanceof HTMLElement && activeElement !== document.body
              ? activeElement
              : null);
          }
        });
        document.addEventListener("click", (e) => {
          const target = e.target as Node;
          const changesSearchLanguage =
            target instanceof Element && target.closest(".lang-toggle") !== null;
          if (
            !searchRoot.contains(target)
            && !searchTriggers.some((trigger) => trigger.contains(target))
            && !changesSearchLanguage
          ) {
            closeSearch();
          }
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeSearch(true);
          } else if (e.key === "ArrowDown") {
            e.preventDefault();
            moveActive(1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            moveActive(-1);
          } else if (e.key === "Enter" && activeIndex >= 0) {
            const hit = hitItems()[activeIndex];
            if (hit) {
              e.preventDefault();
              hit.click();
            }
          }
        });
        // /search/ keeps its guide visible; the reader opens the panel with the
        // page button (site audit: the auto-opened overlay hid the heading and
        // instructions on mobile).
        void pagefindReady.then(() => {
          if (!searchRoot.classList.contains("is-open")) return;
          const query = input.value.trim();
          const generation = nextRequestGeneration();
          if (query) void renderResults(query, generation);
          else renderSearchHelp();
        });
      })();

      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
        if (reduceMotion || targets.length === 0) return;
        document.documentElement.classList.add("motion-ready");
        if (!("IntersectionObserver" in window)) {
          targets.forEach((target) => target.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px 12% 0px", threshold: 0 },
        );
        targets.forEach((target, index) => {
          target.style.setProperty("--reveal-index", String(index % 8));
          observer.observe(target);
        });
      })();
    </script>
  </body>
</html>
