---
import "../styles/portal.css";
import { SITE_URL } from "../lib/site.ts";
import { CATEGORY_META, WORKER_HEALTH } from "../lib/data.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { deriveWorkerRunStatus } from "../lib/run-health.ts";
import ArxivIcon from "../components/icons/ArxivIcon.astro";

export interface Props {
  title?: string;
  description?: string;
  pageKey?: "timeline" | "categories" | "arxiv" | "knowledge" | "glossary" | "sources" | "archive" | "status" | "about" | "search";
  breadcrumb?: Array<{ label: string; href?: string }>;
}

const {
  title = "TECH Dashboard — Pulse of the AI Ecosystem",
  description = "Microsoft / GitHub、Anthropic、OpenAI、Google、AI Coding Tools の公式情報を 1 時間ごとに自動収集・要約。",
  pageKey = "timeline",
  breadcrumb,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentHref = (href: string) =>
  currentPath === (href.replace(/\/+$/, "") || "/");

const navItems = [
  { href: "/", key: "timeline", label: "Timeline", detail: "最新記事と今日見るべき更新" },
  { href: "/glossary", key: "glossary", label: "Glossary", detail: "AI/LLM 用語とトレンドの用語集" },
  { href: "/archive", key: "archive", label: "Archive", detail: "月別に過去記事を確認" },
  { href: "/status", key: "status", label: "Status", detail: "収集 source と Worker 状態" },
  { href: "/about", key: "about", label: "About", detail: "サイトの目的と収集方針" },
] as const;
// Primary explore shortcuts live in the header switcher / mobile tabbar
// (Categories, arXiv, Knowledge), so they are intentionally excluded from
// navItems (the hamburger menu) to avoid duplicate controls (LL-054).
const menuOwnsCurrentPage = pageKey === "search"
  || navItems.some((item) => item.key === pageKey && item.key !== "timeline");
const categorySearchMeta = CATEGORY_META.map((meta) => ({
  slug: meta.slug,
  label: meta.shortLabel,
  aliases: [meta.name, meta.shortLabel, meta.slug.replaceAll("-", " "), ...(meta.searchAliases ?? [])],
}));
const productionHost = new URL(SITE_URL).hostname;
const footerRun = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const footerRunTone = footerRun.tone;
const footerRunStatus = footerRun.runLabel;
const footerRunDetail = !WORKER_HEALTH
  ? "open /status"
  : `last batch ${WORKER_HEALTH.sourcesOk}/${WORKER_HEALTH.sourcesAttempted} src · ${DASHBOARD_METRICS.fallbackEntries} pending`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TECH Dashboard RSS" href="/rss.xml" />
    <link rel="alternate" type="application/json" title="TECH Dashboard JSON Feed" href="/feed.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800&display=swap"
    />
    <slot name="head" />
    <script is:inline>
      // Pre-paint: apply saved language to avoid flash.
      (function () {
        try {
          var l = localStorage.getItem("td:lang");
          if (l !== "ja" && l !== "en") l = "ja";
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
        } catch (_) {
          document.documentElement.setAttribute("data-lang", "ja");
        }
      })();
    </script>
    <script is:inline define:vars={{ productionHost }}>
      // Load ads only on the production custom domain; local preview and pages.dev stay quiet for QA/trust review.
      (function () {
        if (location.hostname !== productionHost) return;
        var script = document.createElement("script");
        script.async = true;
        script.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3044810068333301";
        script.crossOrigin = "anonymous";
        document.head.appendChild(script);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content-start">
      <span class="i18n-ja">本文へスキップ</span>
      <span class="i18n-en" lang="en">Skip to content</span>
    </a>
    <header>
      <div class="header-inner">
        <a class="logo" href="/">
          <span class="logo-mark"></span>
          <span class="logo-text">TECH <span class="logo-accent">Dashboard</span></span>
        </a>
        <nav class="header-switcher" aria-label="Explore sections">
          <a
            href="/categories"
            class={pageKey === "categories" ? "nav-shortcut active" : "nav-shortcut"}
            aria-current={isCurrentHref("/categories") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true">▦</span>
            <span>Categories</span>
          </a>
          <a
            href="/arxiv"
            class={pageKey === "arxiv" ? "nav-shortcut active paper" : "nav-shortcut paper"}
            aria-current={isCurrentHref("/arxiv") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true"><ArxivIcon /></span>
            <span>arXiv</span>
          </a>
          <a
            href="/knowledge"
            class={pageKey === "knowledge" ? "nav-shortcut active knowledge" : "nav-shortcut knowledge"}
            aria-current={isCurrentHref("/knowledge") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true">✦</span>
            <span>Knowledge</span>
          </a>
        </nav>
        <form class="search" action="/search/" method="get" role="search">
          <span aria-hidden="true">🔍</span>
          <span id="search-help" class="visually-hidden">
            Search by keyword, source, category, tag, or language.
          </span>
          <input
            type="search"
            id="pagefind-search-input"
            name="q"
            aria-label="Search updates"
            aria-describedby="search-help"
            aria-controls="pagefind-results"
            aria-expanded="false"
            aria-autocomplete="list"
            role="combobox"
            placeholder="Search updates, source, category..."
            title="Press / or Command-K to search"
            autocomplete="off"
          />
          <span class="search-keys" aria-hidden="true"><kbd>/</kbd><kbd>⌘K</kbd></span>
          <button type="button" class="search-close" data-search-close aria-label="Close search" hidden>
            <span aria-hidden="true">×</span>
          </button>
          <div
            id="pagefind-results"
            class="search-results"
            role="listbox"
            aria-live="polite"
            data-category-search-meta={JSON.stringify(categorySearchMeta)}
            hidden
          ></div>
        </form>
        <div class="lang-toggle" role="group" aria-label="Language">
          <button type="button" class="lang-btn" data-lang="ja" aria-pressed="true">JA</button>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <button
          type="button"
          class="menu-trigger"
          data-menu-trigger
          aria-label="Open Menu"
          aria-controls="site-menu"
          aria-expanded="false"
        >
          <span aria-hidden="true">☰</span>
          <span class="menu-trigger-label">Menu</span>
        </button>
      </div>
      {breadcrumb && breadcrumb.length > 0 && (
        <div class="crumb-bar">
          <div class="crumb-inner">
            {breadcrumb.map((b, i) => (
              <>
                {b.href ? <a href={b.href}>{b.label}</a> : <span class="current">{b.label}</span>}
                {i < breadcrumb.length - 1 && <span class="sep">›</span>}
              </>
            ))}
          </div>
        </div>
      )}
    </header>

    <dialog id="site-menu" class="site-menu" aria-labelledby="site-menu-title" closedby="any" hidden>
      <div class="site-menu-head">
        <span id="site-menu-title">Navigation</span>
        <button type="button" class="site-menu-close" data-menu-close aria-label="Close navigation menu">×</button>
      </div>
      <nav class="site-menu-list" aria-label="Site destinations">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={pageKey === item.key ? "active" : ""}
            aria-current={isCurrentHref(item.href) ? "page" : undefined}
          >
            <span>{item.label}</span>
            <small>{item.detail}</small>
          </a>
        ))}
        <button type="button" class="site-menu-action" data-search-trigger>
          <span>Search</span>
          <small>キーワード・source・tag で検索</small>
        </button>
      </nav>
    </dialog>

    <nav class="mobile-tabbar" aria-label="Primary">
      <a href="/" class={pageKey === "timeline" ? "active" : ""} aria-current={isCurrentHref("/") ? "page" : undefined}><span aria-hidden="true">⌂</span><span>Home</span></a>
      <a href="/categories" class={pageKey === "categories" ? "active" : ""} aria-current={isCurrentHref("/categories") ? "page" : undefined}><span aria-hidden="true">▦</span><span>Categories</span></a>
      <a href="/arxiv" class={pageKey === "arxiv" ? "active" : ""} aria-current={isCurrentHref("/arxiv") ? "page" : undefined}><span aria-hidden="true"><ArxivIcon /></span><span>arXiv</span></a>
      <a href="/knowledge" class={pageKey === "knowledge" ? "active" : ""} aria-current={isCurrentHref("/knowledge") ? "page" : undefined}><span aria-hidden="true">✦</span><span>Knowledge</span></a>
      <button
        type="button"
        data-menu-trigger
        aria-label="Open Menu"
        aria-controls="site-menu"
        aria-expanded="false"
        class={menuOwnsCurrentPage ? "active" : ""}
      ><span aria-hidden="true">☰</span><span>Menu</span></button>
    </nav>

    <div id="content-start" class="content-start-anchor" tabindex="-1"></div>
    <slot />

    <div class="footer-bar">
      <div class="footer-inner">
        <a
          class="item footer-run-link"
          href="/status"
          aria-label={`Collection health: ${footerRunStatus}. ${footerRunDetail}`}
          title={`Collection health: ${footerRunStatus}. ${footerRunDetail}`}
        >
          <span class={`dot ${footerRunTone}`} data-run-tone={footerRunTone} aria-hidden="true"></span>
          <strong>{footerRunStatus}</strong>
          <span class="mono">{footerRunDetail}</span>
        </a>
        <span class="item">harness <strong>v0.1</strong></span>
        <span class="item">powered by <strong>Astro</strong> + <strong>Claude Opus</strong></span>
        <span class="spacer"></span>
        <span class="item">Cloudflare Pages</span>
      </div>
    </div>

    <script>
      import { normalizeSearchText } from "../lib/search-normalize.ts";

      // Language toggle (Ja / En) — sync with <html data-lang="...">.
      (() => {
        const apply = (l: "ja" | "en") => {
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
          try { localStorage.setItem("td:lang", l); } catch {}
          document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
            const on = b.dataset.lang === l;
            b.setAttribute("aria-pressed", on ? "true" : "false");
            b.classList.toggle("is-active", on);
          });
        };
        const current =
          (document.documentElement.getAttribute("data-lang") as "ja" | "en") || "ja";
        apply(current);
        document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
          b.addEventListener("click", () => {
            const l = (b.dataset.lang as "ja" | "en") || "ja";
            apply(l);
          });
        });
      })();

      // Shared hamburger menu — used by desktop header and mobile tabbar.
      (() => {
        const menu = document.getElementById("site-menu") as HTMLDialogElement | null;
        const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"));
        const closeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-menu-close]"));
        if (!menu || triggers.length === 0) return;

        let lastTrigger: HTMLButtonElement | null = null;
        let restoreFocusOnClose = false;
        const isVisible = (el: HTMLElement | null): el is HTMLElement =>
          !!el && el.isConnected && el.getClientRects().length > 0 && !(el as HTMLButtonElement).disabled;
        const syncMenuTriggers = (open: boolean) => {
          triggers.forEach((trigger) => {
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
            trigger.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
            trigger.classList.toggle("is-open", open);
          });
        };
        const finalizeMenuClose = () => {
          menu.hidden = true;
          syncMenuTriggers(false);
          if (restoreFocusOnClose && isVisible(lastTrigger)) lastTrigger.focus();
          restoreFocusOnClose = false;
        };
        const openMenu = (trigger: HTMLButtonElement) => {
          lastTrigger = trigger;
          (window as any).__tdCloseSearch?.();
          menu.hidden = false;
          syncMenuTriggers(true);
          if (!menu.open) menu.showModal();
          const active = menu.querySelector<HTMLElement>("a.active");
          window.requestAnimationFrame(() => (active ?? menu.querySelector<HTMLElement>("a, button"))?.focus());
        };
        const closeMenu = (restoreFocus = false) => {
          restoreFocusOnClose = restoreFocus;
          if (menu.open) menu.close();
          else finalizeMenuClose();
        };
        (window as any).__tdCloseMenu = closeMenu;

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", () => {
            if (!menu.open) openMenu(trigger);
            else closeMenu(true);
          });
        });
        closeButtons.forEach((button) => button.addEventListener("click", () => closeMenu(true)));
        menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
          link.addEventListener("click", () => closeMenu(false));
        });
        menu.addEventListener("cancel", (event) => {
          event.preventDefault();
          closeMenu(true);
        });
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Tab") return;
          const focusable = Array.from(
            menu.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter(isVisible);
          if (focusable.length === 0) {
            event.preventDefault();
            menu.focus();
            return;
          }
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && (document.activeElement === first || !menu.contains(document.activeElement))) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });
        menu.addEventListener("close", finalizeMenuClose);
        menu.addEventListener("click", (event) => {
          if (event.target !== menu) return;
          const rect = menu.getBoundingClientRect();
          const outside =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;
          if (outside) closeMenu(true);
        });
      })();

      // Lazy-load Pagefind and wire to the existing input.
      (async () => {
        const input = document.getElementById("pagefind-search-input") as HTMLInputElement | null;
        const panel = document.getElementById("pagefind-results") as HTMLDivElement | null;
        const searchRoot = input?.closest(".search") as HTMLElement | null;
        const searchTriggers = Array.from(document.querySelectorAll<HTMLElement>("[data-search-trigger]"));
        const closeButton = searchRoot?.querySelector<HTMLButtonElement>("[data-search-close]");
        if (!input || !panel || !searchRoot) return;

        type CategorySearchMeta = { slug: string; label: string; aliases: string[] };
        const categoryMeta = JSON.parse(panel.dataset.categorySearchMeta ?? "[]") as CategorySearchMeta[];
        const categoryLabels = new Map(categoryMeta.map((entry) => [entry.slug, entry.label]));
        let pf: any = null;
        let activeIndex = -1;
        let requestGeneration = 0;
        const isSearchRoute = /^\/search\/?$/.test(window.location.pathname);
        const initialSearchQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
        if (isSearchRoute && !input.value) input.value = initialSearchQuery;
        const syncSearchRoute = (query: string) => {
          if (!isSearchRoute) return;
          const next = new URL(window.location.href);
          if (query) next.searchParams.set("q", query);
          else next.searchParams.delete("q");
          window.history.replaceState(
            window.history.state,
            "",
            `${next.pathname}${next.search}${next.hash}`,
          );
        };
        let pagefindLoadSettled = false;
        const pagefindReady = (async () => {
          try {
            const pfUrl = "/pagefind/pagefind.js";
            pf = { ...await import(/* @vite-ignore */ pfUrl) };
            await pf.init();
            (window as any).__pagefind = pf;
          } catch {
            // Dev/preview: Pagefind index not built yet.
          } finally {
            pagefindLoadSettled = true;
          }
        })();

        const escapeHtml = (value: string) =>
          value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char] ?? char));
        const setExpanded = (expanded: boolean) => {
          input.setAttribute("aria-expanded", expanded ? "true" : "false");
          panel.hidden = !expanded;
        };
        const setTriggerActive = (active: boolean) => {
          searchTriggers.forEach((trigger) => {
            trigger.classList.toggle("active", active);
            if (trigger instanceof HTMLButtonElement) {
              trigger.setAttribute("aria-pressed", active ? "true" : "false");
            }
          });
        };
        const renderSearchHelp = () => {
          panel.removeAttribute("aria-busy");
          setExpanded(true);
          panel.innerHTML = `
            <div class="search-empty search-help-panel">
              <strong>Search updates</strong>
              <p>Try a product, source, category, tag, or short phrase. Examples: <code>Copilot</code>, <code>MCP</code>, <code>release</code>.</p>
              <div class="search-empty-actions">
                <a href="/categories">Browse categories</a>
                <a href="/status">Check sources</a>
                <a href="/archive">Browse archive</a>
              </div>
            </div>`;
        };
        // Focus restoration: remember what opened search so close-button / Escape
        // can return focus, mirroring the menu IIFE's lastTrigger behaviour.
        let lastSearchTrigger: HTMLElement | null = null;
        const isVisible = (el: HTMLElement | null): el is HTMLElement =>
          !!el && el.isConnected && el.getClientRects().length > 0 && !(el as HTMLButtonElement).disabled;
        const restoreSearchFocus = () => {
          if (isVisible(lastSearchTrigger)) {
            lastSearchTrigger.focus();
            return;
          }
          // The opener is no longer visible (e.g. the in-menu Search trigger after
          // the menu closed). Fall back to a visible menu trigger so the mobile
          // Menu -> Search flow still returns focus to a reachable control.
          const menuTrigger = Array.from(
            document.querySelectorAll<HTMLElement>("[data-menu-trigger]"),
          ).find(isVisible);
          menuTrigger?.focus();
        };
        const establishSearchState = () => {
          (window as any).__tdCloseMenu?.();
          searchRoot.classList.add("is-open");
          if (closeButton) closeButton.hidden = false;
          setTriggerActive(true);
        };
        const nextRequestGeneration = () => ++requestGeneration;
        const isCurrentRequest = (generation: number) =>
          generation === requestGeneration && searchRoot.classList.contains("is-open");
        const openSearch = (opener?: HTMLElement | null) => {
          lastSearchTrigger = opener instanceof HTMLElement && opener !== input ? opener : null;
          const generation = nextRequestGeneration();
          establishSearchState();
          if (document.activeElement !== input) {
            input.focus();
          } else if (input.value.trim()) {
            void renderResults(input.value.trim(), generation);
          } else {
            renderSearchHelp();
          }
        };
        const closeSearch = (restoreFocus = false) => {
          nextRequestGeneration();
          window.clearTimeout(t);
          input.value = "";
          syncSearchRoute("");
          activeIndex = -1;
          input.removeAttribute("aria-activedescendant");
          panel.removeAttribute("aria-busy");
          panel.replaceChildren();
          searchRoot.classList.remove("is-open");
          if (closeButton) closeButton.hidden = true;
          setTriggerActive(false);
          setExpanded(false);
          input.blur();
          if (restoreFocus) restoreSearchFocus();
        };
        (window as any).__tdCloseSearch = closeSearch;
        closeButton?.addEventListener("click", () => closeSearch(true));
        const hitItems = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>(".search-hit"));
        const clearActive = () => {
          activeIndex = -1;
          input.removeAttribute("aria-activedescendant");
          hitItems().forEach((hit) => {
            hit.classList.remove("is-active");
            hit.setAttribute("aria-selected", "false");
          });
        };
        const setActive = (nextIndex: number) => {
          const hits = hitItems();
          if (hits.length === 0) {
            clearActive();
            return;
          }
          activeIndex = (nextIndex + hits.length) % hits.length;
          hits.forEach((hit, index) => {
            const active = index === activeIndex;
            hit.classList.toggle("is-active", active);
            hit.setAttribute("aria-selected", active ? "true" : "false");
            if (active) {
              input.setAttribute("aria-activedescendant", hit.id);
              hit.scrollIntoView({ block: "nearest" });
            }
          });
        };
        const moveActive = (direction: 1 | -1) => {
          const hits = hitItems();
          if (hits.length === 0) {
            clearActive();
            return;
          }
          setActive(activeIndex < 0 ? (direction > 0 ? 0 : hits.length - 1) : activeIndex + direction);
        };

        const classifyResult = (url: string): { label: string; className: string } => {
          const path = url.replace(/^https?:\/\/[^/]+/, "");
          if (/^\/e\//.test(path)) return { label: "ARTICLE", className: "article" };
          if (/^\/c\//.test(path) || path === "/categories/" || path === "/categories") return { label: "CATEGORY", className: "category" };
          if (/^\/arxiv/.test(path)) return { label: "ARXIV", className: "paper" };
          if (/^\/t\//.test(path)) return { label: "TAG", className: "tag" };
          if (/^\/archive/.test(path)) return { label: "ARCHIVE", className: "archive" };
          if (/^\/status/.test(path)) return { label: "STATUS", className: "status" };
          return { label: "PAGE", className: "page" };
        };
        const stripTags = (value: string) => value.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
        const resultText = (d: any) =>
          normalizeSearchText(stripTags(`${d.meta?.title || ""} ${d.excerpt || ""} ${d.searchTerms || ""} ${d.url || ""}`));
        const queryTerms = (q: string) =>
          normalizeSearchText(q).split(/\s+/).filter((term) => term.length >= 2);
        const isExactResult = (item: any, q: string) => {
          const terms = queryTerms(q);
          if (terms.length === 0) return false;
          const text = resultText(item);
          return text.includes(normalizeSearchText(q)) || terms.every((term) => text.includes(term));
        };
        const hasExactResult = (items: any[], q: string) => items.some((item) => isExactResult(item, q));
        const filterValue = (item: any, name: string): string => {
          const value = item.filters?.[name];
          return String(Array.isArray(value) ? value[0] ?? "" : value ?? "");
        };
        const authorityOrder: Record<string, number> = {
          official: 0,
          paper: 1,
          community: 2,
          news: 3,
          aggregator: 4,
          source: 5,
        };

        const relativeAge = (day: string): string => {
          const parsed = Date.parse(day);
          if (Number.isNaN(parsed)) return "";
          const days = Math.floor((Date.now() - parsed) / 86400000);
          if (days <= 0) return "today";
          if (days === 1) return "1d ago";
          if (days < 30) return `${days}d ago`;
          const months = Math.floor(days / 30);
          if (months < 12) return `${months}mo ago`;
          return `${Math.floor(days / 365)}y ago`;
        };
        const hitMeta = (d: any, type: { className: string }): string => {
          if (type.className === "article" && d.filters) {
            const parts: string[] = [];
            const source = d.filters.source?.[0];
            const category = d.filters.category?.[0];
            const importance = Number(d.filters.importance?.[0] ?? 0);
            const day = d.filters.publishedDay?.[0];
            if (source) parts.push(source);
            if (category) parts.push(categoryLabels.get(category) ?? category);
            if (importance >= 1 && importance <= 3) {
              parts.push(`${importance === 3 ? "High" : importance === 2 ? "Medium" : "Info"} importance`);
            }
            const age = day ? relativeAge(day) : "";
            if (age) parts.push(age);
            if (parts.length) return parts.join(" · ");
          }
          return (d.url || "").replace(/^https?:\/\/[^/]+/, "") || "/";
        };

        const renderResults = async (q: string, generation = nextRequestGeneration()) => {
          if (!isCurrentRequest(generation)) return;
          clearActive();
          if (!q) {
            renderSearchHelp();
            return;
          }
          if (!pf) {
            setExpanded(true);
            panel.innerHTML = `
              <div class="search-empty">
                <strong>${pagefindLoadSettled ? "Search index is not ready." : "Loading search index..."}</strong>
                <p>${pagefindLoadSettled
                  ? "The static Pagefind index is created during <code>npm run build</code>. Use categories or status until the index is available."
                  : "Your query is preserved while the local search index loads."}</p>
                <div class="search-empty-actions">
                  <a href="/categories">Browse categories</a>
                  <a href="/status">Check sources</a>
                </div>
              </div>`;
            return;
          }
          setExpanded(true);
          panel.setAttribute("aria-busy", "true");
          panel.innerHTML = `<div class="search-empty">Searching for <strong>${escapeHtml(q)}</strong>...</div>`;
          let items: any[] = [];
          try {
            const search = await pf.search(q);
            const batchSize = 30;
            const maxCandidates = Math.min(search.results.length, 300);
            for (let offset = 0; offset < maxCandidates; offset += batchSize) {
              const batch = await Promise.all(
                search.results.slice(offset, offset + batchSize).map((r: any) => r.data()),
              );
              if (!isCurrentRequest(generation)) return;
              items.push(...batch);
              const exactArticleCount = items.filter(
                (item) =>
                  classifyResult(item.url || "").className === "article"
                  && isExactResult(item, q),
              ).length;
              if (exactArticleCount >= 12) break;
            }
          } catch (error) {
            if (!isCurrentRequest(generation)) return;
            panel.removeAttribute("aria-busy");
            panel.innerHTML = `
              <div class="search-empty">
                <strong>Search temporarily failed.</strong>
                <p>${escapeHtml(error instanceof Error ? error.message : "Pagefind could not return results.")}</p>
                <div class="search-empty-actions">
                  <a href="/categories">Browse categories instead</a>
                  <a href="/status">Check sources</a>
                </div>
              </div>`;
            return;
          }
          if (!isCurrentRequest(generation)) return;
          panel.removeAttribute("aria-busy");
          setExpanded(true);
          const normalizedQuery = normalizeSearchText(q);
          const categoryIntent = categoryMeta.find((entry) =>
            entry.aliases.some((alias) => normalizeSearchText(alias) === normalizedQuery),
          );
          const intentSlug = categoryIntent?.slug;
          const categorySlugForItem = (item: any) => {
            const path = String(item.url ?? "").replace(/^https?:\/\/[^/]+/, "");
            return path.match(/^\/c\/([^/]+)(?:\/page\/\d+)?\/?$/)?.[1] ?? "";
          };
          const seenCategorySlugs = new Set<string>();
          items = items
            .map((item) => {
              const slug = categorySlugForItem(item);
              return slug ? { ...item, url: `/c/${slug}/` } : item;
            })
            .filter((item) => {
              const slug = categorySlugForItem(item);
              if (!slug) return true;
              if (seenCategorySlugs.has(slug)) return false;
              seenCategorySlugs.add(slug);
              return true;
            });
          if (categoryIntent) {
            items = items.filter((item) => categorySlugForItem(item) !== intentSlug);
            items.unshift({
              url: `/c/${categoryIntent.slug}/`,
              meta: { title: categoryIntent.label },
              excerpt: `Browse ${categoryIntent.label} updates.`,
              searchTerms: categoryIntent.aliases.join(" "),
              filters: { category: [categoryIntent.slug] },
            });
          }
          const exactItems = items
            .map((item, index) => ({ item, index, type: classifyResult(item.url || "") }))
            .filter(({ item }) => Boolean(item.url) && isExactResult(item, q))
            .sort((a, b) => {
              const intentOrder =
                Number(categorySlugForItem(b.item) === intentSlug)
                - Number(categorySlugForItem(a.item) === intentSlug);
              if (intentOrder) return intentOrder;
              const typeOrder = Number(b.type.className === "article") - Number(a.type.className === "article");
              if (typeOrder) return typeOrder;
              if (a.type.className === "article" && b.type.className === "article") {
                const authority =
                  (authorityOrder[filterValue(a.item, "authority")] ?? 9) -
                  (authorityOrder[filterValue(b.item, "authority")] ?? 9);
                if (authority) return authority;
                const importance =
                  Number(filterValue(b.item, "importance") || 0)
                  - Number(filterValue(a.item, "importance") || 0);
                if (importance) return importance;
                const published =
                  (Date.parse(filterValue(b.item, "publishedDay")) || 0) -
                  (Date.parse(filterValue(a.item, "publishedDay")) || 0);
                if (published) return published;
              }
              return a.index - b.index;
            })
            .slice(0, 10);
          if (!hasExactResult(items, q) || exactItems.length === 0) {
            panel.innerHTML = `
              <div class="search-empty">
                <strong>No results for ${escapeHtml(q)}</strong>
                <p>Try a shorter keyword, remove source/category words, or search in the other language (JA/EN).</p>
                <div class="search-empty-actions">
                  <a href="/categories">Browse categories</a>
                  <a href="/status">Check sources</a>
                  <a href="/archive">Browse by month</a>
                </div>
              </div>`;
            return;
          }
          const heading = `Results for <strong>${escapeHtml(q)}</strong>`;
          panel.innerHTML = `<div class="search-results-heading">${heading}</div>` + exactItems
            .map(({ item: d, type }) => {
              return `
              <a class="search-hit search-hit-${type.className}" id="search-hit-${Math.random().toString(36).slice(2)}" role="option" aria-selected="false" href="${escapeHtml(d.url)}">
                <div class="search-hit-topline">
                  <span class="search-hit-type ${type.className}">${type.label}</span>
                  <span class="search-hit-meta">${escapeHtml(hitMeta(d, type))}</span>
                </div>
                <div class="search-hit-title">${escapeHtml(d.meta?.title || d.url)}</div>
                <div class="search-hit-excerpt">${d.excerpt || ""}</div>
              </a>`;
            })
            .join("");
          clearActive();
        };

        let t: number | undefined;
        input.addEventListener("input", () => {
          const q = input.value.trim();
          syncSearchRoute(q);
          const generation = nextRequestGeneration();
          window.clearTimeout(t);
          t = window.setTimeout(() => renderResults(q, generation), 120);
        });
        input.addEventListener("focus", () => {
          const generation = nextRequestGeneration();
          establishSearchState();
          if (input.value.trim()) renderResults(input.value.trim(), generation);
          else renderSearchHelp();
        });
        searchTriggers.forEach((trigger) => {
          trigger.addEventListener("click", () => openSearch(trigger));
        });
        document.addEventListener("keydown", (e) => {
          const isTextInput = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement;
          const wantsSearch = e.key === "/" || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k");
          if (wantsSearch && !isTextInput) {
            e.preventDefault();
            const activeElement = document.activeElement;
            openSearch(activeElement instanceof HTMLElement && activeElement !== document.body
              ? activeElement
              : null);
          }
        });
        document.addEventListener("click", (e) => {
          const target = e.target as Node;
          if (!searchRoot.contains(target) && !searchTriggers.some((trigger) => trigger.contains(target))) {
            closeSearch();
          }
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeSearch(true);
          } else if (e.key === "ArrowDown") {
            e.preventDefault();
            moveActive(1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            moveActive(-1);
          } else if (e.key === "Enter" && activeIndex >= 0) {
            const hit = hitItems()[activeIndex];
            if (hit) {
              e.preventDefault();
              hit.click();
            }
          }
        });
        if (isSearchRoute) openSearch(null);
        void pagefindReady.then(() => {
          if (!searchRoot.classList.contains("is-open")) return;
          const query = input.value.trim();
          const generation = nextRequestGeneration();
          if (query) void renderResults(query, generation);
          else renderSearchHelp();
        });
      })();

      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
        if (reduceMotion || targets.length === 0) return;
        document.documentElement.classList.add("motion-ready");
        if (!("IntersectionObserver" in window)) {
          targets.forEach((target) => target.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px 12% 0px", threshold: 0 },
        );
        targets.forEach((target, index) => {
          target.style.setProperty("--reveal-index", String(index % 8));
          observer.observe(target);
        });
      })();
    </script>
  </body>
</html>
