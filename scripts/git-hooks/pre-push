#!/usr/bin/env bash
# pre-push: protected branch guard と secret scan、unit/web build/e2e テストを実行する。
# worker/ の deploy は RUN_WORKER_DEPLOY=1 が明示された main push のみ実行する。
# 失敗時は push を中断する (exit 1)。
#
# インストール: bash scripts/install-hooks.sh (リポジトリ root で 1 回だけ)
# スキップ: SKIP_TESTS=1 git push / SKIP_WEB_BUILD=1 git push / SKIP_E2E=1 git push
# Worker deploy: RUN_WORKER_DEPLOY=1 git push

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# 標準入力を全て読まないと git が SIGPIPE になる (空の場合あり)
remote="${1:-}"
url="${2:-}"
input=$(cat || true)
zero_sha="0000000000000000000000000000000000000000"

if ! printf '%s\n' "$input" | node "$ROOT/scripts/check-protected-branch-write.mjs" push; then
  echo "[pre-push] ERR: protected branch への直接 push を中断します"
  exit 1
fi

# ---------- Secret scan ----------
secret_scan_ran=0
pushed_files=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  local_sha=$(echo "$line" | awk '{print $2}')
  remote_sha=$(echo "$line" | awk '{print $4}')

  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    base_ref="refs/remotes/${remote:-origin}/main"
    if git rev-parse --verify --quiet "$base_ref" >/dev/null; then
      range="$base_ref..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  secret_scan_ran=1
  if [[ "$range" == *".."* ]]; then
    changed_files=$(git diff --name-only "$range")
  else
    changed_files=$(git diff-tree --root --no-commit-id --name-only -r "$local_sha")
  fi
  pushed_files="${pushed_files}"$'\n'"${changed_files}"
  echo "[pre-push] secret scan を実行しています... ($range)"
  if ! node "$ROOT/scripts/scan-secrets.mjs" --range "$range"; then
    echo "[pre-push] ERR: secret scan 失敗。push を中断します"
    echo "[pre-push] secret 値を commit から取り除いてから再実行してください"
    exit 1
  fi
done <<EOF
$input
EOF

if [ "$secret_scan_ran" = "0" ]; then
  echo "[pre-push] push 対象 range なし → current tree の secret scan を実行しています..."
  if ! node "$ROOT/scripts/scan-secrets.mjs" --current; then
    echo "[pre-push] ERR: secret scan 失敗。push を中断します"
    exit 1
  fi
fi

# ---------- テスト実行 ----------
if [ "${SKIP_TESTS:-}" = "1" ]; then
  echo "[pre-push] SKIP_TESTS=1 → npm test をスキップします"
else
  # CI とローカルの差異 (web/node_modules キャッシュ等) をなるべく無くすため
  # Vite キャッシュをクリアしてから実行する。これにより「ローカル PASS / CI FAIL」が
  # ローカルでも再現しやすくなる。
  rm -rf "$ROOT/node_modules/.vite" "$ROOT/node_modules/.cache" 2>/dev/null || true
  echo "[pre-push] npm test を実行しています..."
  if ! npm --prefix "$ROOT" test; then
    echo "[pre-push] ERR: テスト失敗。push を中断します"
    echo "[pre-push] テストをスキップして push したい場合: SKIP_TESTS=1 git push"
    exit 1
  fi
  echo "[pre-push] OK: テスト PASS"
fi

web_build_ready=0
if [ "${SKIP_WEB_BUILD:-}" = "1" ]; then
  echo "[pre-push] SKIP_WEB_BUILD=1 → npm run build:web をスキップします"
else
  echo "[pre-push] npm run build:web を実行しています..."
  # 出力を log に退避 (astro はページ毎に数千行出力する)。成功時はサマリのみ、
  # 失敗時のみ全文を表示してターミナルが溢れるのを防ぐ。
  build_log="$(mktemp -t prepush-webbuild.XXXXXX)"
  if ! npm --prefix "$ROOT" run build:web > "$build_log" 2>&1; then
    tail -60 "$build_log"
    rm -f "$build_log"
    echo "[pre-push] ERR: web build 失敗。push を中断します"
    echo "[pre-push] web build をスキップして push したい場合: SKIP_WEB_BUILD=1 git push"
    exit 1
  fi
  grep -E "^(BUILD:|ASTRO:)|Pagefind|Indexed" "$build_log" | tail -8 || true
  rm -f "$build_log"
  echo "[pre-push] OK: web build PASS"
  web_build_ready=1
fi

if [ "${SKIP_E2E:-}" = "1" ]; then
  echo "[pre-push] SKIP_E2E=1 → npm run test:e2e をスキップします"
else
  # web/ または data/index.json に差分が無ければ E2E は省略する (ローカル DX)
  CHANGED="$pushed_files"
  if [ -n "$CHANGED" ] && ! echo "$CHANGED" | grep -qE '^(web/|data/index\.json|tests/e2e/|playwright\.config\.)'; then
    echo "[pre-push] web/ への影響なし → E2E をスキップ"
  else
    echo "[pre-push] focused Playwright E2E を実行しています..."
    playwright_bin="$ROOT/node_modules/.bin/playwright"
    e2e_pattern="Publisher generated artifact|unknown routes|archive warm|singleton tag|navigation highlights|hamburger menu|every metric-bearing"
    if [ "$web_build_ready" = "1" ]; then
      e2e_command=(env PLAYWRIGHT_REUSE_BUILD=1 "$playwright_bin" test tests/e2e/publisher.spec.ts tests/e2e/smoke.spec.ts -g "$e2e_pattern")
    else
      e2e_command=("$playwright_bin" test tests/e2e/publisher.spec.ts tests/e2e/smoke.spec.ts -g "$e2e_pattern")
    fi
    if ! "${e2e_command[@]}"; then
      echo "[pre-push] ERR: E2E テスト失敗。push を中断します"
      echo "[pre-push] E2E をスキップして push したい場合: SKIP_E2E=1 git push"
      exit 1
    fi
    echo "[pre-push] OK: E2E PASS"
  fi
fi

if [ "${SKIP_WORKER_DEPLOY:-}" = "1" ]; then
  echo "[pre-push] SKIP_WORKER_DEPLOY=1 → wrangler deploy をスキップします"
  exit 0
fi

# main にだけ反応させる (PR 作業 push では deploy しない)
push_to_main=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  local_ref=$(echo "$line" | awk '{print $1}')
  local_sha=$(echo "$line" | awk '{print $2}')
  remote_ref=$(echo "$line" | awk '{print $3}')
  remote_sha=$(echo "$line" | awk '{print $4}')

  case "$remote_ref" in
    refs/heads/main)
      push_to_main=1
      # main への push に worker/ 差分があるかを判定する範囲を決める
      if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # 新規ブランチ (=main 新規作成、ほぼ無いケース) は前回 main 比較
        range="origin/main..$local_sha"
      else
        range="$remote_sha..$local_sha"
      fi
      ;;
  esac
done <<EOF
$input
EOF

if [ "$push_to_main" = "0" ]; then
  exit 0
fi

# worker/ 配下の差分を確認
if ! git diff --name-only "$range" -- worker/ 2>/dev/null | grep -q .; then
  echo "[pre-push] worker/ に差分なし → wrangler deploy はスキップ"
  exit 0
fi

if [ "${RUN_WORKER_DEPLOY:-}" != "1" ]; then
  echo "[pre-push] worker/ に差分あり → RUN_WORKER_DEPLOY=1 未指定のため wrangler deploy は実行しません"
  echo "[pre-push] worker を反映する場合: RUN_WORKER_DEPLOY=1 git push"
  exit 0
fi

if [ ! -f "$ROOT/worker/wrangler.toml" ]; then
  echo "[pre-push] ERR: worker/wrangler.toml が見つかりません。worker deploy を中断します"
  exit 1
fi

echo "[pre-push] worker/ に差分あり → RUN_WORKER_DEPLOY=1 のため npx wrangler deploy を実行します"
if ! command -v npx >/dev/null 2>&1; then
  echo "[pre-push] ERR: npx が見つかりません。手動で wrangler deploy してください"
  exit 1
fi

cd "$(git rev-parse --show-toplevel)/worker"
if ! npx --yes wrangler@4.85.0 deploy; then
  echo "[pre-push] ERR: wrangler deploy 失敗。push を中断します"
  echo "[pre-push] 対処案: 認証 (npx wrangler login) を確認、または SKIP_WORKER_DEPLOY=1 git push で一時回避"
  exit 1
fi

echo "[pre-push] OK: worker deploy 完了"
exit 0
