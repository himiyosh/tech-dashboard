---
import Portal from "../../layouts/Portal.astro";
import Sidebar from "../../components/Sidebar.astro";
import CategoryThumb from "../../components/CategoryThumb.astro";
import { SITE_URL } from "../../lib/site.ts";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  adjacentInCategory,
  entriesBySource,
  entriesByTag,
  importancePercentile,
  relatedEntries,
  relativeTime,
  sourceAvgImportance,
  summaryForLang,
  summaryForLangWithFallback,
  titleForLang,
  trendingTags,
  type NormalizedEntry,
} from "../../lib/data.ts";
import { SOURCE_META } from "../../lib/source-meta.ts";
import { sourceFreshnessStatus } from "../../lib/freshness.ts";

export function getStaticPaths() {
  return ALL_ENTRIES.map((e) => ({
    params: { id: e.id },
    props: { entry: e },
  }));
}

interface Props { entry: NormalizedEntry; }
const { entry } = Astro.props as Props;

const titleJa = titleForLang(entry, "ja");
const titleEn = titleForLang(entry, "en");
const titleDisplay = titleJa || titleEn || entry.title;
const summaryJaResult = summaryForLangWithFallback(entry, "ja");
const summaryJa = summaryJaResult.text;
const summaryEn = summaryForLangWithFallback(entry, "en");

const catMeta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = catMeta?.color ?? "#8a847e";
const catName = catMeta?.name ?? entry.category;
const catEmoji = catMeta?.emoji ?? "\u{1F4C4}";

const srcMeta = SOURCE_META.find((s) => s.id === entry.source);
const srcDisplay = srcMeta?.displayName ?? entry.source;
const srcTier = srcMeta?.tier;
const srcAvgImp = sourceAvgImportance(entry, 30);

function host(url: string): string {
  try { return new URL(url).host.replace(/^www\./, ""); } catch { return ""; }
}
function faviconUrl(url: string, size = 32): string {
  const h = host(url);
  return h ? `https://www.google.com/s2/favicons?sz=${size}&domain=${h}` : "";
}
const entryFavicon = faviconUrl(entry.url);

function splitJaPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[。！？])\s*/).map((x) => x.trim()).filter(Boolean);
}
function splitEnPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[.!?])\s+/).map((x) => x.trim()).filter(Boolean);
}
const pointsJa = summaryJaResult.isFallback ? [] : splitJaPoints(summaryJa);
const pointsEn = splitEnPoints(summaryEn.text);

const sourceTypeLabel: Record<NormalizedEntry["sourceType"], string> = {
  release: "リリース", changelog: "Changelog", paper: "論文",
  blog: "ブログ", community: "コミュニティ",
};
const importanceLabel: Record<1 | 2 | 3, string> = {
  3: "重要", 2: "通常", 1: "情報",
};
const halfLifeLabel: Record<string, { label: string; emoji: string; color: string }> = {
  news: { label: "短命 (ニュース)", emoji: "⏱️", color: "#f87171" },
  tutorial: { label: "中期 (チュートリアル)", emoji: "📘", color: "#fbbf24" },
  architecture: { label: "長期 (アーキテクチャ)", emoji: "🏛️", color: "#60a5fa" },
  fundamental: { label: "永続 (基礎知識)", emoji: "🌱", color: "#4ade80" },
};

const now = new Date();
const rel = relativeTime(entry.publishedAt, now);
const sameSource = entriesBySource(entry, 5);
const sameTag = entriesByTag(entry, 5);
const sameCategory = relatedEntries(entry, 6);
const tags = trendingTags(12);
const { prev, next } = adjacentInCategory(entry);
const impPct = importancePercentile(entry);

const freshness = sourceFreshnessStatus(entry, entry.collectedAt, now.getTime());
const collectedAge = freshness.ageHrs >= 0 ? Math.round(freshness.ageHrs / 24) : 0;
const stale = freshness.status === "stale" || freshness.status === "error";

const bodyChars = (entry.bodyJa ?? "").length;
const readMinutes = bodyChars > 0 ? Math.max(1, Math.round(bodyChars / 500)) : 0;

// Split body and build TOC headings (use first ~24 chars of each paragraph as label).
const paragraphsJa: string[] = entry.bodyJa
  ? entry.bodyJa.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];
const paragraphsEn: string[] = entry.bodyEn
  ? entry.bodyEn.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];

function tocLabelJa(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^。．.!?！？]{1,40}[。．.!?！？]/);
  const label = (m?.[0] ?? trimmed).slice(0, 30);
  return label.length < trimmed.length ? label.replace(/[。．.!?！？]$/, "") + "…" : label;
}
function tocLabelEn(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^.!?]{1,80}[.!?]/);
  const label = (m?.[0] ?? trimmed).slice(0, 60);
  return label.length < trimmed.length ? label.replace(/[.!?]$/, "") + "…" : label;
}

// Highlight tag mentions in body — server-side regex replace.
function escapeHtml(s: string): string {
  return s.replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] || c,
  );
}
function escapeRegex(s: string): string {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}
function highlightTags(html: string, tagList: string[]): string {
  if (tagList.length === 0) return html;
  // Sort by length desc to avoid prefix collisions.
  const sorted = [...new Set(tagList.map((t) => t.trim()).filter(Boolean))]
    .sort((a, b) => b.length - a.length);
  let out = html;
  for (const tag of sorted) {
    if (tag.length < 2) continue;
    const re = new RegExp(`\\b${escapeRegex(tag)}\\b`, "gi");
    const href = `/t/${encodeURIComponent(tag.toLowerCase())}`;
    out = out.replace(re, (match) => `<a class="kw" href="${href}">${escapeHtml(match)}</a>`);
  }
  return out;
}

const renderedJa = paragraphsJa.map((p, i) => ({
  id: `p-ja-${i + 1}`,
  label: tocLabelJa(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
const renderedEn = paragraphsEn.map((p, i) => ({
  id: `p-en-${i + 1}`,
  label: tocLabelEn(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
// Backwards-compat alias: TOC defaults to JA when present, otherwise EN.
const renderedParagraphs = renderedJa.length > 0 ? renderedJa : renderedEn;

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: catName, href: `/c/${entry.category}` },
  { label: titleDisplay },
];
const pageTitle = `${titleDisplay} — TECH Dashboard`;
const pageDesc = (summaryJa || summaryEn.text || entry.title).slice(0, 160);
const ogImage = entry.image?.src ?? "";
const canonicalUrl = `${SITE_URL}/e/${entry.id}/`;

function fmtDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat("ja-JP", {
      timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit",
      day: "2-digit", hour: "2-digit", minute: "2-digit",
    }).format(new Date(iso));
  } catch { return iso; }
}

const halfLifeMeta = entry.halfLife ? halfLifeLabel[entry.halfLife] : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: titleDisplay,
  description: pageDesc,
  url: canonicalUrl,
  datePublished: entry.publishedAt,
  dateModified: entry.collectedAt,
  inLanguage: entry.lang === "ja" ? "ja-JP" : "en",
  image: ogImage || undefined,
  author: { "@type": "Organization", name: srcDisplay, url: entry.url },
  publisher: { "@type": "Organization", name: "TECH Dashboard", url: SITE_URL },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  articleSection: catName,
  keywords: entry.tags.join(", "),
};
---

<Portal title={pageTitle} description={pageDesc} pageKey="timeline" breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titleDisplay} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={titleDisplay} />
    <meta name="twitter:description" content={pageDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta property="article:section" content={catName} />
    <meta property="article:published_time" content={entry.publishedAt} />
    <meta property="article:modified_time" content={entry.collectedAt} />
    {entry.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta data-pagefind-filter="category[content]" content={entry.category} />
    <meta data-pagefind-filter="source[content]" content={entry.source} />
    <meta data-pagefind-filter="sourceType[content]" content={entry.sourceType} />
    <meta data-pagefind-filter="importance[content]" content={String(entry.importance)} />
    <meta data-pagefind-filter="publishedDay[content]" content={entry.publishedAt.slice(0, 10)} />
    <meta data-pagefind-sort="published[content]" content={String(Date.parse(entry.publishedAt) || 0)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Reading progress bar */}
  <div class="ed-progress" id="ed-progress" style={`--cat-color:${catColor}`}>
    <div class="ed-progress-bar"></div>
  </div>

  <div class="layout">
    <Sidebar active={entry.category} />

    <main class="entry-main" id="entry-main">
      <article class="entry-detail" data-pagefind-body style={`--cat-color:${catColor}`}>
        {/* HERO */}
        <div class="ed-hero" id="ed-hero">
          {entry.image?.src ? (
            <>
              <div class="ed-hero-skeleton"></div>
              <img
                class="ed-hero-img"
                src={entry.image.src}
                alt={entry.image.alt || titleDisplay}
                width={entry.image.width || 1200}
                height={entry.image.height || 630}
                loading="eager"
                decoding="async"
                onload="this.parentElement.classList.add('ed-hero-loaded')"
                onerror="this.parentElement.classList.add('ed-hero-failed')"
              />
              <div class="ed-hero-fallback">
                <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
              </div>
            </>
          ) : (
            <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
          )}
          <div class="ed-hero-overlay">
            <a class="ed-cat-pill" href={`/c/${entry.category}`}>
              <span aria-hidden="true">{catEmoji}</span>
              <span>{catName}</span>
            </a>
            {entry.importance === 3 && <span class="ed-hot-pill">🔥 HOT</span>}
            {stale && <span class="ed-stale-pill" title={`Collected ${Math.round(collectedAge)} days ago`}>⚠ 古い情報の可能性</span>}
          </div>
        </div>

        {/* TITLE */}
        <header class="ed-head">
          <h1 class="ed-title">
            <span class="i18n-ja">{titleJa || titleEn || entry.title}</span>
            <span class="i18n-en" lang="en">{titleEn || titleJa || entry.title}</span>
          </h1>
          <div class="ed-byline">
            {entryFavicon && (
              <img class="ed-favicon" src={entryFavicon} alt="" width="18" height="18" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
            )}
            <span class="ed-src-name">{srcDisplay}</span>
            <span class="sep">·</span>
            <span class="ed-host">{host(entry.url)}</span>
            <span class="sep">·</span>
            <span class="mono">{fmtDate(entry.publishedAt)}</span>
            <span class="sep">·</span>
            <span class="ed-rel">{rel}</span>
            {readMinutes > 0 && (<>
              <span class="sep">·</span>
              <span class="ed-read">📖 {readMinutes} min</span>
            </>)}
          </div>
          <div class="ed-action-strip">
            <a class="ed-header-cta" href={entry.url} target="_blank" rel="noopener nofollow">
              <span>元記事を読む</span>
              <span aria-hidden="true">↗</span>
            </a>
            <button class="ed-share-btn" type="button" id="ed-share-btn" data-title={titleDisplay} data-url={canonicalUrl}>
              <span aria-hidden="true">🔗</span> シェア
            </button>
            <span class={`ed-freshness ${stale ? "warn" : "ok"}`}>{stale ? "古い情報の可能性" : "鮮度 OK"}</span>
          </div>
        </header>

        {/* TL;DR */}
        {(pointsJa.length > 0 || summaryJa) && (
          <section class="ed-tldr">
            <div class="ed-tldr-label">
              <span class="ai-badge">AI</span>
              <span class="ed-tldr-title">{summaryJaResult.isFallback ? "English summary" : "3 行サマリ"}</span>
            </div>
            {pointsJa.length > 1 ? (
              <ul class="ed-tldr-list">
                {pointsJa.slice(0, 4).map((p) => <li>{p}</li>)}
              </ul>
            ) : (
              <p class="ed-tldr-single" lang={summaryJaResult.fallbackLang === "en" ? "en" : "ja"}>{summaryJa}</p>
            )}
            {pointsEn.length > 0 && !summaryEn.isFallback && !summaryJaResult.isFallback && (
              <details class="ed-tldr-en">
                <summary>English summary</summary>
                <ul lang="en">
                  {pointsEn.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              </details>
            )}
          </section>
        )}

        {/* BODY */}
        {(renderedJa.length > 0 || renderedEn.length > 0) ? (
          <section class="ed-body">
            {renderedJa.length > 0 && (
              <div class="ed-body-prose i18n-ja" lang="ja">
                {renderedJa.map((p, i) => {
                  const mid = Math.floor(renderedJa.length / 2);
                  const showQuote = pointsJa.length > 1 && i === mid && renderedJa.length >= 4;
                  const quote = pointsJa.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · 本記事のポイント</figcaption>
                        </figure>
                      )}
                      {i < renderedJa.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            )}
            {renderedEn.length > 0 && (
              <div class="ed-body-prose i18n-en" lang="en">
                {renderedEn.map((p, i) => {
                  const mid = Math.floor(renderedEn.length / 2);
                  const showQuote = pointsEn.length > 1 && i === mid && renderedEn.length >= 4 && !summaryEn.isFallback;
                  const quote = pointsEn.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · Key takeaway</figcaption>
                        </figure>
                      )}
                      {i < renderedEn.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            )}
            {renderedJa.length === 0 && renderedEn.length > 0 && (
              <p class="ed-body-pending i18n-ja">※ 日本語版の本文は近日中に AI が生成します。現在は英語版をご覧ください。</p>
            )}
            {renderedEn.length === 0 && renderedJa.length > 0 && (
              <p class="ed-body-pending i18n-en" lang="en">※ The English body is being generated. Japanese version is currently shown.</p>
            )}
          </section>
        ) : (
          <section class="ed-body">
            <p class="ed-body-pending">
              ※ この記事の本文は近日中に AI が生成して差し替わります。現時点では上記サマリをご参照ください。
            </p>
          </section>
        )}

        {/* TAGS */}
        {entry.tags.length > 0 && (
          <div class="ed-tag-bar">
            {entry.tags.map((t) => (
              <a class="ed-tag" href={`/t/${t}`}>#{t}</a>
            ))}
          </div>
        )}

        {/* META STRIP */}
        <ul class="ed-meta-strip">
          <li><span class="k">Source</span><span class="v">{srcDisplay}{srcTier && <span class="pill">T{srcTier}</span>}</span></li>
          <li><span class="k">Source Avg ★</span><span class="v"><span class="mini-bar" style={`--w:${(srcAvgImp / 3) * 100}%`}></span> {srcAvgImp.toFixed(1)}</span></li>
          <li><span class="k">Type</span><span class="v">{sourceTypeLabel[entry.sourceType] ?? entry.sourceType}</span></li>
          <li>
            <span class="k">Importance</span>
            <span class="v">
              <span class={`pill imp-${entry.importance}`}>★ {importanceLabel[entry.importance]}</span>
              <span class="muted-sm">(top {100 - impPct}% in {catName})</span>
            </span>
          </li>
          {halfLifeMeta && (
            <li>
              <span class="k">Half-life</span>
              <span class="v" style={`color:${halfLifeMeta.color}`}>
                {halfLifeMeta.emoji} {halfLifeMeta.label}
              </span>
            </li>
          )}
          <li><span class="k">Lang</span><span class="v">{entry.lang === "ja" ? "JA" : "EN"}</span></li>
          <li><span class="k">Collected</span><span class="v mono">{fmtDate(entry.collectedAt)}</span></li>
        </ul>

        {/* CTA */}
        <div class="ed-cta-row">
          <a class="ed-cta" href={entry.url} target="_blank" rel="noopener nofollow">
            <span>元記事を読む</span>
            <span aria-hidden="true">↗</span>
          </a>
          <span class="ed-cta-host">
             {entryFavicon && <img src={entryFavicon} alt="" width="14" height="14" loading="lazy" onerror="this.style.display='none'" />}
            {host(entry.url)}
          </span>
        </div>

        <p class="ed-disclaim">
          本ページの本文・要約は AI による自動生成です。正確性は元記事 ({host(entry.url)}) をご確認ください。
        </p>
      </article>

      {/* PREV / NEXT */}
      {(prev || next) && (
        <nav class="ed-pn" aria-label="同カテゴリの前後の記事">
          {prev ? (
            <a class="ed-pn-card prev" href={`/e/${prev.id}/`} accesskey="ArrowLeft">
              <span class="ed-pn-arrow" aria-hidden="true">←</span>
              <span class="ed-pn-body">
                <span class="ed-pn-dir">新しい記事</span>
                <span class="ed-pn-title">{titleForLang(prev, "ja") || titleForLang(prev, "en") || prev.title}</span>
                <span class="ed-pn-time">{relativeTime(prev.publishedAt, now)}</span>
              </span>
            </a>
          ) : <span class="ed-pn-empty" aria-hidden="true"></span>}
          {next ? (
            <a class="ed-pn-card next" href={`/e/${next.id}/`} accesskey="ArrowRight">
              <span class="ed-pn-body">
                <span class="ed-pn-dir">古い記事</span>
                <span class="ed-pn-title">{titleForLang(next, "ja") || titleForLang(next, "en") || next.title}</span>
                <span class="ed-pn-time">{relativeTime(next.publishedAt, now)}</span>
              </span>
              <span class="ed-pn-arrow" aria-hidden="true">→</span>
            </a>
          ) : <span class="ed-pn-empty" aria-hidden="true"></span>}
        </nav>
      )}

      {/* SAME CATEGORY */}
      {sameCategory.length > 0 && (
        <section class="ed-rel-block">
          <h2 class="ed-rel-h">
            <span class="ed-rel-h-emoji" style={`color:${catColor}`}>{catEmoji}</span>
            <span>{catName} の他の記事</span>
            <a class="ed-rel-h-more" href={`/c/${entry.category}`}>もっと見る →</a>
          </h2>
          <div class="ed-rel-grid">
            {sameCategory.map((r) => {
              const rTitle = titleForLang(r, "ja") || titleForLang(r, "en") || r.title;
              const rSum = summaryForLang(r, "ja") || summaryForLang(r, "en");
              const rMeta = CATEGORY_META.find((c) => c.slug === r.category);
              const rColor = rMeta?.color ?? catColor;
              return (
                <a class="ed-rel-card" href={`/e/${r.id}/`} style={`--cat-color:${rColor}`}>
                  <div class="ed-rel-thumb">
                    {r.image?.src ? (
                      <img src={r.image.src} alt={r.image.alt || rTitle} loading="lazy" decoding="async" onerror="this.parentElement.classList.add('failed')" />
                    ) : null}
                    <div class="ed-rel-thumb-fallback">
                      <CategoryThumb category={r.category} seed={r.id} height="100%" />
                    </div>
                    {r.importance === 3 && <span class="ed-rel-thumb-hot">🔥 HOT</span>}
                  </div>
                  <div class="ed-rel-cardbody">
                    <div class="ed-rel-title">{rTitle}</div>
                    <div class="ed-rel-meta">
                      <span class="ed-rel-src">{r.source}</span>
                      <span class="ed-rel-time">{relativeTime(r.publishedAt, now)}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </main>

    {/* RIGHT RAIL */}
    <aside class="right">
      <div class="side-card reading-card" style={`--cat-color:${catColor}`}>
        <div class="rail-title">読む前に</div>
        <div class="rail-metrics">
          <span><strong>{Math.max(readMinutes, 1)}</strong><small>分</small></span>
          <span><strong>★ {entry.importance}</strong><small>重要度</small></span>
          <span><strong>{entry.lang.toUpperCase()}</strong><small>言語</small></span>
        </div>
        <div class={`rail-freshness ${stale ? "warn" : "ok"}`}>{stale ? "収集から時間が経過" : "鮮度 OK"}</div>
        <a class="rail-cta" href={entry.url} target="_blank" rel="noopener nofollow">元記事を読む <span aria-hidden="true">↗</span></a>
      </div>

      {/* TOC */}
      {renderedParagraphs.length >= 3 && (
        <div class="side-card toc-card">
          <div class="rail-title">目次</div>
          <ol class="toc-list" id="toc-list">
            {renderedParagraphs.map((p, i) => (
              <li>
                <a href={`#${p.id}`} data-toc-target={p.id}>
                  <span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="toc-label">{p.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}

      {sameSource.length > 0 && (
        <div class="side-card">
          <div class="rail-title">
             {entryFavicon && <img class="rail-fav" src={entryFavicon} alt="" width="14" height="14" referrerpolicy="no-referrer" onerror="this.style.display='none'" />}
            {srcDisplay} の最新
          </div>
          <ul class="rail-list">
            {sameSource.map((r) => (
              <li>
                <a href={`/e/${r.id}/`}>
                  <span class="rail-item-title">{titleForLang(r, "ja") || titleForLang(r, "en") || r.title}</span>
                  <span class="rail-item-time">{relativeTime(r.publishedAt, now)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {sameTag.length > 0 && (
        <div class="side-card">
          <div class="rail-title">
            <span style={`color:${catColor}`}>#</span>
            関連タグの記事
          </div>
          <ul class="rail-list">
            {sameTag.map((r) => (
              <li>
                <a href={`/e/${r.id}/`}>
                  <span class="rail-item-title">{titleForLang(r, "ja") || titleForLang(r, "en") || r.title}</span>
                  <span class="rail-item-time">{relativeTime(r.publishedAt, now)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="side-card">
        <div class="rail-title">Trending Tags</div>
        <div class="tag-cloud">
          {tags.map((t) => (
            <a class="tag" href={`/t/${encodeURIComponent(t.tag)}`}>
              #{t.tag} <span class="c">{t.count}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="side-card cat-jump" style={`--cat-color:${catColor}`}>
        <div class="rail-title">Category</div>
        <a class="cat-jump-link" href={`/c/${entry.category}`}>
          <span class="cat-jump-emoji">{catEmoji}</span>
          <span class="cat-jump-name">{catName}</span>
          <span class="cat-jump-arrow">→</span>
        </a>
      </div>
    </aside>
  </div>

  {/* Floating back-to-top */}
  <button class="ed-fab" id="ed-fab" type="button" aria-label="トップに戻る" style={`--cat-color:${catColor}`}>
    ↑
  </button>

  {/* Share toast */}
  <div class="ed-toast" id="ed-toast" role="status">URL をコピーしました</div>
</Portal>

<script is:inline>
  (function () {
    // Reading progress bar
    var bar = document.querySelector("#ed-progress .ed-progress-bar");
    var main = document.getElementById("entry-main");
    function onScroll() {
      if (!bar || !main) return;
      var rect = main.getBoundingClientRect();
      var total = main.offsetHeight - window.innerHeight;
      var scrolled = -rect.top;
      var pct = Math.max(0, Math.min(1, scrolled / Math.max(1, total)));
      bar.style.width = (pct * 100).toFixed(2) + "%";
      var fab = document.getElementById("ed-fab");
      if (fab) fab.classList.toggle("show", scrolled > window.innerHeight * 0.5);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // FAB back-to-top
    var fab = document.getElementById("ed-fab");
    if (fab) fab.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    // Share button — Web Share API w/ clipboard fallback
    var sb = document.getElementById("ed-share-btn");
    var toast = document.getElementById("ed-toast");
    function showToast() {
      if (!toast) return;
      toast.classList.add("show");
      setTimeout(function () { toast.classList.remove("show"); }, 1800);
    }
    if (sb) sb.addEventListener("click", async function () {
      var t = sb.dataset.title || document.title;
      var u = sb.dataset.url || location.href;
      try {
        if (navigator.share) {
          await navigator.share({ title: t, url: u });
          return;
        }
      } catch (_) {}
      try {
        await navigator.clipboard.writeText(u);
        showToast();
      } catch (_) {
        prompt("Copy URL", u);
      }
    });

    // Keyboard nav: ArrowLeft (prev = newer), ArrowRight (next = older)
    document.addEventListener("keydown", function (e) {
      if (e.target && /^(input|textarea|select)$/i.test(e.target.tagName)) return;
      if (e.key === "ArrowLeft") {
        var p = document.querySelector(".ed-pn-card.prev");
        if (p && p instanceof HTMLAnchorElement) { e.preventDefault(); location.href = p.href; }
      } else if (e.key === "ArrowRight") {
        var n = document.querySelector(".ed-pn-card.next");
        if (n && n instanceof HTMLAnchorElement) { e.preventDefault(); location.href = n.href; }
      }
    });

    // TOC active section highlight
    var tocLinks = document.querySelectorAll("#toc-list a[data-toc-target]");
    if (tocLinks.length) {
      var paras = Array.from(tocLinks).map(function (a) {
        return document.getElementById(a.getAttribute("data-toc-target"));
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            tocLinks.forEach(function (a) { a.classList.remove("active"); });
            var match = document.querySelector('#toc-list a[data-toc-target="' + en.target.id + '"]');
            if (match) match.classList.add("active");
          }
        });
      }, { rootMargin: "-30% 0px -55% 0px", threshold: 0 });
      paras.forEach(function (p) { if (p) io.observe(p); });
    }
  })();
</script>

