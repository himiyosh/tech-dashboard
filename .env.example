# tech-dashboard ローカル実行用の環境変数サンプル。
# 実値は .env.local にコピーして設定する (.env.local は .gitignore 済み)。
# このファイルはプレースホルダーのみ。実トークンを書き込まないこと。

# ============ 要約パイプライン認証 (いずれか片方) ============
# Copilot Enterprise 権限を持つ PAT。一時トークン交換を自動で行う。
COPILOT_PAT=__REPLACE_WITH_YOUR_COPILOT_PAT__
# 既に交換済みの一時トークンを直接注入する場合 (CI 等)。
# COPILOT_TOKEN=__REPLACE_WITH_EXCHANGED_TOKEN__
# どちらも未設定なら要約フェーズは自動スキップされる (ローカル dev を妨げない)。

# ============ 要約モデル / エンドポイント ============
# 利用可能なのは claude-sonnet-4.6 / claude-opus-4.7 のみ (R-007)。
SUMMARIZE_MODEL=claude-sonnet-4.6
# SUMMARIZE_ENDPOINT=https://api.githubcopilot.com/chat/completions

# ============ 要約チューニング (任意) ============
# ENQUEUE_MAX_NEW=10
# SUMMARIZE_TIMEOUT_MS=180000
# SUMMARIZE_MAX_TOKENS=6000
# SUMMARIZE_CONCURRENCY=2

# ============ 手動 Worker デプロイ / 運用 (任意) ============
# 通常は Cloudflare Pages Git Integration が自動デプロイするため不要 (R-001)。
# 手動デプロイ時のみ設定する。
# CLOUDFLARE_ACCOUNT_ID=__REPLACE_WITH_ACCOUNT_ID__
# CLOUDFLARE_API_TOKEN=__REPLACE_WITH_API_TOKEN__
# RUN_WORKER_DEPLOY=1   # pre-push で Worker deploy を明示的に有効化する (R-008)
