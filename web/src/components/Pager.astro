---
export interface Props {
  currentPage: number; // 1-based
  totalPages: number;
  baseHref: string; // e.g. "/c/claude" or "/t/github" or ""
  // Page 1 URL is baseHref || "/"; Page N URL is `${baseHref}/page/${N}`
}

const { currentPage, totalPages, baseHref } = Astro.props;

if (totalPages <= 1) {
  // nothing to render
}

function urlFor(page: number): string {
  if (page <= 1) return baseHref || "/";
  return `${baseHref}/page/${page}`;
}

// Window of page links: ±2 around currentPage, always 1 and last.
const pages: Array<number | "…"> = [];
const push = (n: number | "…") => {
  if (pages[pages.length - 1] !== n) pages.push(n);
};
for (let p = 1; p <= totalPages; p++) {
  if (
    p === 1 ||
    p === totalPages ||
    (p >= currentPage - 2 && p <= currentPage + 2)
  ) {
    push(p);
  } else {
    push("…");
  }
}

const prev = currentPage > 1 ? urlFor(currentPage - 1) : null;
const next = currentPage < totalPages ? urlFor(currentPage + 1) : null;
---

{totalPages > 1 && (
  <nav class="pager" aria-label="Pagination">
    {prev ? (
      <a class="pg-btn" href={prev} rel="prev">← Prev</a>
    ) : (
      <span class="pg-btn disabled">← Prev</span>
    )}

    <div class="pg-nums">
      {pages.map((p) =>
        p === "…" ? (
          <span class="pg-ellipsis">…</span>
        ) : p === currentPage ? (
          <span class="pg-num current">{p}</span>
        ) : (
          <a class="pg-num" href={urlFor(p)}>{p}</a>
        ),
      )}
    </div>

    {next ? (
      <a class="pg-btn" href={next} rel="next">Next →</a>
    ) : (
      <span class="pg-btn disabled">Next →</span>
    )}
  </nav>
)}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 24px 0 8px;
    padding: 14px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .pg-btn {
    padding: 7px 14px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-2);
    font-size: 12px;
    font-family: ui-monospace, monospace;
    text-decoration: none;
    transition: border-color 0.12s, color 0.12s;
  }
  .pg-btn:hover { border-color: var(--border-strong); color: var(--text); }
  .pg-btn.disabled {
    color: var(--muted-2);
    background: transparent;
    border-color: var(--border);
    cursor: not-allowed;
    opacity: 0.5;
  }
  .pg-nums {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .pg-num {
    min-width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 8px;
    border-radius: 6px;
    color: var(--muted);
    font-size: 12px;
    font-family: ui-monospace, monospace;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.12s, color 0.12s;
  }
  .pg-num:hover { background: var(--surface); color: var(--text); }
  .pg-num.current {
    background: var(--accent);
    color: #0a0908;
    font-weight: 700;
    border-color: var(--accent);
  }
  .pg-ellipsis { color: var(--muted-2); padding: 0 4px; }
</style>
