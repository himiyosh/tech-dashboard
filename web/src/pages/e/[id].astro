                </span>
                <span class="ed-pn-title i18n-en" lang={prevTitles?.en.fallbackLang ?? "en"}>
                  {prevTitles?.en.isFallback && prevTitles.en.fallbackLang && (
                    <LanguageFallbackBadge fallbackLang={prevTitles.en.fallbackLang} variant="title" />
                  )}
                  {prevTitles?.en.text}
                </span>
                <span class="ed-pn-time" data-relative-time data-datetime={prev.publishedAt}>
