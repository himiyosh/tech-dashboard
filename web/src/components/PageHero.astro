---
export interface PageHeroMetric {
  label: string;
  labelEn?: string;
  value: string | number;
}

export interface PageHeroAction {
  href: string;
  label: string;
  labelEn?: string;
}

export interface Props {
  kicker: string;
  title: string;
  titleEn?: string;
  count?: string;
  countEn?: string;
  description: string;
  descriptionEn?: string;
  headingId: string;
  accent?: string;
  className?: string;
  metrics?: PageHeroMetric[];
  actions?: PageHeroAction[];
}

const {
  kicker,
  title,
  titleEn,
  count,
  countEn,
  description,
  descriptionEn,
  headingId,
  accent,
  className = "",
  metrics = [],
  actions = [],
} = Astro.props;
---

<section
  class:list={["page-hero", className]}
  style={accent ? `--page-hero-accent:${accent}` : undefined}
  aria-labelledby={headingId}
>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="page-kicker">{kicker}</p>
      <h1 id={headingId}>
        {titleEn ? (
          <>
            <span class="i18n-ja">{title}</span>
            <span class="i18n-en" lang="en">{titleEn}</span>
          </>
        ) : title}
        {count && (
          <span class="page-count">
            {countEn ? (
              <>
                <span class="i18n-ja">{count}</span>
                <span class="i18n-en" lang="en">{countEn}</span>
              </>
            ) : count}
          </span>
        )}
      </h1>
      <p>
        {descriptionEn ? (
          <>
            <span class="i18n-ja">{description}</span>
            <span class="i18n-en">{descriptionEn}</span>
          </>
        ) : description}
      </p>
      {actions.length > 0 && (
        <div class="page-hero-actions" aria-label={`${title} shortcuts`}>
          {actions.map((action) => (
            <a href={action.href}>
              {action.labelEn ? (
                <>
                  <span class="i18n-ja">{action.label}</span>
                  <span class="i18n-en" lang="en">{action.labelEn}</span>
                </>
              ) : action.label}
            </a>
          ))}
        </div>
      )}
    </div>

    {metrics.length > 0 && (
      <div class="page-hero-metrics" aria-label={`${title} summary`}>
        {metrics.map((metric) => (
          <div class="page-hero-metric">
            <span>
              {metric.labelEn ? (
                <>
                  <span class="i18n-ja">{metric.label}</span>
                  <span class="i18n-en" lang="en">{metric.labelEn}</span>
                </>
              ) : metric.label}
            </span>
            <strong>{metric.value}</strong>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
