        const classifyResult = (
          value: string | { url?: unknown; resultKind?: unknown },
        ): SearchResultType => {
          if (
            typeof value !== "string"
            && value.resultKind === "cold-archive"
          ) {
            return {
              label: "ARCHIVE",
              className: "article",
              badgeClass: "archive",
            };
          }
          const url = typeof value === "string"
            ? value
            : String(value.url ?? "");
          const path = url.replace(/^https?:\/\/[^/]+/, "");
          if (/^\/e\//.test(path)) return { label: "ARTICLE", className: "article", badgeClass: "article" };
          if (/^\/c\//.test(path) || path === "/categories/" || path === "/categories") return { label: "CATEGORY", className: "category", badgeClass: "category" };
          if (/^\/arxiv/.test(path)) return { label: "ARXIV", className: "paper", badgeClass: "paper" };
          if (/^\/t\//.test(path)) return { label: "TAG", className: "tag", badgeClass: "tag" };
          if (/^\/archive/.test(path)) return { label: "ARCHIVE", className: "archive", badgeClass: "archive" };
          if (/^\/status/.test(path)) return { label: "STATUS", className: "status", badgeClass: "status" };
          return { label: "PAGE", className: "page", badgeClass: "page" };
        };
        const stripTags = (value: string) => value.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
        const resultText = (d: any) => {
          const type = classifyResult(d);
          if (type.className === "article") {
            const source = displaySource(filterValue(d, "source"));
            const category = displayCategory(filterValue(d, "category"));
            // titleRaw: LLM 訳と食い違う生 feed タイトル (issue #253)。元記事や
            // RSS からの貼り付け検索を exact 判定に到達させる。
            return normalizeSearchText(stripTags(
              `${d.meta?.titleJa || ""} ${d.meta?.titleEn || ""} ${d.meta?.titleRaw || ""} ${d.meta?.summaryJa || ""} ${d.meta?.summaryEn || ""} ${d.meta?.tags || ""} ${source} ${category}`,
            ));
          }
          const source = filterValue(d, "source");
          const category = filterValue(d, "category");
          return normalizeSearchText(stripTags(
            `${d.meta?.title || ""} ${d.meta?.titleJa || ""} ${d.meta?.titleEn || ""} ${d.meta?.summaryJa || ""} ${d.meta?.summaryEn || ""} ${displaySource(source)} ${displayCategory(category)}`,
          ));
        };
        const queryTerms = (q: string) =>
          normalizeSearchText(q).split(/\s+/).filter((term) => term.length >= 2);
        const isExactResult = (item: any, q: string) => {
          if (item.intentMatch === true) return true;
          const terms = queryTerms(q);
