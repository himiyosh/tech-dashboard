#!/usr/bin/env bash
# pre-commit: protected branch guard、secret scan、TypeScript 型チェックを実行する。
#
# インストール: bash scripts/install-hooks.sh (リポジトリ root で 1 回だけ)
# スキップ: SKIP_TYPECHECK=1 git commit

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! node "$ROOT/scripts/check-protected-branch-write.mjs" commit; then
  echo "[pre-commit] ERR: protected branch への直接 commit を中断します"
  exit 1
fi

echo "[pre-commit] secret scan を実行しています..."
if ! node "$ROOT/scripts/scan-secrets.mjs" --staged; then
  echo "[pre-commit] ERR: secret scan 失敗。コミットを中断します"
  echo "[pre-commit] secret 値や .env / private key を index から外してください"
  exit 1
fi

if [ "${SKIP_TYPECHECK:-}" = "1" ]; then
  echo "[pre-commit] SKIP_TYPECHECK=1 → 型チェックをスキップします"
  exit 0
fi

# TypeScript ファイルがステージされているかチェック
# (pipefail 下で `| grep -qE` を使うと、grep の早期終了後に git diff が
# SIGPIPE で非 0 終了し、TS ファイルがあっても「変更なし」に誤判定し得る。
# LL-403 と同じ SIGPIPE 誤判定を避けるため、変数へ一度キャプチャしてから
# here-string で grep へ渡す)
staged_files=$(git diff --cached --name-only)
if ! grep -qE '\.(ts|tsx)$' <<<"$staged_files"; then
  # TS ファイルに変更なし → スキップ
  exit 0
fi

echo "[pre-commit] TypeScript ファイルの変更を検出 → npm run typecheck を実行します..."
if ! npm --prefix "$ROOT" run typecheck 2>&1; then
  echo "[pre-commit] ERR: 型チェック失敗。コミットを中断します"
  echo "[pre-commit] 型エラーを修正してから再コミットしてください"
  echo "[pre-commit] スキップしたい場合: SKIP_TYPECHECK=1 git commit"
  exit 1
fi

echo "[pre-commit] OK: 型チェック PASS"
exit 0
