---
import "../styles/portal.css";
import { WORKER_HEALTH, relativeTime } from "../lib/data.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import {
  ADVERTISING_REQUIRES_CONSENT,
  PRIVACY_CONSENT_STORAGE_KEY,
  PRIVACY_CONSENT_VERSION,
} from "../lib/privacy-consent.ts";
import { deriveQueueDisplay } from "../lib/queue-health.ts";
import { deriveWorkerRunStatus, WORKER_RUN_STATE_COPY } from "../lib/run-health.ts";
import { OPML_HREF, OPML_MEDIA_TYPE, OPML_TITLE } from "../lib/feed-catalog.ts";
import { SITE_URL } from "../lib/site.ts";
import type { LocalizedPageMetadata } from "../lib/social-metadata.ts";
import ArxivIcon from "../components/icons/ArxivIcon.astro";

export interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  /**
   * Root-relative path of THIS route (e.g. "/t/claude/page/2/"). It becomes the
   * self-referential <link rel="canonical">. Required for every indexable page:
   * the AdSense audit found 510 generated pages shipping with no canonical at
   * all, so canonical is now a route obligation instead of a layout default.
   * Pages that pass `metadata` carry their canonical there; pages that pass
   * `noindex` are exempt because they must never be indexed.
   */
  canonicalPath?: string;
  /** Emits <meta name="robots" content="noindex, follow"> for a shell or preview route. */
  noindex?: boolean;
  metadata?: LocalizedPageMetadata;
  pageKey?: "timeline" | "categories" | "arxiv" | "knowledge" | "glossary" | "sources" | "archive" | "status" | "about" | "editorial" | "privacy" | "contact" | "search" | "not-found";
  breadcrumb?: Array<{ label: string; href?: string }>;
  rssHref?: string;
  rssTitle?: string;
}

const {
  title: titleProp = "TECH Dashboard — Pulse of the AI Ecosystem",
  titleEn: titleEnProp = titleProp,
  description,
  descriptionEn,
  canonicalPath,
  noindex = false,
  metadata,
  pageKey = "timeline",
  breadcrumb,
  rssHref = "/rss.xml",
  rssTitle = "TECH Dashboard site-wide RSS",
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Fail closed on crawl identity. There is no boilerplate fallback any more: a
// route either states its own canonical and description, or declares itself
// noindex. Both defects the AdSense audit found (510 pages with no canonical,
// 505 pages repeating one description) become build errors, not silent output.
if (!metadata && !noindex && !canonicalPath) {
  throw new Error(
    `PORTAL_CANONICAL_MISSING: ${currentPath} renders an indexable page without \`metadata\` or \`canonicalPath\``,
  );
}
let canonicalFromPath: string | null = null;
if (canonicalPath !== undefined) {
  if (!canonicalPath.startsWith("/") || canonicalPath.startsWith("//")) {
    throw new Error(
      `PORTAL_CANONICAL_NOT_ROOT_RELATIVE: ${currentPath} passed canonicalPath=${JSON.stringify(canonicalPath)}`,
    );
  }
  const siteOrigin = new URL(SITE_URL).origin;
  const resolved = new URL(canonicalPath, `${siteOrigin}/`);
  if (resolved.origin !== siteOrigin || resolved.search || resolved.hash) {
    throw new Error(
      `PORTAL_CANONICAL_NOT_INTERNAL: ${currentPath} passed canonicalPath=${JSON.stringify(canonicalPath)}`,
    );
  }
  canonicalFromPath = resolved.href;
}
const resolvedDescriptionJa = metadata ? metadata.descriptionJa : description;
const resolvedDescriptionEn = metadata
  ? metadata.descriptionEn
  : (descriptionEn ?? description);
if (!resolvedDescriptionJa || !resolvedDescriptionEn) {
  throw new Error(
    `PORTAL_DESCRIPTION_MISSING: ${currentPath} renders without a route-specific meta description`,
  );
}
const canonicalUrl: string | null = metadata
  ? metadata.canonicalUrl
  : canonicalFromPath;
const pageTitleJa = metadata?.titleJa ?? titleProp;
const pageTitleEn = metadata?.titleEn ?? titleEnProp;
const pageDescriptionJa: string = resolvedDescriptionJa;
const pageDescriptionEn: string = resolvedDescriptionEn;
const productionAdvertisingHostname = new URL(SITE_URL).hostname;
const isCurrentHref = (href: string) =>
  currentPath === (href.replace(/\/+$/, "") || "/");

const navItems = [
  { href: "/", key: "timeline", label: "Timeline", detail: "最新記事と今日見るべき更新", detailEn: "Latest articles and today's priorities" },
  { href: "/glossary", key: "glossary", label: "Glossary", detail: "AI/LLM 用語とトレンドの用語集", detailEn: "AI, LLM, and trend glossary" },
  { href: "/archive", key: "archive", label: "Archive", detail: "月別に過去記事を確認", detailEn: "Browse articles by month" },
  { href: "/status", key: "status", label: "Status", detail: "収集 source と Worker 状態", detailEn: "Collection sources and Worker health" },
  { href: "/about", key: "about", label: "About", detail: "サイトの目的・収集方針・RSS購読", detailEn: "Purpose, collection policy, and feeds" },
  { href: "/editorial-policy", key: "editorial", label: "Editorial", detail: "編集方針・訂正・削除依頼の基準", detailEn: "Editorial policy, corrections, and takedowns" },
  { href: "/privacy", key: "privacy", label: "Privacy", detail: "データ取扱い・広告選択・削除", detailEn: "Data use, advertising choice, and deletion" },
  { href: "/contact", key: "contact", label: "Contact", detail: "訂正依頼・削除依頼・お問い合わせ", detailEn: "Corrections, takedowns, and enquiries" },
] as const;
// Primary explore shortcuts live in the header switcher / mobile tabbar
// (Categories, arXiv, Knowledge), so they are intentionally excluded from
// navItems (the hamburger menu) to avoid duplicate controls (LL-054).
const menuOwnsCurrentPage = pageKey === "search"
  || navItems.some((item) => item.key === pageKey && item.key !== "timeline");
const footerRun = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const footerRunTone = footerRun.tone;
const footerRunStatus = footerRun.runLabel;
// Reader-facing state copy (WORKER_RUN_STATE_COPY) instead of pipeline
// telemetry: batch/source counts, queue backlogs, harness version and model
// names belong on /status, not in a footer every visitor sees (site audit).
const footerRunCopy = WORKER_RUN_STATE_COPY[footerRun.state];
const footerRunDetail = footerRun.detail;
const footerSummaryQueue = deriveQueueDisplay({
  mode: DASHBOARD_METRICS.summaryQueueMode,
  backlog: DASHBOARD_METRICS.summaryQueueBacklog,
  drainEstimateHours: DASHBOARD_METRICS.summaryQueueDrainEstimateHours,
  runTone: footerRun.tone,
  runState: footerRun.state,
});
const footerBodyQueue = deriveQueueDisplay({
  mode: DASHBOARD_METRICS.bodyQueueMode,
  backlog: DASHBOARD_METRICS.bodyQueueBacklog,
  drainEstimateHours: DASHBOARD_METRICS.bodyQueueDrainEstimateHours,
  runTone: footerRun.tone,
  runState: footerRun.state,
});
const footerHealthDetail = footerRunDetail;
const footerLastRunAt = WORKER_HEALTH?.lastRunAt ?? null;
const footerLastRunRelative = footerLastRunAt
  ? relativeTime(footerLastRunAt, new Date())
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title
      data-meta-key="title"
      data-meta-content-ja={pageTitleJa}
      data-meta-content-en={pageTitleEn}
    >{pageTitleJa}</title>
    <meta
      name="description"
      content={pageDescriptionJa}
      data-meta-key="description"
      data-meta-content-ja={pageDescriptionJa}
      data-meta-content-en={pageDescriptionEn}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />
    <link rel="alternate" type="application/feed+json" title="TECH Dashboard site-wide JSON Feed" href="/feed.json" />
    <link rel="outline" type={OPML_MEDIA_TYPE} title={OPML_TITLE} href={OPML_HREF} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {metadata && (
      <>
        <meta property="og:type" content={metadata.type} />
        <meta property="og:site_name" content="TECH Dashboard" />
        <meta
          property="og:title"
          content={metadata.socialTitleJa}
          data-meta-key="og:title"
          data-meta-content-ja={metadata.socialTitleJa}
          data-meta-content-en={metadata.socialTitleEn}
        />
        <meta
          property="og:description"
          content={metadata.descriptionJa}
          data-meta-key="og:description"
          data-meta-content-ja={metadata.descriptionJa}
          data-meta-content-en={metadata.descriptionEn}
        />
        <meta
          property="og:url"
          content={metadata.socialUrlJa}
          data-meta-key="og:url"
          data-meta-content-ja={metadata.socialUrlJa}
          data-meta-content-en={metadata.socialUrlEn}
        />
        <meta property="og:image" content={metadata.image.url} />
        {metadata.image.url.startsWith("https://") && (
          <meta property="og:image:secure_url" content={metadata.image.url} />
        )}
        {metadata.image.type && <meta property="og:image:type" content={metadata.image.type} />}
        {metadata.image.width && <meta property="og:image:width" content={String(metadata.image.width)} />}
        {metadata.image.height && <meta property="og:image:height" content={String(metadata.image.height)} />}
        <meta
          property="og:image:alt"
          content={metadata.image.altJa}
          data-meta-key="og:image:alt"
          data-meta-content-ja={metadata.image.altJa}
          data-meta-content-en={metadata.image.altEn}
        />
        <meta
          property="og:locale"
          content="ja_JP"
          data-meta-key="og:locale"
          data-meta-content-ja="ja_JP"
          data-meta-content-en="en_US"
        />
        <meta
          property="og:locale:alternate"
          content="en_US"
          data-meta-key="og:locale:alternate"
          data-meta-content-ja="en_US"
          data-meta-content-en="ja_JP"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
          name="twitter:title"
          content={metadata.socialTitleJa}
          data-meta-key="twitter:title"
          data-meta-content-ja={metadata.socialTitleJa}
          data-meta-content-en={metadata.socialTitleEn}
        />
        <meta
          name="twitter:description"
          content={metadata.descriptionJa}
          data-meta-key="twitter:description"
          data-meta-content-ja={metadata.descriptionJa}
          data-meta-content-en={metadata.descriptionEn}
        />
        <meta name="twitter:image" content={metadata.image.url} />
        <meta
          name="twitter:image:alt"
          content={metadata.image.altJa}
          data-meta-key="twitter:image:alt"
          data-meta-content-ja={metadata.image.altJa}
          data-meta-content-en={metadata.image.altEn}
        />
      </>
    )}
    <slot name="head" />
    <script is:inline>
      // Pre-paint: apply saved language to avoid flash.
      // A shareable URL (?lang=en) is truthful and wins over any stored
      // preference, so a fresh browser with no localStorage reproduces the
      // language the link's author was viewing (see web/src/lib/lang-url.ts
      // for the deferred, unit-tested version of this same resolution).
      (function () {
        try {
          var urlLang = new URLSearchParams(window.location.search).get("lang");
          var l;
          if (urlLang === "ja" || urlLang === "en") {
            l = urlLang;
            try { localStorage.setItem("td:lang", l); } catch (_) {}
          } else {
            l = localStorage.getItem("td:lang");
            if (l !== "ja" && l !== "en") l = "ja";
          }
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
          document.querySelectorAll("[data-meta-content-ja][data-meta-content-en]").forEach(function (element) {
            var localizedContent = element.getAttribute("data-meta-content-" + l);
            if (!localizedContent) return;
            if (element.tagName === "TITLE") element.textContent = localizedContent;
            else element.setAttribute("content", localizedContent);
          });
        } catch (_) {
          document.documentElement.setAttribute("data-lang", "ja");
        }
      })();

    </script>
  </head>
  <body
    class:list={{
      "entry-detail-page": currentPath.startsWith("/e/"),
      "privacy-page": currentPath === "/privacy",
    }}
  >
    <a class="skip-link" href="#content-start">
      <span class="i18n-ja">本文へスキップ</span>
      <span class="i18n-en" lang="en">Skip to content</span>
    </a>
    <header>
      <div class="header-inner">
        <a class="logo" href="/">
          <span class="logo-mark"></span>
          <span class="logo-text">TECH <span class="logo-accent">Dashboard</span></span>
        </a>
        <nav class="header-switcher" aria-label="Explore sections">
          <a
            href="/categories"
            class={pageKey === "categories" ? "nav-shortcut active" : "nav-shortcut"}
            aria-label="Categories"
            aria-current={isCurrentHref("/categories") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true">▦</span>
            <span>Categories</span>
          </a>
          <a
            href="/arxiv"
            class={pageKey === "arxiv" ? "nav-shortcut active paper" : "nav-shortcut paper"}
            aria-label="arXiv"
            aria-current={isCurrentHref("/arxiv") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true"><ArxivIcon /></span>
            <span>arXiv</span>
          </a>
          <a
            href="/knowledge"
            class={pageKey === "knowledge" ? "nav-shortcut active knowledge" : "nav-shortcut knowledge"}
            aria-label="Knowledge"
            aria-current={isCurrentHref("/knowledge") ? "page" : undefined}
          >
            <span class="nav-icon" aria-hidden="true">✦</span>
            <span>Knowledge</span>
          </a>
        </nav>
        <form class="search" action="/search/" method="get" role="search">
          <span aria-hidden="true">🔍</span>
          <span id="search-help" class="visually-hidden">
            Search by keyword, source, category, tag, or language.
          </span>
          <input
            type="search"
            id="pagefind-search-input"
            name="q"
            aria-label="Search updates"
            aria-describedby="search-help"
            aria-controls="pagefind-results"
            aria-expanded="false"
            aria-autocomplete="list"
            role="combobox"
            placeholder="Search updates, source, category..."
            title="Press / or Command-K to search"
            autocomplete="off"
          />
          <span class="search-keys" aria-hidden="true"><kbd>/</kbd><kbd>⌘K</kbd></span>
          <button type="button" class="search-close" data-search-close aria-label="Close search" hidden>
            <span aria-hidden="true">×</span>
          </button>
          <div
            id="pagefind-results"
            class="search-results"
            role="listbox"
            aria-live="polite"
            data-tag-recovery-version={DASHBOARD_METRICS.generatedAt}
            data-cold-archive-search-version={DASHBOARD_METRICS.generatedAt}
            hidden
          ></div>
        </form>
        <div class="lang-toggle" role="group" aria-label="表示言語 / Interface language">
          <button type="button" class="lang-btn" data-lang="ja" aria-pressed="true" aria-label="JA 日本語表示中">JA</button>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed="false" aria-label="EN 英語表示に切り替え">EN</button>
        </div>
        <button
          type="button"
          class="menu-trigger"
          data-menu-trigger
          aria-label="Open Menu"
          aria-controls="site-menu"
          aria-expanded="false"
        >
          <span aria-hidden="true">☰</span>
          <span class="menu-trigger-label">Menu</span>
        </button>
      </div>
      {breadcrumb && breadcrumb.length > 0 && (
        <div class="crumb-bar">
          <div class="crumb-inner">
            {breadcrumb.map((b, i) => (
              <>
                {b.href ? <a href={b.href}>{b.label}</a> : <span class="current">{b.label}</span>}
                {i < breadcrumb.length - 1 && <span class="sep">›</span>}
              </>
            ))}
          </div>
        </div>
      )}
    </header>

    <dialog id="site-menu" class="site-menu" aria-labelledby="site-menu-title" closedby="any" hidden>
      <div class="site-menu-head">
        <span id="site-menu-title">Navigation</span>
        <button type="button" class="site-menu-close" data-menu-close aria-label="Close navigation menu">×</button>
      </div>
      <nav class="site-menu-list" aria-label="Site destinations">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={pageKey === item.key ? "active" : ""}
            aria-current={isCurrentHref(item.href) ? "page" : undefined}
          >
            <span>{item.label}</span>
            <small>
              <span class="i18n-ja">{item.detail}</span>
              <span class="i18n-en">{item.detailEn}</span>
            </small>
          </a>
        ))}
        <button type="button" class="site-menu-action" data-search-trigger>
          <span>Search</span>
          <small>
            <span class="i18n-ja">キーワード・source・tag で検索</span>
            <span class="i18n-en">Search by keyword, source, or tag</span>
          </small>
        </button>
      </nav>
    </dialog>

    <nav class="mobile-tabbar" aria-label="Primary">
      <a href="/" class={pageKey === "timeline" ? "active" : ""} aria-current={isCurrentHref("/") ? "page" : undefined}><span aria-hidden="true">⌂</span><span>Home</span></a>
      <a href="/categories" class={pageKey === "categories" ? "active" : ""} aria-current={isCurrentHref("/categories") ? "page" : undefined}><span aria-hidden="true">▦</span><span>Categories</span></a>
      <a href="/arxiv" class={pageKey === "arxiv" ? "active" : ""} aria-current={isCurrentHref("/arxiv") ? "page" : undefined}><span aria-hidden="true"><ArxivIcon /></span><span>arXiv</span></a>
      <a href="/knowledge" class={pageKey === "knowledge" ? "active" : ""} aria-current={isCurrentHref("/knowledge") ? "page" : undefined}><span aria-hidden="true">✦</span><span>Knowledge</span></a>
      <button
        type="button"
        data-menu-trigger
        aria-label="Open Menu"
        aria-controls="site-menu"
        aria-expanded="false"
        class={`mobile-menu-trigger${menuOwnsCurrentPage ? " active" : ""}`}
      ><span aria-hidden="true">☰</span><span>Menu</span></button>
    </nav>

    {ADVERTISING_REQUIRES_CONSENT && (
    <aside
      class="privacy-consent-prompt"
      data-privacy-consent
      data-consent-surface="prompt"
      aria-labelledby="privacy-consent-prompt-title"
      aria-describedby="privacy-consent-prompt-description"
      hidden
      inert
    >
      <div class="privacy-consent-prompt-copy">
        <strong id="privacy-consent-prompt-title">
          <span class="i18n-ja">Google AdSense は任意です</span>
          <span class="i18n-en" lang="en">Google AdSense is optional</span>
        </strong>
        <p id="privacy-consent-prompt-description">
          <span class="i18n-ja">広告なしでも全機能を使えます。外部画像等は別読込の場合あり。</span>
          <span class="i18n-en" lang="en">All features work without ads. External media may still load.</span>
        </p>
        <p class="privacy-consent-prompt-error" data-consent-error role="status" aria-live="polite" hidden inert>
          <span class="i18n-ja">このブラウザへ選択を保存できませんでした。保存設定を確認して、もう一度お試しください。</span>
          <span class="i18n-en" lang="en">The choice could not be saved in this browser. Check storage settings and try again.</span>
        </p>
      </div>
      <div class="privacy-consent-prompt-actions">
        <a href="/privacy">
          <span class="i18n-ja" aria-hidden="true">詳細</span>
          <span class="i18n-en" lang="en" aria-hidden="true">Details</span>
          <span class="visually-hidden i18n-ja">プライバシーの詳細</span>
          <span class="visually-hidden i18n-en" lang="en">Privacy details</span>
        </a>
        <div class="privacy-consent-choice-actions" role="group" aria-labelledby="privacy-consent-actions-label">
          <span id="privacy-consent-actions-label" class="visually-hidden">
            <span class="i18n-ja">広告の同意</span>
            <span class="i18n-en" lang="en">Advertising consent</span>
          </span>
          <button type="button" data-consent-choice="denied" aria-pressed="false">
            <span class="i18n-ja" aria-hidden="true">拒否</span>
            <span class="i18n-en" lang="en" aria-hidden="true">Decline</span>
            <span class="visually-hidden i18n-ja">広告を拒否</span>
            <span class="visually-hidden i18n-en" lang="en">Decline advertising</span>
          </button>
          <button type="button" data-consent-choice="allowed" aria-pressed="false">
            <span class="i18n-ja" aria-hidden="true">許可</span>
            <span class="i18n-en" lang="en" aria-hidden="true">Allow</span>
            <span class="visually-hidden i18n-ja">広告を許可</span>
            <span class="visually-hidden i18n-en" lang="en">Allow advertising</span>
          </button>
        </div>
      </div>
    </aside>
    )}
    <script
      is:inline
      define:vars={{
        privacyConsentStorageKey: PRIVACY_CONSENT_STORAGE_KEY,
        privacyConsentVersion: PRIVACY_CONSENT_VERSION,
        productionAdvertisingHostname,
      }}
    >
      // Parser-blocking bootstrap: apply the real hidden/inert state before
      // first paint. This exact record contract is parity-tested against
      // parsePrivacyConsent() because an inline classic script cannot import it.
      (function () {
        var root = document.querySelector('[data-consent-surface="prompt"]');
        if (!(root instanceof HTMLElement)) return;

        function parseState(raw) {
          if (!raw) return "undecided";
          try {
            var record = JSON.parse(raw);
            if (!record || typeof record !== "object" || Array.isArray(record)) {
              return "undecided";
            }
            var keys = Object.keys(record);
            var decidedAt = record.decidedAt;
            if (
              keys.length !== 3 ||
              keys.some(function (key) {
                return key !== "version" && key !== "advertising" && key !== "decidedAt";
              }) ||
              record.version !== privacyConsentVersion ||
              (record.advertising !== "allowed" && record.advertising !== "denied") ||
              typeof decidedAt !== "string" ||
              !Number.isFinite(Date.parse(decidedAt)) ||
              new Date(decidedAt).toISOString() !== decidedAt
            ) {
              return "undecided";
            }
            return record.advertising;
          } catch (_) {
            return "undecided";
          }
        }

        function setPromptState(state) {
          var showPrompt =
            window.location.hostname === productionAdvertisingHostname &&
            state === "undecided" &&
            !/^\/privacy\/?$/.test(window.location.pathname);
          document.documentElement.setAttribute("data-advertising-consent", state);
          document.documentElement.setAttribute(
            "data-privacy-consent-prompt",
            showPrompt ? "visible" : "hidden",
          );
          root.dataset.consentState = state;
          root.hidden = !showPrompt;
          if (showPrompt) root.removeAttribute("inert");
          else root.setAttribute("inert", "");
          root.querySelectorAll("[data-consent-choice]").forEach(function (button) {
            button.setAttribute(
              "aria-pressed",
              button.getAttribute("data-consent-choice") === state ? "true" : "false",
            );
          });
        }

        var state = "undecided";
        try {
          state = parseState(localStorage.getItem(privacyConsentStorageKey));
        } catch (_) {}
        setPromptState(state);

        // If the deferred client bundle is unavailable, the prompt remains a
        // working fail-safe. It stores the explicit choice but never loads ads.
        root.addEventListener("click", function (event) {
          if (document.documentElement.dataset.privacyConsentClient === "ready") return;
          var target = event.target;
          if (!(target instanceof Element)) return;
          var button = target.closest("[data-consent-choice]");
          if (!(button instanceof HTMLButtonElement)) return;
          var choice = button.dataset.consentChoice;
          if (choice !== "allowed" && choice !== "denied") return;
          try {
            localStorage.setItem(
              privacyConsentStorageKey,
              JSON.stringify({
                version: privacyConsentVersion,
                advertising: choice,
                decidedAt: new Date().toISOString(),
              }),
            );
          } catch (_) {
            var error = root.querySelector("[data-consent-error]");
            if (error instanceof HTMLElement) {
              error.hidden = false;
              error.removeAttribute("inert");
            }
            return;
          }
          setPromptState(choice);
        });
      })();
    </script>

    <div id="content-start" class="content-start-anchor" tabindex="-1"></div>
    <slot />

    <footer class="footer-bar" aria-label="サイト全体のシステム状態 / Site-wide system status">
      <div class="footer-inner">
        <a
          class="item footer-run-link"
          href="/status"
          title={`Collection health: ${footerRunStatus}. ${footerHealthDetail}`}
          data-run-detail={footerRun.detail}
          data-run-state={footerRun.state}
          data-live-run-health
          data-run-last-at={footerLastRunAt ?? ""}
          data-run-copilot-ok={WORKER_HEALTH ? WORKER_HEALTH.copilotOk : "unknown"}
          data-run-sources-failed={WORKER_HEALTH ? WORKER_HEALTH.sourcesFailed.length : "unknown"}
          data-run-sources-attempted={WORKER_HEALTH ? WORKER_HEALTH.sourcesAttempted : "unknown"}
          data-run-sources-ok={WORKER_HEALTH ? WORKER_HEALTH.sourcesOk : "unknown"}
          data-run-fallback-percent={DASHBOARD_METRICS.fallbackPercent}
          data-run-pending-summaries={DASHBOARD_METRICS.fallbackEntries}
          data-summary-queue-backlog={DASHBOARD_METRICS.summaryQueueBacklog}
          data-summary-queue-mode={footerSummaryQueue.mode}
          data-summary-queue-state={footerSummaryQueue.state}
          data-summary-queue-drain-hours={DASHBOARD_METRICS.summaryQueueDrainEstimateHours ?? "unknown"}
          data-body-queue-mode={footerBodyQueue.mode}
          data-body-queue-state={footerBodyQueue.state}
          data-body-queue-backlog={footerBodyQueue.showBacklog ? footerBodyQueue.backlog : "unknown"}
          data-body-queue-drain-hours={DASHBOARD_METRICS.bodyQueueDrainEstimateHours ?? "unknown"}
          data-health-scope="site-wide-pipeline"
        >
          <span class="footer-scope-label">
            <span class="i18n-ja">サイト全体</span>
            <span class="i18n-en" lang="en">Site-wide</span>
          </span>
          <span class={`dot ${footerRunTone}`} data-run-tone={footerRunTone} aria-hidden="true"></span>
          <strong data-footer-run-label data-run-label-ja={footerRunCopy.ja} data-run-label-en={footerRunCopy.en}>
            <span class="i18n-ja">{footerRunCopy.ja}</span>
            <span class="i18n-en" lang="en">{footerRunCopy.en}</span>
          </strong>
          {footerLastRunAt && footerLastRunRelative && (
            <time
              class="footer-run-time"
              datetime={footerLastRunAt}
              data-relative-time
              data-relative-prefix="更新 "
              title={`Last update: ${footerLastRunAt}`}
            >
              更新 {footerLastRunRelative}
            </time>
          )}
        </a>
        <span class="spacer"></span>
        <a class="item footer-privacy-link" href="/editorial-policy">
          <span class="i18n-ja">編集方針</span>
          <span class="i18n-en" lang="en">Editorial</span>
        </a>
        <a class="item footer-privacy-link" href="/privacy">
          <span class="i18n-ja">Privacy</span>
          <span class="i18n-en" lang="en">Privacy</span>
        </a>
        <a class="item footer-privacy-link" href="/contact">
          {/* 連絡先, not お問い合わせ: the footer must stay one line at 1240px
              and above, where the build stack and body-queue detail are also
              visible (tests/e2e/smoke.spec.ts "top-rank panel remains stable
              across rail breakpoint widths"). The page itself keeps the longer
              title. */}
          <span class="i18n-ja">連絡先</span>
          <span class="i18n-en" lang="en">Contact</span>
        </a>
      </div>
    </footer>

    <script>
      import { normalizeSearchText } from "../lib/search-normalize.ts";
      import { normalizeTagKey } from "../lib/tag-normalize.ts";
      import {
        coldArchiveRecordMatchesQuery,
        coldArchiveRecordToSearchItem,
        parseColdArchiveSearchPayload,
        type ColdArchiveSearchRecord,
      } from "../lib/cold-archive-search-core.ts";
      import { CATEGORY_META } from "../lib/category-meta.ts";
      import { SOURCE_META, sourceLabel } from "../lib/source-meta.ts";
      import { deriveQueueDisplay, summaryQueueCardCopy } from "../lib/queue-health.ts";
      import { initializeRelativeTimes } from "../lib/relative-time.ts";
      import { createDocumentScrollLock } from "../lib/document-scroll-lock.ts";
      import {
        deriveWorkerRunStatus,
        runCadenceLead,
        WORKER_RUN_STATE_COPY,
      } from "../lib/run-health.ts";
      import { hrefWithLang } from "../lib/lang-url.ts";
      import { initializePrivacyConsent } from "../lib/privacy-consent-client.ts";

      initializeRelativeTimes();
      initializePrivacyConsent();

      (() => {
        const link = document.querySelector<HTMLElement>("a.footer-run-link[data-live-run-health]");
        if (!link) return;

        const numberValue = (value: string | undefined): number | null => {
          if (!value || value === "unknown") return null;
          const parsed = Number(value);
          return Number.isFinite(parsed) ? parsed : null;
        };
        const bodyQueueText = (state: string, backlog: number | null): string => {
          if (state === "active") return `body ${backlog ?? "?"} pending`;
          if (state === "clear") return "body ready";
          if (state === "waiting-for-run") return `body ${backlog ?? "?"} waiting`;
          if (state === "paused") return "body paused";
          return "body unavailable";
        };
        const update = (nowMs = Date.now()) => {
          const lastRunAt = link.dataset.runLastAt || null;
          const failedCount = numberValue(link.dataset.runSourcesFailed) ?? 0;
          const run = deriveWorkerRunStatus({
            workerHealth: lastRunAt ? {
              lastRunAt,
              copilotOk: link.dataset.runCopilotOk === "true",
              sourcesFailed: Array.from({ length: failedCount }, () => "failed"),
              sourcesAttempted: numberValue(link.dataset.runSourcesAttempted) ?? 0,
              sourcesOk: numberValue(link.dataset.runSourcesOk) ?? 0,
            } : null,
            nowMs,
            fallbackPercent: numberValue(link.dataset.runFallbackPercent) ?? 0,
            pendingSummaryEntries: numberValue(link.dataset.runPendingSummaries) ?? 0,
          });
          const summaryQueue = deriveQueueDisplay({
            mode: link.dataset.summaryQueueMode,
            backlog: numberValue(link.dataset.summaryQueueBacklog),
            drainEstimateHours: numberValue(link.dataset.summaryQueueDrainHours),
            runTone: run.tone,
            runState: run.state,
          });
          const bodyQueue = deriveQueueDisplay({
            mode: link.dataset.bodyQueueMode,
            backlog: numberValue(link.dataset.bodyQueueBacklog),
            drainEstimateHours: numberValue(link.dataset.bodyQueueDrainHours),
            runTone: run.tone,
            runState: run.state,
          });

          link.dataset.runState = run.state;
          link.dataset.runDetail = run.detail;
          link.dataset.summaryQueueState = summaryQueue.state;
          link.dataset.bodyQueueState = bodyQueue.state;
          link.title = `Collection health: ${run.runLabel}. ${run.detail}`;
          const dot = link.querySelector<HTMLElement>("[data-run-tone]");
          dot?.classList.remove("ok", "warn", "err");
          dot?.classList.add(run.tone);
          if (dot) dot.dataset.runTone = run.tone;
          const label = link.querySelector<HTMLElement>("[data-footer-run-label]");
          if (label) {
            const copy = WORKER_RUN_STATE_COPY[run.state];
            label.dataset.runLabelJa = copy.ja;
            label.dataset.runLabelEn = copy.en;
            const ja = label.querySelector<HTMLElement>(".i18n-ja");
            const en = label.querySelector<HTMLElement>(".i18n-en");
            if (ja) ja.textContent = copy.ja;
            if (en) en.textContent = copy.en;
          }

          const cadence = document.querySelector<HTMLElement>("[data-cadence-state]");
          if (cadence) cadence.dataset.cadenceState = run.state;
          const cadenceLead = runCadenceLead(run);
          const cadenceJa = document.querySelector<HTMLElement>("[data-cadence-lead-ja]");
          const cadenceEn = document.querySelector<HTMLElement>("[data-cadence-lead-en]");
          if (cadenceJa) cadenceJa.textContent = cadenceLead.ja;
          if (cadenceEn) cadenceEn.textContent = cadenceLead.en;

          const bannerRun = document.querySelector<HTMLElement>("[data-banner-run-state]");
          if (bannerRun) {
            bannerRun.hidden = run.tone === "ok";
            bannerRun.dataset.runTone = run.tone;
            bannerRun.setAttribute("aria-label", `Collection health: ${run.runLabel}. ${run.detail}`);
            bannerRun.title = `Collection health: ${run.runLabel}. ${run.detail}`;
            const bannerDot = bannerRun.querySelector<HTMLElement>("[data-run-tone]");
            bannerDot?.classList.remove("ok", "warn", "err");
            bannerDot?.classList.add(run.tone);
            if (bannerDot) bannerDot.dataset.runTone = run.tone;
            const bannerJa = bannerRun.querySelector<HTMLElement>("[data-banner-run-label-ja]");
            const bannerEn = bannerRun.querySelector<HTMLElement>("[data-banner-run-label-en]");
            if (bannerJa) bannerJa.textContent = run.stateText;
            if (bannerEn) bannerEn.textContent = run.stateText;
          }

          const pendingCopy = summaryQueueCardCopy(summaryQueue.state);
          document.querySelectorAll<HTMLElement>(".summary-state[data-summary-queue-state]").forEach((state) => {
            state.dataset.summaryQueueMode = summaryQueue.mode;
            state.dataset.summaryQueueState = summaryQueue.state;
            const badgeJa = state.querySelector<HTMLElement>("[data-summary-queue-badge-ja]");
            const badgeEn = state.querySelector<HTMLElement>("[data-summary-queue-badge-en]");
            const detailJa = state.querySelector<HTMLElement>("[data-summary-queue-detail-ja]");
            const detailEn = state.querySelector<HTMLElement>("[data-summary-queue-detail-en]");
            if (badgeJa) badgeJa.textContent = pendingCopy.badgeJa;
            if (badgeEn) badgeEn.textContent = pendingCopy.badgeEn;
            if (detailJa) detailJa.textContent = pendingCopy.detailJa;
            if (detailEn) detailEn.textContent = pendingCopy.detailEn;
          });

          const aboutRun = document.querySelector<HTMLElement>("[data-about-run-state]");
          if (aboutRun) {
            aboutRun.dataset.runTone = run.tone;
            const lang = document.documentElement.dataset.lang === "en" ? "en" : "ja";
            const accessible = lang === "en"
              ? `Collection health: ${run.runLabel}. ${run.detail}`
              : `収集状況: ${WORKER_RUN_STATE_COPY[run.state].ja}`;
            aboutRun.setAttribute("aria-label", accessible);
            aboutRun.title = accessible;
            const aboutDot = aboutRun.querySelector<HTMLElement>("[data-run-tone]");
            aboutDot?.classList.remove("ok", "warn", "err");
            aboutDot?.classList.add(run.tone);
            if (aboutDot) aboutDot.dataset.runTone = run.tone;
            const aboutLabelJa = aboutRun.querySelector<HTMLElement>("[data-about-run-label-ja]");
            const aboutLabelEn = aboutRun.querySelector<HTMLElement>("[data-about-run-label-en]");
            if (aboutLabelJa) aboutLabelJa.textContent = WORKER_RUN_STATE_COPY[run.state].ja;
            if (aboutLabelEn) aboutLabelEn.textContent = `${run.stateText} · ${run.detail}`;
          }

          document.dispatchEvent(new CustomEvent("techdb:runhealthchange", {
            detail: { run, summaryQueue, bodyQueue },
          }));
        };

        update();
        document.addEventListener("techdb:clocktick", (event) => {
          const nowMs = (event as CustomEvent<{ nowMs?: number }>).detail?.nowMs;
          update(typeof nowMs === "number" ? nowMs : Date.now());
        });
        document.addEventListener("techdb:languagechange", () => update());
      })();

      // Language toggle (Ja / En) — sync with <html data-lang="...">.
      (() => {
        // Keep the address bar truthful: whatever the reader is looking at
        // right now is what a copied/shared link reproduces in a fresh
        // browser. replaceState (not pushState) so this never adds a
        // back/forward history entry or touches focus (LL: shareable URL
        // language contract).
        const syncAddressBar = (l: "ja" | "en") => {
          try {
            const next = hrefWithLang(window.location.href, l);
            const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
            if (next !== current) {
              window.history.replaceState(window.history.state, "", next);
            }
          } catch {}
        };
        const apply = (l: "ja" | "en") => {
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
          document.querySelectorAll<HTMLElement>(
            "[data-meta-content-ja][data-meta-content-en]",
          ).forEach((element) => {
            const localizedContent = l === "en"
              ? element.dataset.metaContentEn
              : element.dataset.metaContentJa;
            if (!localizedContent) return;
            if (element instanceof HTMLTitleElement) element.textContent = localizedContent;
            else if (element instanceof HTMLMetaElement) element.content = localizedContent;
          });
          try { localStorage.setItem("td:lang", l); } catch {}
          syncAddressBar(l);
          document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
            const on = b.dataset.lang === l;
            b.setAttribute("aria-pressed", on ? "true" : "false");
            const targetLang = b.dataset.lang === "en" ? "en" : "ja";
            const stateLabel = l === "ja"
              ? targetLang === "ja" ? "日本語表示中" : "英語表示に切り替え"
              : targetLang === "en" ? "English interface active" : "Switch interface to Japanese";
            b.setAttribute("aria-label", `${targetLang.toUpperCase()} ${stateLabel}`);
            b.classList.toggle("is-active", on);
          });
          document.dispatchEvent(new CustomEvent("techdb:languagechange", { detail: { lang: l } }));
        };
        const current =
          (document.documentElement.getAttribute("data-lang") as "ja" | "en") || "ja";
        apply(current);
        document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
          b.addEventListener("click", () => {
            const l = (b.dataset.lang as "ja" | "en") || "ja";
            apply(l);
          });
        });
      })();

      // Shared hamburger menu — used by desktop header and mobile tabbar.
      (() => {
        const menu = document.getElementById("site-menu") as HTMLDialogElement | null;
        const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"));
        const closeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-menu-close]"));
        if (!menu || triggers.length === 0) return;

        const menuScrollLock = createDocumentScrollLock();
        let lastTrigger: HTMLButtonElement | null = null;
        let restoreFocusOnClose = false;
        let portalledMobileTrigger: HTMLButtonElement | null = null;
        let mobileTriggerPlaceholder: HTMLSpanElement | null = null;
        const isVisible = (el: HTMLElement | null): el is HTMLElement =>
          !!el && el.isConnected && el.getClientRects().length > 0 && !(el as HTMLButtonElement).disabled;
        const visibleMenuTrigger = () => triggers.find(isVisible) ?? null;
        const syncPortalledMobileTrigger = () => {
          if (!portalledMobileTrigger || !mobileTriggerPlaceholder?.isConnected) return;
          const rect = mobileTriggerPlaceholder.getBoundingClientRect();
          portalledMobileTrigger.style.setProperty("--mobile-menu-trigger-left", `${rect.left}px`);
          portalledMobileTrigger.style.setProperty("--mobile-menu-trigger-top", `${rect.top}px`);
          portalledMobileTrigger.style.setProperty("--mobile-menu-trigger-width", `${rect.width}px`);
          portalledMobileTrigger.style.setProperty("--mobile-menu-trigger-height", `${rect.height}px`);
        };
        const portalMobileTrigger = (trigger: HTMLButtonElement) => {
          if (!trigger.matches(".mobile-menu-trigger") || portalledMobileTrigger === trigger) return;
          const placeholder = document.createElement("span");
          placeholder.className = "mobile-menu-trigger-placeholder";
          placeholder.setAttribute("aria-hidden", "true");
          trigger.insertAdjacentElement("afterend", placeholder);
          mobileTriggerPlaceholder = placeholder;
          portalledMobileTrigger = trigger;
          trigger.classList.add("is-dialog-toggle");
          menu.append(trigger);
          syncPortalledMobileTrigger();
          window.addEventListener("resize", syncPortalledMobileTrigger);
          window.visualViewport?.addEventListener("resize", syncPortalledMobileTrigger);
        };
        const restorePortalledMobileTrigger = () => {
          const trigger = portalledMobileTrigger;
          const placeholder = mobileTriggerPlaceholder;
          if (!trigger) return;
          window.removeEventListener("resize", syncPortalledMobileTrigger);
          window.visualViewport?.removeEventListener("resize", syncPortalledMobileTrigger);
          if (placeholder?.isConnected) placeholder.replaceWith(trigger);
          trigger.classList.remove("is-dialog-toggle");
          trigger.style.removeProperty("--mobile-menu-trigger-left");
          trigger.style.removeProperty("--mobile-menu-trigger-top");
          trigger.style.removeProperty("--mobile-menu-trigger-width");
          trigger.style.removeProperty("--mobile-menu-trigger-height");
          portalledMobileTrigger = null;
          mobileTriggerPlaceholder = null;
        };
        const syncMenuTriggers = (open: boolean) => {
          triggers.forEach((trigger) => {
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
            trigger.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
            trigger.classList.toggle("is-open", open);
          });
        };
        const finalizeMenuClose = () => {
          restorePortalledMobileTrigger();
          menu.hidden = true;
          syncMenuTriggers(false);
          const focusTarget = isVisible(lastTrigger) ? lastTrigger : visibleMenuTrigger();
          if (restoreFocusOnClose && focusTarget) focusTarget.focus();
          menuScrollLock.unlock();
          restoreFocusOnClose = false;
        };
        const openMenu = (trigger: HTMLButtonElement) => {
          lastTrigger = trigger;
          restoreFocusOnClose = true;
          (window as any).__tdCloseSearch?.();
          menu.hidden = false;
          syncMenuTriggers(true);
          if (!menu.open) {
            menuScrollLock.lock();
            try {
              menu.showModal();
            } catch (error) {
              menuScrollLock.unlock();
              throw error;
            }
          }
          portalMobileTrigger(trigger);
          const active = menu.querySelector<HTMLElement>("a.active");
          window.requestAnimationFrame(() => (active ?? menu.querySelector<HTMLElement>("a, button"))?.focus());
        };
        const closeMenu = (restoreFocus = false) => {
          restoreFocusOnClose = restoreFocus;
          if (menu.open) menu.close();
          else finalizeMenuClose();
        };
        (window as any).__tdCloseMenu = closeMenu;
        const mobileNavigationBreakpoint = window.matchMedia("(max-width: 720px)");
        mobileNavigationBreakpoint.addEventListener("change", () => {
          if (!menu.open) return;
          window.requestAnimationFrame(() => {
            if (!menu.open) return;
            lastTrigger = visibleMenuTrigger() ?? lastTrigger;
            closeMenu(true);
          });
        });

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", () => {
            if (!menu.open) openMenu(trigger);
            else closeMenu(true);
          });
        });
        closeButtons.forEach((button) => button.addEventListener("click", () => closeMenu(true)));
        menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
          link.addEventListener("click", () => closeMenu(false));
        });
        menu.addEventListener("cancel", (event) => {
          event.preventDefault();
          closeMenu(true);
        });
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Tab") return;
          const focusable = Array.from(
            menu.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter(isVisible);
          if (focusable.length === 0) {
            event.preventDefault();
            menu.focus();
            return;
          }
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && (document.activeElement === first || !menu.contains(document.activeElement))) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });
        menu.addEventListener("close", finalizeMenuClose);
        menu.addEventListener("click", (event) => {
          if (event.target !== menu) return;
          const rect = menu.getBoundingClientRect();
          const outside =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;
          if (outside) closeMenu(true);
        });
      })();

      // Lazy-load Pagefind and wire to the existing input.
      (async () => {
        const input = document.getElementById("pagefind-search-input") as HTMLInputElement | null;
        const panel = document.getElementById("pagefind-results") as HTMLDivElement | null;
        const searchRoot = input?.closest(".search") as HTMLElement | null;
        const searchTriggers = Array.from(document.querySelectorAll<HTMLElement>("[data-search-trigger]"));
        const closeButton = searchRoot?.querySelector<HTMLButtonElement>("[data-search-close]");
        if (!input || !panel || !searchRoot) return;

        type CategorySearchMeta = { slug: string; label: string; aliases: string[] };
        const categoryMeta: CategorySearchMeta[] = CATEGORY_META.map((meta) => ({
          slug: meta.slug,
          label: meta.shortLabel,
          aliases: [
            meta.name,
            meta.shortLabel,
            meta.slug.replaceAll("-", " "),
            ...(meta.searchAliases ?? []),
          ],
        }));
        const categoryLabels = new Map(
          categoryMeta.flatMap((entry) =>
            [entry.slug, entry.label, ...entry.aliases].map((value) => [value, entry.label] as const),
          ),
        );
        type SourceSearchMeta = { id: string; label: string };
        const sourceMeta: SourceSearchMeta[] = SOURCE_META.map((meta) => ({
          id: meta.id,
          label: sourceLabel(meta.id),
        }));
        const sourceLabels = new Map(
          sourceMeta.flatMap((entry) => [[entry.id, entry.label], [entry.label, entry.label]] as const),
        );
        const narrowSearchLayout = window.matchMedia("(max-width: 980px)");
        const searchHeader = searchRoot.closest("header");
        const privacyPrompt = document.querySelector<HTMLElement>(".privacy-consent-prompt");
        const syncSearchOverlayPosition = () => {
          if (!searchRoot.classList.contains("is-open") || !narrowSearchLayout.matches || !searchHeader) {
            searchRoot.style.removeProperty("--search-overlay-top");
            return;
          }
          const headerBottom = searchHeader.getBoundingClientRect().bottom;
          const promptBottom = privacyPrompt?.getClientRects().length
            ? privacyPrompt.getBoundingClientRect().bottom
            : 0;
          searchRoot.style.setProperty(
            "--search-overlay-top",
            `${Math.max(12, Math.ceil(headerBottom), Math.ceil(promptBottom)) + 8}px`,
          );
        };
        const tagRecoveryVersion = panel.dataset.tagRecoveryVersion ?? "";
        const coldArchiveSearchVersion =
          panel.dataset.coldArchiveSearchVersion ?? "";
        let pf: any = null;
        let tagRecoveryMapPromise: Promise<Record<string, string>> | null = null;
        let coldArchiveSearchPromise:
          Promise<readonly ColdArchiveSearchRecord[]> | null = null;
        let activeIndex = -1;
        let requestGeneration = 0;
        const isSearchRoute = /^\/search\/?$/.test(window.location.pathname);
        const initialSearchQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
        if (isSearchRoute && !input.value) input.value = initialSearchQuery;
        const syncSearchRoute = (query: string) => {
          if (!isSearchRoute) return;
          const next = new URL(window.location.href);
          if (query) next.searchParams.set("q", query);
          else next.searchParams.delete("q");
          next.searchParams.delete("tag");
          next.searchParams.delete("entry");
          window.history.replaceState(
            window.history.state,
            "",
            `${next.pathname}${next.search}${next.hash}`,
          );
          window.dispatchEvent(
            new CustomEvent("techdb:search-query-change", { detail: { query } }),
          );
        };
        let pagefindLoadSettled = false;
        const pagefindReady = (async () => {
          try {
            const pfUrl = "/pagefind/pagefind.js";
            pf = { ...await import(/* @vite-ignore */ pfUrl) };
            await pf.init();
            (window as any).__pagefind = pf;
          } catch {
            // Dev/preview: Pagefind index not built yet.
          } finally {
            pagefindLoadSettled = true;
          }
        })();

        const escapeHtml = (value: string) =>
          value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char] ?? char));
        const withDeadline = <T,>(promise: Promise<T>, timeoutMs: number, message: string) =>
          new Promise<T>((resolve, reject) => {
            let settled = false;
            const timer = window.setTimeout(() => {
              settled = true;
              reject(new Error(message));
            }, timeoutMs);
            promise.then(
              (value) => {
                if (settled) return;
                settled = true;
                window.clearTimeout(timer);
                resolve(value);
              },
              (error) => {
                if (settled) return;
                settled = true;
