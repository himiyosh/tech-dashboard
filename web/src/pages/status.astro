---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import StatusAttentionList from "../components/StatusAttentionList.astro";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  GENERATED_AT,
  WORKER_HEALTH,
  relativeTime,
  type Category,
  type NormalizedEntry,
} from "../lib/data.ts";
import { sourceFreshnessStatus, type FreshnessSourceType, type FreshnessStatus } from "../lib/freshness.ts";
import { SOURCE_META, sourceAnchorId, sourceLabel } from "../lib/source-meta.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { deriveWorkerRunStatus } from "../lib/run-health.ts";

const now = new Date();
type SourceStatus = FreshnessStatus;
type SourceRow = {
  id: string;
  anchorId: string;
  displayName: string;
  category: Category;
  categoryName: string;
  categoryColor: string;
  tier: number;
  count: number;
  latestRelative: string;
  latestTitle: string | null;
  latestUrl: string | null;
  sourceType: NormalizedEntry["sourceType"];
  sourceTypeLabel: string;
  status: SourceStatus;
  statusJa: string;
  statusEn: string;
  reasonJa: string;
  reasonEn: string;
};

const TYPE_LABEL: Record<NormalizedEntry["sourceType"], string> = {
  blog: "Blog",
  release: "Release",
  changelog: "Changelog",
  paper: "Paper",
  community: "Community",
};

const SOURCE_STATUS_COPY: Record<SourceStatus, { ja: string; en: string }> = {
  ok: { ja: "正常", en: "Fresh" },
  stale: { ja: "更新遅延", en: "Delayed" },
  error: { ja: "要確認", en: "Needs review" },
  "no-data": { ja: "未収録", en: "Not listed" },
};

const categoryBySlug = new Map(CATEGORY_META.map((category) => [category.slug, category]));

const sources: SourceRow[] = SOURCE_META.map((def) => {
  const fromSource = ALL_ENTRIES.filter((e) => e.source === def.id);
  const latestEntry = fromSource.reduce<NormalizedEntry | null>((acc, entry) => {
    const entryAt = entry.collectedAt ?? entry.publishedAt;
    const accAt = acc ? (acc.collectedAt ?? acc.publishedAt) : "1970-01-01T00:00:00Z";
    return entryAt && entryAt > accAt ? entry : acc;
  }, null);
  const latestCollected = fromSource.reduce(
    (acc, e) => {
      const collectedAt = e.collectedAt ?? e.publishedAt;
      return collectedAt && collectedAt > acc ? collectedAt : acc;
    },
    "1970-01-01T00:00:00Z",
  );
  const sourceType = latestEntry?.sourceType ?? fromSource[0]?.sourceType ?? "blog";
  const freshness = sourceFreshnessStatus(
    { category: def.category, sourceType: sourceType as FreshnessSourceType },
    fromSource.length === 0 ? undefined : latestCollected,
    now.getTime(),
  );
  const status = freshness.status;
  const latestRelative = fromSource.length === 0 ? "n/a" : relativeTime(latestCollected, now);
  const reasonJa = fromSource.length === 0
    ? "収集済みの記事がまだありません。"
    : status === "ok"
      ? `直近の収集は ${latestRelative} です。通常の更新範囲内です。`
      : status === "stale"
        ? `直近の収集は ${latestRelative} です。更新間隔が長くなっています。`
        : `直近の収集は ${latestRelative} です。収集状況の確認が必要です。`;
  const reasonEn = fromSource.length === 0
    ? "No articles have been collected from this source yet."
    : status === "ok"
      ? `Last collected ${latestRelative}. This is within the expected update window.`
      : status === "stale"
        ? `Last collected ${latestRelative}. The update interval is longer than expected.`
        : `Last collected ${latestRelative}. The collection status needs review.`;
  const category = def.category as Category;
  const categoryMeta = categoryBySlug.get(category);
  return {
    id: def.id,
    anchorId: sourceAnchorId(def.id),
    displayName: def.displayName,
    category,
    categoryName: categoryMeta?.name ?? def.category,
    categoryColor: categoryMeta?.color ?? "var(--accent)",
    tier: def.tier,
    count: fromSource.length,
    latestRelative,
    latestTitle: latestEntry?.titleJa || latestEntry?.title || null,
    latestUrl: latestEntry?.url ?? null,
    sourceType,
    sourceTypeLabel: TYPE_LABEL[sourceType],
    status,
    statusJa: SOURCE_STATUS_COPY[status].ja,
    statusEn: SOURCE_STATUS_COPY[status].en,
    reasonJa,
    reasonEn,
  };
});

const ok = sources.filter((s) => s.status === "ok").length;
const stale = sources.filter((s) => s.status === "stale").length;
const error = sources.filter((s) => s.status === "error").length;
const noData = sources.filter((s) => s.status === "no-data").length;
const evaluatedSourceCount = ok + stale + error;
const statusOrder = { error: 0, stale: 1, "no-data": 2, ok: 3 } as const;
const sortedSources = [...sources].sort(
  (a, b) =>
    statusOrder[a.status] - statusOrder[b.status] ||
    a.tier - b.tier ||
    a.displayName.localeCompare(b.displayName),
);
const errorSources = sortedSources.filter((s) => s.status === "error");
const staleSources = sortedSources.filter((s) => s.status === "stale");
const attentionSources = [...errorSources, ...staleSources].slice(0, 8);
const healthyPct = evaluatedSourceCount > 0 ? Math.round((ok / evaluatedSourceCount) * 100) : 0;
const indexAgeLabel = relativeTime(GENERATED_AT, now);
const pendingSummaryEntries = DASHBOARD_METRICS.fallbackEntries;
const pendingSummaryPercent = DASHBOARD_METRICS.fallbackPercent;
const summaryQueueBacklog = DASHBOARD_METRICS.summaryQueueBacklog;
const summaryQueueDrainEstimateHours = DASHBOARD_METRICS.summaryQueueDrainEstimateHours;
const summaryQueueDrainLabelJa = summaryQueueDrainEstimateHours > 0
  ? summaryQueueDrainEstimateHours <= 24
    ? `約 ${summaryQueueDrainEstimateHours}h`
    : `約 ${Math.ceil(summaryQueueDrainEstimateHours / 24)}d`
  : "n/a";
const summaryQueueDrainLabelEn = summaryQueueDrainEstimateHours > 0
  ? summaryQueueDrainEstimateHours <= 24
    ? `about ${summaryQueueDrainEstimateHours}h`
    : `about ${Math.ceil(summaryQueueDrainEstimateHours / 24)}d`
  : "n/a";
const summaryQueueModeCopy = DASHBOARD_METRICS.summaryQueueMode === "enabled"
  ? { ja: "自動処理中", en: "active" }
  : DASHBOARD_METRICS.summaryQueueMode === "disabled"
    ? { ja: "停止中", en: "paused" }
    : { ja: "状態不明", en: "status unknown" };
const categoryRows = CATEGORY_META.map((category) => {
    const rows = sources.filter((source) => source.category === category.slug);
    return {
      ...category,
      total: rows.length,
      ok: rows.filter((source) => source.status === "ok").length,
      stale: rows.filter((source) => source.status === "stale").length,
      error: rows.filter((source) => source.status === "error").length,
      noData: rows.filter((source) => source.status === "no-data").length,
    };
  })
  .filter((row) => row.total > 0)
  .sort((a, b) => b.error - a.error || b.stale - a.stale || b.total - a.total)
  .slice(0, 8);
const sourceCategoryRows = CATEGORY_META.map((category) => {
  const rows = sources.filter((source) => source.category === category.slug);
  return { ...category, total: rows.length };
}).filter((row) => row.total > 0);

const wh = WORKER_HEALTH;
const workerRun = deriveWorkerRunStatus({
  workerHealth: wh,
  nowMs: now.getTime(),
  fallbackPercent: pendingSummaryPercent,
  pendingSummaryEntries,
});
const workerStatus = workerRun.tone;
const workerColor =
  workerStatus === "ok" ? "var(--success)" : workerStatus === "warn" ? "var(--important)" : "var(--danger)";
const workerStatusText = workerRun.statusText;
const sourceReviewStatus = error > 0 ? "err" : stale > 0 ? "warn" : "ok";
const overallStatus =
  workerStatus === "err" || sourceReviewStatus === "err"
    ? "err"
    : workerStatus === "warn" || sourceReviewStatus === "warn"
      ? "warn"
      : "ok";
const overallColor =
  overallStatus === "ok" ? "var(--success)" : overallStatus === "warn" ? "var(--important)" : "var(--danger)";
const freshSourceLabel = `${ok}/${evaluatedSourceCount}`;
const workerSummary = wh
  ? {
      ja: `直近バッチ ${wh.batchIndex}/${wh.batchTotal} · 収集成功 ${wh.sourcesOk}/${wh.sourcesAttempted} · 新規要約 ${wh.summarized}件 · 要約待ち ${pendingSummaryEntries}件`,
      en: `Latest batch ${wh.batchIndex}/${wh.batchTotal} · ${wh.sourcesOk}/${wh.sourcesAttempted} sources collected · ${wh.summarized} new summaries · ${pendingSummaryEntries} pending`,
    }
  : {
      ja: "このデータには収集状況の記録がありません。",
      en: "Collection health metadata is not available in this data snapshot.",
    };
const workerToneCopy = {
  ok: { ja: "正常稼働", en: "Running normally" },
  warn: { ja: "一部確認が必要", en: "Review recommended" },
  err: { ja: "収集状況を確認", en: "Collection needs review" },
} as const;
---

<Portal pageKey="status" title="Status — TECH Dashboard">
  <PageHero
    className={`page-hero-top-level page-hero-status page-hero-status-${overallStatus}`}
    accent={overallColor}
    kicker="Status & Sources"
    title="Status"
    count={`稼働 ${workerStatusText} · 正常な収集元 ${freshSourceLabel}`}
    countEn={`Run ${workerStatusText} · Fresh sources ${freshSourceLabel}`}
    headingId="status-heading"
    description="収集の稼働状況、要約の進捗、サイトの最終更新を分けて確認できます。公開ページが新しくても、収集の遅れは隠しません。"
    descriptionEn="Check collection activity, summary progress, and the latest site update separately. A recently published page does not hide delayed source collection."
    actions={[
      { href: "#worker-health-heading", label: "稼働状況", labelEn: "Collection health" },
      { href: "#source-health-heading", label: "収集元一覧", labelEn: "Source directory" },
      { href: "#source-health-list", label: "要確認の収集元", labelEn: "Sources to review" },
      { href: "/archive", label: "アーカイブ", labelEn: "Open archive" },
    ]}
    metrics={[
      { label: "稼働状態", labelEn: "Run status", value: workerStatusText },
      { label: "正常な収集元", labelEn: "Fresh sources", value: freshSourceLabel },
      { label: "遅延・要確認", labelEn: "Sources to review", value: stale + error },
      { label: "要約待ち", labelEn: "Summaries pending", value: pendingSummaryEntries },
      { label: "最終収集", labelEn: "Last collection", value: wh ? relativeTime(wh.lastRunAt, now) : "不明" },
      { label: "サイト更新", labelEn: "Site updated", value: indexAgeLabel },
    ]}
  />

  <div class="layout status-layout">
    <Sidebar />

    <main class="status-main">
      <section
        class={`status-hero status-hero-${overallStatus}`}
        data-run-status={workerStatus}
        data-source-review-status={sourceReviewStatus}
        aria-labelledby="worker-health-heading"
        aria-describedby="worker-health-summary"
      >
        <div class="status-hero-copy">
          <div class="status-kicker">
            <span class="status-dot" style={`background:${workerColor}`}></span>
            <span>RUN {workerStatusText}</span>
            <span class="i18n-ja">{workerToneCopy[overallStatus].ja}</span>
            <span class="i18n-en" lang="en">{workerToneCopy[overallStatus].en}</span>
            <span class="i18n-ja">正常 {freshSourceLabel}</span>
            <span class="i18n-en" lang="en">fresh {freshSourceLabel}</span>
          </div>
          <div class="section-header primary status-title-row">
            <h2 id="worker-health-heading">
              <span class="i18n-ja">収集と要約の稼働状況</span>
              <span class="i18n-en" lang="en">Collection and summary health</span>
              <span class="count">
                <span class="i18n-ja">分割収集 · 定期実行</span>
                <span class="i18n-en" lang="en">rotating batches · scheduled runs</span>
              </span>
            </h2>
          </div>
          <p id="worker-health-summary">
            <span class="i18n-ja">{workerSummary.ja}</span>
            <span class="i18n-en" lang="en">{workerSummary.en}</span>
          </p>
        </div>

        <div class="status-hero-grid" aria-label="Operational status scopes">
          <div class="status-metric-card" data-health-scope="collection-run">
            <span>
              <span class="i18n-ja">最終収集</span>
              <span class="i18n-en" lang="en">Last collection</span>
            </span>
            <strong>{wh ? relativeTime(wh.lastRunAt, now) : "n/a"}</strong>
            <small>
              <span class="i18n-ja">収集処理が最後に動いた時刻</span>
              <span class="i18n-en" lang="en">last completed collection run</span>
            </small>
          </div>
          <div class="status-metric-card" data-health-scope="latest-batch">
            <span>
              <span class="i18n-ja">今回の収集元</span>
              <span class="i18n-en" lang="en">Sources checked</span>
            </span>
            <strong>{wh ? `${wh.sourcesOk}/${wh.sourcesAttempted}` : "n/a"}</strong>
            <small>
              {wh ? (
                <>
                  <span class="i18n-ja">分割 {wh.batchIndex}/{wh.batchTotal} · 登録 {sources.length}件</span>
                  <span class="i18n-en" lang="en">batch {wh.batchIndex}/{wh.batchTotal} · {sources.length} registered sources</span>
                </>
              ) : (
                <>
                  <span class="i18n-ja">収集記録なし</span>
                  <span class="i18n-en" lang="en">collection details unavailable</span>
                </>
              )}
            </small>
          </div>
          <div class="status-metric-card" data-health-scope="summary-throughput" data-health-domain="summary-queue">
            <span>
              <span class="i18n-ja">新規AI要約</span>
              <span class="i18n-en" lang="en">New AI summaries</span>
            </span>
            <strong title="New AI summaries added in this collection run. Pending summaries are tracked separately.">{wh ? `+${wh.summarized}` : "n/a"}</strong>
            <small>
              <span class="i18n-ja">直近の収集で追加</span>
              <span class="i18n-en" lang="en">added in the latest run</span>
            </small>
          </div>
          <div
            class:list={["status-metric-card", { warn: pendingSummaryEntries > 0, ok: pendingSummaryEntries === 0 }]}
            data-health-scope="summary-backlog"
            data-health-domain="summary-queue"
          >
            <span>
              <span class="i18n-ja">AI要約待ち</span>
              <span class="i18n-en" lang="en">Summaries pending</span>
            </span>
            <strong>{pendingSummaryEntries}</strong>
            <small
              title="Share of live entries still showing a placeholder summary while awaiting AI generation. These entries are visible; only the AI summary is pending."
            >
              <span class="i18n-ja">全記事の {pendingSummaryPercent}%</span>
              <span class="i18n-en" lang="en">{pendingSummaryPercent}% of listed articles</span>
            </small>
          </div>
          <div
            class:list={["status-metric-card", { warn: summaryQueueBacklog > 0, ok: summaryQueueBacklog === 0 }]}
            data-health-scope="summary-eta"
            data-health-domain="summary-queue"
          >
            <span>
              <span class="i18n-ja">要約完了目安</span>
              <span class="i18n-en" lang="en">Estimated summary wait</span>
            </span>
            <strong>
              <span class="i18n-ja">{summaryQueueDrainLabelJa}</span>
              <span class="i18n-en" lang="en">{summaryQueueDrainLabelEn}</span>
            </strong>
            <small>
              <span class="i18n-ja">{summaryQueueBacklog}件を処理待ち</span>
              <span class="i18n-en" lang="en">{summaryQueueBacklog} awaiting summary</span>
            </small>
          </div>
          <div class="status-metric-card" data-health-scope="published-artifact">
            <span>
              <span class="i18n-ja">サイト更新</span>
              <span class="i18n-en" lang="en">Site updated</span>
            </span>
            <strong>{indexAgeLabel}</strong>
            <small>
              <span class="i18n-ja">公開データの最終更新</span>
              <span class="i18n-en" lang="en">latest published data snapshot</span>
            </small>
          </div>
        </div>
      </section>

      <StatusAttentionList
        sources={attentionSources}
        id="attention-list-mobile"
        extraClass="status-attention-mobile"
      />

      {wh ? (
        <section class="status-detail-grid" aria-label="Collection details">
          <div>
            <span class="detail-label">
              <span class="i18n-ja">AI要約サービス</span>
              <span class="i18n-en" lang="en">AI summary service</span>
            </span>
            {wh.copilotOk ? (
              <strong class="tone-ok">
                <span class="i18n-ja">利用可能</span>
                <span class="i18n-en" lang="en">Available</span>
              </strong>
            ) : (
              <strong class="tone-error" title={wh.copilotError ?? ""}>
                <span class="i18n-ja">要確認</span>
                <span class="i18n-en" lang="en">Needs review</span>
              </strong>
            )}
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">要約エラー</span>
              <span class="i18n-en" lang="en">Summary errors</span>
            </span>
            <strong>{wh.summarizeErrors}</strong>
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">要約待ち</span>
              <span class="i18n-en" lang="en">Summary backlog</span>
            </span>
            <strong class={pendingSummaryEntries > 0 ? "tone-warn" : "tone-ok"}>{pendingSummaryEntries}</strong>
            <small class="summary-ready-copy">
              <span class="i18n-ja">要約済み {DASHBOARD_METRICS.realSummaryEntries} · {summaryQueueModeCopy.ja}</span>
              <span class="i18n-en" lang="en">{DASHBOARD_METRICS.realSummaryEntries} ready · automation {summaryQueueModeCopy.en}</span>
            </small>
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">完了までの目安</span>
              <span class="i18n-en" lang="en">Estimated wait</span>
            </span>
            <strong class={summaryQueueBacklog > 0 ? "tone-warn" : "tone-ok"}>
              <span class="i18n-ja">{summaryQueueDrainLabelJa}</span>
              <span class="i18n-en" lang="en">{summaryQueueDrainLabelEn}</span>
            </strong>
            <small
              title="Entries queued for AI summary generation each hourly run, and the total still awaiting a summary."
            >
              <span class="i18n-ja">1回 {DASHBOARD_METRICS.summaryQueueCandidates}件 · 残り {summaryQueueBacklog}件</span>
              <span class="i18n-en" lang="en">{DASHBOARD_METRICS.summaryQueueCandidates} per run · {summaryQueueBacklog} remaining</span>
            </small>
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">画像情報</span>
              <span class="i18n-en" lang="en">Image metadata</span>
            </span>
            <strong>{wh.ogCached}</strong>
            <small>
              <span class="i18n-ja">保存済み · 今回 +{wh.ogNewHits}</span>
              <span class="i18n-en" lang="en">cached · +{wh.ogNewHits} this run</span>
            </small>
          </div>
          <div class="failed-sources">
            <span class="detail-label">
              <span class="i18n-ja">収集エラー</span>
              <span class="i18n-en" lang="en">Collection errors</span>
            </span>
            {wh.sourcesFailed.length === 0 ? (
              <strong class="tone-ok">
                <span class="i18n-ja">なし</span>
                <span class="i18n-en" lang="en">None</span>
              </strong>
            ) : (
              <strong class="tone-warn">{wh.sourcesFailed.map(sourceLabel).join(", ")}</strong>
            )}
          </div>
        </section>
      ) : (
        <p class="status-note">
          <span class="i18n-ja">この公開データには収集状況の記録がありません。次回の収集後に表示されます。</span>
          <span class="i18n-en" lang="en">Collection health is not available in this published snapshot. It will appear after the next run.</span>
        </p>
      )}

      <section class="source-health-panel" aria-labelledby="source-health-heading">
        <div class="section-header primary source-heading-row">
          <h2 id="source-health-heading">
            <span class="i18n-ja">収集ソース一覧</span>
            <span class="i18n-en" lang="en">Collection sources</span>
            <span class="count">
              <span class="i18n-ja">{sources.length}件</span>
              <span class="i18n-en" lang="en">{sources.length} sources</span>
            </span>
          </h2>
        </div>

        <div class="source-summary-grid" aria-label="Source summary">
          <div class="source-summary-card ok">
            <span>
              <span class="i18n-ja">順調</span>
              <span class="i18n-en" lang="en">On schedule</span>
            </span>
            <strong>{ok}</strong>
          </div>
          <div class="source-summary-card stale">
            <span>
              <span class="i18n-ja">更新遅延</span>
              <span class="i18n-en" lang="en">Delayed</span>
            </span>
            <strong>{stale}</strong>
          </div>
          <div class="source-summary-card error">
            <span>
              <span class="i18n-ja">要確認</span>
              <span class="i18n-en" lang="en">Needs review</span>
            </span>
            <strong>{error}</strong>
          </div>
          <div class="source-summary-card no-data">
            <span>
              <span class="i18n-ja">未収録</span>
              <span class="i18n-en" lang="en">Not listed</span>
            </span>
            <strong>{noData}</strong>
          </div>
          <div class="source-summary-card">
            <span>
              <span class="i18n-ja">順調な割合</span>
              <span class="i18n-en" lang="en">On-schedule rate</span>
            </span>
            <strong>{healthyPct}%</strong>
          </div>
        </div>

        <div class="status-toolbar" role="group" aria-label="Filter collection sources by status">
          <button type="button" class="status-filter is-active" data-source-filter="all" data-source-count={sources.length} aria-pressed="true">
            <span class="i18n-ja">すべて</span><span class="i18n-en" lang="en">All</span> <span>{sources.length}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="error" data-source-count={error} aria-pressed="false">
            <span class="i18n-ja">要確認</span><span class="i18n-en" lang="en">Needs review</span> <span>{error}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="stale" data-source-count={stale} aria-pressed="false">
            <span class="i18n-ja">更新遅延</span><span class="i18n-en" lang="en">Delayed</span> <span>{stale}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="no-data" data-source-count={noData} aria-pressed="false">
            <span class="i18n-ja">未収録</span><span class="i18n-en" lang="en">Not listed</span> <span>{noData}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="ok" data-source-count={ok} aria-pressed="false">
            <span class="i18n-ja">順調</span><span class="i18n-en" lang="en">On schedule</span> <span>{ok}</span>
          </button>
        </div>

        <div class="category-filter-row" role="group" aria-label="Filter collection sources by category">
          <button type="button" class="category-filter is-active" data-category-filter="all" aria-pressed="true">
            <span class="i18n-ja">全カテゴリ</span>
            <span class="i18n-en" lang="en">All categories</span>
          </button>
          {sourceCategoryRows.map((row) => (
            <button type="button" class="category-filter" style={`--category-color:${row.color}`} data-category-filter={row.slug} aria-pressed="false">
              {row.name}<span>{row.total}</span>
            </button>
          ))}
        </div>

        <div class="side-card source-health-list status-source-table" id="source-health-list">
          {sortedSources.map((s) => (
            <div
              id={s.anchorId}
              class={`source-item source-row-${s.status}`}
              style={`--category-color:${s.categoryColor}`}
              data-source-status={s.status}
              data-source-category={s.category}
            >
              <span class={`status ${s.status}`} aria-hidden="true"></span>
              <span class="name source-name-block">
                <strong>{s.displayName}</strong>
                <span class="source-meta-line">
                  <span class="source-category-chip">{s.categoryName}</span>
                  <span aria-hidden="true">·</span>
                  <span>{s.sourceTypeLabel}</span>
                </span>
                <span class="source-reason-line">
                  <span class="i18n-ja">{s.reasonJa}</span>
                  <span class="i18n-en" lang="en">{s.reasonEn}</span>
                </span>
                <span class="source-latest-line">
                  <span class="i18n-ja">最新記事</span>
                  <span class="i18n-en" lang="en">Latest article</span>
                  {s.latestUrl ? (
                    <a href={s.latestUrl} target="_blank" rel="noopener noreferrer">{s.latestTitle}</a>
                  ) : (
                    <strong>
                      {s.count === 0 ? (
                        <>
                          <span class="i18n-ja">収集済み記事なし</span>
                          <span class="i18n-en" lang="en">No collected entries</span>
                        </>
                      ) : s.latestTitle ?? (
                        <>
                          <span class="i18n-ja">記事情報を確認できません</span>
                          <span class="i18n-en" lang="en">Article details unavailable</span>
                        </>
                      )}
                    </strong>
                  )}
                </span>
              </span>
              <span class={`source-status-badge ${s.status}`}>
                <span class="i18n-ja">{s.statusJa}</span>
                <span class="i18n-en" lang="en">{s.statusEn}</span>
              </span>
              <span class="time source-time-block">
                <strong>{s.count}</strong>
                <span>
                  {s.count === 0 ? (
                    <>
                      <span class="i18n-ja">記事なし</span>
                      <span class="i18n-en" lang="en">No entries</span>
                    </>
                  ) : s.latestRelative}
                </span>
              </span>
            </div>
          ))}
          <div class="source-empty" id="source-empty" hidden>
            <strong>
              <span class="i18n-ja">条件に一致するソースはありません。</span>
              <span class="i18n-en" lang="en">No sources match these filters.</span>
            </strong>
            <span>
              <span class="i18n-ja">状態またはカテゴリの条件を変更してください。</span>
              <span class="i18n-en" lang="en">Try another status or category.</span>
            </span>
          </div>
        </div>

        <p class="status-note compact">
          <span class="i18n-ja">
            状態はソースごとの更新間隔を基準に判定します。「更新遅延」は上流の更新が少ない場合にも表示されるため、収集サービスの状態と個別の理由を合わせて確認してください。
          </span>
          <span class="i18n-en" lang="en">
            Status is based on each source's normal publishing cadence. A delayed source may simply publish infrequently, so check the collection service and the source-specific reason together.
          </span>
        </p>
      </section>
    </main>

    <aside class="right status-insights">
      <div class="side-card status-insight-card status-score-card">
        <div class="rail-title">
          <span class="i18n-ja">収集状況</span>
          <span class="i18n-en" lang="en">Collection coverage</span>
        </div>
        <div class="status-score">
          <strong>{healthyPct}</strong>
          <span>
            <span class="i18n-ja">% 順調</span>
            <span class="i18n-en" lang="en">% fresh</span>
          </span>
        </div>
        <div class="status-score-bar"><span style={`width:${healthyPct}%`}></span></div>
        <p>
          <span class="i18n-ja">{ok} / {sources.length} ソースが通常の更新範囲内です。</span>
          <span class="i18n-en" lang="en">{ok} of {sources.length} sources are within their normal update window.</span>
        </p>
      </div>

      <StatusAttentionList sources={attentionSources} id="attention-list" />

      <div class="side-card status-insight-card">
        <div class="rail-title">
          <span class="i18n-ja">カテゴリ別の状態</span>
          <span class="i18n-en" lang="en">Status by category</span>
        </div>
        <ul class="category-health-list">
          {categoryRows.map((row) => (
            <li>
              <span>{row.name}</span>
              <small>
                <span class="i18n-ja">{row.ok} 順調 · {row.stale} 更新遅延 · {row.error} 要確認</span>
                <span class="i18n-en" lang="en">{row.ok} fresh · {row.stale} delayed · {row.error} review</span>
              </small>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-card status-insight-card">
        <div class="rail-title">
          <span class="i18n-ja">表示の見方</span>
          <span class="i18n-en" lang="en">How to read this page</span>
        </div>
        <p>
          <span class="i18n-ja">記事の収集、AI要約、サイト反映は別々に表示しています。更新遅延は必ずしも収集サービスの停止を意味しません。</span>
          <span class="i18n-en" lang="en">Collection, AI summaries, and site publication are reported separately. A delayed source does not always mean the collection service is down.</span>
        </p>
      </div>
    </aside>
  </div>
</Portal>

