---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import {
  ALL_ENTRIES,
  CATEGORIES_BY_NAME,
  CATEGORY_META,
  relativeTime,
  type Category,
  type CategoryGroup,
} from "../lib/data.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { REACTION_CONTRACT_EN, REACTION_CONTRACT_JA } from "../lib/reaction-copy.ts";
import { WORKER_HEALTH } from "../lib/data.ts";
import { deriveWorkerRunStatus, WORKER_RUN_STATE_COPY } from "../lib/run-health.ts";
import { NEW_ISSUE_URL, PUBLIC_OPERATOR_NAME } from "../lib/site.ts";
import { OPML_HREF, OPML_MEDIA_TYPE } from "../lib/feed-catalog.ts";

const now = new Date();
const lastUpdated = relativeTime(DASHBOARD_METRICS.generatedAt, now);
const workerLastRun = DASHBOARD_METRICS.workerLastRunAt
  ? relativeTime(DASHBOARD_METRICS.workerLastRunAt, now)
  : null;
// Shared aggregate run state (same derivation as the footer + Home + /status, LL-126).
const runStatus = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const sourceTypes = [...new Set(ALL_ENTRIES.map((entry) => entry.sourceType))].sort();
const workerBatchCount = DASHBOARD_METRICS.workerBatchTotal;
const workerBatchCopy = workerBatchCount ? `${workerBatchCount} batch` : "multi-batch";
const groupSummary = CATEGORY_META.reduce<Record<CategoryGroup, number>>((acc, category) => {
  acc[category.group] = (acc[category.group] ?? 0) + 1;
  return acc;
}, {} as Record<CategoryGroup, number>);
const GROUP_LABEL: Record<CategoryGroup, string> = {
  microsoft: "Microsoft / GitHub",
  anthropic: "Anthropic",
  openai: "OpenAI",
  google: "Google",
  "coding-tools": "AI Coding Tools",
  "open-models": "Local & Open Models",
  "agent-tools": "Agent Tools & Protocols",
  research: "Research & Benchmarks",
  industry: "Industry & Policy",
};
const categoryLast30 = (category: Category) => {
  const cutoff = now.getTime() - 30 * 86_400_000;
  return ALL_ENTRIES.filter((entry) => entry.category === category && Date.parse(entry.publishedAt) >= cutoff).length;
};
const topCategories = CATEGORY_META.map((category) => ({
  ...category,
  last30: categoryLast30(category.slug),
})).sort((a, b) => b.last30 - a.last30).slice(0, 5);

const pipelineSteps = [
  {
    label: "Collect",
    title: "公式 feed と community feed を収集",
    titleEn: "Collect official and community feeds",
    body: `RSS、Atom、GitHub Releases、arXiv、HTML index から記事候補を取り込みます。${DASHBOARD_METRICS.totalSourceCount} source を ${workerBatchCopy} に分け、毎時 1 batch、各 source を約 6 時間周期で巡回します。`,
    bodyEn: `Candidates come from RSS, Atom, GitHub Releases, arXiv, and HTML indexes. ${DASHBOARD_METRICS.totalSourceCount} sources are split across ${workerBatchCopy}; one batch runs hourly, revisiting each source about every 6 hours.`,
  },
  {
    label: "Normalize",
    title: "重複除去とカテゴリ正規化",
    titleEn: "Deduplicate and normalize categories",
    body: "source、URL、publishedAt、category、importance、archiveTier を揃え、同一記事の重複を canonical URL ベースで抑えます。",
    bodyEn: "Source, URL, publishedAt, category, importance, and archiveTier fields are normalized. Canonical URLs suppress duplicate copies of the same article.",
  },
  {
    label: "Summarize",
    title: "日本語で読み始められる形に変換",
    titleEn: "Prepare summaries for fast review",
    body: "タイトル、要約、タグ、重要度を生成し、KV cache を使って再生成を抑えます。原文への導線は記事詳細に残します。",
    bodyEn: "Titles, summaries, tags, and importance are generated, with KV caching to avoid unnecessary regeneration. Article details retain a direct link to the original source.",
  },
  {
    label: "Publish",
    title: "静的サイトとして高速に配信",
    titleEn: "Publish as a fast static site",
    body: "差分がある場合だけ data artifact を commit し、Cloudflare Pages Git Integration が Astro build と Pagefind index を作成します。",
    bodyEn: "Data artifacts are committed only when they change. Cloudflare Pages Git Integration then builds the Astro site and Pagefind index.",
  },
];
---

<Portal
  pageKey="about"
  title="About — TECH Dashboard"
  canonicalPath="/about/"
  description={`TECH Dashboard の目的、収集パイプライン、${sourceTypes.length} 種類のソース種別、AI 要約の作り方、RSS/JSON Feed の購読方法を説明します。運営は ${PUBLIC_OPERATOR_NAME}。`}
  descriptionEn={`What TECH Dashboard is: its purpose, collection pipeline, ${sourceTypes.length} source types, how AI summaries are produced, and how to subscribe by RSS or JSON Feed. Operated by ${PUBLIC_OPERATOR_NAME}.`}
  breadcrumb={[{ label: "Home", href: "/" }, { label: "About" }]}
>
  <PageHero
    className="page-hero-top-level page-hero-about"
    kicker="About TECH Dashboard"
    title="About"
    count={`${DASHBOARD_METRICS.totalSourceCount} sources`}
    headingId="about-heading"
    description="TECH Dashboard は、AI coding と agent ecosystem の変化を毎日追うための日本語 dashboard です。公式発表、release note、研究、community feed を同じ情報設計に揃え、短時間で確認できます。"
    descriptionEn="TECH Dashboard tracks daily changes across AI coding and the agent ecosystem. Official announcements, release notes, research, and community feeds share one information model for fast review."
    actions={[
      { href: "/rss.xml", label: "全体RSS", labelEn: "Site-wide RSS", mobilePriority: true },
      { href: "/feed.json", label: "JSON Feed", labelEn: "JSON Feed", mobilePriority: true },
      { href: OPML_HREF, label: "OPMLで一括購読", labelEn: "Subscribe via OPML", mediaType: OPML_MEDIA_TYPE, mobilePriority: true },
      { href: "/status", label: "Status" },
      { href: "/editorial-policy", label: "編集方針", labelEn: "Editorial policy" },
      { href: "/privacy", label: "Privacy" },
      { href: "#feedback", label: "問題を報告", labelEn: "Report an issue" },
    ]}
    metrics={[
      {
        label: "Live entries",
        value: DASHBOARD_METRICS.timelineEntries,
        detail: "現在のTimeline",
        detailEn: "Current Timeline",
        scope: "timeline-live",
      },
      {
        label: "All time",
        value: DASHBOARD_METRICS.allTimeEntries,
        detail: "live + archive履歴",
        detailEn: "Live plus archive history",
        scope: "all-time",
      },
      {
        label: "Sources",
        value: DASHBOARD_METRICS.totalSourceCount,
        detail: "登録source",
        detailEn: "Registered sources",
        scope: "registered-sources",
      },
      {
        label: "Categories",
        value: DASHBOARD_METRICS.totalCategories,
        detail: "現在のtaxonomy",
        detailEn: "Current taxonomy",
        scope: "category-count",
      },
      {
        label: "Archive months",
        value: DASHBOARD_METRICS.archiveMonths,
        detail: "月次artifact",
        detailEn: "Monthly artifacts",
        scope: "archive-months",
      },
      {
        label: "Last updated",
        value: lastUpdated,
        datetime: DASHBOARD_METRICS.generatedAt,
        detail: "公開index snapshot",
        detailEn: "Published index snapshot",
        scope: "published-snapshot",
      },
    ]}
  />

  <div class="layout about-layout">
    <Sidebar />

    <main class="about-main">
      <section class="about-section-grid" aria-label="What this site covers">
        <article class="about-panel large">
          <span class="panel-kicker">Purpose</span>
          <h3>
            <span class="i18n-ja">速く読むためではなく、見落とさないための dashboard</span>
            <span class="i18n-en" lang="en">A dashboard for not missing important changes</span>
          </h3>
          <p>
            <span class="i18n-ja">
              AI coding のニュースは、product blog、changelog、release、論文、community 記事に分散しています。
              このサイトではそれらをカテゴリ、重要度、source type、時系列で揃え、日次確認と後追い調査の両方で使えるようにしています。
            </span>
            <span class="i18n-en" lang="en">
              AI coding updates are scattered across product blogs, changelogs, releases, papers, and community posts.
              This site aligns them by category, importance, source type, and time for both daily review and later research.
            </span>
          </p>
        </article>

        <article class="about-panel">
          <span class="panel-kicker">Freshness</span>
          <h3 data-worker-batch-total={workerBatchCount ?? "unknown"}>
            <span class="i18n-ja">毎時 1 batch、各 source は約 6 時間周期</span>
            <span class="i18n-en" lang="en">One batch hourly; each source about every 6 hours</span>
          </h3>
          <p>
            <span class="i18n-ja">
              {DASHBOARD_METRICS.totalSourceCount} sources を {workerBatchCopy} に分け、1 run で約 {Math.ceil(DASHBOARD_METRICS.totalSourceCount / Math.max(workerBatchCount ?? 1, 1))} sources を確認します。
              Status では batch、source registry、freshness、summarize 状態を確認できます。
            </span>
            <span class="i18n-en" lang="en">
              {DASHBOARD_METRICS.totalSourceCount} sources are split across {workerBatchCopy}, with about {Math.ceil(DASHBOARD_METRICS.totalSourceCount / Math.max(workerBatchCount ?? 1, 1))} checked per run.
              Status shows the batch, source registry, freshness, and summarization state.
            </span>
          </p>
        </article>

        <article class="about-panel">
          <span class="panel-kicker">History</span>
          <h3>
            <span class="i18n-ja">Archive と stats で長期推移を保持</span>
            <span class="i18n-en" lang="en">Archive and stats preserve long-term trends</span>
          </h3>
          <p>
            <span class="i18n-ja">
              live index から外れた記事も archive と stats に集約し、カテゴリ別の月次推移や記事数推移を後から確認できるようにしています。
            </span>
            <span class="i18n-en" lang="en">
              Entries that leave the live index remain aggregated in archive and stats data, preserving monthly category and volume trends for later review.
            </span>
          </p>
        </article>
      </section>

      <section class="pipeline-section" aria-labelledby="pipeline-heading">
        <div class="section-header primary compact">
          <h2 id="pipeline-heading">Pipeline</h2>
        </div>
        <div class="pipeline-grid">
          {pipelineSteps.map((step, index) => (
            <article class="pipeline-card">
              <span class="step-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="panel-kicker">{step.label}</span>
              <h3>
                <span class="i18n-ja">{step.title}</span>
                <span class="i18n-en" lang="en">{step.titleEn}</span>
              </h3>
              <p>
                <span class="i18n-ja">{step.body}</span>
                <span class="i18n-en" lang="en">{step.bodyEn}</span>
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="coverage-section" aria-labelledby="coverage-heading">
        <div class="section-header primary compact">
          <h2 id="coverage-heading">Coverage</h2>
        </div>
        <div class="coverage-grid">
          {CATEGORIES_BY_NAME.map((category) => (
            <a href={`/c/${category.slug}`} class="coverage-chip" style={`--category-color:${category.color}`}>
              <span class="coverage-chip-icon" aria-hidden="true">{category.emoji}</span>
              <strong>{category.name}</strong>
            </a>
          ))}
        </div>
      </section>

      <section class="about-note-panel trust-assumption">
        <h3>
          <span class="i18n-ja">利用時の前提</span>
          <span class="i18n-en" lang="en">Assumptions and caveats</span>
        </h3>
        <p>
          <span class="i18n-ja">
            タイトル、要約、タグ、重要度には機械生成の内容が含まれます。要約は読む優先度を判断するための補助です。
            共有前に原文を確認してください。要約待ちや翻訳表示にはラベルを付けています。
          </span>
          <span class="i18n-en" lang="en">
            Titles, summaries, tags, and importance may include machine-generated content. Summaries support triage.
            Confirm the original source before sharing. Pending and translated states are labeled.
          </span>
        </p>
      </section>
      <section class="about-note-panel sharing-checklist">
        <h3>
          <span class="i18n-ja">共有前チェック</span>
          <span class="i18n-en" lang="en">Sharing checklist</span>
        </h3>
        <p>
          <span class="i18n-ja">
            一覧と詳細には、AI 要約が準備待ちの新着を含む場合があります。Spotlight、優先度 Top 3、RSS、JSON Feed は要約準備済みの記事だけを扱います。
            要約はトリアージの補助です。要約待ちや翻訳表示のラベルを確認し、共有前に原文を確認してください。
          </span>
          <span class="i18n-en" lang="en">
            Public listing and detail pages may include newly collected entries while AI summary enrichment is pending.
            Spotlight, Ranked Top 3, RSS, and JSON Feed remain summary-ready-only. Summaries support triage.
            Check pending or translated labels, and confirm the original source before sharing.
          </span>
        </p>
        <p>
          <span class="i18n-ja">任意の広告スクリプトは、利用者が明示的に許可した場合だけ本番カスタムドメインで読み込みます。ローカル preview と pages.dev では読み込みません。</span>
          <span class="i18n-en" lang="en">The optional ad script loads on the production custom domain only after explicit consent. It remains disabled on local previews and pages.dev.</span>
        </p>
      </section>
      <section id="reactions-privacy" class="about-note-panel reactions-privacy">
        <h3>
          <span class="i18n-ja">匿名いいねとプライバシー</span>
          <span class="i18n-en" lang="en">Anonymous likes and privacy</span>
        </h3>
        <p>
          <span class="i18n-ja">{REACTION_CONTRACT_JA}</span>
          <span class="i18n-en" lang="en">{REACTION_CONTRACT_EN}</span>
        </p>
        <p>
          <span class="i18n-ja">
            Knowledge と記事詳細の「いいね」は匿名の公開件数です。ブラウザごとの不透明な識別子を HttpOnly Cookie に保持し、
            server では HMAC-SHA256 化した値だけを D1 に保存します。IP address は Turnstile 検証にだけ使用し、D1 には保存しません。
          </span>
          <span class="i18n-en" lang="en">
            Likes on Knowledge cards and article detail pages are anonymous public counts. An opaque browser identifier is kept in an HttpOnly cookie,
            and only its HMAC-SHA256 digest is stored in D1. The IP address is used only for Turnstile verification and is not stored in D1.
          </span>
        </p>
        <p>
          <span class="i18n-ja">
            Cookie を削除した場合や別ブラウザでは別票として扱われます。いいねはお気に入りや記事保存ではなく、
            live index から外れた記事の URL 保持を保証しません。Featured、Top 3、importance、掲載順位にも影響しません。
          </span>
          <span class="i18n-en" lang="en">
            Clearing the cookie or using another browser creates a separate vote. A like is not a bookmark or saved article,
            and it does not guarantee that an article URL remains available after the entry leaves the live index.
            It does not affect Featured, Top 3, importance, or listing order.
          </span>
        </p>
        <p>
          <a href="/privacy#anonymous-reactions">
            <span class="i18n-ja">保存内容、第三者サービス、削除方法を確認</span>
            <span class="i18n-en" lang="en">Review stored data, third parties, and deletion controls</span>
          </a>
        </p>
      </section>

      <section id="feedback" class="about-note-panel feedback-panel">
        <h3>
          <span class="i18n-ja">問題の報告</span>
          <span class="i18n-en" lang="en">Report a problem</span>
        </h3>
        <p>
          <span class="i18n-ja">
            誤ったカテゴリ・タグ、翻訳の欠落、壊れたリンク、表示崩れなど、サイトの問題を見つけた場合は GitHub Issues で報告できます。
            記事 URL や再現手順を含めていただくと調査しやすくなります。
          </span>
          <span class="i18n-en" lang="en">
            If you notice a miscategorized entry, a missing translation, a broken link, or a display bug, you can report it
            on GitHub Issues. Including the article URL and steps to reproduce helps investigation.
          </span>
        </p>
        <p>
          <span class="i18n-ja">
            収集や AI 要約の遅れ自体は、通常の運用状態であり不具合ではありません。まず
            <a href="/status">Status</a> で稼働状況・Queue backlog・収集エラーを確認し、それでも数時間以上 ERR が続く場合や、
            意図的な障害と思われる場合に報告してください。
          </span>
          <span class="i18n-en" lang="en">
            Collection or AI summary delays are expected operational states, not bugs by themselves. Check
            <a href="/status">Status</a> first for run health, queue backlog, and collection errors, and report only when
            an ERR state persists for several hours or looks like an unintended failure.
          </span>
        </p>
        <p class="feedback-cta">
          <a class="feedback-issue-link" href={NEW_ISSUE_URL} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">⚠</span>
            <span class="i18n-ja">GitHub で問題を報告</span>
            <span class="i18n-en" lang="en">Report an issue on GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        </p>
      </section>

      <section id="operator" class="about-note-panel operator-panel" aria-labelledby="operator-heading">
        <h3 id="operator-heading">
          <span class="i18n-ja">運営者情報</span>
          <span class="i18n-en" lang="en">Operator</span>
        </h3>
        <dl class="operator-dl">
          <div>
            <dt>
              <span class="i18n-ja">運営主体</span>
              <span class="i18n-en" lang="en">Operated by</span>
            </dt>
            <dd>{PUBLIC_OPERATOR_NAME}</dd>
          </div>

        </dl>
        <p>
          <span class="i18n-ja">
            お問い合わせは上記「問題の報告」の GitHub Issues をご利用ください。情報源の選定基準・訂正削除ポリシーは <a href="/editorial-policy">編集方針</a>、データの扱い・第三者サービス・適用法域の詳細は <a href="/privacy">Privacy</a> を参照してください。
          </span>
          <span class="i18n-en" lang="en">
            For enquiries, use the GitHub Issues link above. See the <a href="/editorial-policy">Editorial Policy</a> for source selection and correction rules, and <a href="/privacy">Privacy</a> for data handling, third-party services, and jurisdiction details.
          </span>
        </p>
      </section>
    </main>

    <aside class="right about-insights">
      <div class="side-card about-side-card">
        <div class="rail-title">Current run</div>
        <dl class="about-dl">
          <div>
            <dt>Run state</dt>
            <dd
              data-about-run-state
              data-run-tone={runStatus.tone}
              title={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
              aria-label={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
            >
              <span class={`dot ${runStatus.tone}`} data-run-tone={runStatus.tone} aria-hidden="true"></span>
              <span class="i18n-ja" data-about-run-label-ja>{WORKER_RUN_STATE_COPY[runStatus.state].ja}</span>
              <span class="i18n-en" lang="en" data-about-run-label-en>{runStatus.stateText} · {runStatus.detail}</span>
            </dd>
          </div>
          <div>
            <dt>Worker</dt>
            <dd>
              {workerLastRun && DASHBOARD_METRICS.workerLastRunAt ? (
                <time datetime={DASHBOARD_METRICS.workerLastRunAt} data-relative-time>{workerLastRun}</time>
              ) : (
                <>
                  <span class="i18n-ja">記録なし</span>
                  <span class="i18n-en" lang="en">No data</span>
                </>
              )}
            </dd>
          </div>
          <div>
            <dt>Batch</dt>
            <dd>
              {WORKER_HEALTH ? DASHBOARD_METRICS.workerBatchLabel : (
                <>
                  <span class="i18n-ja">記録なし</span>
                  <span class="i18n-en" lang="en">No data</span>
                </>
              )}
            </dd>
          </div>
          <div>
            <dt>Source OK</dt>
            <dd>
              {WORKER_HEALTH ? DASHBOARD_METRICS.workerSourceOkLabel : (
                <>
                  <span class="i18n-ja">記録なし</span>
                  <span class="i18n-en" lang="en">No data</span>
                </>
              )}
            </dd>
          </div>
        </dl>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Recent volume</div>
        <dl class="about-dl">
          <div><dt>Last 24h</dt><dd data-metric="last24hEntries">{DASHBOARD_METRICS.last24hEntries}</dd></div>
          <div><dt>Last 7d</dt><dd data-metric="last7dEntries">{DASHBOARD_METRICS.last7dEntries}</dd></div>
          <div><dt>Last 30d</dt><dd data-metric="last30dEntries">{DASHBOARD_METRICS.last30dEntries}</dd></div>
          <div><dt>Archive months</dt><dd data-metric="archiveMonths">{DASHBOARD_METRICS.archiveMonths}</dd></div>
        </dl>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Hot categories</div>
        <ul class="about-rank-list">
          {topCategories.map((category) => (
            <li style={`--category-color:${category.color}`}>
              <span><i></i>{category.name}</span>
              <strong>{category.last30}</strong>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Source mix</div>
        <div class="source-type-list">
          {sourceTypes.map((type) => <span>{type}</span>)}
        </div>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Groups</div>
        <ul class="about-rank-list simple">
          {Object.entries(groupSummary).map(([group, count]) => (
            <li><span>{GROUP_LABEL[group as CategoryGroup] ?? group}</span><strong>{count}</strong></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</Portal>

<style>
  .about-main {
    min-width: 0;
  }

  .about-panel,
  .pipeline-card,
  .about-note-panel {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
  }

  .panel-kicker,
  .about-side-card .rail-title {
    display: block;
    margin-bottom: 5px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  .about-panel {
