---
import {
  trendingTags,
  relativeTime,
  CATEGORY_META,
  tagHref,
  type NormalizedEntry,
} from "../lib/data.ts";
import { SOURCE_META } from "../lib/source-meta.ts";

interface Props {
  /** Entries used to compute the rankings/freshness for this surface. */
  entries: readonly NormalizedEntry[];
  now?: Date;
  /** How many trending tags to show. */
  tagCount?: number;
  /** Accessible label for the landmark (varies per surface). */
  label?: string;
}

const {
  entries,
  now = new Date(),
  tagCount = 7,
  label = "Timeline insights",
} = Astro.props as Props;

// Platform / feed-origin tags describe *where* an item came from, not *what*
// it is about. Drop them so the rail surfaces real topics (mcp, agent, cursor)
// instead of qiita/zenn (persona R-05).
const PLATFORM_TAGS: ReadonlySet<string> = new Set([
  "qiita",
  "zenn",
  "github",
  "hacker-news",
  "hackernews",
  "reddit",
  "youtube",
  "note",
  "medium",
  "dev-to",
  "devto",
  "x",
  "twitter",
  "rss",
  "blog",
]);

const sourceMetaById = new Map(SOURCE_META.map((s) => [s.id, s]));
const categoryMetaBySlug = new Map(CATEGORY_META.map((c) => [c.slug, c]));

/** Tidy a feed display name for rail use (e.g. "Qiita MCP tag" -> "Qiita MCP"). */
const cleanSourceLabel = (id: string): string => {
  const name = sourceMetaById.get(id)?.displayName ?? id;
  return name.replace(/\s+(?:tag|feed)$/i, "");
};

// Most active sources within the recent window of this surface, linked to the
// source's category so each row is a real destination (persona R-04).
const recent = entries.slice(0, 200);
const sourceCounts = new Map<string, number>();
for (const e of recent) {
  sourceCounts.set(e.source, (sourceCounts.get(e.source) ?? 0) + 1);
}
const topSources = [...sourceCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([id, count]) => {
    const cat = sourceMetaById.get(id)?.category;
    const catMeta = cat ? categoryMetaBySlug.get(cat) : undefined;
    return {
      id,
      label: cleanSourceLabel(id),
      count,
      catSlug: cat,
      catLabel: catMeta?.shortLabel ?? catMeta?.name,
      catColor: catMeta?.color ?? "var(--paper)",
    };
  });

const tags = trendingTags(tagCount, { exclude: PLATFORM_TAGS });
const maxTagCount = Math.max(1, ...tags.map((tag) => tag.count));
const maxSourceCount = Math.max(1, ...topSources.map((source) => source.count));

// Freshness for THIS surface, derived from the same entries that drive the
// adjacent timeline/DailySummary. This avoids the global-vs-timeline "today"
// contradiction that arose from DASHBOARD_METRICS (persona R-01).
const nowMs = now.getTime();
const newestMs = entries.reduce((max, e) => {
  const t = Date.parse(e.publishedAt);
  return Number.isNaN(t) ? max : Math.max(max, t);
}, 0);
const updatedLabel =
  newestMs > 0 ? relativeTime(new Date(newestMs).toISOString(), now) : "不明";
const last7d = entries.filter((e) => {
  const t = Date.parse(e.publishedAt);
  return !Number.isNaN(t) && nowMs - t <= 7 * 86_400_000;
}).length;
---

<aside class="right home-right" aria-label={label}>
  {tags.length > 0 && (
    <div class="side-card">
      <h3 class="right-title">Trending topics <small>entries</small></h3>
      <div class="home-ranked-list" data-rail-ranking="topics">
        {tags.map((t, index) => (
          <a
            class="home-ranked-row"
            href={tagHref(t.tag)}
            style={`--rail-color:var(--accent);--rail-level:${Math.max(10, Math.round((t.count / maxTagCount) * 100))}%`}
          >
            <span class="home-rank-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="home-ranked-copy">
              <span class="home-ranked-label">#{t.tag}</span>
            </span>
            <strong class="home-ranked-count">
              {t.count}<span class="visually-hidden"> entries</span>
            </strong>
            <span class="home-ranked-meter" aria-hidden="true"><i></i></span>
          </a>
        ))}
      </div>
    </div>
  )}

  {topSources.length > 0 && (
    <div class="side-card">
      <h3 class="right-title">Most active sources <small>entries</small></h3>
      <p class="rail-ranking-scope" data-ranking-scope="first-200-listed-entries">
        <span class="i18n-ja">表示中一覧の先頭200件</span>
        <span class="i18n-en" lang="en">First 200 listed entries</span>
      </p>
      <div class="home-ranked-list home-source-list" data-rail-ranking="sources">
        {topSources.map((s, index) =>
          s.catSlug ? (
            <a
              class="home-ranked-row home-source-row"
              href={`/c/${s.catSlug}`}
              style={`--rail-color:${s.catColor};--rail-level:${Math.max(10, Math.round((s.count / maxSourceCount) * 100))}%`}
            >
              <span class="home-rank-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="home-ranked-copy">
                <span class="home-ranked-label">{s.label}</span>
                {s.catLabel && <span class="home-ranked-meta">{s.catLabel}</span>}
              </span>
              <strong class="home-ranked-count">
                {s.count}<span class="visually-hidden"> entries</span>
              </strong>
              <span class="home-ranked-meter" aria-hidden="true"><i></i></span>
            </a>
          ) : (
            <div
              class="home-ranked-row home-source-row is-static"
              style={`--rail-color:${s.catColor};--rail-level:${Math.max(10, Math.round((s.count / maxSourceCount) * 100))}%`}
            >
              <span class="home-rank-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="home-ranked-copy">
                <span class="home-ranked-label">{s.label}</span>
              </span>
              <strong class="home-ranked-count">{s.count}</strong>
              <span class="home-ranked-meter" aria-hidden="true"><i></i></span>
            </div>
          ),
        )}
      </div>
      <a class="side-action rail-action" href="/status">ソースの稼働状況 →</a>
    </div>
  )}

  <div class="side-card">
    <h3 class="right-title">Freshness</h3>
    <p class="rail-scope-note" data-activity-scope="listed-entries">
      <span class="i18n-ja">過去7日は表示中一覧を基準に集計。</span>
      <span class="i18n-en" lang="en">The 7-day count uses this listed view.</span>
    </p>
    <div class="home-side-metrics">
      <div class="home-side-metric">
        <span>最新記事</span>
        <strong
          data-relative-time
          data-datetime={newestMs > 0 ? new Date(newestMs).toISOString() : undefined}
        >{updatedLabel}</strong>
      </div>
      <div class="home-side-metric">
        <span>過去7日</span>
        <strong>{last7d}</strong>
      </div>
    </div>
  </div>
</aside>

<style>
  .rail-ranking-scope,
  .rail-scope-note {
    margin: -2px 0 10px;
    color: var(--muted-2);
    font-size: 10.5px;
    line-height: 1.55;
  }

  .right-title small {
    margin-left: 5px;
    color: var(--muted-2);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
</style>
