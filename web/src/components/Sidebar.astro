---
import { CATEGORY_META, countByCategory, ALL_ENTRIES, type Category, type CategoryGroup } from "../lib/data.ts";
import { categoryDailySpark } from "../lib/stats.ts";

export interface Props {
  active?: Category | "all";
}

const { active = "all" } = Astro.props;
const counts = countByCategory();
const total = ALL_ENTRIES.length;

const groupLabels: Record<CategoryGroup, string> = {
  microsoft: "Microsoft",
  anthropic: "Anthropic",
  openai: "OpenAI",
  google: "Google",
  "coding-tools": "AI Coding Tools",
  "open-models": "Open Models",
  "agent-tools": "Agent Tools",
  research: "Research",
  industry: "Industry",
};

const groupOrder: CategoryGroup[] = [
  "microsoft",
  "anthropic",
  "openai",
  "google",
  "coding-tools",
  "open-models",
  "agent-tools",
  "research",
  "industry",
];

function tileClass(slug: Category): string {
  const map: Record<Category, string> = {
    copilot: "bt-copilot",
    claude: "bt-claude",
    codex: "bt-codex",
    gemini: "bt-gemini",
    cursor: "bt-cursor",
    cline: "bt-cline",
    aider: "bt-aider",
    opencode: "bt-opencode",
    vscode: "bt-vscode",
    "local-llm": "bt-local",
    "agent-fw": "bt-agentfw",
    mcp: "bt-mcp",
    "tech-news": "bt-technews",
    research: "bt-research",
  };
  return map[slug];
}

function initial(slug: Category): string {
  const map: Record<Category, string> = {
    copilot: "Co",
    claude: "Cl",
    codex: "Cx",
    gemini: "Gm",
    cursor: "Cu",
    cline: "Cn",
    aider: "Ai",
    opencode: "Oc",
    vscode: "Vs",
    "local-llm": "Ll",
    "agent-fw": "Af",
    mcp: "Mc",
    "tech-news": "Tn",
    research: "Rs",
  };
  return map[slug];
}

function compactLabel(slug: Category): string {
  const map: Record<Category, string> = {
    copilot: "Copilot",
    claude: "Claude Code",
    codex: "Codex",
    gemini: "Gemini/Gemma",
    cursor: "AI Editors",
    cline: "Cline/Roo",
    aider: "Aider",
    opencode: "OpenHands/OpenCode",
    vscode: "VS Code",
    "local-llm": "Local Models",
    "agent-fw": "Agent Frameworks",
    mcp: "MCP",
    "tech-news": "News/Policy",
    research: "Papers/Benchmarks",
  };
  return map[slug];
}
---

<aside class="left">
  <div class="side-card">
    <div class="side-title">Categories <span class="sub">{total}</span></div>
    <a class={`side-item ${active === "all" ? "active" : ""}`} href="/">
      <span class="brand-tile bt-all">•</span>
      <span class="name" title="All"><span class="name-marquee">All</span></span>
      <span class="count">{total}</span>
    </a>

    {groupOrder.map((g) => (
      <>
        <div class="side-group-label">{groupLabels[g]}</div>
        {CATEGORY_META.filter((c) => c.group === g).map((c) => {
          const trend = categoryDailySpark(c.slug, 30);
          const label = compactLabel(c.slug);
          const title = `${groupLabels[c.group]}: ${c.name}`;
          const href = `/c/${c.slug}`;
          const isActive = active === c.slug;
          return (
            <a
              class={`side-item ${isActive ? "active" : ""}`}
              href={href}
              aria-label={`${label}, ${title}, ${counts[c.slug]} entries`}
            >
              <span class={`brand-tile ${tileClass(c.slug)}`}>{initial(c.slug)}</span>
              <span class="name" title={title}><span class="name-marquee">{label}</span></span>
              <span class="spark" title="Last 30 days" aria-label={`${label} article trend for the last 30 days`}>
                {trend.map((bucket) => (
                  <i title={`${bucket.key}: ${bucket.count}`} style={`height:${bucket.height}%`}></i>
                ))}
              </span>
              <span class="count">{counts[c.slug]}</span>
            </a>
          );
        })}
      </>
    ))}
  </div>
</aside>

<script>
  (() => {
    const setupSidebarMarquees = () => {
      document.querySelectorAll<HTMLElement>(".side-item").forEach((item) => {
        const label = item.querySelector<HTMLElement>(".name");
        const marquee = item.querySelector<HTMLElement>(".name-marquee");
        if (!label || !marquee) return;

        const distance = marquee.scrollWidth - label.clientWidth;
        const overflows = distance > 1;
        item.toggleAttribute("data-marquee", overflows);

        if (overflows) {
          marquee.style.setProperty("--marquee-distance", `-${Math.ceil(distance)}px`);
          marquee.style.setProperty("--marquee-duration", `${Math.min(5.5, Math.max(2.4, distance / 18))}s`);
        } else {
          marquee.style.removeProperty("--marquee-distance");
          marquee.style.removeProperty("--marquee-duration");
        }
      });
    };

    let resizeTimer: number | undefined;
    const scheduleSetup = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(setupSidebarMarquees, 80);
    };

    window.requestAnimationFrame(setupSidebarMarquees);
    window.addEventListener("resize", scheduleSetup, { passive: true });
  })();
</script>
