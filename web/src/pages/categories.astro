---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  countByCategory,
  entriesFor,
  relativeTime,
  titleForLangWithFallback,
  type Category,
  type CategoryGroup,
  type NormalizedEntry,
} from "../lib/data.ts";
import { categoryDailySpark, STATS } from "../lib/stats.ts";

const now = new Date();
const counts = countByCategory();

const GROUP_LABEL: Record<CategoryGroup, string> = {
  microsoft: "Microsoft / GitHub",
  anthropic: "Anthropic",
  openai: "OpenAI",
  google: "Google",
  "coding-tools": "AI Coding Tools",
  "open-models": "Local & Open Models",
  "agent-tools": "Agent Tools & Protocols",
  research: "Research & Benchmarks",
  industry: "Industry & Policy",
};

const GROUP_COPY: Record<CategoryGroup, string> = {
  microsoft: "GitHub Copilot、VS Code、Microsoft 系の開発者向け更新をまとめます。",
  anthropic: "Claude、Claude Code、Anthropic API / research の動きを追います。",
  openai: "OpenAI、Codex、ChatGPT、API / agent 関連の更新をまとめます。",
  google: "Gemini、Gemma、Vertex AI、DeepMind、Google Developers AI を整理します。",
  "coding-tools": "Cursor、Zed、Cline、Aider、OpenHands など AI coding tool をまとめます。",
  "open-models": "Ollama、Hugging Face、open models、local inference の更新です。",
  "agent-tools": "MCP、LangChain、AutoGen、Semantic Kernel など agent tooling を扱います。",
  research: "論文、benchmark、DORA など評価・研究・長期知見をまとめます。",
  industry: "AI 業界、cloud / GPU、市場、政策、security incident など横断ニュースです。",
};

const GROUP_ORDER: CategoryGroup[] = [
  "microsoft",
  "anthropic",
  "openai",
  "google",
  "coding-tools",
  "open-models",
  "agent-tools",
  "research",
  "industry",
];

const TYPE_LABEL: Record<NormalizedEntry["sourceType"], string> = {
  blog: "Blog",
  release: "Release",
  changelog: "Changelog",
  paper: "Paper",
  community: "Community",
};

const entryTime = (entry: NormalizedEntry): number => Date.parse(entry.publishedAt ?? entry.collectedAt ?? "") || 0;
const countLiveDays = (entries: NormalizedEntry[], days: number): number => {
  const cutoff = now.getTime() - days * 86_400_000;
  return entries.filter((entry) => entryTime(entry) >= cutoff).length;
};
const countLivePrevDays = (entries: NormalizedEntry[], days: number): number => {
  const end = now.getTime() - days * 86_400_000;
  const start = now.getTime() - days * 2 * 86_400_000;
  return entries.filter((entry) => {
    const time = entryTime(entry);
    return time >= start && time < end;
  }).length;
};

const pctDelta = (current: number, previous: number): number => {
  if (previous === 0) return current > 0 ? 100 : 0;
  return Math.round(((current - previous) / previous) * 100);
};

const categoryPanels = CATEGORY_META.map((cat) => {
  const entries = entriesFor(cat.slug);
  const latest = entries[0] ?? null;
  const daily = categoryDailySpark(cat.slug, 30).map((bucket) => ({
    ...bucket,
    label: bucket.key.slice(5), // MM-DD
  }));
  const last7 = countLiveDays(entries, 7);
  const prev7 = countLivePrevDays(entries, 7);
  const last30 = countLiveDays(entries, 30);
  const sourceCount = new Set(entries.map((entry) => entry.source)).size;
  const types = new Map<NormalizedEntry["sourceType"], number>();
  for (const entry of entries.slice(0, 80)) {
    types.set(entry.sourceType, (types.get(entry.sourceType) ?? 0) + 1);
  }
  const topTypes = [...types.entries()]
    .sort(([, a], [, b]) => b - a)
    .slice(0, 3)
    .map(([type, count]) => ({ type, label: TYPE_LABEL[type], count }));
  return {
    ...cat,
    liveCount: counts[cat.slug] ?? 0,
    last7,
    last30,
    sourceCount,
    delta: pctDelta(last7, prev7),
    latest,
    latestTitle: latest ? titleForLangWithFallback(latest, "ja").text : "",
    daily,
    topTypes,
  };
});

const totalLiveEntries = ALL_ENTRIES.length;
const topCategory = [...categoryPanels].sort((a, b) => b.liveCount - a.liveCount)[0] ?? null;
const activeCategories = categoryPanels.filter((panel) => panel.last30 > 0).length;
const researchPanel = categoryPanels.find((panel) => panel.slug === "research");
const techNewsPanel = categoryPanels.find((panel) => panel.slug === "tech-news");

// Group categories by display group while preserving order.
const grouped = new Map<CategoryGroup, typeof categoryPanels>(
  GROUP_ORDER.map((group) => [group, categoryPanels.filter((cat) => cat.group === group)]),
);
---

<Portal pageKey="categories" title="Categories - TECH Dashboard">
  <PageHero
    className="page-hero-top-level page-hero-categories"
    kicker="Explore by category"
    title="Categories"
    count={`${CATEGORY_META.length} categories`}
    headingId="categories-heading"
    description="カテゴリごとの記事量、直近の勢い、過去 30 日の推移を比較できます。伸びている領域を見つけたら、そのままカテゴリ詳細へ移動できます。"
    actions={[
      { href: topCategory ? `/c/${topCategory.slug}` : "#category-groups", label: "Hot category" },
      { href: "#category-directory", label: "Category list" },
      { href: "/status", label: "Check source health" },
    ]}
    metrics={[
      { label: "Live entries", value: totalLiveEntries },
      { label: "Active cats", value: activeCategories },
      { label: "Top live cat", value: topCategory?.name ?? "none" },
      { label: "Research live", value: researchPanel?.liveCount ?? 0 },
      { label: "Tech News live", value: techNewsPanel?.liveCount ?? 0 },
      { label: "Updated", value: relativeTime(STATS.generatedAt, now) },
    ]}
  />

  <div class="layout categories-layout">
    <Sidebar />

    <main class="categories-main">
      <section id="category-directory" class="category-directory" aria-labelledby="category-directory-heading">
        <div class="category-directory-head">
          <div>
            <span class="category-directory-kicker">Quick directory</span>
            <h2 id="category-directory-heading">
              Jump to category
              <span>{CATEGORY_META.length} categories</span>
            </h2>
          </div>
          <p>
            ここは移動用のミニ目次です。比較や傾向確認は下のカードで行えます。
          </p>
        </div>

        <nav class="category-directory-grid" aria-label="Category quick links">
          {categoryPanels.map((cat) => (
            <a
              href={`/c/${cat.slug}`}
              class="category-directory-item"
              style={`--cat-color:${cat.color}`}
              aria-label={`${cat.name}: ${cat.liveCount} live entries, ${cat.last30} entries in the last 30 days`}
            >
              <span class="category-directory-dot"></span>
              <span class="category-directory-text">
                <span class="category-directory-name">{cat.name}</span>
                <span class="category-directory-group-label">{GROUP_LABEL[cat.group]}</span>
              </span>
              <span class="category-directory-count">{cat.liveCount}</span>
            </a>
          ))}
        </nav>
      </section>

      <div id="category-groups"></div>
      {[...grouped.entries()].map(([group, cats]) => (
        <section class="category-group" aria-labelledby={`group-${group}`}>
          <div class="category-group-head">
            <div>
              <h3 id={`group-${group}`}>{GROUP_LABEL[group]}</h3>
              <p>{GROUP_COPY[group]}</p>
            </div>
            <span>{cats.length} categories</span>
          </div>
          <div class="category-grid">
            {cats.map((cat) => {
              return (
                <a href={`/c/${cat.slug}`} class="category-card" style={`--cat-color:${cat.color}`}>
                  <div class="cat-head">
                    <span class="cat-dot"></span>
                    <div class="cat-title-block">
                      <span class="cat-name">{cat.name}</span>
                      <span class="cat-group-label">{GROUP_LABEL[cat.group]}</span>
                    </div>
                    <span class="cat-count">{cat.liveCount}</span>
                  </div>

                  <div class="cat-metrics">
                    <span><strong>{cat.liveCount}</strong> live</span>
                    <span><strong>{cat.last30}</strong> live 30d</span>
                    <span><strong>{cat.sourceCount}</strong> sources</span>
                    <span class:list={["cat-delta", cat.delta > 0 ? "up" : cat.delta < 0 ? "down" : "flat"]}>
                      {cat.delta > 0 ? "+" : ""}{cat.delta}% 7d
                    </span>
                  </div>

                  <div class="cat-trend" role="img" aria-label={`${cat.name} article trend for the last 30 days`}>
                    {cat.daily.map((bucket) => (
                      <span class="cat-bar" title={`${bucket.key}: ${bucket.count}`}>
                        <i style={`height:${bucket.height}%`}></i>
                      </span>
                    ))}
                  </div>

                  <div class="cat-axis" aria-hidden="true">
                    <span>{cat.daily[0]?.label}</span>
                    <span>{cat.daily.at(-1)?.label}</span>
                  </div>

                  {cat.latest && (
                    <div class="cat-latest">
                      <span>Latest</span>
                      <strong>{cat.latestTitle}</strong>
                    </div>
                  )}

                  <table class="sr-only">
                    <caption>{cat.name} daily article counts (last 30 days)</caption>
                    <thead>
                      <tr><th scope="col">Date</th><th scope="col">Count</th></tr>
                    </thead>
                    <tbody>
                      {cat.daily.map((bucket) => (
                        <tr><td>{bucket.key}</td><td>{bucket.count}</td></tr>
                      ))}
                    </tbody>
                  </table>

                  <div class="cat-footer">
                    <div class="cat-meta">
                      {cat.latest ? `最終更新 ${relativeTime(cat.latest.publishedAt, now)}` : "エントリなし"}
                    </div>
                    <div class="cat-types">
                      {cat.topTypes.map((type) => (
                        <span>{type.label} {type.count}</span>
                      ))}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </main>
  </div>
</Portal>

<style>
  .categories-main {
    min-width: 0;
  }

  .category-directory {
    position: sticky;
    top: 72px;
    z-index: 5;
    padding: 12px;
    margin-bottom: 18px;
    border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 94%, transparent), color-mix(in srgb, var(--surface) 84%, transparent)),
      color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px);
  }

  .category-directory-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }

  .category-directory-kicker {
    display: block;
    margin-bottom: 3px;
    color: var(--accent);
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .category-directory h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    color: var(--text);
    font-size: 14px;
    letter-spacing: 0;
  }

  .category-directory h2 span {
    color: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
  }

  .category-directory-head p {
    max-width: 360px;
    margin: 0;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.45;
  }

  .category-directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(218px, 1fr));
    gap: 8px;
  }

  .category-directory-item {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px;
    min-height: 48px;
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
    border-radius: 6px;
    color: var(--text-2);
    background: color-mix(in srgb, var(--bg-2) 66%, transparent);
  }

  .category-directory-item:hover,
  .category-directory-item:focus-visible {
    border-color: color-mix(in srgb, var(--cat-color) 58%, var(--border));
    color: var(--text);
    outline: 0;
  }

  .category-directory-dot {
    width: 8px;
    height: 26px;
    margin-top: 2px;
    border-radius: 999px;
    background: var(--cat-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cat-color) 16%, transparent);
  }

  .category-directory-text {
    min-width: 0;
  }

  .category-directory-name,
  .category-directory-group-label {
    display: block;
  }

  .category-directory-name {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .category-directory-group-label {
    color: var(--muted);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    margin-top: 3px;
    text-transform: uppercase;
  }

  .category-directory-count {
    align-self: start;
    min-width: 22px;
    padding: 2px 5px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--cat-color) 16%, transparent);
    color: var(--text);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 700;
    text-align: center;
  }

  .cat-group-label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-group {
    margin-bottom: 26px;
  }

  .category-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 12px;
  }

  .category-group-head h3 {
    margin: 0 0 4px 4px;
    color: var(--text-subtle);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-group-head p {
    margin: 0 0 0 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .category-group-head > span {
    color: var(--muted-2);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    white-space: nowrap;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px;
  }

  .category-card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 5px;
    padding: 8px 9px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cat-color) 10%, transparent), transparent 42%),
      var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .category-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 62%, var(--border));
    transform: translateY(-1px);
  }

  .cat-head {
    display: flex;
    align-items: flex-start;
    gap: 7px;
  }

  .cat-dot {
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 999px;
    flex: 0 0 auto;
    background: var(--cat-color);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--cat-color) 16%, transparent);
  }

  .cat-title-block {
    min-width: 0;
    flex: 1;
  }

  .cat-name {
    display: block;
    overflow: hidden;
    color: var(--text);
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-count {
    color: var(--text);
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cat-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cat-metrics span {
    min-width: auto;
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-2) 62%, transparent);
    color: var(--muted);
    font-size: 10px;
    line-height: 1.25;
  }

  .cat-metrics strong {
    color: var(--text);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .cat-delta.up {
    color: var(--success);
  }

  .cat-delta.down {
    color: var(--danger);
  }

  .cat-delta.flat {
    color: var(--muted);
  }

  .cat-trend {
    display: grid;
    /* One bar per daily bucket on a single row (bucket count is data-driven; do
       not hard-code a column count or the bars will wrap onto multiple rows). */
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    align-items: end;
    gap: 1px;
    height: 32px;
    padding: 4px 6px;
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-2) 54%, transparent);
    overflow: hidden;
  }

  .cat-bar {
    display: flex;
    height: 100%;
    align-items: end;
  }

  .cat-bar i {
    display: block;
    width: 100%;
    min-height: 2px;
    border-radius: 999px 999px 2px 2px;
    background: var(--cat-color);
    opacity: 0.86;
  }

  .cat-axis {
    display: none;
    justify-content: space-between;
    margin-top: -4px;
    color: var(--muted-2);
    font-size: 9px;
  }

  .cat-latest {
    display: grid;
    gap: 2px;
    min-height: 0;
    padding: 6px 8px;
    border: 1px solid color-mix(in srgb, var(--cat-color) 24%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-2) 62%, transparent);
  }

  .cat-latest span {
    color: var(--muted-2);
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cat-latest strong {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .cat-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 0;
  }

  .cat-meta {
    min-width: 0;
    color: var(--text-subtle);
    font-size: 10.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-types {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: 4px;
    max-width: 54%;
    overflow: hidden;
  }

  .cat-types span {
    flex: 0 0 auto;
    padding: 2px 5px;
    border: 1px solid color-mix(in srgb, var(--cat-color) 36%, var(--border));
    border-radius: 999px;
    color: var(--muted);
    font-size: 9.5px;
    line-height: 1.2;
  }

  .cat-types span:nth-child(n+3) {
    display: none;
  }

  .sr-only {
    position: absolute !important;
    display: block !important;
    overflow: hidden !important;
    width: 1px !important;
    max-width: 1px !important;
    height: 1px !important;
    padding: 0;
    border: 0;
    margin: -1px;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .category-directory {
      position: static;
      padding: 14px;
      margin-bottom: 18px;
    }

    .category-directory-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 10px;
    }

    .category-directory-head p {
      font-size: 11.5px;
    }

    .category-directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7px;
    }

    .category-directory-item {
      grid-template-columns: 7px minmax(0, 1fr) auto;
      align-items: center;
      gap: 7px;
      min-height: 42px;
      padding: 7px 8px;
    }

    .category-directory-dot {
      width: 7px;
      height: 22px;
      margin-top: 0;
    }

    .category-directory-name {
      font-size: 11.5px;
      line-height: 1.2;
    }

    .category-directory-group-label {
      display: none;
    }

    .category-directory-count {
      min-width: 20px;
      padding: 2px 4px;
      font-size: 10px;
    }

    .cat-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .category-card {
      min-height: 0;
      padding: 12px;
    }

    .cat-axis,
    .cat-latest {
      display: none;
    }

    .cat-trend {
      height: 38px;
    }

    .cat-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .cat-types {
      justify-content: flex-start;
      max-width: none;
    }

    .category-group-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
