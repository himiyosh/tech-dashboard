                </li>
              ))}
            </ol>
          )}
          {renderedEn.length >= 3 && (
            <ol class="toc-list i18n-en" id="toc-list-en" lang="en">
              {renderedEn.map((p, i) => (
                <li>
                  <a href={`#${p.id}`} data-toc-target={p.id}>
