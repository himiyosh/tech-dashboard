---
/**
 * Card for the Knowledge lane (evergreen best-practice / engineering guides).
 * Uniform card height with an optional thumbnail column. Image-less entries use
 * the full card width instead of spending space on decorative placeholders.
 */
import {
  CATEGORY_META,
  relativeTime,
  titleForLangWithFallback,
  summaryForLangWithFallback,
  type NormalizedEntry,
} from "../lib/data.ts";
import { entryDestination } from "../lib/entry-destination.ts";
import { sourceFaviconUrl, sourceHost } from "../lib/favicon.ts";
import ArticleLike from "./ArticleLike.astro";
import LanguageFallbackBadge from "./LanguageFallbackBadge.astro";
import ExternalLinkHint from "./ExternalLinkHint.astro";

export interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;

const meta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = meta?.color ?? "#34d399";

const titleJa = titleForLangWithFallback(entry, "ja");
const titleEn = titleForLangWithFallback(entry, "en");
const sumJa = summaryForLangWithFallback(entry, "ja");
const sumEn = summaryForLangWithFallback(entry, "en");
const rel = relativeTime(entry.publishedAt ?? entry.collectedAt);
const siteHost = sourceHost(entry.url);
const favicon = sourceFaviconUrl(entry.url);
const tags = (entry.tags ?? []).slice(0, 2);
const destination = entryDestination(entry);

const imgSrc = typeof entry.image?.src === "string" && entry.image.src.length > 0 ? entry.image.src : "";
const hasImage = imgSrc.length > 0;
---

<article class={`kg-card ${hasImage ? "has-image" : "no-image"}`} style={`--cat-color:${catColor}`}>
  <a
    class="kg-card-link"
    href={destination.href}
    target={destination.target}
    rel={destination.rel}
    data-detail-destination={destination.external ? "source" : "internal"}
  >
    {hasImage && (
      <div class="kg-thumb" aria-hidden="true">
        <img
          src={imgSrc}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="const card=this.closest('.kg-card'); card?.classList.remove('has-image'); card?.classList.add('no-image'); this.closest('.kg-thumb')?.remove()"
        />
      </div>
    )}

    <div class="kg-body">
      <div class="kg-src">
        {favicon && <img class="kg-favicon" src={favicon} alt="" width="16" height="16" loading="lazy" />}
        <span class="kg-host">{siteHost}</span>
        <span class="kg-dot" aria-hidden="true">·</span>
        <time class="kg-time" datetime={entry.publishedAt ?? entry.collectedAt} data-relative-time>{rel}</time>
      </div>

      <h3 class="kg-title">
        <span class="i18n-ja" lang={titleJa.fallbackLang === "en" ? "en" : "ja"}>
          {titleJa.isFallback && titleJa.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={titleJa.fallbackLang} variant="title" />
          )}{titleJa.text}
          {destination.external && <ExternalLinkHint lang="ja" />}
        </span>
        <span class="i18n-en" lang={titleEn.fallbackLang === "ja" ? "ja" : "en"}>
          {titleEn.isFallback && titleEn.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={titleEn.fallbackLang} variant="title" />
          )}{titleEn.text}
          {destination.external && <ExternalLinkHint lang="en" />}
        </span>
      </h3>

      {sumJa.text && (
        <p class="kg-sum i18n-ja" lang={sumJa.fallbackLang === "en" ? "en" : "ja"}>
          {sumJa.isFallback && sumJa.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={sumJa.fallbackLang} variant="summary" />
          )}{sumJa.text}
        </p>
      )}
      {sumEn.text && (
        <p class="kg-sum i18n-en" lang={sumEn.fallbackLang === "ja" ? "ja" : "en"}>
          {sumEn.isFallback && sumEn.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={sumEn.fallbackLang} variant="summary" />
          )}{sumEn.text}
        </p>
      )}

      {tags.length > 0 && (
        <div class="kg-tags">
          {tags.map((t) => (
            <span class="kg-tag">#{t}</span>
          ))}
        </div>
      )}
    </div>
  </a>
  <ArticleLike
    entryId={entry.id}
    variant="card"
    articleTitleJa={titleJa.text}
    articleTitleEn={titleEn.text}
    articleTitleJaLang={titleJa.isFallback ? titleJa.fallbackLang : "ja"}
    articleTitleEnLang={titleEn.isFallback ? titleEn.fallbackLang : "en"}
  />
</article>

<style>
  .kg-card {
    --cat-color: #34d399;
    display: flex;
    position: relative;
    transition: transform 0.16s ease;
  }
  .kg-card-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    width: 100%;
    height: 152px;
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2, rgba(148, 163, 184, 0.04));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .kg-card-link:has(.kg-thumb) {
    grid-template-columns: 116px minmax(0, 1fr);
  }
  .kg-card:hover,
  .kg-card:focus-within {
    transform: translateY(-2px);
  }
  .kg-card:hover .kg-card-link,
  .kg-card:focus-within .kg-card-link {
    border-color: color-mix(in srgb, var(--cat-color) 50%, var(--border));
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  }
  .kg-card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .kg-thumb {
    position: relative;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cat-color) 24%, transparent), rgba(20, 19, 15, 0.85)),
      #14130f;
    overflow: hidden;
  }
  .kg-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kg-body {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    padding: 0.6rem 0.75rem 0.65rem;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .kg-src {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-muted, #94a3b8);
    min-width: 0;
    padding-right: 0;
  }
  .kg-favicon {
    border-radius: 3px;
    flex-shrink: 0;
  }
  .kg-host {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kg-dot {
    opacity: 0.5;
  }
  .kg-time {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .kg-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text, #e9e7e3);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    /* Reserve exactly 2 lines so 1-line and 2-line titles take equal space
       (keeps card height uniform under fixed-height layout, LL-096). */
    min-height: 2.52rem;
    padding-right: 0;
  }
  .kg-card:has(> [data-reaction-control]:not([data-state="unavailable"])) :is(.kg-src, .kg-title) {
    padding-right: 70px;
  }
  .kg-sum {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted, #94a3b8);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 2.34rem;
  }
  .kg-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.1rem;
  }
  .kg-tag {
    font-size: 0.67rem;
    padding: 0.1rem 0.42rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-color) 14%, transparent);
    color: color-mix(in srgb, var(--cat-color) 80%, #cbd5e1);
  }
  @supports not selector(:has(*)) {
    .kg-card.has-image .kg-card-link {
      grid-template-columns: 116px minmax(0, 1fr);
    }
    .kg-src,
    .kg-title {
      padding-right: 70px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kg-card,
    .kg-card-link {
      transition: none;
    }
    .kg-card:hover,
    .kg-card:focus-within {
      transform: none;
    }
  }
  @media (max-width: 460px) {
    .kg-card-link {
      height: 148px;
    }

    .kg-card-link:has(.kg-thumb) {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .kg-thumb {
      width: 84px;
      height: 84px;
      align-self: center;
      justify-self: center;
      border: 1px solid color-mix(in srgb, var(--cat-color) 24%, var(--border));
      border-radius: 10px;
    }

    @supports not selector(:has(*)) {
      .kg-card.has-image .kg-card-link {
        grid-template-columns: 96px minmax(0, 1fr);
      }
    }
  }
</style>
