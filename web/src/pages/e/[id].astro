    ↑
  </button>

  {/* Share toast */}
  <div class="ed-toast" id="ed-toast" role="status">URL をコピーしました</div>
</Portal>

<script is:inline>
  (function () {
    // Reading progress bar
    var bar = document.querySelector("#ed-progress .ed-progress-bar");
    var main = document.getElementById("entry-main");
    function onScroll() {
      if (!bar || !main) return;
      var rect = main.getBoundingClientRect();
      var total = main.offsetHeight - window.innerHeight;
      var scrolled = -rect.top;
      var pct = Math.max(0, Math.min(1, scrolled / Math.max(1, total)));
      bar.style.transform = "scaleX(" + pct.toFixed(4) + ")";
      var fab = document.getElementById("ed-fab");
      if (fab) fab.classList.toggle("show", scrolled > window.innerHeight * 0.5);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // FAB back-to-top
    var fab = document.getElementById("ed-fab");
    if (fab) fab.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    // Share buttons: copy either URL or title + URL. Pending summaries prefer the upstream URL.
    var shareButtons = document.querySelectorAll(".ed-share-btn[data-share-mode]");
    var toast = document.getElementById("ed-toast");
    function showToast(message) {
      if (!toast) return;
      toast.textContent = message || "Copied";
      toast.classList.add("show");
      setTimeout(function () { toast.classList.remove("show"); }, 1800);
    }
    shareButtons.forEach(function (button) {
      button.addEventListener("click", async function () {
        var t = button.dataset.title || document.title;
        var u = button.dataset.url || location.href;
        var text = button.dataset.shareMode === "title-url" ? t + "\n" + u : u;
        try {
          if (navigator.share && button.dataset.shareMode === "url") {
            await navigator.share({ title: t, url: u });
            return;
          }
        } catch (_) {}
        try {
          await navigator.clipboard.writeText(text);
          showToast(button.dataset.shareMode === "title-url" ? "Title and URL copied" : "URL copied");
        } catch (_) {
          prompt("Copy", text);
        }
      });
    });

    // Keyboard nav: ArrowLeft (prev = newer), ArrowRight (next = older)
    document.addEventListener("keydown", function (e) {
      if (e.target && /^(input|textarea|select)$/i.test(e.target.tagName)) return;
      if (e.key === "ArrowLeft") {
        var p = document.querySelector(".ed-pn-card.prev");
        if (p && p instanceof HTMLAnchorElement) { e.preventDefault(); location.href = p.href; }
      } else if (e.key === "ArrowRight") {
        var n = document.querySelector(".ed-pn-card.next");
        if (n && n instanceof HTMLAnchorElement) { e.preventDefault(); location.href = n.href; }
      }
    });

    // TOC active section highlight
    var tocLinks = document.querySelectorAll("#toc-list a[data-toc-target]");
    if (tocLinks.length) {
      var paras = Array.from(tocLinks).map(function (a) {
        return document.getElementById(a.getAttribute("data-toc-target"));
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            tocLinks.forEach(function (a) { a.classList.remove("active"); });
            var match = document.querySelector('#toc-list a[data-toc-target="' + en.target.id + '"]');
            if (match) match.classList.add("active");
          }
        });
      }, { rootMargin: "-30% 0px -55% 0px", threshold: 0 });
      paras.forEach(function (p) { if (p) io.observe(p); });
    }
  })();
</script>

