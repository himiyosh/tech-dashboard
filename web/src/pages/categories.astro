---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import LanguageFallbackBadge from "../components/LanguageFallbackBadge.astro";
import {
  ARXIV_ENTRIES,
  MAIN_TIMELINE_ENTRIES,
  RESEARCH_ENTRIES,
  CATEGORY_META,
  countByCategory,
  entriesFor,
  relativeTime,
  titleForLangWithFallback,
  type Category,
  type CategoryGroup,
  type NormalizedEntry,
} from "../lib/data.ts";
import { categoryDailySpark, STATS } from "../lib/stats.ts";

const now = new Date();
const counts = countByCategory();

const GROUP_LABEL: Record<CategoryGroup, string> = {
  microsoft: "Microsoft / GitHub",
  anthropic: "Anthropic",
  openai: "OpenAI",
  google: "Google",
  "coding-tools": "AI Coding Tools",
  "open-models": "Local & Open Models",
  "agent-tools": "Agent Tools & Protocols",
  research: "Research & Benchmarks",
  industry: "Industry & Policy",
};

const GROUP_COPY: Record<CategoryGroup, string> = {
  microsoft: "GitHub Copilot、VS Code、Microsoft 系の開発者向け更新をまとめます。",
  anthropic: "Claude、Claude Code、Anthropic API / research の動きを追います。",
  openai: "OpenAI、Codex、ChatGPT、API / agent 関連の更新をまとめます。",
  google: "Gemini、Gemma、Vertex AI、DeepMind、Google Developers AI を整理します。",
  "coding-tools": "Cursor、Zed、Cline、Aider、OpenHands など AI coding tool をまとめます。",
  "open-models": "Ollama、Hugging Face、open models、local inference の更新です。",
  "agent-tools": "MCP、LangChain、AutoGen、Semantic Kernel など agent tooling を扱います。",
  research: "論文、benchmark、DORA など評価・研究・長期知見をまとめます。",
  industry: "AI 業界、cloud / GPU、市場、政策、security incident など横断ニュースです。",
};

const GROUP_ORDER: CategoryGroup[] = [
  "microsoft",
  "anthropic",
  "openai",
  "google",
  "coding-tools",
  "open-models",
  "agent-tools",
  "research",
  "industry",
];

const TYPE_LABEL: Record<NormalizedEntry["sourceType"], string> = {
  blog: "Blog",
  release: "Release",
  changelog: "Changelog",
  paper: "Paper",
  community: "Community",
};

const entryTime = (entry: NormalizedEntry): number => Date.parse(entry.publishedAt ?? entry.collectedAt ?? "") || 0;
const countLiveDays = (entries: NormalizedEntry[], days: number): number => {
  const cutoff = now.getTime() - days * 86_400_000;
  return entries.filter((entry) => entryTime(entry) >= cutoff).length;
};
const countLivePrevDays = (entries: NormalizedEntry[], days: number): number => {
  const end = now.getTime() - days * 86_400_000;
  const start = now.getTime() - days * 2 * 86_400_000;
  return entries.filter((entry) => {
    const time = entryTime(entry);
    return time >= start && time < end;
  }).length;
};

const pctDelta = (current: number, previous: number): number => {
  if (previous === 0) return current > 0 ? 100 : 0;
  return Math.round(((current - previous) / previous) * 100);
};

const categoryPanels = CATEGORY_META.map((cat) => {
  const entries = entriesFor(cat.slug);
  const latest = entries[0] ?? null;
  const daily = categoryDailySpark(cat.slug, 30).map((bucket) => ({
    ...bucket,
    label: bucket.key.slice(5), // MM-DD
  }));
  const last7 = countLiveDays(entries, 7);
  const prev7 = countLivePrevDays(entries, 7);
  const last30 = countLiveDays(entries, 30);
  const sourceCount = new Set(entries.map((entry) => entry.source)).size;
  const types = new Map<NormalizedEntry["sourceType"], number>();
  for (const entry of entries) {
    types.set(entry.sourceType, (types.get(entry.sourceType) ?? 0) + 1);
  }
  const topTypes = [...types.entries()]
    .sort(([, a], [, b]) => b - a)
    .slice(0, 3)
    .map(([type, count]) => ({ type, label: TYPE_LABEL[type], count }));
  return {
    ...cat,
    liveCount: counts[cat.slug] ?? 0,
    last7,
    last30,
    sourceCount,
    delta: pctDelta(last7, prev7),
    latest,
    latestTitleJa: latest ? titleForLangWithFallback(latest, "ja") : null,
    latestTitleEn: latest ? titleForLangWithFallback(latest, "en") : null,
    daily,
    topTypes,
  };
});

// Categories hero total must equal the categories this page lists (the news
// Timeline = sidebar total), not the all-lanes count. Using ALL_ENTRIES here
// made the hero (1740) contradict the per-category sums (1660). LL data-trust.
const totalLiveEntries = MAIN_TIMELINE_ENTRIES.length;
const topCategory = [...categoryPanels].sort((a, b) => b.liveCount - a.liveCount)[0] ?? null;
const activeCategories = categoryPanels.filter((panel) => panel.last30 > 0).length;
const researchPanel = categoryPanels.find((panel) => panel.slug === "research");
const techNewsPanel = categoryPanels.find((panel) => panel.slug === "tech-news");
const researchLaneCounts = {
  curated: RESEARCH_ENTRIES.length,
  arxiv: ARXIV_ENTRIES.length,
} as const;

// Compact directory: a flat A→Z list so the order is predictable (not the
// vendor-group authoring order, which read as "scattered").
const directoryPanels = [...categoryPanels].sort((a, b) => a.name.localeCompare(b.name));

// Detailed cards keep the ecosystem grouping (LL-057) but everything is now
// alphabetical: groups by label A→Z, categories within each group A→Z.
const grouped = new Map<CategoryGroup, typeof categoryPanels>(
  [...GROUP_ORDER]
    .sort((a, b) => GROUP_LABEL[a].localeCompare(GROUP_LABEL[b]))
    .map((group) => [
      group,
      categoryPanels
        .filter((cat) => cat.group === group)
        .sort((a, b) => a.name.localeCompare(b.name)),
    ]),
);
---

<Portal pageKey="categories" title="Categories — TECH Dashboard" breadcrumb={[{ label: "Home", href: "/" }, { label: "Categories" }]}>
  <PageHero
    className="page-hero-top-level page-hero-categories"
    kicker="Explore by category"
    title="Categories"
    count={`${CATEGORY_META.length} categories`}
    headingId="categories-heading"
    description="カテゴリごとの記事量、直近の勢い、過去 30 日の推移を比較できます。伸びている領域を見つけたら、そのままカテゴリ詳細へ移動できます。"
    actions={[
      {
        href: "#category-directory",
        label: "カテゴリ一覧を見る",
        labelEn: "Browse the category list",
        mobilePriority: true,
      },
      { href: topCategory ? `/c/${topCategory.slug}` : "#category-groups", label: "Hot category" },
      { href: "/status", label: "Check source health" },
    ]}
    metrics={[
      {
        label: "Live entries",
        value: totalLiveEntries,
        detail: "現在の Timeline",
        detailEn: "Current Timeline",
        scope: "timeline-live",
      },
      {
        label: "Active cats",
        value: activeCategories,
        detail: "過去30日に掲載あり",
        detailEn: "Listed in the last 30 days",
        scope: "active-last-30d",
      },
      {
        label: "Top live cat",
        value: topCategory?.name ?? "none",
        detail: "現在掲載数が最多",
        detailEn: "Most current entries",
        scope: "top-live-category",
      },
      {
        label: "Research live",
        value: researchPanel?.liveCount ?? 0,
        detail: "arXiv専用レーンを除く",
        detailEn: "Excludes the arXiv lane",
        scope: "research-live",
      },
      {
        label: "Tech News live",
        value: techNewsPanel?.liveCount ?? 0,
        detail: "現在のIndustry / Policy",
        detailEn: "Current Industry / Policy",
        scope: "tech-news-live",
      },
      {
        label: "Updated",
        value: relativeTime(STATS.generatedAt, now),
        datetime: STATS.generatedAt,
        detail: "統計snapshot",
        detailEn: "Stats snapshot",
        scope: "stats-snapshot",
      },
    ]}
  />

  <div class="layout categories-layout">
    <Sidebar />

    <main class="categories-main">
      <section id="category-directory" class="category-directory" aria-labelledby="category-directory-heading">
        <div class="category-directory-head">
          <div>
            <span class="category-directory-kicker">Quick directory</span>
            <h2 id="category-directory-heading">
              Jump to category
              <span>{CATEGORY_META.length} categories</span>
            </h2>
          </div>
          <p>
            ここは移動用のミニ目次です。比較や傾向確認は下のカードで行えます。
          </p>
        </div>

        <nav class="category-directory-grid" aria-label="Category quick links">
          {directoryPanels.map((cat) => (
            <a
              href={`/c/${cat.slug}`}
              class="category-directory-item"
              style={`--cat-color:${cat.color}`}
              aria-label={`${cat.name}: ${cat.liveCount} live entries, ${cat.last30} entries in the last 30 days`}
            >
              <span class="category-directory-icon" aria-hidden="true">{cat.emoji}</span>
              <span class="category-directory-text">
                <span class="category-directory-name">{cat.name}</span>
                <span class="category-directory-group-label">{GROUP_LABEL[cat.group]}</span>
              </span>
              <span class="category-directory-count">{cat.liveCount}</span>
            </a>
          ))}
        </nav>
      </section>

      <div id="category-groups"></div>
      {[...grouped.entries()].map(([group, cats]) => (
        <section class="category-group" aria-labelledby={`group-${group}`}>
          <div class="category-group-head">
            <div>
              <h3 id={`group-${group}`}>{GROUP_LABEL[group]}</h3>
              <p>{GROUP_COPY[group]}</p>
            </div>
            <span>{cats.length} categories</span>
          </div>
          <div class="category-grid">
            {cats.map((cat) => {
              const isResearch = cat.slug === "research";
              const CardElement = isResearch ? "article" : "a";
              return (
                <CardElement
                  href={isResearch ? undefined : `/c/${cat.slug}`}
                  class:list={["category-card", isResearch && "category-card-research"]}
                  style={`--cat-color:${cat.color}`}
                  data-category={cat.slug}
                  data-research-overview={isResearch ? "" : undefined}
                >
                  <div class="cat-head">
                    <span class="cat-icon" aria-hidden="true">{cat.emoji}</span>
                    <div class="cat-title-block">
                      <span class="cat-name">{cat.name}</span>
                      <span class="cat-group-label">{GROUP_LABEL[cat.group]}</span>
                    </div>
                    {!isResearch && <span class="cat-count">{cat.liveCount}</span>}
                  </div>

                  {isResearch ? (
                    <div
                      class="cat-metrics cat-metrics-research"
                      data-lane-scope="curated-research"
                      aria-label="Curated Research activity, excluding arXiv papers"
                    >
                      <small class="research-curated-scope">
                        <span class="i18n-ja">キュレーション Research の動向</span>
                        <span class="i18n-en" lang="en">Curated Research activity</span>
                      </small>
                      <span><strong>{cat.last30}</strong> live 30d</span>
                      <span><strong>{cat.sourceCount}</strong> sources</span>
                      <span class:list={["cat-delta", cat.delta > 0 ? "up" : cat.delta < 0 ? "down" : "flat"]}>
                        {cat.delta > 0 ? "+" : ""}{cat.delta}% 7d
                      </span>
                    </div>
                  ) : (
                    <div class="cat-metrics">
                      <span><strong>{cat.liveCount}</strong> live</span>
                      <span><strong>{cat.last30}</strong> live 30d</span>
                      <span><strong>{cat.sourceCount}</strong> sources</span>
                      <span class:list={["cat-delta", cat.delta > 0 ? "up" : cat.delta < 0 ? "down" : "flat"]}>
                        {cat.delta > 0 ? "+" : ""}{cat.delta}% 7d
                      </span>
                    </div>
                  )}

                  <div
                    class="cat-trend"
                    role="img"
                    aria-label={isResearch
                      ? "Curated Research article trend for the last 30 days, excluding arXiv papers"
                      : `${cat.name} article trend for the last 30 days`}
                  >
                    {cat.daily.map((bucket) => (
                      <span class="cat-bar" title={`${bucket.key}: ${bucket.count}`}>
                        <i style={`height:${bucket.height}%`}></i>
                      </span>
                    ))}
                  </div>

                  <div class="cat-axis" aria-hidden="true">
                    <span>{cat.daily[0]?.label}</span>
                    <span>{cat.daily.at(-1)?.label}</span>
                  </div>

                  {!isResearch && cat.latest && cat.latestTitleJa && cat.latestTitleEn && (
                    <div class="cat-latest">
                      <span>Latest</span>
                      <strong class="i18n-ja" lang={cat.latestTitleJa.fallbackLang ?? "ja"}>
                        {cat.latestTitleJa.isFallback && cat.latestTitleJa.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={cat.latestTitleJa.fallbackLang} variant="title" />
                        )}
                        {cat.latestTitleJa.text}
                      </strong>
                      <strong class="i18n-en" lang={cat.latestTitleEn.fallbackLang ?? "en"}>
                        {cat.latestTitleEn.isFallback && cat.latestTitleEn.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={cat.latestTitleEn.fallbackLang} variant="title" />
                        )}
                        {cat.latestTitleEn.text}
                      </strong>
                    </div>
                  )}

                  <table class="sr-only">
                    <caption>{cat.name} daily article counts (last 30 days)</caption>
                    <thead>
                      <tr><th scope="col">Date</th><th scope="col">Count</th></tr>
                    </thead>
                    <tbody>
                      {cat.daily.map((bucket) => (
                        <tr><td>{bucket.key}</td><td>{bucket.count}</td></tr>
                      ))}
                    </tbody>
                  </table>

                  {isResearch ? (
                    <ul class="research-lane-actions" role="list">
                      <li>
                        <a
                          href="/c/research/"
                          class="research-lane-link"
                          data-research-lane="curated"
                          data-entry-count={researchLaneCounts.curated}
                        >
                          <span class="research-lane-copy">
                            <strong>
                              <span class="i18n-ja">Research</span>
                              <span class="i18n-en" lang="en">Curated Research</span>
                            </strong>
                            <small>
                              <span class="i18n-ja">arXivを除く選定記事</span>
                              <span class="i18n-en" lang="en">Selected entries, excluding arXiv</span>
                            </small>
                          </span>
                          <span class="research-lane-count">
                            <strong>{researchLaneCounts.curated}</strong>
                            <small>
                              <span class="i18n-ja">記事</span>
                              <span class="i18n-en" lang="en">entries</span>
                            </small>
                          </span>
                        </a>
                      </li>
                      <li>
                        <a
                          href="/arxiv/"
                          class="research-lane-link"
                          data-research-lane="arxiv"
                          data-entry-count={researchLaneCounts.arxiv}
                        >
                          <span class="research-lane-copy">
                            <strong>
                              <span class="i18n-ja">arXiv 論文</span>
                              <span class="i18n-en" lang="en">arXiv papers</span>
                            </strong>
                            <small>
                              <span class="i18n-ja">専用レーン</span>
                              <span class="i18n-en" lang="en">Dedicated paper lane</span>
                            </small>
                          </span>
                          <span class="research-lane-count">
                            <strong>{researchLaneCounts.arxiv}</strong>
                            <small>
                              <span class="i18n-ja">件</span>
                              <span class="i18n-en" lang="en">papers</span>
                            </small>
                          </span>
                        </a>
                      </li>
                    </ul>
                  ) : (
                    <div class="cat-footer">
                      <div class="cat-meta">
                        {cat.latest ? (
                          <>
                            最終更新{" "}
                            <time datetime={cat.latest.publishedAt} data-relative-time>
                              {relativeTime(cat.latest.publishedAt, now)}
                            </time>
                          </>
                        ) : "エントリなし"}
                      </div>
                      <div
                        class="cat-types"
                        data-type-scope="category-live-entries"
                        aria-label={`${cat.name} current live entries by source type`}
                      >
                        <small class="cat-types-scope">
                          <span class="i18n-ja">Live内訳</span>
                          <span class="i18n-en" lang="en">Live mix</span>
                        </small>
                        {cat.topTypes.map((type) => (
                          <span class="cat-type">{type.label} {type.count}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </CardElement>
              );
            })}
          </div>
        </section>
      ))}
    </main>
  </div>
</Portal>

<style>
  .categories-main {
    min-width: 0;
  }

  .category-directory {
    position: static;
    padding: 12px;
    margin-bottom: 18px;
    border: 1px solid color-mix(in srgb, var(--border) 86%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 94%, transparent), color-mix(in srgb, var(--surface) 84%, transparent)),
      color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px);
  }

  .category-directory-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }

  .category-directory-kicker {
    display: block;
    margin-bottom: 3px;
    color: var(--accent);
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .category-directory h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    color: var(--text);
    font-size: 14px;
    letter-spacing: 0;
  }

  .category-directory h2 span {
    color: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
  }

  .category-directory-head p {
    max-width: 360px;
    margin: 0;
    color: var(--muted);
    font-size: 11.5px;
    line-height: 1.45;
  }

  .category-directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(218px, 1fr));
    gap: 8px;
  }

  .category-directory-item {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
    border-radius: 6px;
    color: var(--text-2);
    background: color-mix(in srgb, var(--bg-2) 66%, transparent);
  }

  .category-directory-item:hover,
  .category-directory-item:focus-visible {
    border-color: color-mix(in srgb, var(--cat-color) 58%, var(--border));
    color: var(--text);
    outline: 0;
  }

  .category-directory-icon {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-size: 15px;
    line-height: 1;
    background: color-mix(in srgb, var(--cat-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
  }

  .category-directory-text {
    min-width: 0;
  }

  .category-directory-name,
  .category-directory-group-label {
    display: block;
  }

  .category-directory-name {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .category-directory-group-label {
    color: var(--muted);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    margin-top: 3px;
    text-transform: uppercase;
  }

  .category-directory-count {
    align-self: start;
    min-width: 22px;
    padding: 2px 5px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--cat-color) 16%, transparent);
    color: var(--text);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 700;
    text-align: center;
  }

  .cat-group-label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-group {
    margin-bottom: 26px;
  }

  .category-group-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 12px;
  }

  .category-group-head h3 {
    margin: 0 0 4px 4px;
    color: var(--text-subtle);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-group-head p {
    margin: 0 0 0 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .category-group-head > span {
    color: var(--muted-2);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    white-space: nowrap;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px;
  }

  .category-card {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 5px;
    padding: 8px 9px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cat-color) 10%, transparent), transparent 42%),
      var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  a.category-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 62%, var(--border));
    transform: translateY(-1px);
  }

  .category-card-research:focus-within {
    border-color: color-mix(in srgb, var(--cat-color) 62%, var(--border));
  }

  .cat-head {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .cat-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-top: 0;
    border-radius: 8px;
    flex: 0 0 auto;
    font-size: 17px;
    line-height: 1;
    background: color-mix(in srgb, var(--cat-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
  }

  .cat-title-block {
    min-width: 0;
    flex: 1;
  }

  .cat-name {
    display: block;
    overflow: hidden;
    color: var(--text);
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-count {
    color: var(--text);
    font-size: 16px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cat-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cat-metrics span {
    min-width: auto;
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-2) 62%, transparent);
    color: var(--muted);
    font-size: 10px;
    line-height: 1.25;
  }

  .cat-metrics strong {
    color: var(--text);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .cat-metrics-research {
    align-items: center;
