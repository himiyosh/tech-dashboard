          ) : <span class="ed-pn-empty" aria-hidden="true"></span>}
          {next ? (
            <a class="ed-pn-card next" href={`/e/${next.id}/`} accesskey="ArrowRight">
              <span class="ed-pn-body">
                <span class="ed-pn-dir">
                  <span class="i18n-ja">古い記事</span>
