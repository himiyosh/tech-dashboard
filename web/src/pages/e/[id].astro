          <div class="ed-rel-grid">
            {sameCategory.map((r) => {
              const rTitle = titleForLang(r, "ja") || titleForLang(r, "en") || r.title;
              const rSum = summaryForLang(r, "ja") || summaryForLang(r, "en");
              const rMeta = CATEGORY_META.find((c) => c.slug === r.category);
              const rColor = rMeta?.color ?? catColor;
              return (
                <a class="ed-rel-card" href={`/e/${r.id}/`} style={`--cat-color:${rColor}`}>
