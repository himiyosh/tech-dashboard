---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  GENERATED_AT,
  WORKER_HEALTH,
  relativeTime,
  type Category,
  type NormalizedEntry,
} from "../lib/data.ts";
import { sourceFreshnessStatus, type FreshnessSourceType } from "../lib/freshness.ts";
import { SOURCE_META, sourceAnchorId, sourceLabel } from "../lib/source-meta.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { deriveQueueDisplay } from "../lib/queue-health.ts";
import { deriveWorkerRunStatus } from "../lib/run-health.ts";

const now = new Date();
type SourceActivityStatus = "recent" | "low-activity" | "long-inactive" | "not-listed";
type SourceRow = {
  id: string;
  anchorId: string;
  displayName: string;
  category: Category;
  categoryName: string;
  categoryColor: string;
  tier: number;
  count: number;
  latestRelative: string;
  latestTitle: string | null;
  latestUrl: string | null;
  sourceType: NormalizedEntry["sourceType"];
  sourceTypeLabel: string;
  status: SourceActivityStatus;
  statusJa: string;
  statusEn: string;
  reasonJa: string;
  reasonEn: string;
};

const TYPE_LABEL: Record<NormalizedEntry["sourceType"], string> = {
  blog: "Blog",
  release: "Release",
  changelog: "Changelog",
  paper: "Paper",
  community: "Community",
};

const SOURCE_STATUS_COPY: Record<SourceActivityStatus, { ja: string; en: string }> = {
  recent: { ja: "最近掲載あり", en: "Recently listed" },
  "low-activity": { ja: "低活動", en: "Low activity" },
  "long-inactive": { ja: "長期非掲載", en: "Long inactive" },
  "not-listed": { ja: "未収録", en: "Not listed" },
};

const categoryBySlug = new Map(CATEGORY_META.map((category) => [category.slug, category]));

const sources: SourceRow[] = SOURCE_META.map((def) => {
  const fromSource = ALL_ENTRIES.filter((e) => e.source === def.id);
  const latestEntry = fromSource.reduce<NormalizedEntry | null>((acc, entry) => {
    const entryAt = entry.collectedAt ?? entry.publishedAt;
    const accAt = acc ? (acc.collectedAt ?? acc.publishedAt) : "1970-01-01T00:00:00Z";
    return entryAt && entryAt > accAt ? entry : acc;
  }, null);
  const latestCollected = fromSource.reduce(
    (acc, e) => {
      const collectedAt = e.collectedAt ?? e.publishedAt;
      return collectedAt && collectedAt > acc ? collectedAt : acc;
    },
    "1970-01-01T00:00:00Z",
  );
  const sourceType = latestEntry?.sourceType ?? fromSource[0]?.sourceType ?? "blog";
  const freshness = sourceFreshnessStatus(
    { category: def.category, sourceType: sourceType as FreshnessSourceType },
    fromSource.length === 0 ? undefined : latestCollected,
    now.getTime(),
  );
  const status: SourceActivityStatus = fromSource.length === 0
    ? "not-listed"
    : freshness.status === "ok"
      ? "recent"
      : freshness.status === "stale"
        ? "low-activity"
        : "long-inactive";
  const latestRelative = fromSource.length === 0 ? "n/a" : relativeTime(latestCollected, now);
  const reasonJa = fromSource.length === 0
    ? "現在の掲載記事がないため、掲載アクティビティを判定できません。"
    : status === "recent"
      ? `このサイトで最後に掲載した記事は ${latestRelative} です。`
      : status === "low-activity"
        ? `最後の掲載は ${latestRelative}。掲載間隔が長めですが、直近 batch の収集エラーとは別の指標です。`
        : `最後の掲載は ${latestRelative}。長期間掲載がありませんが、収集障害を意味するものではありません。`;
  const reasonEn = fromSource.length === 0
    ? "No listed entry is available, so publication activity cannot be evaluated."
    : status === "recent"
      ? `The latest article listed on this site was ${latestRelative}.`
      : status === "low-activity"
        ? `Last listed ${latestRelative}. Activity is low, but this is separate from latest-batch collection errors.`
        : `Last listed ${latestRelative}. No recent article is listed, but this does not by itself indicate a collection failure.`;
  const category = def.category as Category;
  const categoryMeta = categoryBySlug.get(category);
  return {
    id: def.id,
    anchorId: sourceAnchorId(def.id),
    displayName: def.displayName,
    category,
    categoryName: categoryMeta?.name ?? def.category,
    categoryColor: categoryMeta?.color ?? "var(--accent)",
    tier: def.tier,
    count: fromSource.length,
    latestRelative,
    latestTitle: latestEntry?.titleJa || latestEntry?.title || null,
    latestUrl: latestEntry?.url ?? null,
    sourceType,
    sourceTypeLabel: TYPE_LABEL[sourceType],
    status,
    statusJa: SOURCE_STATUS_COPY[status].ja,
    statusEn: SOURCE_STATUS_COPY[status].en,
    reasonJa,
    reasonEn,
  };
});

const recent = sources.filter((s) => s.status === "recent").length;
const lowActivity = sources.filter((s) => s.status === "low-activity").length;
const longInactive = sources.filter((s) => s.status === "long-inactive").length;
const notListed = sources.filter((s) => s.status === "not-listed").length;
const limitedListingSourceCount = lowActivity + longInactive + notListed;
const defaultSourceFilter = limitedListingSourceCount > 0 ? "limited" : "all";
const initialVisibleSourceCount =
  defaultSourceFilter === "limited" ? limitedListingSourceCount : sources.length;
const evaluatedSourceCount = recent + lowActivity + longInactive;
const statusOrder = { recent: 0, "low-activity": 1, "long-inactive": 2, "not-listed": 3 } as const;
const sortedSources = [...sources].sort(
  (a, b) =>
    statusOrder[a.status] - statusOrder[b.status] ||
    a.tier - b.tier ||
    a.displayName.localeCompare(b.displayName),
);
const recentActivityPct = evaluatedSourceCount > 0 ? Math.round((recent / evaluatedSourceCount) * 100) : 0;
const indexAgeLabel = relativeTime(GENERATED_AT, now);
const pendingSummaryEntries = DASHBOARD_METRICS.fallbackEntries;
const pendingSummaryPercent = DASHBOARD_METRICS.fallbackPercent;
const wh = WORKER_HEALTH;
const collectionFailureIds = new Set(wh?.sourcesFailed ?? []);
const sourceById = new Map(sources.map((source) => [source.id, source]));
const collectionFailureSources = [...collectionFailureIds].map((id) => ({
  id,
  displayName: sourceById.get(id)?.displayName ?? sourceLabel(id),
}));
const collectionFailureCount = wh === null ? null : wh.sourcesFailed.length;
const workerRun = deriveWorkerRunStatus({
  workerHealth: wh,
  nowMs: now.getTime(),
  fallbackPercent: pendingSummaryPercent,
  pendingSummaryEntries,
});
const summaryQueueBacklog = DASHBOARD_METRICS.summaryQueueBacklog;
const summaryQueue = deriveQueueDisplay({
  mode: DASHBOARD_METRICS.summaryQueueMode,
  backlog: summaryQueueBacklog,
  drainEstimateHours: DASHBOARD_METRICS.summaryQueueDrainEstimateHours,
  runTone: workerRun.tone,
  runState: workerRun.state,
});
const bodyQueueBacklog = DASHBOARD_METRICS.bodyQueueBacklog;
const bodyQueue = deriveQueueDisplay({
  mode: DASHBOARD_METRICS.bodyQueueMode,
  backlog: bodyQueueBacklog,
  drainEstimateHours: DASHBOARD_METRICS.bodyQueueDrainEstimateHours,
  runTone: workerRun.tone,
  runState: workerRun.state,
});
const enrichmentEnqueueCap = DASHBOARD_METRICS.enrichmentEnqueueCap;
const enrichmentEnqueued = DASHBOARD_METRICS.enrichmentEnqueued;
const hasEnrichmentBudgetTelemetry = enrichmentEnqueueCap !== null && enrichmentEnqueued !== null;
const enrichmentBudgetLabel = hasEnrichmentBudgetTelemetry
  ? `${enrichmentEnqueued}/${enrichmentEnqueueCap}`
  : null;
const summaryQueueEnqueued = DASHBOARD_METRICS.summaryQueueEnqueued;
const bodyQueueEnqueued = DASHBOARD_METRICS.bodyQueueEnqueued;
const bodyQueueMerged = DASHBOARD_METRICS.bodyQueueMerged;
const categoryRows = CATEGORY_META.map((category) => {
    const rows = sources.filter((source) => source.category === category.slug);
    return {
      ...category,
      total: rows.length,
      recent: rows.filter((source) => source.status === "recent").length,
      lowActivity: rows.filter((source) => source.status === "low-activity").length,
      longInactive: rows.filter((source) => source.status === "long-inactive").length,
      notListed: rows.filter((source) => source.status === "not-listed").length,
    };
  })
  .filter((row) => row.total > 0)
  .sort((a, b) => b.longInactive - a.longInactive || b.lowActivity - a.lowActivity || b.total - a.total)
  .slice(0, 8);
const sourceCategoryRows = CATEGORY_META.map((category) => {
  const rows = sources.filter((source) => source.category === category.slug);
  return { ...category, total: rows.length };
}).filter((row) => row.total > 0);

const workerStatus = workerRun.tone;
const workerColor =
  workerStatus === "ok" ? "var(--success)" : workerStatus === "warn" ? "var(--important)" : "var(--danger)";
const workerStatusText = workerRun.stateText;
const overallStatus = workerStatus;
const overallColor =
  overallStatus === "ok" ? "var(--success)" : overallStatus === "warn" ? "var(--important)" : "var(--danger)";
const workerSummary = wh
  ? {
      ja: `直近バッチ ${wh.batchIndex}/${wh.batchTotal} · 収集成功 ${wh.sourcesOk}/${wh.sourcesAttempted} · 新規要約 ${wh.summarized}件 · 要約待ち ${pendingSummaryEntries}件`,
      en: `Latest batch ${wh.batchIndex}/${wh.batchTotal} · ${wh.sourcesOk}/${wh.sourcesAttempted} sources collected · ${wh.summarized} new summaries · ${pendingSummaryEntries} pending`,
    }
  : {
      ja: "このデータには収集状況の記録がありません。",
      en: "Collection health metadata is not available in this data snapshot.",
    };
const workerStateCopy = {
  healthy: { ja: "正常稼働", en: "Running normally" },
  missing: { ja: "稼働記録なし", en: "Run telemetry unavailable" },
  late: { ja: "定期収集が遅延", en: "Scheduled collection delayed" },
  failed: { ja: "直近バッチが失敗", en: "Latest batch failed" },
  degraded: { ja: "一部確認が必要", en: "Review recommended" },
} as const;
---

<Portal pageKey="status" title="Status — TECH Dashboard">
  <PageHero
    className={`page-hero-top-level page-hero-status page-hero-status-${overallStatus}`}
    accent={overallColor}
    kicker="Status & Sources"
    title="Status"
    headingId="status-heading"
    description="収集、AI要約、AI解説本文、サイト更新の状態を分けて確認できます。公開ページが新しくても、収集や生成の遅れは隠しません。"
    descriptionEn="Check collection, AI summaries, AI explainer bodies, and the latest site update separately. A recently published page does not hide delayed collection or enrichment."
    actions={[
      { href: "#worker-health-heading", label: "稼働状況", labelEn: "Collection health" },
      { href: "#source-health-heading", label: "掲載アクティビティ", labelEn: "Publication activity" },
      { href: "/archive", label: "アーカイブ", labelEn: "Open archive" },
    ]}
    metrics={[
      {
        label: "稼働状態",
        labelEn: "Run status",
        value: workerStatusText,
        detail: "公開snapshotの直近run",
        detailEn: "Latest run in this snapshot",
        scope: "run-status",
      },
      {
        label: "収集エラー",
        labelEn: "Collection errors",
        value: collectionFailureCount ?? "n/a",
        detail: "直近1バッチ",
        detailEn: "Latest batch",
        scope: "latest-batch-errors",
      },
      {
        label: "要約待ち",
        labelEn: "Summaries pending",
        value: pendingSummaryEntries,
        detail: "現在のlive index",
        detailEn: "Current live index",
        scope: "summary-backlog",
      },
      {
        label: "本文待ち",
        labelEn: "Bodies pending",
        value: bodyQueue.showBacklog ? bodyQueue.backlog : "n/a",
        detail: "本文保持対象Queue",
        detailEn: "Retention-eligible body queue",
        scope: "body-backlog",
      },
      {
        label: "直近収集",
        labelEn: "Latest collection",
        value: wh ? `${wh.sourcesOk}/${wh.sourcesAttempted}` : "n/a",
        detail: "今回バッチのsource",
        detailEn: "Sources in the latest batch",
        scope: "latest-batch-sources",
      },
      {
        label: "サイト更新",
        labelEn: "Site updated",
        value: indexAgeLabel,
        detail: "公開index snapshot",
        detailEn: "Published index snapshot",
        scope: "published-snapshot",
      },
    ]}
  />

  <div class="layout status-layout">
    <Sidebar />

    <main class="status-main">
      <section
        class={`status-hero status-hero-${overallStatus}`}
        data-run-status={workerStatus}
        data-run-state={workerRun.state}
        aria-labelledby="worker-health-heading"
        aria-describedby="worker-health-summary"
      >
        <div class="status-hero-copy">
          <div class="status-kicker">
            <span class="status-dot" style={`background:${workerColor}`}></span>
            <span>RUN {workerStatusText}</span>
            <span class="i18n-ja">{workerStateCopy[workerRun.state].ja}</span>
            <span class="i18n-en" lang="en">{workerStateCopy[workerRun.state].en}</span>
          </div>
          <div class="section-header primary status-title-row">
            <h2 id="worker-health-heading">
              <span class="i18n-ja">収集と生成処理の稼働状況</span>
              <span class="i18n-en" lang="en">Collection and enrichment health</span>
              <span class="count">
                <span class="i18n-ja">分割収集 · 定期実行</span>
                <span class="i18n-en" lang="en">rotating batches · scheduled runs</span>
              </span>
            </h2>
          </div>
          <p id="worker-health-summary">
            <span class="i18n-ja">{workerSummary.ja}</span>
            <span class="i18n-en" lang="en">{workerSummary.en}</span>
          </p>
        </div>

        <div class="status-hero-grid" aria-label="Operational status scopes">
          <div class="status-metric-card" data-health-scope="collection-run">
            <span>
              <span class="i18n-ja">最終収集</span>
              <span class="i18n-en" lang="en">Last collection</span>
            </span>
            <strong>{wh ? relativeTime(wh.lastRunAt, now) : "n/a"}</strong>
            <small>
              <span class="i18n-ja">収集処理が最後に動いた時刻</span>
              <span class="i18n-en" lang="en">last completed collection run</span>
            </small>
          </div>
          <div class="status-metric-card" data-health-scope="latest-batch">
            <span>
              <span class="i18n-ja">今回の収集元</span>
              <span class="i18n-en" lang="en">Sources checked</span>
            </span>
            <strong>{wh ? `${wh.sourcesOk}/${wh.sourcesAttempted}` : "n/a"}</strong>
            <small>
              {wh ? (
                <>
                  <span class="i18n-ja">分割 {wh.batchIndex}/{wh.batchTotal} · 登録 {sources.length}件</span>
                  <span class="i18n-en" lang="en">batch {wh.batchIndex}/{wh.batchTotal} · {sources.length} registered sources</span>
                </>
              ) : (
                <>
                  <span class="i18n-ja">収集記録なし</span>
                  <span class="i18n-en" lang="en">collection details unavailable</span>
                </>
              )}
            </small>
          </div>
          <div
            class:list={[
              "status-metric-card",
              {
                warn: summaryQueue.tone === "warn",
                ok: summaryQueue.tone === "ok",
                err: summaryQueue.tone === "err",
              },
            ]}
            data-health-scope="summary-queue"
            data-health-domain="summary-queue"
            data-health-tone={summaryQueue.tone}
            data-summary-queue-mode={summaryQueue.mode}
            data-summary-queue-state={summaryQueue.state}
            data-summary-queue-backlog={summaryQueue.showBacklog ? summaryQueue.backlog : "unknown"}
          >
            <span>
              <span class="i18n-ja">AI要約 Queue</span>
              <span class="i18n-en" lang="en">AI summary queue</span>
            </span>
            <strong>{summaryQueue.showBacklog ? summaryQueue.backlog : "n/a"}</strong>
            <small>
              <span class="i18n-ja">
                {summaryQueue.mode !== "enabled" || summaryQueueEnqueued === null
                  ? ""
                  : `直近送信 +${summaryQueueEnqueued} · `}
                {summaryQueue.labelJa}
              </span>
              <span class="i18n-en" lang="en">
                {summaryQueue.mode !== "enabled" || summaryQueueEnqueued === null
                  ? ""
                  : `latest enqueue +${summaryQueueEnqueued} · `}
                {summaryQueue.labelEn}
              </span>
            </small>
          </div>
          <div
            class:list={[
              "status-metric-card",
              {
                warn: bodyQueue.tone === "warn",
                ok: bodyQueue.tone === "ok",
                err: bodyQueue.tone === "err",
              },
            ]}
            data-health-scope="body-queue"
            data-health-domain="body-queue"
            data-health-tone={bodyQueue.tone}
            data-body-queue-mode={bodyQueue.mode}
            data-body-queue-state={bodyQueue.state}
            data-body-queue-backlog={bodyQueue.showBacklog ? bodyQueue.backlog : "unknown"}
            data-body-queue-merged={bodyQueueMerged ?? "unknown"}
            data-body-queue-enqueued={bodyQueueEnqueued ?? "unknown"}
          >
            <span>
              <span class="i18n-ja">AI解説本文 Queue</span>
              <span class="i18n-en" lang="en">AI explainer queue</span>
            </span>
            <strong>{bodyQueue.showBacklog ? bodyQueue.backlog : "n/a"}</strong>
            <small>
              <span class="i18n-ja">
                {bodyQueue.mode !== "enabled" || bodyQueueMerged === null ? "" : `本文ファイル反映 +${bodyQueueMerged} · `}
                {bodyQueue.mode !== "enabled" || bodyQueueEnqueued === null ? "" : `送信 +${bodyQueueEnqueued} · `}
                {bodyQueue.labelJa}
              </span>
              <span class="i18n-en" lang="en">
                {bodyQueue.mode !== "enabled" || bodyQueueMerged === null ? "" : `applied to body file +${bodyQueueMerged} · `}
                {bodyQueue.mode !== "enabled" || bodyQueueEnqueued === null ? "" : `enqueued +${bodyQueueEnqueued} · `}
                {bodyQueue.labelEn}
              </span>
            </small>
          </div>
          <div
            class="status-metric-card"
            data-health-scope="enrichment-budget"
            data-health-domain="enrichment"
            data-telemetry-state={hasEnrichmentBudgetTelemetry ? "recorded" : "not-recorded"}
            data-enrichment-enqueue-cap={enrichmentEnqueueCap ?? "unknown"}
            data-enrichment-enqueued={enrichmentEnqueued ?? "unknown"}
          >
            <span>
              <span class="i18n-ja">直近runの生成枠</span>
              <span class="i18n-en" lang="en">Latest-run enrichment slots</span>
            </span>
            <strong>
              {enrichmentBudgetLabel ?? (
                <>
                  <span class="i18n-ja">記録なし</span>
                  <span class="i18n-en" lang="en">Not recorded</span>
                </>
              )}
            </strong>
            <small>
              {hasEnrichmentBudgetTelemetry ? (
                <>
                  <span class="i18n-ja">
                    1 run 上限 {enrichmentEnqueueCap} 件 · 要約 {summaryQueueEnqueued ?? "n/a"} · 本文 {bodyQueueEnqueued ?? "n/a"}
                  </span>
                  <span class="i18n-en" lang="en">
                    max {enrichmentEnqueueCap} per run · summaries {summaryQueueEnqueued ?? "n/a"} · bodies {bodyQueueEnqueued ?? "n/a"}
                  </span>
                </>
              ) : (
                <>
                  <span class="i18n-ja">この公開スナップショットには直近runの共有生成枠が記録されていません。</span>
                  <span class="i18n-en" lang="en">This published snapshot does not include the latest run's shared enrichment budget.</span>
                </>
              )}
            </small>
          </div>
          <div class="status-metric-card" data-health-scope="published-artifact">
            <span>
              <span class="i18n-ja">サイト更新</span>
              <span class="i18n-en" lang="en">Site updated</span>
            </span>
            <strong>{indexAgeLabel}</strong>
            <small>
              <span class="i18n-ja">公開データの最終更新</span>
              <span class="i18n-en" lang="en">latest published data snapshot</span>
            </small>
          </div>
        </div>
      </section>

      {wh ? (
        <section class="status-detail-grid" aria-label="Collection details">
          <div
            data-health-scope="ai-summary-service"
            data-state-source="published-snapshot"
            data-observed-at={wh.lastRunAt}
          >
            <span class="detail-label">
              <span class="i18n-ja">AI要約サービス</span>
              <span class="i18n-en" lang="en">AI summary service</span>
            </span>
            {wh.copilotOk ? (
              <strong class="tone-ok">
                <span class="i18n-ja">前回実行時: 利用可能</span>
                <span class="i18n-en" lang="en">Last run: available</span>
              </strong>
            ) : (
              <strong class="tone-error" title={wh.copilotError ?? ""}>
                <span class="i18n-ja">前回実行時: 要確認</span>
                <span class="i18n-en" lang="en">Last run: needs review</span>
              </strong>
            )}
            <small>
              <span class="i18n-ja">
                公開スナップショット: <time datetime={wh.lastRunAt}>{relativeTime(wh.lastRunAt, now)}</time>
              </span>
              <span class="i18n-en" lang="en">
                Published snapshot: <time datetime={wh.lastRunAt}>{relativeTime(wh.lastRunAt, now)}</time>
              </span>
            </small>
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">要約エラー</span>
              <span class="i18n-en" lang="en">Summary errors</span>
            </span>
            <strong>{wh.summarizeErrors}</strong>
          </div>
          <div>
            <span class="detail-label">
              <span class="i18n-ja">要約待ち</span>
              <span class="i18n-en" lang="en">Summary backlog</span>
            </span>
            <strong class={pendingSummaryEntries > 0 ? "tone-warn" : "tone-ok"}>{pendingSummaryEntries}</strong>
            <small class="summary-ready-copy">
              <span class="i18n-ja">要約済み {DASHBOARD_METRICS.realSummaryEntries} · {summaryQueue.modeLabelJa}</span>
              <span class="i18n-en" lang="en">{DASHBOARD_METRICS.realSummaryEntries} ready · automation {summaryQueue.modeLabelEn}</span>
            </small>
          </div>
          <div class="failed-sources">
            <span class="detail-label">
              <span class="i18n-ja">収集エラー</span>
              <span class="i18n-en" lang="en">Collection errors</span>
            </span>
            {wh.sourcesFailed.length === 0 ? (
              <strong class="tone-ok">
                <span class="i18n-ja">なし</span>
                <span class="i18n-en" lang="en">None</span>
              </strong>
            ) : (
              <strong class="tone-error">{wh.sourcesFailed.map(sourceLabel).join(", ")}</strong>
            )}
          </div>
        </section>
      ) : (
        <p class="status-note">
          <span class="i18n-ja">この公開データには収集状況の記録がありません。次回の収集後に表示されます。</span>
          <span class="i18n-en" lang="en">Collection health is not available in this published snapshot. It will appear after the next run.</span>
        </p>
      )}

      <section class="source-health-panel" aria-labelledby="source-health-heading">
        <div class="section-header primary source-heading-row">
          <h2 id="source-health-heading">
            <span class="i18n-ja">掲載アクティビティ</span>
            <span class="i18n-en" lang="en">Publication activity</span>
            <span class="count">
              <span class="i18n-ja">{sources.length}件</span>
              <span class="i18n-en" lang="en">{sources.length} sources</span>
            </span>
          </h2>
        </div>

        <div class="source-summary-grid" aria-label="Source summary">
          <div class="source-summary-card recent">
            <span>
              <span class="i18n-ja">最近掲載あり</span>
              <span class="i18n-en" lang="en">Recently listed</span>
            </span>
            <strong>{recent}</strong>
          </div>
          <div class="source-summary-card low-activity">
            <span>
              <span class="i18n-ja">低活動</span>
              <span class="i18n-en" lang="en">Low activity</span>
            </span>
            <strong>{lowActivity}</strong>
          </div>
          <div class="source-summary-card long-inactive">
            <span>
              <span class="i18n-ja">長期非掲載</span>
              <span class="i18n-en" lang="en">Long inactive</span>
            </span>
            <strong>{longInactive}</strong>
          </div>
          <div class="source-summary-card not-listed">
            <span>
              <span class="i18n-ja">未収録</span>
              <span class="i18n-en" lang="en">Not listed</span>
            </span>
            <strong>{notListed}</strong>
          </div>
          <div class="source-summary-card">
            <span>
              <span class="i18n-ja">最近掲載あり率</span>
              <span class="i18n-en" lang="en">Recently listed rate</span>
            </span>
            <strong>{recentActivityPct}%</strong>
          </div>
        </div>

        <p class="source-threshold-note">
          <span class="i18n-ja">
            各組の1値目までが「最近掲載あり」、2値目までが「低活動」、超過後が「長期非掲載」です。Blog 42h / 7d、Community 7d / 30d、Release 30d / 120d、Research 14d / 60d。「要確認」は低活動・長期非掲載・未収録をまとめます。
          </span>
          <span class="i18n-en" lang="en">
            The first limit is recently listed, the second is low activity, and older sources are long inactive: Blog 42h / 7d, Community 7d / 30d, Release 30d / 120d, Research 14d / 60d. Needs attention combines low activity, long inactive, and not listed.
          </span>
        </p>

        <div class="status-toolbar" role="group" aria-label="Filter collection sources by status">
          <button
            type="button"
            class:list={["status-filter", { "is-active": defaultSourceFilter === "limited" }]}
            data-source-filter="limited"
            data-source-count={limitedListingSourceCount}
            aria-pressed={defaultSourceFilter === "limited" ? "true" : "false"}
          >
            <span class="i18n-ja">要確認</span><span class="i18n-en" lang="en">Needs attention</span> <span>{limitedListingSourceCount}</span>
          </button>
          <button
            type="button"
            class:list={["status-filter", { "is-active": defaultSourceFilter === "all" }]}
            data-source-filter="all"
            data-source-count={sources.length}
            aria-pressed={defaultSourceFilter === "all" ? "true" : "false"}
          >
            <span class="i18n-ja">すべて</span><span class="i18n-en" lang="en">All</span> <span>{sources.length}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="long-inactive" data-source-count={longInactive} aria-pressed="false">
            <span class="i18n-ja">長期非掲載</span><span class="i18n-en" lang="en">Long inactive</span> <span>{longInactive}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="low-activity" data-source-count={lowActivity} aria-pressed="false">
            <span class="i18n-ja">低活動</span><span class="i18n-en" lang="en">Low activity</span> <span>{lowActivity}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="not-listed" data-source-count={notListed} aria-pressed="false">
            <span class="i18n-ja">未収録</span><span class="i18n-en" lang="en">Not listed</span> <span>{notListed}</span>
          </button>
          <button type="button" class="status-filter" data-source-filter="recent" data-source-count={recent} aria-pressed="false">
            <span class="i18n-ja">最近掲載あり</span><span class="i18n-en" lang="en">Recently listed</span> <span>{recent}</span>
          </button>
        </div>
        <p class="source-filter-summary" id="source-filter-summary" aria-live="polite">
          <span class="i18n-ja">
            <strong data-visible-source-count>{initialVisibleSourceCount}</strong> / {sources.length} ソースを表示
          </span>
          <span class="i18n-en" lang="en">
            Showing <strong data-visible-source-count>{initialVisibleSourceCount}</strong> of {sources.length} sources
          </span>
        </p>

        <div class="category-filter-row" role="group" aria-label="Filter collection sources by category">
          <button type="button" class="category-filter is-active" data-category-filter="all" aria-pressed="true">
            <span class="i18n-ja">全カテゴリ</span>
            <span class="i18n-en" lang="en">All categories</span>
          </button>
          {sourceCategoryRows.map((row) => (
            <button type="button" class="category-filter" style={`--category-color:${row.color}`} data-category-filter={row.slug} aria-pressed="false">
              {row.name}<span>{row.total}</span>
            </button>
          ))}
        </div>

        <div
          class="side-card source-health-list status-source-table"
          id="source-health-list"
          aria-describedby="source-filter-summary"
        >
          {sortedSources.map((s) => (
            <div
              id={s.anchorId}
              class={`source-item source-row-${s.status}`}
              style={`--category-color:${s.categoryColor}`}
              data-source-activity-status={s.status}
              data-source-category={s.category}
              hidden={defaultSourceFilter === "limited" && s.status === "recent"}
            >
              <span class={`status ${s.status}`} aria-hidden="true"></span>
              <span class="name source-name-block">
                <strong>{s.displayName}</strong>
                <span class="source-meta-line">
                  <span class="source-category-chip">{s.categoryName}</span>
                  <span aria-hidden="true">·</span>
                  <span>{s.sourceTypeLabel}</span>
                </span>
                <span class="source-reason-line">
                  <span class="i18n-ja">{s.reasonJa}</span>
                  <span class="i18n-en" lang="en">{s.reasonEn}</span>
                </span>
                <span class="source-latest-line">
                  <span class="i18n-ja">最新記事</span>
                  <span class="i18n-en" lang="en">Latest article</span>
                  {s.latestUrl ? (
                    <a href={s.latestUrl} target="_blank" rel="noopener noreferrer">{s.latestTitle}</a>
                  ) : (
                    <strong>
                      {s.count === 0 ? (
                        <>
                          <span class="i18n-ja">収集済み記事なし</span>
                          <span class="i18n-en" lang="en">No collected entries</span>
                        </>
                      ) : s.latestTitle ?? (
                        <>
                          <span class="i18n-ja">記事情報を確認できません</span>
                          <span class="i18n-en" lang="en">Article details unavailable</span>
                        </>
                      )}
                    </strong>
                  )}
                </span>
              </span>
              <span class={`source-status-badge ${s.status}`}>
                <span class="i18n-ja">{s.statusJa}</span>
                <span class="i18n-en" lang="en">{s.statusEn}</span>
              </span>
              <span class="time source-time-block" data-live-entry-count={s.count}>
                <strong>
                  <span class="i18n-ja">掲載 {s.count}件</span>
                  <span class="i18n-en" lang="en">{s.count} live entries</span>
                </strong>
                <span class="source-latest-age">
                  {s.count === 0 ? (
                    <>
                      <span class="i18n-ja">記事なし</span>
                      <span class="i18n-en" lang="en">No entries</span>
                    </>
                  ) : s.latestRelative}
                </span>
              </span>
            </div>
          ))}
          <div class="source-empty" id="source-empty" hidden>
            <strong>
              <span class="i18n-ja">条件に一致するソースはありません。</span>
              <span class="i18n-en" lang="en">No sources match these filters.</span>
            </strong>
            <span>
              <span class="i18n-ja">状態またはカテゴリの条件を変更してください。</span>
              <span class="i18n-en" lang="en">Try another status or category.</span>
            </span>
          </div>
        </div>

        <p class="status-note compact">
          <span class="i18n-ja">
            ここは収集障害ではなく、このサイトへ最後に記事を掲載した時期を示します。実際の収集エラーは上部の「収集エラー」で確認してください。
          </span>
          <span class="i18n-en" lang="en">
            This section shows when each source last contributed an article to this site, not collection failures. Check “Collection errors” above for actual latest-batch failures.
          </span>
        </p>
      </section>
    </main>

    <aside class="right status-insights">
      <div
        class="side-card status-insight-card status-score-card"
        data-health-scope="publication-activity"
        data-healthy-source-count={recent}
        data-evaluated-source-count={evaluatedSourceCount}
        data-registered-source-count={sources.length}
        data-not-listed-source-count={notListed}
        data-health-percentage={recentActivityPct}
      >
        <h3 class="rail-title">
          <span class="i18n-ja">掲載アクティビティ</span>
          <span class="i18n-en" lang="en">Publication activity</span>
        </h3>
        <div class="status-score">
          <strong>{recentActivityPct}</strong>
          <span>
            <span class="i18n-ja">% 最近掲載</span>
            <span class="i18n-en" lang="en">% recently listed</span>
          </span>
        </div>
        <div class="status-score-bar"><span style={`width:${recentActivityPct}%`}></span></div>
        <p>
          <span class="i18n-ja">登録 {sources.length} ソース。掲載実績を評価できる {evaluatedSourceCount} ソース中 {recent} ソースが通常の掲載間隔内、未収録 {notListed} ソースです。運用障害の割合ではありません。</span>
          <span class="i18n-en" lang="en">{sources.length} registered sources. {recent} of {evaluatedSourceCount} evaluated sources are within their normal listing cadence; {notListed} are not yet listed. This is not an outage rate.</span>
        </p>
      </div>

      <div
        class:list={[
          "side-card",
          "status-insight-card",
          "collection-failure-card",
          {
            unknown: collectionFailureCount === null,
            clear: collectionFailureCount === 0,
            alert: collectionFailureCount !== null && collectionFailureCount > 0,
          },
        ]}
        data-health-scope="collection-failures"
        data-collection-failure-count={collectionFailureCount ?? "unknown"}
        data-collection-telemetry-state={wh ? "available" : "unavailable"}
      >
        <h3 class="rail-title">
          <span class="i18n-ja">直近 batch の収集エラー</span>
          <span class="i18n-en" lang="en">Latest-batch collection errors</span>
        </h3>
        <strong class:list={{
          "tone-ok": collectionFailureCount === 0,
          "tone-error": collectionFailureCount !== null && collectionFailureCount > 0,
        }}>
          {collectionFailureCount === null ? (
            <>
              <span class="i18n-ja">記録なし</span>
              <span class="i18n-en" lang="en">Not recorded</span>
            </>
          ) : collectionFailureCount === 0 ? (
            <>
              <span class="i18n-ja">なし</span>
              <span class="i18n-en" lang="en">None</span>
            </>
          ) : (
            collectionFailureCount
          )}
        </strong>
        {collectionFailureCount === null ? (
          <p>
            <span class="i18n-ja">実行記録がないため、直近 batch の収集結果を確認できません。</span>
            <span class="i18n-en" lang="en">Run telemetry is unavailable, so the latest batch result cannot be confirmed.</span>
          </p>
        ) : collectionFailureSources.length > 0 ? (
          <ul class="collection-failure-list">
            {collectionFailureSources.map((source) => <li>{source.displayName}</li>)}
          </ul>
        ) : (
          <p>
            <span class="i18n-ja">直近の実行では、確認対象の収集元がすべて成功しました。</span>
            <span class="i18n-en" lang="en">Every source checked in the latest run completed successfully.</span>
          </p>
        )}
      </div>

      <div class="side-card status-insight-card">
        <h3 class="rail-title">
          <span class="i18n-ja">主なカテゴリ別状況（最大8件）</span>
          <span class="i18n-en" lang="en">Key category status (up to 8)</span>
        </h3>
        <ul class="category-health-list">
          {categoryRows.map((row) => (
            <li>
              <span>{row.name}</span>
              <small>
                <span class="i18n-ja">{row.recent} 最近掲載 · {row.lowActivity} 低活動 · {row.longInactive} 長期非掲載 · {row.notListed} 未収録</span>
                <span class="i18n-en" lang="en">{row.recent} recent · {row.lowActivity} low activity · {row.longInactive} long inactive · {row.notListed} not listed</span>
              </small>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-card status-insight-card">
        <h3 class="rail-title">
          <span class="i18n-ja">表示の見方</span>
          <span class="i18n-en" lang="en">How to read this page</span>
        </h3>
        <p>
          <span class="i18n-ja">上部は実行結果とQueue、下部は掲載アクティビティです。「低活動」「長期非掲載」は収集エラーではありません。</span>
          <span class="i18n-en" lang="en">The top reports runs and queues; the directory reports listing activity. “Low activity” and “Long inactive” are not collection errors.</span>
        </p>
      </div>
    </aside>
  </div>
</Portal>

<style>
