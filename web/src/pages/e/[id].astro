      </article>

      {/* PREV / NEXT */}
      {(prev || next) && (
        <nav class="ed-pn" aria-labelledby="ed-pn-label">
          <span id="ed-pn-label" class="visually-hidden">
            <span class="i18n-ja">同カテゴリの前後の記事</span>
