        };
        const hitMeta = (d: any, type: SearchResultType): string => {
          const lang = activeSearchLang();
          if (type.className === "article" && d.filters) {
            const parts: string[] = [];
            const source = displaySource(filterValue(d, "source"));
            const category = displayCategory(filterValue(d, "category"));
            const importance = Number(filterValue(d, "importance") || 0);
            const day = filterValue(d, "publishedDay");
            if (source) parts.push(source);
            if (category) parts.push(category);
            if (importance >= 1 && importance <= 3) {
              parts.push(
                lang === "ja"
                  ? `重要度 ${importance === 3 ? "High" : importance === 2 ? "Medium" : "Info"}`
                  : `${importance === 3 ? "High" : importance === 2 ? "Medium" : "Info"} importance`,
              );
