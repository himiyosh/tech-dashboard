---
import Portal from "../../layouts/Portal.astro";
import PageHero from "../../components/PageHero.astro";
import Sidebar from "../../components/Sidebar.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import EntryCard from "../../components/EntryCard.astro";
import Pager from "../../components/Pager.astro";
import TimelineRightRail from "../../components/TimelineRightRail.astro";
import {
  ARXIV_ENTRIES,
  GENERATED_AT,
  MAIN_TIMELINE_ENTRIES,
  PAGE_SIZE,
  groupByDay,
  jstDayLabel,
  relativeTime,
} from "../../lib/data.ts";
import {
  paginationPageNumbers,
  timelinePagePath,
  totalPageCount,
} from "../../lib/route-inventory.ts";

export function getStaticPaths() {
  const total = totalPageCount(MAIN_TIMELINE_ENTRIES.length, PAGE_SIZE);
  return paginationPageNumbers(MAIN_TIMELINE_ENTRIES.length, PAGE_SIZE).map((page) => ({
    params: { page: String(page) },
    props: { page, total },
  }));
}

interface Props {
  page: number;
  total: number;
}

const { page, total } = Astro.props as Props;
const start = (page - 1) * PAGE_SIZE;
const pageEntries = MAIN_TIMELINE_ENTRIES.slice(start, start + PAGE_SIZE);
const dayGroups = groupByDay(pageEntries);
const now = new Date();

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: `Page ${page}` },
];
---

<Portal
  pageKey="timeline"
  title={`Timeline · p.${page} — TECH Dashboard`}
  canonicalPath={timelinePagePath(page)}
  description={`AI 技術アップデートのタイムライン ${page}/${total} ページ目。収録 ${MAIN_TIMELINE_ENTRIES.length} 件のうち ${pageEntries.length} 件を新着順・出典付き AI 要約で掲載します。`}
  descriptionEn={`Page ${page} of ${total} of the TECH Dashboard timeline: ${pageEntries.length} of ${MAIN_TIMELINE_ENTRIES.length} collected updates in recency order with sourced AI summaries.`}
  breadcrumb={breadcrumb}
>
  <PageHero
    className="page-hero-timeline"
    kicker="Timeline archive"
    title="Timeline"
    count={`page ${page}/${total}`}
    headingId="timeline-page-heading"
    description="arXiv 論文を分離した通常更新の記事一覧です。Top items から外れた更新も、日付ごとに追って後から確認できます。"
    actions={[
      { href: "/", label: "Back to latest" },
      { href: "/arxiv", label: "arXiv papers" },
      { href: "/categories", label: "Browse categories" },
      { href: "/archive", label: "Open archive" },
    ]}
    metrics={[
      {
        label: "Showing",
        value: pageEntries.length,
        detail: "このページの件数",
        detailEn: "Entries on this page",
        scope: "timeline-page-count",
      },
      {
        label: "Timeline",
        value: MAIN_TIMELINE_ENTRIES.length,
        detail: "arXivを除く現在一覧",
        detailEn: "Current main Timeline, excluding arXiv",
        scope: "timeline-live",
      },
      {
        label: "Page",
        value: `${page}/${total}`,
        detail: "静的ページ位置",
        detailEn: "Static page position",
        scope: "timeline-page-position",
      },
      {
        label: "Updated",
        value: relativeTime(GENERATED_AT, now),
        datetime: GENERATED_AT,
        detail: "一覧の更新時刻",
        detailEn: "List last updated",
        scope: "timeline-snapshot",
      },
      {
        label: "arXiv lane",
        value: ARXIV_ENTRIES.length,
        detail: "arXiv 論文の掲載数",
        detailEn: "arXiv papers listed",
        scope: "arxiv-live-papers",
      },
    ]}
  />

  <div class="layout">
    <Sidebar active="all" />

    <main data-category-filter-scope>
      <div class="section-header primary">
        <h2>
          Entries
          <span class="count">
            {pageEntries.length} on this page · {MAIN_TIMELINE_ENTRIES.length} timeline ·
            <a href="/arxiv">{ARXIV_ENTRIES.length} arXiv papers on a separate page</a>
          </span>
        </h2>
      </div>

      <CategoryFilter />

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span>{jstDayLabel(key, now)}</span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={page} totalPages={total} baseHref="" />
    </main>

    <TimelineRightRail entries={MAIN_TIMELINE_ENTRIES} now={now} label="Timeline insights" />
  </div>
</Portal>
