---
import Portal from "../layouts/Portal.astro";
import Sidebar from "../components/Sidebar.astro";
import EntryCard from "../components/EntryCard.astro";
import DailySummary from "../components/DailySummary.astro";
import LiveMetrics from "../components/LiveMetrics.astro";
import TickerBar from "../components/TickerBar.astro";
import Pager from "../components/Pager.astro";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { STATS } from "../lib/stats.ts";
import {
  ALL_ENTRIES,
  PAGE_SIZE,
  CATEGORY_META,
  entryHref,
  featured,
  trendingTags,
  relativeTime,
  groupByDay,
  jstDayLabel,
  summaryForLang,
  summaryForLangWithFallback,
  titleForLang,
  titleForLangWithFallback,
} from "../lib/data.ts";

const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(ALL_ENTRIES.length / PAGE_SIZE));
const pageEntries = ALL_ENTRIES.slice(0, PAGE_SIZE);
const dayGroups = groupByDay(pageEntries);

const feat = featured();
const tags = trendingTags(12);

const now = new Date();
const ago = relativeTime(DASHBOARD_METRICS.generatedAt, now);

// Top 3 = importance × recency. Recent importance=3 first, then importance=2.
const rankedPool = ALL_ENTRIES.filter((e) => e.importance >= 2).slice(0, 60);
const topThree = rankedPool
  .map((e) => {
    const ageHours = Math.max(
      0,
      (now.getTime() - new Date(e.publishedAt || e.collectedAt).getTime()) / 3600_000,
    );
    const score = e.importance * 100 - ageHours * 0.6;
    return { entry: e, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ entry }) => entry);
const medals = ["\u{1F947}", "\u{1F948}", "\u{1F949}"];
---

<Portal pageKey="timeline">
  <section class="banner">
    <div class="banner-bg-grid"></div>
    <div class="banner-inner">
      <h1 class="i18n-ja">
        AI の<span class="brand-accent">脈動</span>を、<br />
        ひとつのダッシュボードに。
      </h1>
      <h1 class="i18n-en" lang="en">
        The <span class="brand-accent">pulse</span> of AI,<br />
        on a single dashboard.
      </h1>
      <p class="tagline i18n-ja">
        <strong>Copilot / Claude / Codex / Gemini / Local LLM / Research</strong>
        の公式情報・論文・リリースを 1 時間おきに自動収集。日本語で要約し、重要度でソートして届けます。
      </p>
      <p class="tagline i18n-en" lang="en">
        Official news, papers, and releases from
        <strong>Copilot / Claude / Codex / Gemini / Local LLM / Research</strong>
        collected every hour, summarized, and ranked by importance.
      </p>
    </div>
  </section>

  <TickerBar entries={ALL_ENTRIES} now={now} />

  <section class="stats">
    <div class="stat">
      <span>Today</span>
      <span class="value" data-metric="todayEntries">{DASHBOARD_METRICS.todayEntries}</span>
    </div>
    <div class="stat">
      <span>Total</span>
      <span class="value" data-metric="liveEntries">{DASHBOARD_METRICS.liveEntries}</span>
    </div>
    <div class="stat">
      <span>Major</span>
      <span class="value" data-metric="majorEntries">{DASHBOARD_METRICS.majorEntries}</span>
    </div>
    <div class="stat">
      <span>Active sources</span>
      <span class="value compact-value" data-metric="sourceCoverageLabel">{DASHBOARD_METRICS.sourceCoverageLabel}</span>
    </div>
    <div class="stat">
      <span>Updated</span>
      <span class="value" style="font-size:13px" data-metric="updatedLabel">{ago}</span>
    </div>
  </section>

  <div class="layout">
    <Sidebar active="all" />

    <main>
      {feat && (() => {
        const featSumJa = summaryForLang(feat, "ja");
        const featSumEn = summaryForLangWithFallback(feat, "en");
        const featCat = CATEGORY_META.find((c) => c.slug === feat.category);
        const featCatColor = featCat?.color ?? "#5eead4";
        const featCatEmoji = featCat?.emoji ?? "\u{1F4C4}";
        let featHost = "";
        try { featHost = new URL(feat.url).host.replace(/^www\./, ""); } catch {}
        const featFavicon = featHost
          ? `https://www.google.com/s2/favicons?sz=64&domain=${featHost}`
          : "";
        const featImg = feat.image?.src ?? "";
        return (
        <article class="featured" data-pagefind-body style={`--cat-color:${featCatColor}`}>
          <div class="featured-thumb">
            {featImg ? (
              <img src={featImg} alt={feat.image?.alt || feat.title} loading="lazy" decoding="async" />
            ) : (
              <div class="featured-thumb-fallback" aria-hidden="true">
                <span class="featured-thumb-emoji">{featCatEmoji}</span>
              </div>
            )}
          </div>
          <div class="featured-body">
            <div class="featured-label">
              <span class="i18n-ja">Featured · 注目</span>
              <span class="i18n-en" lang="en">Featured</span>
            </div>
            <h2 class="featured-title">
              <a href={entryHref(feat)}>
                {(() => {
                  const ja = titleForLangWithFallback(feat, "ja");
                  const en = titleForLangWithFallback(feat, "en");
                  return (
                    <>
                      <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                        {ja.isFallback && <span class="lang-badge">[en]</span>}
                        {ja.text}
                      </span>
                      <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                        {en.isFallback && <span class="lang-badge">[ja]</span>}
                        {en.text}
                      </span>
                    </>
                  );
                })()}
              </a>
            </h2>
            {featSumJa && <p class="featured-sum i18n-ja">{featSumJa}</p>}
            {featSumEn.text && (
              <p class="featured-sum i18n-en" lang={featSumEn.isFallback ? "ja" : "en"}>
                {featSumEn.isFallback && <span class="lang-badge">[ja]</span>}
                {featSumEn.text}
              </p>
            )}
            <div class="featured-meta">
              <span class="badge release">{feat.sourceType}</span>
              <span class="featured-src">
                {featFavicon && (
                  <img
                    class="featured-favicon"
                    src={featFavicon}
                    alt=""
                    width="16"
                    height="16"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.style.display='none'"
                  />
                )}
                <span>{feat.source}</span>
              </span>
              <span>·</span>
              <span>{relativeTime(feat.publishedAt, now)}</span>
            </div>
          </div>
        </article>
        );
      })()}

      <DailySummary entries={ALL_ENTRIES} stats={STATS} now={now} />

      {topThree.length > 0 && (
        <section class="top-rank">
          <div class="top-rank-head">
            <span class="top-rank-title">🔥 Today's Top {topThree.length}</span>
            <span class="top-rank-sub">importance × recency</span>
          </div>
          <ol class="top-rank-list">
            {topThree.map((e, i) => {
              const meta = CATEGORY_META.find((c) => c.slug === e.category);
              return (
                <li class={`top-rank-item rank-${i + 1}`} style={`--cat-color:${meta?.color ?? "#8a847e"}`}>
                  <span class="medal" aria-hidden="true">{medals[i]}</span>
                  <span class="rank-cat" aria-hidden="true">{meta?.emoji ?? "\u{1F4C4}"}</span>
                  <a class="rank-title" href={entryHref(e)}>
                    {(() => {
                      const ja = titleForLangWithFallback(e, "ja");
                      const en = titleForLangWithFallback(e, "en");
                      return (
                        <>
                          <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                            {ja.isFallback && <span class="lang-badge">[en]</span>}
                            {ja.text}
                          </span>
                          <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                            {en.isFallback && <span class="lang-badge">[ja]</span>}
                            {en.text}
                          </span>
                        </>
                      );
                    })()}
                  </a>
                  <span class="rank-meta">
                    <span class="rank-source">{e.source}</span>
                    <span class="rank-time mono">{relativeTime(e.publishedAt, now)}</span>
                  </span>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      <div class="section-header primary">
        <h2>Timeline <span class="count"><span data-metric="liveEntries">{DASHBOARD_METRICS.liveEntries}</span> total · page {currentPage}/{totalPages}</span></h2>
      </div>

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span>{jstDayLabel(key, now)}</span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={currentPage} totalPages={totalPages} baseHref="" />
    </main>

    <aside class="right">
      <div class="side-card">
        <div class="right-title">Trending Tags</div>
        <div class="tag-cloud">
          {tags.map((t) => (
            <a class="tag" href={`/t/${encodeURIComponent(t.tag)}`}>
              #{t.tag} <span class="c">{t.count}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="side-card">
        <div class="right-title">About</div>
        <p style="font-size:12px;color:var(--muted);line-height:1.55">
          1 時間おきに公式ソースを自動収集し、日本語で要約。
          <a href="/about" style="color:var(--accent)">詳しく</a>
        </p>
      </div>
    </aside>
  </div>
  <LiveMetrics />
</Portal>
