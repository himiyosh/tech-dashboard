---
const target = "/status/";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Sources moved to Status - TECH Dashboard</title>
  </head>
  <body>
    <script is:inline>
      window.location.replace("/status/");
    </script>
    <main>
      <p>Sources は Status に統合されました。<a href="/status/">Status を開く</a></p>
    </main>
  </body>
</html>
