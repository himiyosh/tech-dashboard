            Published <time datetime={entry.publishedAt} data-relative-time>{relativeTime(entry.publishedAt, now)}</time>
          </span>
        </p>
      </div>

      {/* TOC */}
      {(renderedJa.length >= 3 || renderedEn.length >= 3) && (
        <div class="side-card toc-card">
          <div class="rail-title"><span class="i18n-ja">目次</span><span class="i18n-en" lang="en">Contents</span></div>
          {renderedJa.length >= 3 && (
            <ol class="toc-list i18n-ja" id="toc-list-ja">
              {renderedJa.map((p, i) => (
