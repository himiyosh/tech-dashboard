        const fallbackBadge = (fallbackLang: "" | "JA" | "EN") =>
          fallbackLang
            ? `<span class="search-hit-fallback"><span class="i18n-ja">原文 ${fallbackLang}</span><span class="i18n-en" lang="en">Original ${fallbackLang}</span></span>`
            : "";
        const resultTitle = (d: any) => {
          const type = classifyResult(d);
          return type.className === "article"
            ? localizedResult(d.meta?.titleJa, d.meta?.titleEn)
            : localizedResult(d.meta?.titleJa, d.meta?.titleEn, d.meta?.title || type.label);
        };
        const resultTitleMarkup = (d: any) => {
          const title = resultTitle(d);
          const langAttribute = title.lang ? ` lang="${title.lang}"` : "";
          return `${fallbackBadge(title.fallbackLang)}<span${langAttribute}>${escapeHtml(title.text)}</span>`;
        };
        const resultSummary = (d: any) => {
