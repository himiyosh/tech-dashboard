---
import {
  relativeTime,
  isRecentlyCollected,
  RECENT_COLLECTION_BADGE,
  RECENT_COLLECTION_WINDOW_HOURS,
  CATEGORY_META,
  importanceLabel,
  summaryForLangWithFallback,
  tagHref,
  titleForLangWithFallback,
  WORKER_HEALTH,
  type NormalizedEntry,
} from "../lib/data.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { isDefaultMutedCategory } from "../lib/category-visibility.ts";
import { effectiveImportance } from "../lib/release-signal.ts";
import { sourceFaviconUrl } from "../lib/favicon.ts";
import { deriveQueueDisplay, summaryQueueCardCopy } from "../lib/queue-health.ts";
import { deriveWorkerRunStatus } from "../lib/run-health.ts";
import { sourceExcerptForEntry } from "../lib/source-excerpt.ts";
import {
  entryDestination,
  EXTERNAL_ENTRY_REL,
} from "../lib/entry-destination.ts";
import {
  canonicalSourceUrl,
  sourceAuthority,
  sourceLabel,
} from "../lib/source-meta.ts";
import LanguageFallbackBadge from "./LanguageFallbackBadge.astro";
import ExternalLinkHint from "./ExternalLinkHint.astro";
import SourceExcerpt from "./SourceExcerpt.astro";

export interface Props {
  entry: NormalizedEntry;
  href?: string;
  external?: boolean;
  anchorId?: string;
}

const {
  entry,
  href: hrefOverride,
  external: externalOverride,
  anchorId,
} = Astro.props;
const defaultDestination = entryDestination(entry);
const href = hrefOverride ?? defaultDestination.href;
const external = externalOverride ?? defaultDestination.external;
const target = external ? "_blank" : undefined;
const destinationRel = external ? EXTERNAL_ENTRY_REL : undefined;
const rel = relativeTime(entry.publishedAt);

const summaryJaResult = summaryForLangWithFallback(entry, "ja");
const summaryEnResult = summaryForLangWithFallback(entry, "en");
// summaryForLangWithFallback returns "" for pending boilerplate / title echoes
// and cross-falls-back to the other language's real summary. So an entry whose
// JA summary is not generated yet still shows its real EN summary (flagged with
// a language badge) instead of placeholder text or an empty card (LL-074).
const summaryJa = summaryJaResult.text;
const summaryEn = summaryEnResult.text;
const hasSummary = Boolean(summaryJa || summaryEn);
const recentlyCollected = hasSummary && isRecentlyCollected(entry);
// Routine patch/prerelease builds always read as importance 1 on cards, even
// while stored data still carries the old over-scored value (release-signal.ts).
const cardImportance = effectiveImportance(entry);
const isImportant = hasSummary && cardImportance === 3;
const titleJaResult = titleForLangWithFallback(entry, "ja");
const titleEnResult = titleForLangWithFallback(entry, "en");
const titleJa = titleJaResult.text;
const titleEn = titleEnResult.text;

const catMeta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = catMeta?.color ?? "#8a847e";
const catName = catMeta?.name ?? entry.category;
const catShortLabel = catMeta?.shortLabel ?? catName;
const catEmoji = catMeta?.emoji ?? "\u{1F4C4}";
const authority = sourceAuthority(entry.source, entry.sourceType);
const authorityBadgeClass = ["badge", "authority", authority.kind].join(" ");
const sourceUrl = canonicalSourceUrl(entry.url);

const sourceTypeJa: Record<NormalizedEntry["sourceType"], string> = {
  blog: "技術記事",
  release: "公式リリース",
  changelog: "変更履歴",
  paper: "論文/研究",
  community: "コミュニティ",
};
const sourceTypeEn: Record<NormalizedEntry["sourceType"], string> = {
  blog: "technical post",
  release: "official release",
  changelog: "changelog",
  paper: "paper/research",
  community: "community",
};
const priority = importanceLabel(cardImportance);
const rankReasonJa =
  cardImportance >= 2 || recentlyCollected
    ? `${sourceTypeJa[entry.sourceType]} · ${catName}`
    : `深掘り候補 · ${sourceTypeJa[entry.sourceType]} · ${catName}`;
const rankReasonEn =
  cardImportance >= 2 || recentlyCollected
    ? `${sourceTypeEn[entry.sourceType]} · ${catName}`
    : `Deep-dive candidate · ${sourceTypeEn[entry.sourceType]} · ${catName}`;
const publishedJa = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  month: "short",
  day: "numeric",
}).format(new Date(entry.publishedAt));
const publishedEn = new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Tokyo",
  month: "short",
  day: "numeric",
}).format(new Date(entry.publishedAt));

const workerRun = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const summaryQueue = deriveQueueDisplay({
  mode: DASHBOARD_METRICS.summaryQueueMode,
  backlog: DASHBOARD_METRICS.summaryQueueBacklog,
  drainEstimateHours: DASHBOARD_METRICS.summaryQueueDrainEstimateHours,
  runTone: workerRun.tone,
  runState: workerRun.state,
});
const queueCopy = summaryQueueCardCopy(summaryQueue.state);
const sourceExcerpt = hasSummary ? "" : sourceExcerptForEntry(entry);

// Generate a deterministic pattern seed from the entry id
const patternSeed = entry.id.split("").reduce((a, c) => a + c.charCodeAt(0), 0);
const patternRotate = patternSeed % 360;
const patternScale = 0.8 + (patternSeed % 5) * 0.1;

// Source type icon character
function sourceIcon(t: string): string {
  if (t === "release") return "\u{1F680}";
  if (t === "changelog") return "\u{1F4CB}";
  if (t === "paper") return "\u{1F4D1}";
  if (t === "blog") return "\u{270D}\u{FE0F}";
  return "\u{1F4AC}";
}
const img = entry.image;
const hasUsableImage =
  !!img && typeof img.src === "string" && img.src.length > 0;
// The image origin ("og" / "media") is diagnostic, not reader-facing (site
// audit): it lives on data-image-source instead of a visible corner mark.
const thumbSource = hasUsableImage ? img!.source : "";
const visibleTags = entry.tags.slice(0, 3);
const hiddenTagCount = Math.max(0, entry.tags.length - visibleTags.length);
---

<article
  id={anchorId}
  class:list={["card", "has-thumb", { important: isImportant }]}
  data-summary-state={hasSummary ? "ready" : "pending"}
  data-entry-id={entry.id}
  data-category={entry.category}
  data-catvis={isDefaultMutedCategory(entry.category) ? "muted" : "visible"}
  data-archive-tier={entry.archiveTier}
  data-archive-search-anchor={anchorId || undefined}
  data-detail-destination={external ? "source" : "internal"}
  data-pagefind-body
  data-reveal="card"
  tabindex={anchorId ? "-1" : undefined}
  style={`--cat-color:${catColor}`}
>
  <div class="card-body">
    <div class="meta">
      {isImportant && <span class="badge hot" title="重要リリース">🔥 HOT</span>}
      {recentlyCollected && (
        <span
          class="badge new"
          data-recency-scope="collection"
          data-recency-window-hours={RECENT_COLLECTION_WINDOW_HOURS}
        >
          <span class="i18n-ja">{RECENT_COLLECTION_BADGE.ja}</span>
          <span class="i18n-en" lang="en">{RECENT_COLLECTION_BADGE.en}</span>
        </span>
      )}
      <span
        class={authorityBadgeClass}
        data-source-authority={authority.kind}
        data-source-type={entry.sourceType}
        title={`${authority.en} source · ${entry.sourceType}`}
      >
        <span class="i18n-ja">{authority.ja}</span>
        <span class="i18n-en" lang="en">{authority.en}</span>
      </span>
      <span
        class="badge cat"
        data-category={entry.category}
        title={catName}
        aria-label={`Category: ${catName}`}
      >{catShortLabel}</span>
      <span class="spacer"></span>
      <time class="mono" datetime={entry.publishedAt} data-relative-time>{rel}</time>
      <span>·</span>
      <span class="src-tag">
        <img
          class="src-favicon"
          src={sourceFaviconUrl(sourceUrl)}
          alt=""
          width="14"
          height="14"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.style.display='none'"
        />
        <span>{sourceLabel(entry.source, entry.url)}</span>
      </span>
    </div>
    <h3 class="title">
      <a
        href={href}
        target={target}
        rel={destinationRel}
      >
        <span
          class="i18n-ja"
          lang={titleJaResult.fallbackLang === "en" ? "en" : "ja"}
        >
          {titleJaResult.isFallback && titleJaResult.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={titleJaResult.fallbackLang} variant="title" />
          )}
          {titleJa}
          {external && <ExternalLinkHint lang="ja" />}
        </span>
        <span
          class="i18n-en"
          lang={titleEnResult.fallbackLang === "ja" ? "ja" : "en"}
        >
          {titleEnResult.isFallback && titleEnResult.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={titleEnResult.fallbackLang} variant="title" />
          )}
          {titleEn}
          {external && <ExternalLinkHint lang="en" />}
        </span>
      </a>
    </h3>
    {hasSummary && (
      <div class="card-insight" aria-label="Reading priority">
        <span class={`insight-priority ${priority.tone}`}>
          <span class="i18n-ja">{priority.ja}</span>
          <span class="i18n-en" lang="en">{priority.en}</span>
        </span>
        <span class="insight-reason i18n-ja">{rankReasonJa}</span>
        <span class="insight-reason i18n-en" lang="en">{rankReasonEn}</span>
        <time class="insight-date" datetime={entry.publishedAt}>
          <span class="i18n-ja">公開 {publishedJa}</span>
          <span class="i18n-en" lang="en">Published {publishedEn}</span>
        </time>
      </div>
    )}
    {hasSummary ? (
      <div class="summary-stack">
        {summaryJa && (
          <p
            class="summary summary-ja i18n-ja"
            title={summaryJa}
            lang={summaryJaResult.fallbackLang === "en" ? "en" : "ja"}
          >
            {summaryJaResult.isFallback && summaryJaResult.fallbackLang ? (
              <LanguageFallbackBadge fallbackLang={summaryJaResult.fallbackLang} variant="summary" />
            ) : (
              <span class="ai-mark">AI要約</span>
            )}
            <span class="s-text">{summaryJa}</span>
          </p>
        )}
        {summaryEn && (
          <p
            class="summary summary-en i18n-en"
            title={summaryEn}
            lang={summaryEnResult.fallbackLang === "ja" ? "ja" : "en"}
          >
            {summaryEnResult.isFallback && summaryEnResult.fallbackLang ? (
              <LanguageFallbackBadge fallbackLang={summaryEnResult.fallbackLang} variant="summary" />
            ) : (
              <span class="en-mark">AI SUMMARY</span>
            )}
            <span class="s-text">{summaryEn}</span>
          </p>
        )}
      </div>
    ) : (
      <div class="pending-summary-stack">
        <p
          class="summary-state"
          data-summary-queue-mode={summaryQueue.mode}
          data-summary-queue-state={summaryQueue.state}
        >
          <span class="summary-pending-badge">
            <span class="i18n-ja" data-summary-queue-badge-ja>{queueCopy.badgeJa}</span>
            <span class="i18n-en" lang="en" data-summary-queue-badge-en>{queueCopy.badgeEn}</span>
          </span>
        </p>
        {sourceExcerpt && (
          <SourceExcerpt
            entryId={entry.id}
            excerpt={sourceExcerpt}
            lang={entry.lang}
            variant="card"
          />
        )}
      </div>
    )}
    <div class="card-footer">
      {visibleTags.length > 0 && (
        <div class="tag-row">
          {visibleTags.map((t) => (
            <a class="tag-chip" href={tagHref(t, entry.id)}>#{t}</a>
          ))}
          {hiddenTagCount > 0 && <span class="tag-chip tag-more">+{hiddenTagCount}</span>}
        </div>
      )}
      <a
        class="url"
        href={href}
        target={target}
        rel={destinationRel}
      >
        <img
          class="url-favicon"
          src={sourceFaviconUrl(sourceUrl)}
          alt=""
          width="16"
          height="16"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.style.display='none'"
        />
        <span class="i18n-ja">
          <span class="url-label">{external ? "元記事" : "記事詳細"}</span>
          {external && <ExternalLinkHint lang="ja" />}
        </span>
        <span class="i18n-en" lang="en">
          <span class="url-label">{external ? "Original article" : "Article details"}</span>
          {external && <ExternalLinkHint lang="en" />}
        </span>
        {!external && <span class="arrow">→</span>}
      </a>
    </div>
  </div>

  <div class:list={["card-thumb", { fallback: !hasUsableImage, "has-image": hasUsableImage }]} style={`--cat-color:${catColor}${hasUsableImage ? `;--thumb-src:url("${img!.src.replace(/"/g, "%22")}")` : ""}`} data-image-source={thumbSource || undefined}>
    {hasUsableImage && (
      <img
        src={img!.src}
        alt={img!.alt || titleJa}
        loading="lazy"
        decoding="async"
        onerror="this.closest('.card-thumb')?.classList.add('failed')"
      />
    )}
    <svg viewBox="0 0 144 96" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id={`bg-${entry.id}`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color={catColor} stop-opacity="0.30" />
          <stop offset="100%" stop-color={catColor} stop-opacity="0.05" />
        </linearGradient>
      </defs>
      <rect width="144" height="96" fill="#1a1917" />
      <rect width="144" height="96" fill={`url(#bg-${entry.id})`} />
      <g opacity="0.10" transform={`rotate(${patternRotate} 72 48) scale(${patternScale})`}>
        <circle cx="20" cy="15" r="18" fill={catColor} />
        <circle cx="130" cy="80" r="24" fill={catColor} />
        <rect x="90" y="5" width="40" height="40" rx="8" fill={catColor} />
      </g>
      <text
        x="72"
        y="54"
        text-anchor="middle"
        dominant-baseline="middle"
        font-size="40"
        style="filter:drop-shadow(0 2px 4px rgba(0,0,0,0.4))"
      >{catEmoji}</text>
      <text
        x="72"
        y="82"
        text-anchor="middle"
        font-family="system-ui, -apple-system, sans-serif"
        font-size="8.5"
        fill={catColor}
        opacity="0.7"
        letter-spacing="0.08em"
        font-weight="600"
      >{catName}</text>
      <text
        x="132"
        y="14"
        text-anchor="end"
        font-size="12"
        opacity="0.85"
      >{sourceIcon(entry.sourceType)}</text>
    </svg>
  </div>
</article>
