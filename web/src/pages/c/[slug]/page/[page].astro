---
import Portal from "../../../../layouts/Portal.astro";
import PageHero from "../../../../components/PageHero.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import EntryCard from "../../../../components/EntryCard.astro";
import Pager from "../../../../components/Pager.astro";
import CategorySidePanel from "../../../../components/CategorySidePanel.astro";
import {
  CATEGORY_META,
  PAGE_SIZE,
  entriesFor,
  groupByDay,
  jstDayLabel,
  type Category,
} from "../../../../lib/data.ts";
import { categoryWeekOverWeek } from "../../../../lib/stats.ts";

export function getStaticPaths() {
  const out: Array<{
    params: { slug: string; page: string };
    props: {
      category: (typeof CATEGORY_META)[number];
      page: number;
      total: number;
    };
  }> = [];
  for (const c of CATEGORY_META) {
    const all = entriesFor(c.slug);
    const total = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
    for (let p = 2; p <= total; p++) {
      out.push({
        params: { slug: c.slug, page: String(p) },
        props: { category: c, page: p, total },
      });
    }
  }
  return out;
}

interface Props {
  category: (typeof CATEGORY_META)[number];
  page: number;
  total: number;
}

const { category, page, total } = Astro.props as Props;
const slug = category.slug as Category;
const categoryContextLabel = slug === "research" ? "Research" : category.name;
const all = entriesFor(slug);
const start = (page - 1) * PAGE_SIZE;
const entries = all.slice(start, start + PAGE_SIZE);
const dayGroups = groupByDay(entries);
const now = new Date();
const wow = categoryWeekOverWeek(slug);
const deltaSign = wow.deltaPct > 0 ? "+" : wow.deltaPct < 0 ? "-" : "";

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Categories", href: "/categories" },
  { label: category.name, href: `/c/${slug}` },
  { label: `Page ${page}` },
];
---

<Portal
  pageKey="categories"
  title={`${category.name} · p.${page} — TECH Dashboard`}
  breadcrumb={breadcrumb}
>
  <PageHero
    className="page-hero-category-detail"
    accent={category.color}
    kicker="Category detail"
    title={categoryContextLabel}
    count={`page ${page}/${total}`}
    headingId="category-heading"
    description={`${categoryContextLabel} カテゴリの更新の続きです。ページを移動してもカテゴリ文脈と主要指標を維持します。`}
    descriptionEn={`Continue browsing ${categoryContextLabel} updates while keeping category context and key metrics in view.`}
    actions={[
      { href: `/c/${slug}`, label: "First page" },
      { href: "/categories", label: "All categories" },
      { href: `/rss.xml?category=${slug}`, label: "RSS" },
    ]}
    metrics={[
      {
        label: "Total",
        value: all.length,
        detail: "現在のカテゴリ一覧",
        detailEn: "Current category listing",
        scope: "category-live-total",
      },
      {
        label: "Showing",
        value: entries.length,
        detail: "このページの表示件数",
        detailEn: "Entries on this page",
        scope: "category-page-count",
      },
      {
        label: "Last 7d",
        value: wow.thisWeek,
        detail: "直近7日の掲載数",
        detailEn: "Entries in the latest 7 days",
        scope: "category-last-7d",
      },
      {
        label: "Vs prev 7d",
        value: `${deltaSign}${Math.abs(wow.deltaPct)}%`,
        detail: "その前の7日間と比較",
        detailEn: "Compared with the previous 7 days",
        scope: "category-week-over-week",
      },
      {
        label: "Page",
        value: `${page}/${total}`,
        detail: "静的ページ位置",
        detailEn: "Static page position",
        scope: "category-page-position",
      },
    ]}
  />

  <div class="layout">
    <Sidebar active={slug} />

    <main>
      {slug === "research" && (
        <section class="research-split-callout" aria-labelledby="research-split-heading">
          <div>
            <p class="section-kicker">Research navigation</p>
            <h2 id="research-split-heading">
              <span class="i18n-ja">arXiv 論文は専用ページで分離表示しています</span>
              <span class="i18n-en">arXiv papers have a dedicated lane</span>
            </h2>
            <p class="i18n-ja">件数の多い arXiv cs.AI / cs.CL / cs.SE / cs.LG は、通常のカテゴリ閲覧とは別に専用レーンで確認できます。</p>
            <p class="i18n-en">Browse high-volume arXiv cs.AI, cs.CL, cs.SE, and cs.LG feeds separately from the category timeline.</p>
          </div>
          <a href="/arxiv/">arXiv Papers</a>
        </section>
      )}

      <div
        class="section-header"
        style={`border-bottom:2px solid ${category.color}`}
      >
        <h2>
          All articles
          <span
            class="count"
            style={`background:${category.color}22;color:${category.color}`}
          >
            page {page}/{total} · {all.length} total
          </span>
        </h2>
        <div class="sort">
          <span class="active">
            <span class="i18n-ja">新着順</span>
            <span class="i18n-en">Newest first</span>
          </span>
        </div>
      </div>

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span>{jstDayLabel(key, now)}</span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={page} totalPages={total} baseHref={`/c/${slug}`} />
    </main>

    <CategorySidePanel category={category} entries={all} now={now} />
  </div>
</Portal>

<style>
  .section-header .sort {
    display: flex; gap: 2px; padding: 2px;
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: 6px; font-size: 11px;
  }
  .section-header .sort span { padding: 3px 10px; border-radius: 4px; color: var(--muted); }
  .section-header .sort span.active { background: var(--surface-2, var(--surface)); color: var(--text); }
</style>
