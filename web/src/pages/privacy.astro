---
import PageHero from "../components/PageHero.astro";
import ExternalLinkHint from "../components/ExternalLinkHint.astro";
import Portal from "../layouts/Portal.astro";
import {
  NEW_ISSUE_URL,
  PRIVACY_JURISDICTION,
  PRIVACY_LAST_UPDATED,
  PUBLIC_OPERATOR_NAME,
} from "../lib/site.ts";
---

<Portal
  pageKey="privacy"
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Privacy" }]}
  title="Privacy & Consent - TECH Dashboard"
  description="TECH Dashboardのデータ取扱い、広告同意、匿名いいね、第三者サービス、利用者の選択を説明します。"
  descriptionEn="TECH Dashboard privacy, advertising consent, anonymous likes, third-party services, retention, deletion, and user controls."
>
  <PageHero
    className="page-hero-privacy"
    kicker="Privacy & consent"
    title="プライバシー"
    titleEn="Privacy & consent"
    headingId="privacy-heading"
    description="収集する情報を最小限にし、広告・解析・第三者サービスの取扱いを公開します。"
    descriptionEn="We minimize data collection and do not load optional advertising until you explicitly allow it. This page documents the current technical behavior and your controls."
    actions={[
      { href: "#choices", label: "選択を変更", labelEn: "Change choices" },
      { href: "#data-we-use", label: "取扱うデータ", labelEn: "Data we use" },
      { href: "#third-parties", label: "第三者サービス", labelEn: "Third parties" },
      { href: "#contact", label: "連絡先", labelEn: "Contact" },
    ]}
  />

  <div class="privacy-layout">
    <aside class="privacy-rail" aria-labelledby="privacy-rail-label">
      <span id="privacy-rail-label" class="visually-hidden">
        <span class="i18n-ja">プライバシーページの案内</span>
        <span class="i18n-en" lang="en">Privacy page navigation</span>
      </span>
      <div class="privacy-identity">
        <span class="privacy-mark" aria-hidden="true">◎</span>
        <div>
          <strong>{PUBLIC_OPERATOR_NAME}</strong>
          <small>
            <span class="i18n-ja">日本で運営</span>
            <span class="i18n-en" lang="en">Operated in Japan</span>
          </small>
        </div>
      </div>
      <dl>
        <div>
          <dt>
            <span class="i18n-ja">更新日</span>
            <span class="i18n-en" lang="en">Updated</span>
          </dt>
          <dd><time datetime={PRIVACY_LAST_UPDATED}>{PRIVACY_LAST_UPDATED}</time></dd>
        </div>
        <div>
          <dt>
            <span class="i18n-ja">解析サービス</span>
            <span class="i18n-en" lang="en">Analytics</span>
          </dt>
          <dd>
            <span class="i18n-ja">Cloudflare RUM</span>
            <span class="i18n-en" lang="en">Cloudflare RUM</span>
          </dd>
        </div>
        <div>
          <dt>
            <span class="i18n-ja">広告</span>
            <span class="i18n-en" lang="en">Optional ads</span>
          </dt>
          <dd>
            <span class="i18n-ja">初期OFF</span>
            <span class="i18n-en" lang="en">Off by default</span>
          </dd>
        </div>
      </dl>
      <nav aria-labelledby="privacy-sections-label">
        <span id="privacy-sections-label" class="visually-hidden">
          <span class="i18n-ja">プライバシーの各項目</span>
          <span class="i18n-en" lang="en">Privacy sections</span>
        </span>
        <a href="#choices">
          <span class="i18n-ja">選択と初期設定</span>
          <span class="i18n-en" lang="en">Choices and defaults</span>
        </a>
        <a href="#data-we-use">
          <span class="i18n-ja">取扱うデータ</span>
          <span class="i18n-en" lang="en">Data we use</span>
        </a>
        <a href="#anonymous-reactions">
          <span class="i18n-ja">匿名いいね</span>
          <span class="i18n-en" lang="en">Anonymous likes</span>
        </a>
        <a href="#third-parties">
          <span class="i18n-ja">第三者サービス</span>
          <span class="i18n-en" lang="en">Third parties</span>
        </a>
        <a href="#your-controls">
          <span class="i18n-ja">削除と変更</span>
          <span class="i18n-en" lang="en">Deletion and changes</span>
        </a>
        <a href="#contact">
          <span class="i18n-ja">運営者と連絡先</span>
          <span class="i18n-en" lang="en">Operator and contact</span>
        </a>
      </nav>
    </aside>

    <main class="privacy-main">
      <section class="privacy-intro" aria-labelledby="privacy-intro-heading">
        <p class="privacy-label">What we collect</p>
        <h2 id="privacy-intro-heading">
          <span class="i18n-ja">収集する情報は最小限です</span>
          <span class="i18n-en" lang="en">We keep collected information to a minimum</span>
        </h2>
        <p>
          <span class="i18n-ja">記事一覧、検索、Archive、RSS、JSON Feed は登録もアカウントも不要で利用できます。本番サイトでは運営費をまかなうため Google AdSense の広告を表示し、あわせて配信基盤の Cloudflare Web Analytics (RUM) がパフォーマンス計測のため動作します。TECH Dashboard はこれ以外のアクセス解析providerを追加していません。広告scriptは本番custom domainでのみ読み込み、pages.devとローカルpreviewでは読み込みません。</span>
          <span class="i18n-en" lang="en">Article lists, search, Archive, RSS, and JSON Feed need no account or sign-up. The production site shows Google AdSense advertising to cover running costs, and Cloudflare Web Analytics (RUM) operates alongside it to measure performance. TECH Dashboard adds no other analytics provider. Advertising scripts load only on the production custom domain, never on pages.dev or local previews.</span>
        </p>
      </section>

      <section id="choices" class="privacy-section" aria-labelledby="choices-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="choices-heading">
              <span class="i18n-ja">広告について</span>
              <span class="i18n-en" lang="en">About advertising</span>
            </h2>
            <p>
              <span class="i18n-ja">広告は本番サイトの標準機能として表示され、現在オフにする設定は提供していません。</span>
              <span class="i18n-en" lang="en">Advertising is a standard part of the production site; there is currently no setting to turn it off.</span>
            </p>
          </div>
        </div>
        <p>
          <span class="i18n-ja">広告の配信には Google AdSense を使用します。Googleはcookie、IP address、browser情報などを広告配信と不正対策へ使用する場合があり、保持と削除はGoogleのpolicyとcontrolに従います。ブラウザ側の広告設定は <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google 広告センター</a> から変更できます。</span>
          <span class="i18n-en" lang="en">Advertising is served by Google AdSense. Google may use cookies, IP address, and browser information for ad delivery and fraud prevention; retention and deletion follow Google policies and controls. You can adjust your own ad settings at <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google Ad Center</a>.</span>
        </p>
      </section>

      <section id="data-we-use" class="privacy-section" aria-labelledby="data-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="data-heading">
              <span class="i18n-ja">取扱うデータ</span>
              <span class="i18n-en" lang="en">Data we use</span>
            </h2>
            <p>
              <span class="i18n-ja">機能ごとに目的を限定し、別用途へ自動転用しません。</span>
              <span class="i18n-en" lang="en">Each data category has a limited purpose and is not automatically repurposed.</span>
            </p>
          </div>
        </div>
        <dl class="privacy-practices">
          <div data-privacy-practice="display">
            <dt>
              <span class="i18n-ja">表示設定</span>
              <span class="i18n-en" lang="en">Display preferences</span>
            </dt>
            <dd>
              <span class="i18n-ja">表示言語とarXiv表示形式をlocalStorageへ保存します。英語表示は共有可能なURLの<code>?lang=en</code>にも反映され、そのURLは通常の配信requestとしてCloudflareへ届きます。これらの設定は運営者のserverへ送信しません。</span>
              <span class="i18n-en" lang="en">Interface language and arXiv view mode are stored in localStorage. English mode is also reflected as <code>?lang=en</code> in shareable URLs, so Cloudflare receives it as ordinary delivery request data. These preferences are not sent to the operator's server.</span>
            </dd>
          </div>
          <div data-privacy-practice="search">
            <dt>
              <span class="i18n-ja">検索</span>
              <span class="i18n-en" lang="en">Search</span>
            </dt>
            <dd>
              <span class="i18n-ja">Pagefindの静的indexをbrowser内で検索します。共有可能な検索URLには<code>?q=</code>、<code>?tag=</code>、exact recovery用の<code>?entry=</code>が含まれる場合があります。カテゴリRSSは<code>/rss/&lt;category&gt;.xml</code>で配信します。これらのpathとqueryはCloudflareが通常の配信requestとして処理します。</span>
              <span class="i18n-en" lang="en">Pagefind searches a static index in the browser. Shareable search URLs can contain <code>?q=</code>, <code>?tag=</code>, and an exact-recovery <code>?entry=</code>. Category RSS is served at <code>/rss/&lt;category&gt;.xml</code>. Cloudflare processes these paths and queries as ordinary delivery requests.</span>
            </dd>
          </div>
          <div data-privacy-practice="rum">
            <dt>
              <span class="i18n-ja">パフォーマンス計測 (RUM)</span>
              <span class="i18n-en" lang="en">Performance measurement (RUM)</span>
            </dt>
            <dd>
              <span class="i18n-ja">本番サイトではCloudflare Web Analytics (RUM)を使用します。広告とは独立して、通常の閲覧時に<code>static.cloudflareinsights.com</code>のbeaconが読み込まれ、browserのPerformance APIから得るpage読込・応答性などの性能測定値、閲覧pageのURL、送信元IPなど通常のrequest contextを<code>/cdn-cgi/rum</code>へ送信する場合があります。目的はsiteの性能と利用状況の把握です。保持とcontrolはCloudflareのpolicyに従います。</span>
              <span class="i18n-en" lang="en">The production site uses Cloudflare Web Analytics (RUM). Independently of optional advertising consent, normal site use can load a beacon from <code>static.cloudflareinsights.com</code> and send performance measurements from browser Performance APIs, such as page-load and responsiveness data, together with the viewed page URL and ordinary request context such as source IP, to <code>/cdn-cgi/rum</code>. Its purpose is to understand site performance and usage. Retention and controls follow Cloudflare's policy.</span>
            </dd>
          </div>
          <div data-privacy-practice="delivery">
            <dt>
              <span class="i18n-ja">配信request</span>
              <span class="i18n-en" lang="en">Delivery requests</span>
            </dt>
            <dd>
              <span class="i18n-ja">Cloudflare PagesとFunctionsがsiteとAPIを配信します。URL path・query、IP address、user agent、referrerなどのHTTP request metadataを配信・security・abuse対策のためCloudflareが処理する場合があります。保持期間とcontrolはCloudflareのpolicyに従います。</span>
              <span class="i18n-en" lang="en">Cloudflare Pages and Functions deliver the site and APIs. Cloudflare may process HTTP request metadata such as URL path and query, IP address, user agent, and referrer for delivery, security, and abuse prevention. Retention and controls follow Cloudflare's policy.</span>
            </dd>
          </div>
          <div data-privacy-practice="media">
            <dt>
              <span class="i18n-ja">外部media</span>
              <span class="i18n-en" lang="en">External media</span>
            </dt>
            <dd>
              <span class="i18n-ja">記事画像やfaviconは広告と独立して、元siteまたは画像providerから直接取得する場合があります。そのrequestではURL、IP address、browser情報、referrerが送信先へ届く場合があります。保持期間と削除controlは各送信先が管理し、このpageの削除controlでは消去できません。</span>
              <span class="i18n-en" lang="en">Independently of advertising, article images and favicons may load directly from source sites or image providers. Those requests may expose URL, IP address, browser information, and referrer to the destination. Each destination controls retention and deletion; this page's deletion control cannot remove that data.</span>
            </dd>
          </div>
          <div data-privacy-practice="retention">
            <dt>
              <span class="i18n-ja">保持期間</span>
              <span class="i18n-en" lang="en">Retention</span>
            </dt>
            <dd>
              <span class="i18n-ja">localStorageの設定は変更・消去またはbrowser storageの削除まで保持されます。匿名いいねCookieは最長1年間です。D1のactive identity、票、rate-limit行には現在、自動削除期限を設定していません。このpageの削除controlまたは運用上の削除で消去します。第三者が保持する情報は各serviceのpolicyに従います。</span>
              <span class="i18n-en" lang="en">Local preferences remain until changed, cleared, or removed with browser storage. The anonymous-like cookie lasts up to one year. D1 active-identity, vote, and rate-limit rows currently have no automatic expiry; they are removed by this page's deletion control or operational deletion. Third-party retention follows each provider's policy.</span>
            </dd>
          </div>
        </dl>
      </section>

      <section id="anonymous-reactions" class="privacy-section" aria-labelledby="reactions-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="reactions-heading">
              <span class="i18n-ja">匿名いいね</span>
              <span class="i18n-en" lang="en">Anonymous likes</span>
            </h2>
            <p>
              <span class="i18n-ja">いいねを操作したbrowserだけに、機能用の識別子を作成します。</span>
              <span class="i18n-en" lang="en">A functional identifier is created only for a browser that uses the like control.</span>
            </p>
          </div>
        </div>
        <div class="privacy-prose">
          <p>
            <span class="i18n-ja">不透明なUUIDを<code>__Host-techdb_reaction_voter</code>というHttpOnly、Secure、SameSite=Lax Cookieに最長1年間保存します。serverはUUIDそのものではなく、active identityのHMAC-SHA256 digestと作成時刻、記事ID、いいね状態、rate-limit状態だけをD1へ保存します。count読込時は記事IDを<code>?ids=</code>でsame-origin Functionへ送り、設定済みCookieはbrowserが同じrequestへ付与します。</span>
            <span class="i18n-en" lang="en">An opaque UUID is stored for up to one year in the <code>__Host-techdb_reaction_voter</code> HttpOnly, Secure, SameSite=Lax cookie. The server stores only the active identity's HMAC-SHA256 digest and creation time, article ID, like state, and rate-limit state in D1, not the UUID itself. Count reads send article IDs to the same-origin Function in <code>?ids=</code>, and the browser includes the configured cookie with that request.</span>
          </p>
          <p>
            <span class="i18n-ja">いいね変更時だけCloudflare Turnstileを読み込み、one-time tokenとIP addressを検証へ送信します。IP addressはTECH DashboardのD1へ保存しません。いいねはお気に入り、記事保存、ranking signalではありません。</span>
            <span class="i18n-en" lang="en">Cloudflare Turnstile loads only when a like changes, sending a one-time token and IP address for verification. TECH Dashboard does not store the IP address in D1. Likes are not bookmarks, saved articles, or ranking signals.</span>
          </p>
        </div>
      </section>

      <section id="third-parties" class="privacy-section" aria-labelledby="third-parties-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="third-parties-heading">
              <span class="i18n-ja">第三者サービス</span>
              <span class="i18n-en" lang="en">Third-party services</span>
            </h2>
            <p>
              <span class="i18n-ja">利用する目的と起動条件を分けて公開します。</span>
              <span class="i18n-en" lang="en">Purpose and activation conditions are disclosed separately.</span>
            </p>
          </div>
        </div>
        <ul class="third-party-list">
          <li>
            <strong>Cloudflare</strong>
            <span>
              <span class="i18n-ja">site配信、Functions、D1、広告と独立して動作するWeb Analytics (RUM)、任意のいいね検証に使用します。request metadata、RUM performance data、Turnstile verification dataの保持・controlはCloudflareのpolicyに従い、このpageのlocal/D1削除ではCloudflare側の記録を消去できません。</span>
              <span class="i18n-en" lang="en">Used for site delivery, Functions, D1, Web Analytics (RUM) that operates independently of advertising, and optional like verification. Retention and controls for request metadata, RUM performance data, and Turnstile verification data follow Cloudflare's policy; this page's local/D1 deletion cannot remove provider-side records.</span>
            </span>
            <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">
              Privacy policy
              <ExternalLinkHint lang="ja" />
              <ExternalLinkHint lang="en" />
            </a>
          </li>
          <li>
            <strong>Google AdSense</strong>
            <span>
              <span class="i18n-ja">本番custom domainで読み込みます (pages.devとローカルpreviewでは読み込みません)。Googleはcookie、IP address、browser情報などを広告配信と不正対策へ使用する場合があります。既にGoogleが受け取ったdataの保持・削除はGoogleのpolicyとcontrolに従い、表示される広告の設定は Google 広告センターから変更できます。</span>
              <span class="i18n-en" lang="en">Loads on the production custom domain (never on pages.dev or local previews). Google may use cookies, IP address, and browser information for ad delivery and fraud prevention. Retention and deletion of data already received by Google follow Google's policies and controls, and you can adjust the ads you see in Google Ad Center.</span>
            </span>
            <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">
              Advertising policy
              <ExternalLinkHint lang="ja" />
              <ExternalLinkHint lang="en" />
            </a>
          </li>
          <li>
            <strong>DuckDuckGo icons</strong>
            <span>
              <span class="i18n-ja">一部sourceのfaviconを広告と独立して表示するために使用します。送信先のrequest記録はDuckDuckGoが管理し、このpageの削除controlでは消去できません。</span>
              <span class="i18n-en" lang="en">Used independently of advertising to display favicons for some sources. DuckDuckGo controls destination-side request records; this page's deletion control cannot remove them.</span>
            </span>
            <a href="https://duckduckgo.com/privacy" target="_blank" rel="noopener noreferrer">
              Privacy policy
              <ExternalLinkHint lang="ja" />
              <ExternalLinkHint lang="en" />
            </a>
          </li>
        </ul>
      </section>

      <section id="your-controls" class="privacy-section" aria-labelledby="controls-heading" data-privacy-controls>
        <div class="privacy-section-heading">
          <div>
            <h2 id="controls-heading">
              <span class="i18n-ja">削除と変更</span>
              <span class="i18n-en" lang="en">Deletion and changes</span>
            </h2>
            <p>
              <span class="i18n-ja">選択の変更と匿名いいねデータの削除を、このpageから実行できます。</span>
              <span class="i18n-en" lang="en">You can change choices and delete anonymous like data from this page.</span>
            </p>
          </div>
        </div>
        <div class="privacy-controls">
          <article aria-labelledby="local-preferences-heading">
            <h3 id="local-preferences-heading">
              <span class="i18n-ja">ローカル設定を消去</span>
              <span class="i18n-en" lang="en">Clear local preferences</span>
            </h3>
            <p id="local-preferences-description">
              <span class="i18n-ja">このbrowserの保存済み表示言語とarXiv表示形式をlocalStorageから削除します。現在のURLにある<code>?lang=</code>、<code>?q=</code>、<code>?tag=</code>は変更しません。</span>
              <span class="i18n-en" lang="en">Removes saved interface language and arXiv view mode from this browser's localStorage. It does not rewrite <code>?lang=</code>, <code>?q=</code>, or <code>?tag=</code> in the current URL.</span>
            </p>
            <button type="button" data-clear-local-preferences aria-describedby="local-preferences-description">
              <span class="i18n-ja">ローカル設定を消去</span>
              <span class="i18n-en" lang="en">Clear local preferences</span>
            </button>
          </article>
          <article
            aria-labelledby="reaction-deletion-heading"
            data-reaction-delete-card
            data-reaction-delete-state="checking"
          >
            <h3 id="reaction-deletion-heading">
              <span class="i18n-ja">匿名いいねデータを削除</span>
              <span class="i18n-en" lang="en">Delete anonymous like data</span>
            </h3>
            <p id="reaction-deletion-description">
              <span class="i18n-ja">現在のbrowser識別子に紐づくactive identity、全ての票、rate-limit記録をD1から削除し、Cookieを失効させます。第三者service側のrequest記録は削除対象に含みません。</span>
              <span class="i18n-en" lang="en">Deletes the active identity, all votes, and rate-limit records linked to the current browser from D1 and expires its cookie. Provider-side request records are not included.</span>
            </p>
            <p
              class="reaction-delete-availability"
              data-reaction-delete-availability="checking"
              role="status"
            >
              <span class="i18n-ja">削除機能の設定を確認しています。</span>
              <span class="i18n-en" lang="en">Checking deletion availability.</span>
            </p>
            <p
              class="reaction-delete-availability"
              data-reaction-delete-availability="ready"
              role="status"
              hidden
              inert
            >
              <span class="i18n-ja">この環境では削除機能を利用できます。</span>
              <span class="i18n-en" lang="en">Deletion is available in this environment.</span>
            </p>
            <p
              class="reaction-delete-availability"
              data-reaction-delete-availability="not-configured"
              role="status"
              hidden
              inert
            >
              <span class="i18n-ja">D1または識別子署名が未設定のため、この環境では削除できません。</span>
              <span class="i18n-en" lang="en">Deletion is unavailable because D1 or identity signing is not configured in this environment.</span>
            </p>
            <p
              class="reaction-delete-availability"
              data-reaction-delete-availability="unavailable"
              role="status"
              hidden
              inert
            >
              <span class="i18n-ja">静的previewでは削除APIを確認できません。本番Pages Functionsで設定済みの場合に利用できます。</span>
              <span class="i18n-en" lang="en">The deletion API cannot be verified in a static preview. It is available when configured in production Pages Functions.</span>
            </p>
            <button
              type="button"
              data-reaction-delete-open
              aria-controls="reaction-delete-confirmation"
              aria-expanded="false"
              aria-describedby="reaction-deletion-description"
              hidden
              inert
            >
              <span class="i18n-ja">削除を確認</span>
              <span class="i18n-en" lang="en">Review deletion</span>
            </button>
            <div
              id="reaction-delete-confirmation"
              class="delete-confirmation"
              data-reaction-delete-confirmation
              hidden
              inert
            >
              <p id="reaction-delete-confirmation-label">
                <span class="i18n-ja">この操作は取り消せません。続行しますか？</span>
                <span class="i18n-en" lang="en">This action cannot be undone. Continue?</span>
              </p>
              <div role="group" aria-labelledby="reaction-delete-confirmation-label">
                <button type="button" data-reaction-delete-cancel>
