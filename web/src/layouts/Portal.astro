        const authorityLabels: Record<string, { ja: string; en: string }> = {
          official: { ja: "公式", en: "Official" },
          paper: { ja: "論文", en: "Paper" },
          community: { ja: "コミュニティ", en: "Community" },
          news: { ja: "報道", en: "News" },
          aggregator: { ja: "集約", en: "Aggregator" },
          source: { ja: "出典", en: "Source" },
        };

        const relativeAge = (day: string): string => {
          const parsed = Date.parse(day);
          if (Number.isNaN(parsed)) return "";
          const days = Math.floor((Date.now() - parsed) / 86400000);
          if (days <= 0) return "today";
          if (days === 1) return "1d ago";
          if (days < 30) return `${days}d ago`;
          const months = Math.floor(days / 30);
          if (months < 12) return `${months}mo ago`;
          return `${Math.floor(days / 365)}y ago`;
        };
        const displaySource = (value: string) => sourceLabels.get(value) ?? "";
        const displayCategory = (value: string) => categoryLabels.get(value) ?? "";
        const activeSearchLang = (): "ja" | "en" =>
          document.documentElement.getAttribute("data-lang") === "en" ? "en" : "ja";
        const localizedResult = (
          jaValue: unknown,
          enValue: unknown,
          genericValue: unknown = "",
        ): { text: string; fallbackLang: "" | "JA" | "EN"; lang: "" | "ja" | "en" } => {
          const lang = activeSearchLang();
          const ja = String(jaValue ?? "").trim();
          const en = String(enValue ?? "").trim();
          const generic = String(genericValue ?? "").trim();
          if (lang === "en") {
            if (en) return { text: en, fallbackLang: "", lang: "en" };
            if (ja) return { text: ja, fallbackLang: "JA", lang: "ja" };
          } else {
            if (ja) return { text: ja, fallbackLang: "", lang: "ja" };
            if (en) return { text: en, fallbackLang: "EN", lang: "en" };
          }
          return { text: generic, fallbackLang: "", lang: "" };
