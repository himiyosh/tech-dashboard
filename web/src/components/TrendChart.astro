---
import type { Category } from "../lib/data.ts";
import { categoryDailyTrend, categoryWeekOverWeek } from "../lib/stats.ts";

export interface Props {
  category: Category;
  color: string;
  days?: number;
}

const { category, color, days = 30 } = Astro.props;

const buckets = categoryDailyTrend(category, days);
const maxTotal = Math.max(1, ...buckets.map((b) => b.count));
const wow = categoryWeekOverWeek(category);

const axisStride = Math.max(1, Math.floor(days / 4));
const axisTicks = buckets
  .map((b, i) => ({ key: b.key, i }))
  .filter((b) => b.i % axisStride === 0 || b.i === buckets.length - 1);

const pct = (n: number): number => Math.round((n / maxTotal) * 100);

const formatTick = (key: string): string =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    month: "short",
    day: "numeric",
  }).format(new Date(`${key}T00:00:00+09:00`));

const deltaColor =
  wow.deltaPct > 0 ? "#4ade80" : wow.deltaPct < 0 ? "#f87171" : "var(--muted)";
const deltaSign = wow.deltaPct > 0 ? "▲" : wow.deltaPct < 0 ? "▼" : "—";
const chartLabel = `${category} trend chart for the last ${days} days. This week ${wow.thisWeek}, last week ${wow.prevWeek}, daily average ${wow.avgPerDay}.`;
---

<section class="trend" style={`--cat-color:${color}`}>
  <div class="trend-head">
    <div class="trend-title">
      Trend
      <span class="range-pill">Last {days} days</span>
    </div>
    <div class="trend-kpis">
      <span>
        This week <span class="v">{wow.thisWeek}</span>
        <span class="delta" style={`color:${deltaColor}`}>
          {deltaSign} {Math.abs(wow.deltaPct)}%
        </span>
      </span>
      <span>Last week <span class="v">{wow.prevWeek}</span></span>
      <span>Daily avg <span class="v">{wow.avgPerDay}</span></span>
      {wow.peak && wow.peak.count > 0 && (
        <span>Peak <span class="v">{wow.peak.count}</span></span>
      )}
    </div>
  </div>

  <div class="chart-wrap" role="group" aria-label={chartLabel}>
    <div class="chart">
      {buckets.map((b, i) => (
        <div
          class:list={["bar", { past: i < buckets.length - 7 }]}
          title={`${b.key}: ${b.count}`}
        >
          {b.count > 0 && (
            <div
              class="seg"
              style={`height:${pct(b.count)}%;background:${color}`}
            ></div>
          )}
        </div>
      ))}
    </div>
    <div class="x-axis">
      {axisTicks.map((t, idx) => (
        <span class:list={[{ today: idx === axisTicks.length - 1 }]}>
          {formatTick(t.key)}{idx === axisTicks.length - 1 ? " ↑today" : ""}
        </span>
      ))}
    </div>
    <table class="sr-only">
      <caption>{category} trend counts</caption>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Count</th>
        </tr>
      </thead>
      <tbody>
        {buckets.map((bucket) => (
          <tr>
            <td>{bucket.key}</td>
            <td>{bucket.count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="legend">
    <span class="dim">data/stats.json (archive + live) を元に、直近 7 日間は vivid、それ以前は薄色で表示</span>
  </div>
</section>

<style>
  .trend {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 26px 18px;
    margin-bottom: 22px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .trend-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 14px; flex-wrap: wrap; gap: 10px;
  }
  .trend-title {
    font-size: 13px; font-weight: 700; color: var(--text);
    display: flex; align-items: center; gap: 8px;
  }
  .trend-title .range-pill {
    font-size: 11px; font-weight: 500; color: var(--muted);
    padding: 2px 8px; border: 1px solid var(--border); border-radius: 999px;
  }
  .trend-kpis {
    display: flex; gap: 22px; font-size: 11px; color: var(--muted); flex-wrap: wrap;
  }
  .trend-kpis .v {
    color: var(--text); font-weight: 700; font-size: 13px;
    font-variant-numeric: tabular-nums; margin-left: 4px;
  }
  .trend-kpis .delta { margin-left: 4px; font-size: 11px; }
  .chart-wrap { position: relative; }
  .chart {
    display: flex; align-items: flex-end; gap: 3px; height: 120px;
    padding-top: 18px; border-bottom: 1px solid var(--border);
  }
  .chart .bar {
    flex: 1; display: flex; flex-direction: column-reverse; min-width: 0;
    height: 100%;
    border-radius: 3px 3px 0 0; overflow: hidden; background: transparent;
    transition: opacity 0.15s;
  }
  .chart .bar:hover { opacity: 0.75; }
  .chart .bar.past .seg { opacity: 0.35 !important; filter: saturate(0.5); }
  .chart .bar .seg { width: 100%; min-height: 1px; }
  .x-axis {
    display: flex; justify-content: space-between; margin-top: 6px;
    font-size: 9.5px; color: var(--muted-2); font-family: ui-monospace, monospace;
  }
  .x-axis .today { color: var(--cat-color, var(--accent)); }
  .legend {
    display: flex; gap: 16px; margin-top: 14px; font-size: 11px;
    color: var(--muted); flex-wrap: wrap;
  }
  .legend .sw {
    display: inline-block; width: 10px; height: 10px; border-radius: 2px;
    margin-right: 6px; vertical-align: middle;
  }
  .legend .dim {
    border-left: 1px solid var(--border); padding-left: 16px; color: var(--muted-2);
  }

  @media (max-width: 640px) {
    .trend {
      padding: 10px 12px;
      margin: 0 -2px 12px;
    }

    .trend-head {
      align-items: stretch;
      margin-bottom: 0;
      gap: 6px;
    }

    .trend-title {
      justify-content: space-between;
      width: 100%;
    }

    .trend-kpis {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      width: 100%;
      font-size: 10px;
    }

    .trend-kpis > span {
      min-width: 0;
      padding: 5px 7px;
      border: 1px solid color-mix(in srgb, var(--border) 74%, transparent);
      border-radius: 6px;
      background: color-mix(in srgb, var(--bg-2) 58%, transparent);
    }

    .trend-kpis > span:nth-child(n + 3) {
      display: none;
    }

    .trend-kpis .v {
      display: inline-block;
      margin-left: 3px;
      font-size: 12.5px;
    }

    .trend-kpis .delta {
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 10.5px;
    }

    .chart,
    .x-axis,
    .legend {
      display: none;
    }
  }
</style>
