---
import Portal from "../layouts/Portal.astro";
import Sidebar from "../components/Sidebar.astro";
import CategoryFilter from "../components/CategoryFilter.astro";
import EntryCard from "../components/EntryCard.astro";
import CategoryThumb from "../components/CategoryThumb.astro";
import DailySummary from "../components/DailySummary.astro";
import TickerBar from "../components/TickerBar.astro";
import TimelineRightRail from "../components/TimelineRightRail.astro";
import Pager from "../components/Pager.astro";
import SourceDisclosure from "../components/SourceDisclosure.astro";
import LanguageFallbackBadge from "../components/LanguageFallbackBadge.astro";
import ExternalLinkHint from "../components/ExternalLinkHint.astro";
import ArxivIcon from "../components/icons/ArxivIcon.astro";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { sourceFaviconUrl } from "../lib/favicon.ts";
import {
  decisionTopicKey,
  selectDiverseDecisionEntries,
} from "../lib/ranking.ts";
import {
  canonicalSourceUrl,
  sourceAuthority,
  sourceLabel,
} from "../lib/source-meta.ts";
import { STATS } from "../lib/stats.ts";
import {
  ALL_ENTRIES,
  ARXIV_ENTRIES,
  MAIN_TIMELINE_ENTRIES,
  PAGE_SIZE,
  CATEGORY_META,
  featured,
  importanceLabel,
  latestListedCollectedAtForEntry,
  relativeTime,
  groupByDay,
  jstDayLabel,
  summaryForLangWithFallback,
  titleForLangWithFallback,
  isPublishableEntry,
  isLowSignalRelease,
  isOffTopicForHero,
  WORKER_HEALTH,
} from "../lib/data.ts";
import { entryDestination } from "../lib/entry-destination.ts";
import { sourceFreshnessStatus } from "../lib/freshness.ts";
import { effectiveImportance, isRoutineReleaseEntry } from "../lib/release-signal.ts";
import { serializeJsonLd } from "../lib/json-ld.ts";
import { deriveWorkerRunStatus, runCadenceLead } from "../lib/run-health.ts";
import { SITE_URL } from "../lib/site.ts";
import {
  HOME_DESCRIPTION_EN,
  HOME_DESCRIPTION_JA,
  HOME_PAGE_METADATA,
  HOME_TITLE_EN,
  HOME_TITLE_JA,
} from "../lib/social-metadata.ts";

// Shared aggregate run state (same derivation as the footer + /status, LL-126).
const runStatus = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const showRunWarning = runStatus.tone !== "ok";

const currentPage = 1;
const primaryEntries = MAIN_TIMELINE_ENTRIES;
const arxivEntries = ARXIV_ENTRIES;
const totalPages = Math.max(1, Math.ceil(primaryEntries.length / PAGE_SIZE));
const pageEntries = primaryEntries.slice(0, PAGE_SIZE);
const dayGroups = groupByDay(pageEntries);
const dayGroupsWithOffsets = dayGroups.map((group, index) => ({
  ...group,
  startIndex: dayGroups
    .slice(0, index)
    .reduce((count, previousGroup) => count + previousGroup.items.length, 0),
}));
const dailySummaryAfterEntryIndex = Math.min(2, pageEntries.length - 1);

const feat = featured();
const featuredId = feat?.id ?? null;
const featuredDestination = feat ? entryDestination(feat) : null;
const featuredTopic = feat ? decisionTopicKey(feat) : null;

const now = new Date();
const ago = relativeTime(DASHBOARD_METRICS.generatedAt, now);
const cadenceLead = runCadenceLead(runStatus);
const activeSourcesLabel = `${DASHBOARD_METRICS.sourceCoverageLabel} sources with live entries`;
const activeSourcesJa = `公開中の記事がある登録ソース ${DASHBOARD_METRICS.sourceCoverageLabel}`;
const activeSourcesEn = `${DASHBOARD_METRICS.sourceCoverageLabel} registry sources with live entries`;

// Top 3 = importance x authority x recency, but only entries with real summaries.
// Limit repeated source/category so the decision list is useful at a glance.
// Routine patch/prerelease releases are excluded even when their stored
// importance is inflated (see release-signal.ts).
const rankedPool = primaryEntries
  .filter(
    (e) =>
      e.importance >= 2 &&
      isPublishableEntry(e) &&
      !isLowSignalRelease(e) &&
      !isOffTopicForHero(e) &&
      !isRoutineReleaseEntry(e),
  );
const topThree = selectDiverseDecisionEntries(rankedPool, {
  featured: feat,
  limit: 3,
  nowMs: now.getTime(),
});
const medals = ["\u{1F947}", "\u{1F948}", "\u{1F949}"];
const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: `${SITE_URL}/`,
  name: "TECH Dashboard",
  alternateName: [HOME_TITLE_JA, HOME_TITLE_EN],
  description: [
    { "@value": HOME_DESCRIPTION_JA, "@language": "ja" },
    { "@value": HOME_DESCRIPTION_EN, "@language": "en" },
  ],
  inLanguage: ["ja-JP", "en"],
  publisher: {
    "@type": "Organization",
    name: "TECH Dashboard",
    url: SITE_URL,
  },
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}/search/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<Portal pageKey="timeline" metadata={HOME_PAGE_METADATA}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={serializeJsonLd(homeJsonLd)} />
  </Fragment>
  <section class="banner">
    <div class="banner-bg-grid"></div>
    <div class="banner-inner">
      <div class="banner-copy" data-reveal="hero-copy">
        <p class="banner-kicker">TECH UPDATE ROUTER</p>
        <h1>
          <span class="i18n-ja">
            今日読むべき技術更新を、<br />
            <span class="brand-accent">判断できる</span>形で。
          </span>
          <span class="i18n-en" lang="en">
            Decide what to read today,<br />
            from one <span class="brand-accent">ranked</span> dashboard.
          </span>
        </h1>
        <p class="tagline tagline-full i18n-ja">
          公式発表、業界ニュース、コミュニティ記事を毎時 1 バッチ収集。各ソースを約 6 時間周期で巡回し、AI 要約と重要度で読む順番を整理します。
        </p>
        <p class="tagline tagline-full i18n-en" lang="en">
          Official releases, industry news, and community posts are collected in one hourly batch; each source is revisited about every 6 hours.
        </p>
        <p class="tagline tagline-compact i18n-ja">毎時1バッチ、約6時間巡回。AI要約で整理。</p>
        <p class="tagline tagline-compact i18n-en" lang="en">One batch hourly; each source about every 6 hours.</p>
        <div class="banner-actions" aria-label="First actions">
          <a class="banner-cta primary" href="#today-priority">
            <span class="i18n-ja">今日の重要記事を見る</span>
            <span class="i18n-en" lang="en">View today's priorities</span>
          </a>
          <button type="button" class="banner-cta" data-search-trigger>
            <span class="i18n-ja">検索する</span>
            <span class="i18n-en" lang="en">Search</span>
          </button>
        </div>
        <div class="banner-quick-links" aria-label="Explore sections">
          <a href="/categories">
            <span class="quick-icon" aria-hidden="true">▦</span>
            <span class="i18n-ja">カテゴリ一覧</span>
            <span class="i18n-en" lang="en">Categories</span>
          </a>
          <a href="/arxiv">
            <span class="quick-icon paper" aria-hidden="true"><ArxivIcon /></span>
            <span class="i18n-ja">arXiv 論文</span>
            <span class="i18n-en" lang="en">arXiv papers</span>
          </a>
          <a href="/knowledge">
            <span class="quick-icon knowledge" aria-hidden="true">✦</span>
            <span class="i18n-ja">ナレッジ</span>
            <span class="i18n-en" lang="en">Knowledge</span>
          </a>
        </div>
      </div>
      <div class="banner-right" data-reveal="hero-panel">
        <div class="dynamic-orbit" aria-hidden="true">
          <span class="orbit-ring orbit-ring-a"></span>
          <span class="orbit-ring orbit-ring-b"></span>
          <span class="scan-beam"></span>
          <div class="orbit-core">
            <span>Hourly</span>
            <strong>Routing</strong>
            <small>ranked feed</small>
          </div>
          <span class="signal-node node-source">{activeSourcesLabel}</span>
          <span class="signal-node node-rank">rank</span>
          <span class="signal-node node-summary">AI summary</span>
          <span class="signal-node node-publish">publish</span>
        </div>
        <div class="banner-facts" aria-label="Dashboard overview">
          <div class="banner-fact" data-cadence-state={runStatus.state}>
            <strong class="i18n-ja">できること</strong>
            <strong class="i18n-en" lang="en">What it does</strong>
            <span class="i18n-ja">要約・重要度・出典から、読む/共有する判断を短時間で行えます。</span>
            <span class="i18n-en" lang="en">Use summaries, importance, and sources to decide what to read or share.</span>
          </div>
          <div class="banner-fact">
            <strong class="i18n-ja">収録中ソース</strong>
            <strong class="i18n-en" lang="en">Active registry sources</strong>
            <span class="i18n-ja">{activeSourcesJa}</span>
            <span class="i18n-en" lang="en">{activeSourcesEn}</span>
          </div>
          <div class="banner-fact">
            <div class="banner-fact-head">
              <strong class="i18n-ja">更新頻度</strong>
              <strong class="i18n-en" lang="en">Cadence</strong>
              <a
                class="banner-run-state"
                href="/status"
                data-banner-run-state
                data-run-tone={runStatus.tone}
                aria-label={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
                title={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
                hidden={!showRunWarning}
              >
                <span class={`dot ${runStatus.tone}`} data-run-tone={runStatus.tone} aria-hidden="true"></span>
                <span class="i18n-ja" data-banner-run-label-ja>{runStatus.stateText}</span>
                <span class="i18n-en" lang="en" data-banner-run-label-en>{runStatus.stateText}</span>
              </a>
            </div>
            <span class="i18n-ja">
              <span data-cadence-lead-ja>{cadenceLead.ja}</span><time datetime={DASHBOARD_METRICS.generatedAt} data-relative-time>{ago}</time>
            </span>
            <span class="i18n-en" lang="en">
              <span data-cadence-lead-en>{cadenceLead.en}</span><time datetime={DASHBOARD_METRICS.generatedAt} data-relative-time>{ago}</time>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TickerBar entries={primaryEntries} excludeEntryIds={featuredId ? [featuredId] : []} now={now} />

  <div class="layout">
    <Sidebar active="all" />

    <main>
        <section
          class="priority-section"
          id="today-priority"
          aria-labelledby="priority-heading"
          aria-describedby="priority-note-ja priority-note-en"
          data-decision-eligibility="summary-ready"
          data-ranking-scope="importance-authority-recency"
          data-ranking-diversity="topic-source-limited"
        >
        <div class="section-header primary section-header-stacked">
          <h2 id="priority-heading">
            <span class="i18n-ja">今日見るべきもの</span>
            <span class="i18n-en" lang="en">Today's decision list</span>
          </h2>
          <p class="section-note i18n-ja" id="priority-note-ja">
            AI 要約が利用できる記事だけを選び、同じ話題と source の重複を抑えて比較します。
          </p>
          <p class="section-note i18n-en" id="priority-note-en" lang="en">
            Only summary-ready articles appear here, with repeated topics and sources limited for comparison.
          </p>
        </div>

      {feat && (() => {
        const featSumJa = summaryForLangWithFallback(feat, "ja");
        const featSumEn = summaryForLangWithFallback(feat, "en");
        const featCat = CATEGORY_META.find((c) => c.slug === feat.category);
        const featCatColor = featCat?.color ?? "#5eead4";
        const featFreshness = sourceFreshnessStatus(
          feat,
          latestListedCollectedAtForEntry(feat),
          now.getTime(),
        );
        const featStale = featFreshness.status === "stale" || featFreshness.status === "error";
        const featImportance = importanceLabel(effectiveImportance(feat));
        const featAuthority = sourceAuthority(feat.source, feat.sourceType);
        const featAuthorityBadgeClass = ["badge", "authority", featAuthority.kind].join(" ");
        const featFavicon = sourceFaviconUrl(canonicalSourceUrl(feat.url));
        const featImg = feat.image?.src ?? "";
        return (
        <article
          class="featured"
          data-pagefind-body
          data-reveal="featured"
          data-source={feat.source}
          data-decision-topic={featuredTopic ?? `entry:${feat.id}`}
          style={`--cat-color:${featCatColor}`}
        >
          <div class:list={["featured-thumb", { "has-image": !!featImg }]}>
            {featImg && (
              <img
                src={featImg}
                alt={feat.image?.alt || feat.title}
                loading="lazy"
                decoding="async"
                onerror="this.closest('.featured-thumb')?.classList.add('failed')"
              />
            )}
            <div class="featured-thumb-fallback" aria-hidden="true">
              <CategoryThumb category={feat.category} seed={feat.id} height="100%" />
            </div>
          </div>
          <div class="featured-body">
            <div class="featured-label">
              <span class="i18n-ja">Spotlight · 要約済みの優先候補</span>
              <span class="i18n-en" lang="en">Spotlight · summary-ready priority pick</span>
            </div>
            <h2 class="featured-title">
              <a
                href={featuredDestination?.href}
                target={featuredDestination?.target}
                rel={featuredDestination?.rel}
                data-detail-destination={featuredDestination?.external ? "source" : "internal"}
              >
                {(() => {
                  const ja = titleForLangWithFallback(feat, "ja");
                  const en = titleForLangWithFallback(feat, "en");
                  return (
                    <>
                      <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                        {ja.isFallback && ja.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={ja.fallbackLang} variant="title" />
                        )}
                        {ja.text}
                        {featuredDestination?.external && <ExternalLinkHint lang="ja" />}
                      </span>
                      <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                        {en.isFallback && en.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={en.fallbackLang} variant="title" />
                        )}
                        {en.text}
                        {featuredDestination?.external && <ExternalLinkHint lang="en" />}
                      </span>
                    </>
                  );
                })()}
              </a>
            </h2>
            <div class="featured-meta">
              <span
                class={featAuthorityBadgeClass}
                data-source-authority={featAuthority.kind}
                data-source-type={feat.sourceType}
                title={`${featAuthority.en} source · ${feat.sourceType}`}
              >
                <span class="i18n-ja">{featAuthority.ja}</span>
                <span class="i18n-en" lang="en">{featAuthority.en}</span>
              </span>
              <span
                class={`badge importance-badge ${featImportance.tone}`}
                data-featured-importance
                data-importance-tone={featImportance.tone}
                data-importance-level={String(feat.importance)}
              >
                <span class="i18n-ja">{featImportance.ja}</span>
                <span class="i18n-en" lang="en">{featImportance.en}</span>
              </span>
              <SourceDisclosure
                class="featured-src"
                label={sourceLabel(feat.source, feat.url)}
                favicon={featFavicon}
                faviconClass="featured-favicon"
                href={canonicalSourceUrl(feat.url)}
                authorityJa={featAuthority.ja}
                authorityEn={featAuthority.en}
              />
              <span>·</span>
              <time datetime={feat.publishedAt} data-relative-time>{relativeTime(feat.publishedAt, now)}</time>
              {featStale && (
                <span class="featured-freshness stale">
                  <span class="i18n-ja">収集元 更新遅延</span>
                  <span class="i18n-en" lang="en">Source feed stale</span>
                </span>
              )}
            </div>
            {featSumJa.text && (
              <p
                class="featured-sum featured-summary i18n-ja"
                lang={featSumJa.fallbackLang === "en" ? "en" : "ja"}
              >
                {featSumJa.isFallback && featSumJa.fallbackLang && (
                  <LanguageFallbackBadge fallbackLang={featSumJa.fallbackLang} variant="summary" />
                )}
                {featSumJa.text}
              </p>
            )}
            {featSumEn.text && (
              <p class="featured-sum featured-summary i18n-en" lang={featSumEn.fallbackLang === "ja" ? "ja" : "en"}>
                {featSumEn.isFallback && featSumEn.fallbackLang && (
                  <LanguageFallbackBadge fallbackLang={featSumEn.fallbackLang} variant="summary" />
                )}
                {featSumEn.text}
              </p>
            )}
          </div>
        </article>
        );
      })()}

      {topThree.length > 0 && (
        <section class="top-rank" data-reveal="top-rank" data-ranking-diversity="topic-source-limited">
          <div class="top-rank-head">
            <span class="top-rank-title">
              <span class="i18n-ja">次に見る Top {topThree.length}</span>
              <span class="i18n-en" lang="en">Next {topThree.length} to review</span>
            </span>
            <span class="top-rank-sub">
              <span class="i18n-ja">要約済み · 話題と source の重複を抑制</span>
              <span class="i18n-en" lang="en">Summary-ready · repeated topics and sources limited</span>
            </span>
          </div>
          <ol class="top-rank-list">
            {topThree.map((e, i) => {
              const meta = CATEGORY_META.find((c) => c.slug === e.category);
              const freshness = sourceFreshnessStatus(
                e,
                latestListedCollectedAtForEntry(e),
                now.getTime(),
              );
              const stale = freshness.status === "stale" || freshness.status === "error";
              const summaryJa = summaryForLangWithFallback(e, "ja");
              const summaryEn = summaryForLangWithFallback(e, "en");
              const rankAuthority = sourceAuthority(e.source, e.sourceType);
              const destination = entryDestination(e);
              const decisionTopic = decisionTopicKey(e);
              return (
                <li
                  class={`top-rank-item rank-${i + 1}`}
                  data-source={e.source}
                  data-decision-topic={decisionTopic ?? `entry:${e.id}`}
                  style={`--cat-color:${meta?.color ?? "#8a847e"}`}
                >
                  <span class="medal" aria-hidden="true">{medals[i]}</span>
                  <a
                    class="rank-content-link"
                    href={destination.href}
                    target={destination.target}
                    rel={destination.rel}
                    data-detail-destination={destination.external ? "source" : "internal"}
                  >
                    <span class="rank-cat" aria-hidden="true">{meta?.emoji ?? "\u{1F4C4}"}</span>
                    <span class="rank-title">
                      {(() => {
                        const ja = titleForLangWithFallback(e, "ja");
                        const en = titleForLangWithFallback(e, "en");
                        return (
                          <>
                            <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                              {ja.isFallback && ja.fallbackLang && (
                                <LanguageFallbackBadge fallbackLang={ja.fallbackLang} variant="title" />
                              )}
                              {ja.text}
                              {destination.external && <ExternalLinkHint lang="ja" />}
                            </span>
                            <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                              {en.isFallback && en.fallbackLang && (
                                <LanguageFallbackBadge fallbackLang={en.fallbackLang} variant="title" />
                              )}
                              {en.text}
                              {destination.external && <ExternalLinkHint lang="en" />}
                            </span>
                          </>
                        );
                      })()}
                    </span>
                    <span class="rank-summary">
                      <span class="i18n-ja" lang={summaryJa.fallbackLang === "en" ? "en" : "ja"}>
                        {summaryJa.isFallback && summaryJa.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={summaryJa.fallbackLang} variant="summary" />
                        )}
                        {summaryJa.text}
                      </span>
                      <span class="i18n-en" lang={summaryEn.fallbackLang === "ja" ? "ja" : "en"}>
                        {summaryEn.isFallback && summaryEn.fallbackLang && (
                          <LanguageFallbackBadge fallbackLang={summaryEn.fallbackLang} variant="summary" />
                        )}
                        {summaryEn.text}
                      </span>
                    </span>
                  </a>
                  <span class="rank-meta">
                    <SourceDisclosure
                      class="rank-source"
                      label={sourceLabel(e.source, e.url)}
                      href={canonicalSourceUrl(e.url)}
                      authorityJa={rankAuthority.ja}
                      authorityEn={rankAuthority.en}
                    />
                    <time class="rank-time mono" datetime={e.publishedAt} data-relative-time>{relativeTime(e.publishedAt, now)}</time>
                    {stale && (
                      <span class="rank-freshness stale">
                        <span class="visually-hidden">
                          <span class="i18n-ja">収集元 更新遅延</span>
                          <span class="i18n-en" lang="en">Source feed stale</span>
                        </span>
                        <span class="rank-freshness-short i18n-ja" aria-hidden="true">遅延</span>
                        <span class="rank-freshness-short i18n-en" lang="en" aria-hidden="true">LATE</span>
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ol>
        </section>
      )}
      </section>

      <section
        class="timeline-section"
        id="timeline"
        aria-labelledby="timeline-heading"
        data-category-filter-scope
      >
        <div class="section-header primary section-header-stacked">
          <h2 id="timeline-heading">
            <span class="i18n-ja">深掘り一覧</span>
            <span class="i18n-en" lang="en">Deep-dive timeline</span>
            <span class="count">
              <span class="i18n-ja">
                {primaryEntries.length} timeline · <a href="/arxiv">{arxivEntries.length} arXiv 論文は専用ページ</a> · page {currentPage}/{totalPages}
              </span>
              <span class="i18n-en" lang="en">
                {primaryEntries.length} timeline · <a href="/arxiv">{arxivEntries.length} arXiv papers on a separate page</a> · page {currentPage}/{totalPages}
              </span>
            </span>
          </h2>
          <p class="section-note i18n-ja">
            arXiv 論文を分離した通常更新の一覧です。カテゴリ・タグ・検索で絞り込んで詳細へ進めます。
          </p>
          <p class="section-note i18n-en" lang="en">
            Browse the non-arXiv update stream by recency, then narrow with category, tags, or search.
          </p>
        </div>

        <CategoryFilter />

        {pageEntries.length === 0 ? (
          <div class="empty-state">
            <strong class="i18n-ja">表示できる更新がありません。</strong>
            <strong class="i18n-en" lang="en">No updates are available.</strong>
            <p class="i18n-ja">次回の毎時収集後に再度確認するか、Status で source 更新状況を確認してください。</p>
            <p class="i18n-en" lang="en">Check again after the next hourly run, or open Status to inspect source freshness.</p>
            <a href="/status">Status</a>
          </div>
        ) : (
          dayGroupsWithOffsets.map(({ key, items, startIndex }) => (
            <>
              <div class="day-header">
                <span>{jstDayLabel(key, now)}</span>
                <span class="day-count">{items.length} entries</span>
              </div>
              {items.map((entry, entryIndex) => (
                <>
                  <EntryCard entry={entry} />
                  {startIndex + entryIndex === dailySummaryAfterEntryIndex && (
                    <DailySummary
                      entries={ALL_ENTRIES}
                      boardEntries={primaryEntries}
                      stats={STATS}
                      now={now}
                    />
                  )}
                </>
              ))}
            </>
          ))
        )}

        <Pager currentPage={currentPage} totalPages={totalPages} baseHref="" />
      </section>
    </main>

    <TimelineRightRail entries={primaryEntries} now={now} label="Timeline insights" />
  </div>
</Portal>
