---
/**
 * Card for the Knowledge lane (evergreen best-practice / engineering guides).
 * Uniform horizontal layout: every card has the SAME structure and height
 * whether or not it has an image (LL-096). A fixed-width thumbnail slot on the
 * left shows the OGP image when present, otherwise a small, subtle
 * category-tinted placeholder (not the wasteful full-width 16:9 artwork of
 * LL-094). Body on the right: source, title, summary.
 */
import {
  CATEGORY_META,
  entryHref,
  relativeTime,
  titleForLangWithFallback,
  summaryForLangWithFallback,
  type NormalizedEntry,
} from "../lib/data.ts";
import { sourceFaviconUrl, sourceHost } from "../lib/favicon.ts";

export interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;

const meta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = meta?.color ?? "#34d399";
const catEmoji = meta?.emoji ?? "\u{1F4DA}";

const titleJa = titleForLangWithFallback(entry, "ja");
const titleEn = titleForLangWithFallback(entry, "en");
const sumJa = summaryForLangWithFallback(entry, "ja");
const sumEn = summaryForLangWithFallback(entry, "en");
const rel = relativeTime(entry.publishedAt ?? entry.collectedAt);
const siteHost = sourceHost(entry.url);
const favicon = sourceFaviconUrl(entry.url);
const tags = (entry.tags ?? []).slice(0, 2);

const imgSrc = typeof entry.image?.src === "string" && entry.image.src.length > 0 ? entry.image.src : "";
const hasImage = imgSrc.length > 0;
---

<article class={`kg-card${hasImage ? "" : " no-image"}`} style={`--cat-color:${catColor}`}>
  <a class="kg-card-link" href={entryHref(entry)}>
    <div class="kg-thumb">
      {hasImage && (
        <img
          src={imgSrc}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.kg-card')?.classList.add('no-image'); this.remove()"
        />
      )}
      <span class="kg-thumb-mark" aria-hidden="true">{catEmoji}</span>
    </div>

    <div class="kg-body">
      <div class="kg-src">
        {favicon && <img class="kg-favicon" src={favicon} alt="" width="16" height="16" loading="lazy" />}
        <span class="kg-host">{siteHost}</span>
        <span class="kg-dot" aria-hidden="true">·</span>
        <time class="kg-time" datetime={entry.publishedAt}>{rel}</time>
      </div>

      <h3 class="kg-title">
        <span class="i18n-ja" lang={titleJa.fallbackLang === "en" ? "en" : "ja"}>
          {titleJa.isFallback && <span class="lang-badge">[en]</span>}{titleJa.text}
        </span>
        <span class="i18n-en" lang={titleEn.fallbackLang === "ja" ? "ja" : "en"}>
          {titleEn.isFallback && <span class="lang-badge">[ja]</span>}{titleEn.text}
        </span>
      </h3>

      {sumJa.text && (
        <p class="kg-sum i18n-ja" lang={sumJa.fallbackLang === "en" ? "en" : "ja"}>{sumJa.text}</p>
      )}
      {sumEn.text && (
        <p class="kg-sum i18n-en" lang={sumEn.fallbackLang === "ja" ? "ja" : "en"}>{sumEn.text}</p>
      )}

      {tags.length > 0 && (
        <div class="kg-tags">
          {tags.map((t) => (
            <span class="kg-tag">#{t}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .kg-card {
    --cat-color: #34d399;
    display: flex;
  }
  /* Uniform horizontal card: SAME structure & height for every entry, with or
     without an image (LL-096). Fixed-width thumbnail slot on the left. */
  .kg-card-link {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    width: 100%;
    /* Fixed height so every card is identical regardless of content (LL-096).
       min-height let cards vary when an entry lacked tags or had a 1-line title
       (exposed once summary-first made more evergreen entries publishable). */
    height: 152px;
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2, rgba(148, 163, 184, 0.04));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .kg-card-link:hover,
  .kg-card-link:focus-visible {
    border-color: color-mix(in srgb, var(--cat-color) 50%, var(--border));
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
    outline: 0;
  }
  /* Thumbnail slot — always present so layout is identical regardless of image. */
  .kg-thumb {
    position: relative;
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cat-color) 24%, transparent), rgba(20, 19, 15, 0.85)),
      #14130f;
    overflow: hidden;
  }
  .kg-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Small subtle emoji placeholder — only visible when there is no image (it
     sits behind the img). Far smaller than the old wasteful 16:9 block (LL-094). */
  .kg-thumb-mark {
    font-size: 1.7rem;
    line-height: 1;
    opacity: 0.85;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.4));
  }
  .kg-body {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    padding: 0.6rem 0.75rem 0.65rem;
    min-width: 0;
  }
  .kg-src {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-muted, #94a3b8);
    min-width: 0;
  }
  .kg-favicon {
    border-radius: 3px;
    flex-shrink: 0;
  }
  .kg-host {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kg-dot {
    opacity: 0.5;
  }
  .kg-time {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .kg-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text, #e9e7e3);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    /* Reserve exactly 2 lines so 1-line and 2-line titles take equal space
       (keeps card height uniform under fixed-height layout, LL-096). */
    min-height: 2.52rem;
  }
  .kg-sum {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted, #94a3b8);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 2.34rem;
  }
  .kg-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.1rem;
  }
  .kg-tag {
    font-size: 0.67rem;
    padding: 0.1rem 0.42rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-color) 14%, transparent);
    color: color-mix(in srgb, var(--cat-color) 80%, #cbd5e1);
  }
  .lang-badge {
    display: inline-block;
    margin-right: 0.3rem;
    padding: 0 0.3rem;
    border-radius: 4px;
    font-size: 0.66rem;
    font-weight: 700;
    background: rgba(148, 163, 184, 0.18);
    color: var(--text-muted, #94a3b8);
    vertical-align: middle;
  }
  @media (max-width: 460px) {
    .kg-card-link {
      grid-template-columns: 92px minmax(0, 1fr);
      height: 148px;
    }
  }
</style>
