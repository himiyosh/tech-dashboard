---
interface AttentionSource {
  status: "error" | "stale";
  anchorId: string;
  displayName: string;
  categoryName: string;
  count: number;
  latestRelative: string;
}

interface Props {
  sources: AttentionSource[];
  id: string;
  extraClass?: string;
}

const { sources, id, extraClass = "" } = Astro.props;
const statusCopy = {
  error: {
    ja: "収集状況の確認が必要",
    en: "Collection needs review",
  },
  stale: {
    ja: "更新間隔が長くなっています",
    en: "Collection may be delayed",
  },
} as const;
---

<div class:list={["side-card", "status-insight-card", extraClass]} id={id}>
  <div class="rail-title">
    <span class="i18n-ja">要確認</span>
    <span class="i18n-en" lang="en">Needs review</span>
  </div>
  {sources.length > 0 ? (
    <ul class="status-attention-list" aria-label="Sources requiring attention">
      {sources.map((s) => (
        <li class={`attention-${s.status}`} data-source-status={s.status}>
          <a
            href={`#${s.anchorId}`}
            aria-describedby={`${id}-${s.anchorId}-status`}
          >{s.displayName}</a>
          <small id={`${id}-${s.anchorId}-status`}>
            <span class="i18n-ja">
              {statusCopy[s.status].ja} · {s.categoryName}
              {s.count > 0 ? ` · 最終収集 ${s.latestRelative}` : " · 収集済み記事なし"}
            </span>
            <span class="i18n-en" lang="en">
              {statusCopy[s.status].en} · {s.categoryName}
              {s.count > 0 ? ` · last collected ${s.latestRelative}` : " · no collected entries"}
            </span>
          </small>
        </li>
      ))}
    </ul>
  ) : (
    <p>
      <span class="i18n-ja">確認が必要な収集元はありません。</span>
      <span class="i18n-en" lang="en">No sources currently need review.</span>
    </p>
  )}
</div>
