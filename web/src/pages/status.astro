---
import Portal from "../layouts/Portal.astro";
import Sidebar from "../components/Sidebar.astro";
import { ALL_ENTRIES, GENERATED_AT, WORKER_HEALTH, relativeTime } from "../lib/data.ts";
import { SOURCE_META } from "../lib/source-meta.ts";

const now = new Date();
const SIX_H = 6 * 3600_000;
const WARN_H = 42 * 3600_000;

const sources = SOURCE_META.map((def) => {
  const fromSource = ALL_ENTRIES.filter((e) => e.source === def.id);
  const latest = fromSource.reduce(
    (acc, e) => {
      if (!e.publishedAt) return acc;
      return e.publishedAt > acc ? e.publishedAt : acc;
    },
    "1970-01-01T00:00:00Z",
  );
  const ageMs = now.getTime() - new Date(latest).getTime();
  const status =
    fromSource.length === 0 ? "error" : ageMs > WARN_H ? "stale" : "ok";
  return {
    id: def.id,
    displayName: def.displayName,
    category: def.category,
    tier: def.tier,
    count: fromSource.length,
    latest,
    status,
  };
});

const ok = sources.filter((s) => s.status === "ok").length;
const stale = sources.filter((s) => s.status === "stale").length;
const error = sources.filter((s) => s.status === "error").length;

// Worker health badge: ok / warn / err based on age and copilot status.
const wh = WORKER_HEALTH;
const lastRunAge = wh ? now.getTime() - new Date(wh.lastRunAt).getTime() : null;
const lastRunHours = lastRunAge !== null ? lastRunAge / 3600_000 : null;
let workerStatus: "ok" | "warn" | "err" = "ok";
let workerLabel = "healthy";
if (!wh) {
  workerStatus = "warn";
  workerLabel = "no data (legacy index)";
} else if (lastRunHours !== null && lastRunHours > 6) {
  workerStatus = "err";
  workerLabel = "no run in 6h+";
} else if (!wh.copilotOk) {
  workerStatus = "warn";
  workerLabel = "summarize disabled";
} else if (wh.sourcesFailed.length > 0) {
  workerStatus = "warn";
  workerLabel = `${wh.sourcesFailed.length} source error`;
}
const workerColor =
  workerStatus === "ok" ? "var(--success)" : workerStatus === "warn" ? "var(--important)" : "var(--danger)";
---

<Portal pageKey="status" title="Status — TECH Dashboard">
  <div class="layout">
    <Sidebar />

    <main>
      <div class="section-header primary">
        <h2>
          Worker Health
          <span class="count">batch ローテーション · 毎時実行</span>
        </h2>
      </div>

      <div class="side-card" style="padding:16px 20px;margin-bottom:14px">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
          <span class="status" style={`background:${workerColor};width:10px;height:10px;border-radius:50%;display:inline-block`}></span>
          <strong style="font-size:14px">{workerLabel}</strong>
          {wh && (
            <span style="color:var(--muted);font-size:12px;margin-left:auto">
              最終実行: {relativeTime(wh.lastRunAt, now)}
            </span>
          )}
        </div>
        {wh ? (
          <table style="width:100%;font-size:12.5px;color:var(--text-2);border-collapse:collapse">
            <tbody>
              <tr>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">直近 batch</td>
                <td><strong>{wh.batchIndex} / {wh.batchTotal}</strong></td>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">収集成功</td>
                <td><strong>{wh.sourcesOk} / {wh.sourcesAttempted}</strong> sources</td>
              </tr>
              <tr>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">Copilot 要約</td>
                <td>
                  {wh.copilotOk ? (
                    <span style="color:var(--success)">OK</span>
                  ) : (
                    <span style="color:var(--danger)" title={wh.copilotError ?? ""}>
                      NG ({wh.copilotError ? wh.copilotError.slice(0, 40) : "unknown"})
                    </span>
                  )}
                </td>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">本 run 要約</td>
                <td><strong>+{wh.summarized}</strong> ({wh.summarizeErrors} err)</td>
              </tr>
              <tr>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">og:image cache</td>
                <td><strong>{wh.ogCached}</strong> URL ({wh.ogNewHits} new)</td>
                <td style="padding:3px 8px 3px 0;color:var(--muted)">失敗 source</td>
                <td>
                  {wh.sourcesFailed.length === 0
                    ? "なし"
                    : <span style="color:var(--important);font-family:ui-monospace,monospace;font-size:11.5px">{wh.sourcesFailed.join(", ")}</span>}
                </td>
              </tr>
            </tbody>
          </table>
        ) : (
          <p style="color:var(--muted);font-size:12.5px;line-height:1.6">
            このバージョンの <code>data/index.json</code> には Worker health メタデータが含まれていません。
            次回 Worker run 後に表示されます。
          </p>
        )}
      </div>

      <div class="section-header primary">
        <h2>
          Source Health
          <span class="count">{sources.length} sources</span>
        </h2>
      </div>

      <div class="stats" style="padding:0 0 16px">
        <div class="stat">
          <span>Healthy</span>
          <span class="value" style="color:var(--success)">{ok}</span>
        </div>
        <div class="stat">
          <span>Stale</span>
          <span class="value" style="color:var(--important)">{stale}</span>
        </div>
        <div class="stat">
          <span>Error</span>
          <span class="value" style="color:var(--danger)">{error}</span>
        </div>
        <div class="stat">
          <span>Index</span>
          <span class="value" style="font-size:13px">{relativeTime(GENERATED_AT, now)}</span>
        </div>
      </div>

      <div class="side-card">
        {sources.map((s) => {
          const dotColor = s.status === "ok" ? "var(--success)" : s.status === "stale" ? "var(--important)" : "var(--danger)";
          return (
            <div class="source-item">
              <span class="status" style={`background:${dotColor}`}></span>
              <span class="name">
                {s.displayName}
                <span style="color:var(--muted-2);margin-left:8px;font-size:11px">
                  tier {s.tier} · {s.category}
                </span>
              </span>
              <span class="time">
                {s.count} · {s.status === "error" ? "no data" : relativeTime(s.latest, now)}
              </span>
            </div>
          );
        })}
      </div>

      <p style="color:var(--muted);font-size:12px;margin-top:12px;line-height:1.6">
        <strong style="color:var(--text-2)">status</strong>:
        <span style="color:var(--success)">ok</span> = 最新が 42h 以内に収集 ·
        <span style="color:var(--important)">stale</span> = 42h 以上経過 ·
        <span style="color:var(--danger)">error</span> = 直近 run でデータなし
      </p>
    </main>

    <aside class="right"></aside>
  </div>
</Portal>
