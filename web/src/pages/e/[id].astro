              const rMeta = CATEGORY_META.find((c) => c.slug === r.category);
              const rColor = rMeta?.color ?? catColor;
              return (
                <a class="ed-rel-card" href={`/e/${r.id}/`} style={`--cat-color:${rColor}`}>
                  <div class="ed-rel-thumb">
                    {r.image?.src ? (
                      <img src={r.image.src} alt={r.image.alt || rTitle} loading="lazy" decoding="async" onerror="this.parentElement.classList.add('failed')" />
