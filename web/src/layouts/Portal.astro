---
import "../styles/portal.css";

export interface Props {
  title?: string;
  description?: string;
  pageKey?: "timeline" | "categories" | "sources" | "archive" | "status" | "about";
  breadcrumb?: Array<{ label: string; href?: string }>;
}

const {
  title = "TECH Dashboard — Pulse of the AI Ecosystem",
  description = "Copilot / Claude / Codex / Local LLM / Research の公式情報を 1 時間ごとに自動収集・要約。",
  pageKey = "timeline",
  breadcrumb,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TECH Dashboard RSS" href="/rss.xml" />
    <link rel="alternate" type="application/json" title="TECH Dashboard JSON Feed" href="/feed.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800&display=swap"
    />
    <slot name="head" />
    <script is:inline>
      // Pre-paint: apply saved language to avoid flash.
      (function () {
        try {
          var l = localStorage.getItem("td:lang");
          if (l !== "ja" && l !== "en") l = "ja";
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
        } catch (_) {
          document.documentElement.setAttribute("data-lang", "ja");
        }
      })();
    </script>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3044810068333301"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a class="logo" href="/">
          <span class="logo-mark"></span>
          <span class="logo-text">TECH <span class="logo-accent">Dashboard</span></span>
        </a>
        <nav class="nav">
          <a href="/" data-mobile-primary class={pageKey === "timeline" ? "active" : ""}>Timeline</a>
          <a href="/categories" data-mobile-primary class={pageKey === "categories" ? "active" : ""}>Categories</a>
          <a href="/archive" data-mobile-primary class={pageKey === "archive" ? "active" : ""}>Archive</a>
          <a href="/status" data-mobile-primary class={pageKey === "status" ? "active" : ""}>Status</a>
          <a href="/about" data-mobile-primary class={pageKey === "about" ? "active" : ""}>About</a>
        </nav>
        <div class="search">
          <span aria-hidden="true">🔍</span>
          <input
            type="search"
            id="pagefind-search-input"
            aria-label="Search updates"
            aria-controls="pagefind-results"
            aria-expanded="false"
            role="combobox"
            placeholder="search updates..."
            autocomplete="off"
          />
          <span class="search-keys" aria-hidden="true"><kbd>/</kbd><kbd>⌘K</kbd></span>
          <div id="pagefind-results" class="search-results" role="listbox" aria-live="polite" aria-label="Search results" hidden></div>
          <div id="pagefind-status" class="sr-only" role="status" aria-live="polite"></div>
        </div>
        <div class="lang-toggle" role="group" aria-label="Language">
          <button type="button" class="lang-btn" data-lang="ja" aria-pressed="true">JA</button>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>
      </div>
      {breadcrumb && breadcrumb.length > 0 && (
        <div class="crumb-bar">
          <div class="crumb-inner">
            {breadcrumb.map((b, i) => (
              <>
                {b.href ? <a href={b.href}>{b.label}</a> : <span class="current">{b.label}</span>}
                {i < breadcrumb.length - 1 && <span class="sep">›</span>}
              </>
            ))}
          </div>
        </div>
      )}
    </header>

    <slot />

    <div class="footer-bar">
      <div class="footer-inner">
        <span class="item"><span class="dot"></span> <strong>healthy</strong></span>
        <span class="item">harness <strong>v0.1</strong></span>
        <span class="item">powered by <strong>Astro</strong> + <strong>Claude Sonnet</strong></span>
        <span class="spacer"></span>
        <span class="item">Cloudflare Pages</span>
      </div>
    </div>

    <nav class="mobile-tabbar" aria-label="Primary">
      <a href="/" class={pageKey === "timeline" ? "active" : ""}><span aria-hidden="true">⌂</span><span>Timeline</span></a>
      <a href="/categories" class={pageKey === "categories" ? "active" : ""}><span aria-hidden="true">▦</span><span>Categories</span></a>
      <a href="/archive" class={pageKey === "archive" ? "active" : ""}><span aria-hidden="true">🗄</span><span>Archive</span></a>
      <a href="/status" class={pageKey === "status" ? "active" : ""}><span aria-hidden="true">●</span><span>Status</span></a>
      <a href="/about" class={pageKey === "about" ? "active" : ""}><span aria-hidden="true">ℹ</span><span>About</span></a>
      <button type="button" id="mobile-search-trigger"><span aria-hidden="true">⌕</span><span>Search</span></button>
    </nav>

    <script>
      // Language toggle (Ja / En) — sync with <html data-lang="...">.
      (() => {
        const apply = (l: "ja" | "en") => {
          document.documentElement.setAttribute("data-lang", l);
          document.documentElement.setAttribute("lang", l);
          try { localStorage.setItem("td:lang", l); } catch {}
          document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
            const on = b.dataset.lang === l;
            b.setAttribute("aria-pressed", on ? "true" : "false");
            b.classList.toggle("is-active", on);
          });
        };
        const current =
          (document.documentElement.getAttribute("data-lang") as "ja" | "en") || "ja";
        apply(current);
        document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((b) => {
          b.addEventListener("click", () => {
            const l = (b.dataset.lang as "ja" | "en") || "ja";
            apply(l);
          });
        });
      })();

      // Lazy-load Pagefind and wire to the existing input.
      (async () => {
        const input = document.getElementById("pagefind-search-input") as HTMLInputElement | null;
        const panel = document.getElementById("pagefind-results") as HTMLDivElement | null;
        const status = document.getElementById("pagefind-status") as HTMLDivElement | null;
        const mobileTrigger = document.getElementById("mobile-search-trigger") as HTMLButtonElement | null;
        const searchRoot = input?.closest(".search") as HTMLElement | null;
        if (!input || !panel || !searchRoot) return;

        let pf: any = null;
        let activeIndex = -1;
        try {
          const pfUrl = "/pagefind/pagefind.js";
          pf = await import(/* @vite-ignore */ pfUrl);
          await pf.init();
          (window as any).__pagefind = pf;
        } catch {
          // Dev/preview — Pagefind index not built yet.
        }

        const escapeHtml = (value: string) =>
          value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char] ?? char));
        const sanitizeExcerpt = (value: string) =>
          escapeHtml(value).replace(/&lt;(\/?)mark&gt;/g, "<$1mark>");
        const setStatus = (message: string) => {
          if (status) status.textContent = message;
        };
        const setExpanded = (expanded: boolean) => {
          input.setAttribute("aria-expanded", expanded ? "true" : "false");
          panel.hidden = !expanded;
        };
        const openSearch = () => {
          searchRoot.classList.add("is-open");
          input.focus();
        };
        const closeSearch = () => {
          input.value = "";
          searchRoot.classList.remove("is-open");
          setExpanded(false);
          input.blur();
        };
        const hitItems = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>(".search-hit"));
        const setActive = (nextIndex: number) => {
          const hits = hitItems();
          if (hits.length === 0) {
            activeIndex = -1;
            input.removeAttribute("aria-activedescendant");
            return;
          }
          activeIndex = (nextIndex + hits.length) % hits.length;
          hits.forEach((hit, index) => {
            const active = index === activeIndex;
            hit.classList.toggle("is-active", active);
            hit.setAttribute("aria-selected", active ? "true" : "false");
            if (active) {
              input.setAttribute("aria-activedescendant", hit.id);
              hit.scrollIntoView({ block: "nearest" });
            }
          });
        };

        const renderResults = async (q: string) => {
          activeIndex = -1;
          if (!q) {
            setExpanded(false);
            panel.innerHTML = "";
            setStatus("");
            return;
          }
          if (!pf) {
            setExpanded(true);
            panel.innerHTML = `<div class="search-empty">Search index not built yet. Run <code>npm run build</code>.</div>`;
            setStatus("Search index is not built yet.");
            return;
          }
          const search = await pf.search(q);
          const items = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));
          setExpanded(true);
          if (items.length === 0) {
            panel.innerHTML = `<div class="search-empty">No results for <strong>${escapeHtml(q)}</strong></div>`;
            setStatus(`No results for ${q}.`);
            return;
          }
          setStatus(`${items.length} search results for ${q}.`);
          panel.innerHTML = items
            .map(
              (d: any) => `
              <a class="search-hit" id="search-hit-${Math.random().toString(36).slice(2)}" role="option" aria-selected="false" href="${escapeHtml(d.url)}">
                <div class="search-hit-title">${escapeHtml(d.meta?.title || d.url)}</div>
                <div class="search-hit-excerpt">${sanitizeExcerpt(d.excerpt || "")}</div>
                <div class="search-hit-meta">${escapeHtml(d.url.replace(/^https?:\/\/[^/]+/, "") || "/")}</div>
              </a>`,
            )
            .join("");
          setActive(0);
        };

        let t: number | undefined;
        input.addEventListener("input", () => {
          const q = input.value.trim();
          window.clearTimeout(t);
          t = window.setTimeout(() => renderResults(q), 120);
        });
        input.addEventListener("focus", () => {
          if (input.value.trim()) renderResults(input.value.trim());
        });
        mobileTrigger?.addEventListener("click", () => openSearch());
        input.form?.addEventListener("submit", (e) => e.preventDefault());
        document.addEventListener("keydown", (e) => {
          const isTextInput = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement;
          const wantsSearch = e.key === "/" || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k");
          if (wantsSearch && !isTextInput) {
            e.preventDefault();
            openSearch();
          }
        });
        document.addEventListener("click", (e) => {
          const target = e.target as Node;
          if (!searchRoot.contains(target) && !mobileTrigger?.contains(target)) {
            if (input.value.trim()) {
              setExpanded(false);
            }
            searchRoot.classList.remove("is-open");
          }
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeSearch();
          } else if (e.key === "ArrowDown") {
            e.preventDefault();
            setActive(activeIndex + 1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            setActive(activeIndex - 1);
          } else if (e.key === "Enter" && activeIndex >= 0) {
            const hit = hitItems()[activeIndex];
            if (hit) {
              e.preventDefault();
              hit.click();
            }
          }
        });
      })();
    </script>
  </body>
</html>
