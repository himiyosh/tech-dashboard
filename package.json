{
  "name": "tech-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Daily AI tech dashboard driven by registry-defined categories and sources",
  "type": "module",
  "scripts": {
    "collect": "tsx --env-file-if-exists=.env.local harness/orchestrator.ts",
    "collect:dry": "tsx --env-file-if-exists=.env.local harness/orchestrator.ts --dry-run",
    "summaries:apply-cache": "tsx scripts/apply-summary-cache.mjs",
    "ogp:backfill": "node scripts/fetch-missing-ogp.mjs",
    "archive:trim-hot": "node scripts/trim-archive-hot-summaries.mjs",
    "noise:clean": "tsx scripts/clean-source-noise.mjs",
    "titles:backfill": "tsx scripts/backfill-release-titles.mjs",
    "summaries:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-summaries.mjs",
    "summaries:migrate-pending": "tsx scripts/migrate-stuck-summaries-to-pending.mjs",
    "migrate:evergreen": "tsx scripts/migrate-evergreen.mjs",
    "body:strip-filler": "node scripts/strip-filler-body.mjs",
    "body:migrate": "node scripts/migrate-bodies-to-file.mjs",
    "titleen:fill": "node scripts/fill-title-en.mjs",
    "publisher:contract": "node scripts/update-publisher-contract.mjs",
    "publisher:run": "tsx scripts/run-publisher.ts",
    "auth:setup": "bash scripts/setup-copilot-auth.sh",
    "auth:rotate": "bash scripts/setup-copilot-auth.sh --rotate",
    "auth:device": "tsx scripts/copilot-device-login.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "npm --prefix worker run typecheck",
    "lint": "tsc --noEmit",
    "pretest": "node scripts/ensure-web-deps.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs --current",
    "secrets:scan:worktree": "node scripts/scan-secrets.mjs --worktree",
    "secrets:scan:history": "node scripts/scan-secrets.mjs --history",
    "audit:root": "npm audit --audit-level=moderate",
    "audit:web": "npm --prefix web audit --audit-level=moderate",
    "audit:all": "npm run audit:root && npm run audit:web",
    "build:web": "npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run typecheck && npm run typecheck:worker && npm test && npm run build:web && npm run test:e2e",
    "health:prod": "node scripts/check-production-health.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
