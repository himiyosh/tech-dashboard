---
export interface PageHeroMetric {
  label: string;
  labelEn?: string;
  value: string | number;
  datetime?: string;
  detail: string;
  detailEn: string;
  scope: string;
}

export interface PageHeroAction {
  href: string;
  label: string;
  labelEn?: string;
  mediaType?: string;
  mobilePriority?: boolean;
}

export interface Props {
  kicker: string;
  title: string;
  titleEn?: string;
  count?: string;
  countEn?: string;
  description: string;
  descriptionEn?: string;
  headingId: string;
  accent?: string;
  className?: string;
  metrics?: PageHeroMetric[];
  actions?: PageHeroAction[];
}

const {
  kicker,
  title,
  titleEn,
  count,
  countEn,
  description,
  descriptionEn,
  headingId,
  accent,
  className = "",
  metrics = [],
  actions = [],
} = Astro.props;
const hasMobilePriorityActions = actions.some((action) => action.mobilePriority);
const descriptionId = `${headingId}-description`;
---

<section
  class:list={[
    "page-hero",
    className,
    { "page-hero-mobile-priority": hasMobilePriorityActions },
  ]}
  style={accent ? `--page-hero-accent:${accent}` : undefined}
  aria-labelledby={headingId}
  aria-describedby={descriptionId}
>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="page-kicker">{kicker}</p>
      <h1 id={headingId}>
        {titleEn ? (
          <>
            <span class="i18n-ja">{title}</span>
            <span class="i18n-en" lang="en">{titleEn}</span>
          </>
        ) : title}
        {count && (
          <span class="page-count">
            {countEn ? (
              <>
                <span class="i18n-ja">{count}</span>
                <span class="i18n-en" lang="en">{countEn}</span>
              </>
            ) : count}
          </span>
        )}
      </h1>
      <p id={descriptionId} class="page-hero-description">
        {descriptionEn ? (
          <>
            <span class="i18n-ja">{description}</span>
            <span class="i18n-en" lang="en">{descriptionEn}</span>
          </>
        ) : description}
      </p>
      {actions.length > 0 && (
        <div
          class:list={[
            "page-hero-actions",
            { "has-mobile-priority-actions": hasMobilePriorityActions },
          ]}
          aria-label={`${title} shortcuts`}
        >
          {actions.map((action) => (
            <a
              href={action.href}
              type={action.mediaType}
              class:list={{ "page-hero-action-mobile": action.mobilePriority }}
            >
              {action.labelEn ? (
                <>
                  <span class="i18n-ja">{action.label}</span>
                  <span class="i18n-en" lang="en">{action.labelEn}</span>
                </>
              ) : action.label}
            </a>
          ))}
        </div>
      )}
    </div>

    {metrics.length > 0 && (
      <div class="page-hero-metrics" aria-label={`${title} summary`}>
        {metrics.map((metric, index) => {
          const detailId = `${headingId}-metric-${index + 1}-detail`;
          return (
            <div
              class="page-hero-metric"
              role="group"
              data-metric-scope={metric.scope}
              aria-describedby={detailId}
            >
              <span>
                {metric.labelEn ? (
                  <>
                    <span class="i18n-ja">{metric.label}</span>
                    <span class="i18n-en" lang="en">{metric.labelEn}</span>
                  </>
                ) : metric.label}
              </span>
              <strong>
                {metric.datetime ? (
                  <time datetime={metric.datetime} data-relative-time>{metric.value}</time>
                ) : metric.value}
              </strong>
              <small id={detailId} class="page-hero-metric-detail">
                <span class="i18n-ja">{metric.detail}</span>
                <span class="i18n-en" lang="en">{metric.detailEn}</span>
              </small>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
