                    {r.image?.src ? (
                      <img src={r.image.src} alt={r.image.alt || rTitle} loading="lazy" decoding="async" onerror="this.parentElement.classList.add('failed')" />
                    ) : null}
                    <div class="ed-rel-thumb-fallback">
                      <CategoryThumb category={r.category} seed={r.id} height="100%" />
                    </div>
                    {r.importance === 3 && <span class="ed-rel-thumb-hot">🔥 HOT</span>}
                  </div>
                  <div class="ed-rel-cardbody">
                    <div class="ed-rel-title">{rTitle}</div>
                    <div class="ed-rel-meta">
                      <span class="ed-rel-src">{sourceLabel(r.source)}</span>
                      <span class="ed-rel-time">{relativeTime(r.publishedAt, now)}</span>
