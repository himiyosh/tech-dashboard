---
/**
 * Card for the Knowledge lane (evergreen best-practice / engineering guides).
 * Always shows a visual: the entry's OGP image when available, otherwise a
 * deterministic category-tinted artwork (never a blank/broken thumb). Compact
 * but polished — avoids the heavy Timeline EntryCard that over-inflated the
 * lane layout (LL-091) and the bare text list that looked sparse (LL-093).
 */
import {
  CATEGORY_META,
  entryHref,
  relativeTime,
  titleForLangWithFallback,
  summaryForLangWithFallback,
  type NormalizedEntry,
} from "../lib/data.ts";

export interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;

const meta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = meta?.color ?? "#34d399";
const catEmoji = meta?.emoji ?? "\u{1F4DA}";

function host(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
}
function faviconUrl(url: string, size = 32): string {
  const h = host(url);
  return h ? `https://www.google.com/s2/favicons?sz=${size}&domain=${h}` : "";
}

const titleJa = titleForLangWithFallback(entry, "ja");
const titleEn = titleForLangWithFallback(entry, "en");
const sumJa = summaryForLangWithFallback(entry, "ja");
const sumEn = summaryForLangWithFallback(entry, "en");
const rel = relativeTime(entry.publishedAt ?? entry.collectedAt);
const siteHost = host(entry.url);
const favicon = faviconUrl(entry.url);
const tags = (entry.tags ?? []).slice(0, 3);

// Deterministic artwork seed → stable gradient angle per entry.
const seed = Array.from(entry.id).reduce((a, c) => a + c.charCodeAt(0), 0);
const angle = seed % 360;
const hasImage = Boolean(entry.image);
---

<article class="kg-card" style={`--cat-color:${catColor}`}>
  <a class="kg-card-link" href={entryHref(entry)}>
    <div class={`kg-thumb${hasImage ? " has-image" : ""}`}>
      {hasImage && (
        <img
          src={entry.image}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.closest('.kg-thumb')?.classList.remove('has-image')"
        />
      )}
      <div class="kg-thumb-art" aria-hidden="true" style={`--angle:${angle}deg`}>
        <span class="kg-thumb-emoji">{catEmoji}</span>
      </div>
    </div>

    <div class="kg-body">
      <div class="kg-src">
        {favicon && <img class="kg-favicon" src={favicon} alt="" width="16" height="16" loading="lazy" />}
        <span class="kg-host">{siteHost}</span>
        <span class="kg-dot" aria-hidden="true">·</span>
        <time class="kg-time" datetime={entry.publishedAt}>{rel}</time>
      </div>

      <h3 class="kg-title">
        <span class="i18n-ja" lang={titleJa.fallbackLang === "en" ? "en" : "ja"}>
          {titleJa.isFallback && <span class="lang-badge">[en]</span>}{titleJa.text}
        </span>
        <span class="i18n-en" lang={titleEn.fallbackLang === "ja" ? "ja" : "en"}>
          {titleEn.isFallback && <span class="lang-badge">[ja]</span>}{titleEn.text}
        </span>
      </h3>

      {sumJa.text && (
        <p class="kg-sum i18n-ja" lang={sumJa.fallbackLang === "en" ? "en" : "ja"}>{sumJa.text}</p>
      )}
      {sumEn.text && (
        <p class="kg-sum i18n-en" lang={sumEn.fallbackLang === "ja" ? "ja" : "en"}>{sumEn.text}</p>
      )}

      {tags.length > 0 && (
        <div class="kg-tags">
          {tags.map((t) => (
            <span class="kg-tag">#{t}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .kg-card {
    --cat-color: #34d399;
  }
  .kg-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2, rgba(148, 163, 184, 0.04));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .kg-card-link:hover,
  .kg-card-link:focus-visible {
    border-color: color-mix(in srgb, var(--cat-color) 50%, var(--border));
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
    outline: 0;
  }
  .kg-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #14130f;
  }
  .kg-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }
  .kg-thumb.has-image img {
    display: block;
  }
  .kg-thumb-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 18% 12%, color-mix(in srgb, var(--cat-color) 34%, transparent), transparent 60%),
      linear-gradient(var(--angle, 120deg), color-mix(in srgb, var(--cat-color) 22%, transparent), rgba(20, 19, 15, 0.92));
  }
  .kg-thumb.has-image .kg-thumb-art {
    display: none;
  }
  .kg-thumb-emoji {
    font-size: 2.6rem;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    opacity: 0.92;
  }
  .kg-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.7rem 0.8rem 0.8rem;
    flex: 1;
  }
  .kg-src {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-muted, #94a3b8);
    min-width: 0;
  }
  .kg-favicon {
    border-radius: 3px;
    flex-shrink: 0;
  }
  .kg-host {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kg-dot {
    opacity: 0.5;
  }
  .kg-time {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .kg-title {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.42;
    color: var(--text, #e9e7e3);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  .kg-sum {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-muted, #94a3b8);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .kg-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }
  .kg-tag {
    font-size: 0.68rem;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-color) 14%, transparent);
    color: color-mix(in srgb, var(--cat-color) 80%, #cbd5e1);
  }
  .lang-badge {
    display: inline-block;
    margin-right: 0.3rem;
    padding: 0 0.3rem;
    border-radius: 4px;
    font-size: 0.66rem;
    font-weight: 700;
    background: rgba(148, 163, 184, 0.18);
    color: var(--text-muted, #94a3b8);
    vertical-align: middle;
  }
</style>
