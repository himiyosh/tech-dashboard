---
import Portal from "../../layouts/Portal.astro";
import PageHero from "../../components/PageHero.astro";
import Sidebar from "../../components/Sidebar.astro";
import EntryCard from "../../components/EntryCard.astro";
import Pager from "../../components/Pager.astro";
import TimelineRightRail from "../../components/TimelineRightRail.astro";
import {
  PAGE_SIZE,
  STATIC_TAG_PAGE_TAGS,
  GENERATED_AT,
  entriesForTagPage,
  groupByDay,
  jstDayLabel,
  relativeTime,
  tagHref,
} from "../../lib/data.ts";
import { tagPath } from "../../lib/route-inventory.ts";

export function getStaticPaths() {
  return STATIC_TAG_PAGE_TAGS.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props as Props;
const all = entriesForTagPage(tag);
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const entries = all.slice(0, PAGE_SIZE);
const dayGroups = groupByDay(entries);
const now = new Date();
const tagBaseHref = tagHref(tag);

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Tags" },
  { label: `#${tag}` },
];
---

<Portal
  title={`#${tag} — TECH Dashboard`}
  canonicalPath={tagPath(tag)}
  description={`#${tag} タグが付いた ${all.length} 件の AI 技術アップデートを、カテゴリ横断で新着順・出典付き AI 要約とともに一覧します。`}
  descriptionEn={`All ${all.length} AI technology updates tagged #${tag}, across every category, in recency order with sourced AI summaries.`}
  breadcrumb={breadcrumb}
>
  <PageHero
    className="page-hero-tag"
    kicker="Tag timeline"
    title={`#${tag}`}
    count={`${all.length} total`}
    headingId="tag-heading"
    description="同じキーワードで束ねられた更新を確認できます。カテゴリをまたいだ関連ニュースや実装トピックの追跡に使えます。"
    actions={[
      { href: "/", label: "Latest timeline" },
      { href: "/categories", label: "Browse categories" },
      { href: "/archive", label: "Open archive" },
    ]}
    metrics={[
      {
        label: "Total",
        value: all.length,
        detail: `#${tag} の全掲載記事`,
        detailEn: `All listed entries tagged #${tag}`,
        scope: "tag-live-total",
      },
      {
        label: "Showing",
        value: entries.length,
        detail: "このページの表示件数",
        detailEn: "Entries on this page",
        scope: "tag-page-count",
      },
      {
        label: "Page",
        value: `${currentPage}/${totalPages}`,
        detail: "静的ページ位置",
        detailEn: "Static page position",
        scope: "tag-page-position",
      },
      {
        label: "Updated",
        value: relativeTime(GENERATED_AT, now),
        datetime: GENERATED_AT,
        detail: "公開index snapshot",
        detailEn: "Published index snapshot",
        scope: "tag-snapshot",
      },
    ]}
  />

  <div class="layout">
    <Sidebar active="all" />

    <main>
      <div class="section-header primary">
        <h2>
          Entries
          <span class="count">page {currentPage}/{totalPages} · {all.length} total</span>
        </h2>
      </div>

      {entries.length === 0 ? (
        <p style="color:var(--muted);padding:24px 0">該当するエントリがありません。</p>
      ) : (
        dayGroups.map(({ key, items }) => (
          <>
            <div class="day-header">
              <span>{jstDayLabel(key, now)}</span>
              <span class="day-count">{items.length} entries</span>
            </div>
            {items.map((entry) => <EntryCard entry={entry} />)}
          </>
        ))
      )}

      <Pager
        currentPage={currentPage}
        totalPages={totalPages}
        baseHref={tagBaseHref}
      />
    </main>

    <TimelineRightRail entries={all} now={now} label={`#${tag} insights`} />
  </div>
</Portal>
