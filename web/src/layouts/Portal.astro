            return (slug && displayCategory(slug)) || (lang === "ja" ? "カテゴリ" : "Category");
          }
          const url = String(d.url || "").replace(/^https?:\/\/[^/]+/, "");
          if (url.startsWith("/t/")) return lang === "ja" ? "トピックページ" : "Topic page";
          if (url.startsWith("/archive/")) return lang === "ja" ? "Archiveページ" : "Archive page";
          if (url.startsWith("/status")) return lang === "ja" ? "Statusページ" : "Status page";
          if (url.startsWith("/about")) return lang === "ja" ? "Aboutページ" : "About page";
          if (url.startsWith("/contact")) return lang === "ja" ? "お問い合わせ" : "Contact page";
          if (url.startsWith("/glossary")) return "Glossary";
          if (url.startsWith("/knowledge")) return lang === "ja" ? "Knowledgeレーン" : "Knowledge lane";
          if (url.startsWith("/arxiv")) return "arXiv lane";
          if (url.startsWith("/categories")) return lang === "ja" ? "カテゴリ一覧" : "Category directory";
          return lang === "ja" ? "サイトページ" : "Site page";
