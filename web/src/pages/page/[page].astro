---
import Portal from "../../layouts/Portal.astro";
import PageHero from "../../components/PageHero.astro";
import Sidebar from "../../components/Sidebar.astro";
import EntryCard from "../../components/EntryCard.astro";
import Pager from "../../components/Pager.astro";
import {
  ARXIV_ENTRIES,
  GENERATED_AT,
  MAIN_TIMELINE_ENTRIES,
  PAGE_SIZE,
  groupByDay,
  jstDayLabel,
  relativeTime,
} from "../../lib/data.ts";

export function getStaticPaths() {
  const total = Math.max(1, Math.ceil(MAIN_TIMELINE_ENTRIES.length / PAGE_SIZE));
  const paths: Array<{ params: { page: string }; props: { page: number; total: number } }> = [];
  for (let p = 2; p <= total; p++) {
    paths.push({ params: { page: String(p) }, props: { page: p, total } });
  }
  return paths;
}

interface Props {
  page: number;
  total: number;
}

const { page, total } = Astro.props as Props;
const start = (page - 1) * PAGE_SIZE;
const pageEntries = MAIN_TIMELINE_ENTRIES.slice(start, start + PAGE_SIZE);
const dayGroups = groupByDay(pageEntries);
const now = new Date();

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: `Page ${page}` },
];
---

<Portal pageKey="timeline" title={`Timeline · p.${page} — TECH Dashboard`} breadcrumb={breadcrumb}>
  <PageHero
    className="page-hero-timeline"
    kicker="Timeline archive"
    title="Timeline"
    count={`page ${page}/${total}`}
    headingId="timeline-page-heading"
    description="arXiv 論文を分離した通常更新の深掘り一覧です。Top items から外れた更新も、日付ごとに追って後から確認できます。"
    actions={[
      { href: "/", label: "Back to latest" },
      { href: "/arxiv", label: "arXiv papers" },
      { href: "/categories", label: "Browse categories" },
      { href: "/archive", label: "Open archive" },
    ]}
    metrics={[
      { label: "Showing", value: pageEntries.length },
      { label: "Timeline", value: MAIN_TIMELINE_ENTRIES.length },
      { label: "arXiv moved", value: ARXIV_ENTRIES.length },
      { label: "Page", value: `${page}/${total}` },
      { label: "Updated", value: relativeTime(GENERATED_AT, now) },
    ]}
  />

  <div class="layout">
    <Sidebar active="all" />

    <main>
      <div class="section-header primary">
        <h2>Entries <span class="count">{pageEntries.length} on this page · {MAIN_TIMELINE_ENTRIES.length} timeline · {ARXIV_ENTRIES.length} arXiv moved</span></h2>
      </div>

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span>{jstDayLabel(key, now)}</span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={page} totalPages={total} baseHref="" />
    </main>

    <aside class="right"></aside>
  </div>
</Portal>
