---
import PageHero from "../components/PageHero.astro";
import ExternalLinkHint from "../components/ExternalLinkHint.astro";
import Portal from "../layouts/Portal.astro";
import {
  NEW_ISSUE_URL,
  PRIVACY_JURISDICTION,
  PRIVACY_LAST_UPDATED,
  PUBLIC_OPERATOR_NAME,
} from "../lib/site.ts";
---

<Portal
  pageKey="privacy"
  canonicalPath="/privacy/"
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Privacy" }]}
  title="Privacy & Consent - TECH Dashboard"
  description="TECH Dashboardのデータ取扱い、広告同意、匿名いいね、第三者サービス、利用者の選択を説明します。"
  descriptionEn="TECH Dashboard privacy, advertising consent, anonymous likes, third-party services, retention, deletion, and user controls."
>
  <PageHero
    className="page-hero-privacy"
    kicker="Privacy & consent"
    title="プライバシー"
    titleEn="Privacy & consent"
    headingId="privacy-heading"
    description="収集する情報は最小限です。広告は本番サイトの標準機能で、実際に動作している処理・データを受け取る事業者・利用者が使える選択肢をこのページで公開します。"
    descriptionEn="We keep collected information to a minimum. Advertising is a standard part of the production site: this page documents what actually runs, who receives data, and the controls available to you."
    actions={[
      { href: "#choices", label: "広告について", labelEn: "About advertising" },
      { href: "#data-we-use", label: "取扱うデータ", labelEn: "Data we use" },
      { href: "#third-parties", label: "第三者サービス", labelEn: "Third parties" },
      { href: "#contact", label: "連絡先", labelEn: "Contact" },
    ]}
  />

  <div class="privacy-layout">
    <aside class="privacy-rail" aria-labelledby="privacy-rail-label">
      <span id="privacy-rail-label" class="visually-hidden">
        <span class="i18n-ja">プライバシーページの案内</span>
        <span class="i18n-en" lang="en">Privacy page navigation</span>
      </span>
      <div class="privacy-identity">
        <span class="privacy-mark" aria-hidden="true">◎</span>
        <div>
          <strong>{PUBLIC_OPERATOR_NAME}</strong>
          <small>
            <span class="i18n-ja">日本で運営</span>
            <span class="i18n-en" lang="en">Operated in Japan</span>
          </small>
        </div>
      </div>
      <dl>
        <div>
          <dt>
            <span class="i18n-ja">更新日</span>
            <span class="i18n-en" lang="en">Updated</span>
          </dt>
          <dd><time datetime={PRIVACY_LAST_UPDATED}>{PRIVACY_LAST_UPDATED}</time></dd>
        </div>
        <div>
          <dt>
            <span class="i18n-ja">解析サービス</span>
            <span class="i18n-en" lang="en">Analytics</span>
          </dt>
          <dd>
            <span class="i18n-ja">Cloudflare RUM</span>
            <span class="i18n-en" lang="en">Cloudflare RUM</span>
          </dd>
        </div>
        <div>
          <dt>
            <span class="i18n-ja">広告</span>
            <span class="i18n-en" lang="en">Advertising</span>
          </dt>
          <dd>
            <span class="i18n-ja">本番のみ常時</span>
            <span class="i18n-en" lang="en">Always on (production)</span>
          </dd>
        </div>
      </dl>
      <nav aria-labelledby="privacy-sections-label">
        <span id="privacy-sections-label" class="visually-hidden">
          <span class="i18n-ja">プライバシーの各項目</span>
          <span class="i18n-en" lang="en">Privacy sections</span>
        </span>
        <a href="#choices">
          <span class="i18n-ja">広告について</span>
          <span class="i18n-en" lang="en">About advertising</span>
        </a>
        <a href="#personalised-ads">
          <span class="i18n-ja">パーソナライズ広告と Cookie</span>
          <span class="i18n-en" lang="en">Personalised ads and cookies</span>
        </a>
        <a href="#eea-uk">
          <span class="i18n-ja">EEA・英国・スイスの方へ</span>
          <span class="i18n-en" lang="en">EEA, UK, and Switzerland</span>
        </a>
        <a href="#us-states">
          <span class="i18n-ja">米国各州の居住者の方へ</span>
          <span class="i18n-en" lang="en">US state privacy rights</span>
        </a>
        <a href="#data-we-use">
          <span class="i18n-ja">取扱うデータ</span>
          <span class="i18n-en" lang="en">Data we use</span>
        </a>
        <a href="#anonymous-reactions">
          <span class="i18n-ja">匿名いいね</span>
          <span class="i18n-en" lang="en">Anonymous likes</span>
        </a>
        <a href="#third-parties">
          <span class="i18n-ja">第三者サービス</span>
          <span class="i18n-en" lang="en">Third parties</span>
        </a>
        <a href="#your-controls">
          <span class="i18n-ja">削除と変更</span>
          <span class="i18n-en" lang="en">Deletion and changes</span>
        </a>
        <a href="#contact">
          <span class="i18n-ja">運営者と連絡先</span>
          <span class="i18n-en" lang="en">Operator and contact</span>
        </a>
      </nav>
    </aside>

    <main class="privacy-main">
      <section class="privacy-intro" aria-labelledby="privacy-intro-heading">
        <p class="privacy-label">What we collect</p>
        <h2 id="privacy-intro-heading">
          <span class="i18n-ja">収集する情報は最小限です</span>
          <span class="i18n-en" lang="en">We keep collected information to a minimum</span>
        </h2>
        <p>
          <span class="i18n-ja">記事一覧、検索、Archive、RSS、JSON Feed は、登録もアカウントも不要で利用できます。本番サイトでは運営費をまかなうため Google AdSense の広告を表示し、あわせて配信基盤の Cloudflare Web Analytics (RUM) がパフォーマンス計測のために動作します。TECH Dashboard はこれ以外のアクセス解析サービスを追加していません。広告スクリプトは本番のカスタムドメインでのみ読み込み、pages.dev とローカルプレビューでは読み込みません。</span>
          <span class="i18n-en" lang="en">Article lists, search, Archive, RSS, and JSON Feed need no account or sign-up. The production site shows Google AdSense advertising to cover running costs, and Cloudflare Web Analytics (RUM) operates alongside it to measure performance. TECH Dashboard adds no other analytics provider. Advertising scripts load only on the production custom domain, never on pages.dev or local previews.</span>
        </p>
      </section>

      <section id="choices" class="privacy-section" aria-labelledby="choices-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="choices-heading">
              <span class="i18n-ja">広告について</span>
              <span class="i18n-en" lang="en">About advertising</span>
            </h2>
            <p>
              <span class="i18n-ja">広告は本番サイトの標準機能として表示され、現在オフにする設定は提供していません。</span>
              <span class="i18n-en" lang="en">Advertising is a standard part of the production site; there is currently no setting to turn it off.</span>
            </p>
          </div>
        </div>
        <p>
          <span class="i18n-ja">広告の配信には Google AdSense を使用します。Google は Cookie、IP アドレス、ブラウザ情報などを広告の配信と不正対策に使用する場合があり、その保持と削除は Google のポリシーと設定に従います。表示される広告の設定は <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google 広告センター</a> から変更できます。</span>
          <span class="i18n-en" lang="en">Advertising is served by Google AdSense. Google may use cookies, IP address, and browser information for ad delivery and fraud prevention; retention and deletion follow Google policies and controls. You can adjust your own ad settings at <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google Ad Center</a>.</span>
        </p>
      </section>

      <section id="personalised-ads" class="privacy-section" aria-labelledby="personalised-ads-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="personalised-ads-heading">
              <span class="i18n-ja">パーソナライズ広告と Cookie</span>
              <span class="i18n-en" lang="en">Personalised advertising and cookies</span>
            </h2>
            <p>
              <span class="i18n-ja">Google が広告を選ぶために何を使うか、どこで止められるかを示します。</span>
              <span class="i18n-en" lang="en">What Google uses to choose an ad, and where you can turn it off.</span>
            </p>
          </div>
        </div>
        <div class="privacy-prose">
          <p>
            <span class="i18n-ja">第三者配信事業者である Google は、Cookie を使用して、利用者がこのサイトや他のサイトへ過去にアクセスした情報に基づく広告を配信します。広告の選択には、Cookie のほか、IP アドレス、ブラウザや端末の情報、閲覧中のページの URL が使われる場合があります。TECH Dashboard 側でこれらの情報を受け取ったり保存したりすることはありません。</span>
            <span class="i18n-en" lang="en">Google, as a third-party vendor, uses cookies to serve ads based on your prior visits to this website and to other websites. Besides cookies, ad selection can use your IP address, your browser and device information, and the URL of the page you are viewing. TECH Dashboard itself neither receives nor stores any of it.</span>
          </p>
          <p>
            <span class="i18n-ja">パーソナライズ広告は <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google の広告設定<ExternalLinkHint lang="ja" /></a> からいつでも無効にできます。複数の広告事業者をまとめて無効にする場合は <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">aboutads.info<ExternalLinkHint lang="ja" /></a> を利用できます。Google が広告のために取得する情報の詳細は <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">Google の広告に関するポリシー<ExternalLinkHint lang="ja" /></a> に記載されています。無効にしても広告の表示自体は続き、パーソナライズされない広告に切り替わります。</span>
            <span class="i18n-en" lang="en">You can turn personalised advertising off at any time in <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings<ExternalLinkHint lang="en" /></a>. To opt out of several ad vendors at once, use <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">aboutads.info<ExternalLinkHint lang="en" /></a>. What Google collects for advertising is described in <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">Google's advertising policy<ExternalLinkHint lang="en" /></a>. Opting out does not remove the ads; it switches them to non-personalised ones.</span>
          </p>
        </div>
      </section>

      <section id="eea-uk" class="privacy-section" aria-labelledby="eea-uk-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="eea-uk-heading">
              <span class="i18n-ja">EEA・英国・スイスからご覧の方へ</span>
              <span class="i18n-en" lang="en">If you are in the EEA, the UK, or Switzerland</span>
            </h2>
            <p>
              <span class="i18n-ja">GDPR・UK GDPR に基づく同意と権利について。</span>
              <span class="i18n-en" lang="en">Consent and your rights under the GDPR and UK GDPR.</span>
            </p>
          </div>
        </div>
        <div class="privacy-prose">
          <p>
            <span class="i18n-ja">当サイトは広告を配信する場合、欧州経済領域 (EEA)、英国、スイスからの閲覧者に対して、Google 認定の同意管理プラットフォーム (CMP) による同意メッセージを表示します。広告および広告効果測定のための Cookie 等の使用について、そのメッセージで同意の可否を選択でき、選択は同じメッセージからいつでも変更できます。同意しない場合でも広告の表示は続きますが、パーソナライズされません。サイトの閲覧、検索、RSS の利用に同意は必要ありません。</span>
            <span class="i18n-en" lang="en">Where this site serves advertising, visitors from the European Economic Area, the United Kingdom, or Switzerland are shown a consent message through a Google-certified consent management platform (CMP). That message is where you choose whether cookies and similar technologies may be used for advertising and ad measurement, and you can change the choice at any time from the same place. Declining does not remove the ads; it makes them non-personalised. Reading the site, searching, and using the feeds require no consent at all.</span>
          </p>
          <p>
            <span class="i18n-ja">GDPR および UK GDPR に基づくアクセス、訂正、削除、処理の制限、異議申立ての請求は <a href="/contact">お問い合わせ</a> から受け付けます。ただし、Google や Cloudflare が自らの管理者として保持している情報については、当サイトから削除することはできません。各事業者へ直接ご請求ください。連絡先は <a href="#third-parties">第三者サービス</a> に記載しています。</span>
            <span class="i18n-en" lang="en">Requests for access, rectification, erasure, restriction, or objection under the GDPR and UK GDPR go through <a href="/contact">Contact</a>. Data that Google or Cloudflare hold as controllers in their own right cannot be deleted by this site — address those providers directly; they are listed under <a href="#third-parties">Third-party services</a>.</span>
          </p>
        </div>
      </section>

      <section id="us-states" class="privacy-section" aria-labelledby="us-states-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="us-states-heading">
              <span class="i18n-ja">米国各州の居住者の方へ</span>
              <span class="i18n-en" lang="en">US state privacy rights</span>
            </h2>
            <p>
              <span class="i18n-ja">CCPA / CPRA をはじめとする州法上の「販売」「共有」の扱いについて。</span>
              <span class="i18n-en" lang="en">How the CCPA/CPRA and similar state laws treat what happens here.</span>
            </p>
          </div>
        </div>
        <div class="privacy-prose">
          <p>
            <span class="i18n-ja">TECH Dashboard は、個人情報を金銭と引き換えに販売していません。ただし、カリフォルニア州 (CCPA / CPRA) をはじめとする米国各州の法律では、パーソナライズ広告のために第三者へ識別子や閲覧情報を渡すことを「販売」または「共有」に含める場合があります。該当する州の居住者は、上記「パーソナライズ広告と Cookie」に記載した無効化手順によって、この扱いをオプトアウトできます。</span>
            <span class="i18n-en" lang="en">TECH Dashboard does not sell personal information for money. However, several US state laws — California's CCPA/CPRA among them — treat passing identifiers or browsing signals to a third party for personalised advertising as a "sale" or "sharing". Residents of those states can opt out of that by following the steps in "Personalised advertising and cookies" above.</span>
          </p>
          <p>
            <span class="i18n-ja">開示、削除、訂正、オプトアウトのご請求は <a href="/contact">お問い合わせ</a> から受け付けます。請求されたことを理由に、閲覧できる内容や機能を制限するなどの不利益な取扱いを行うことはありません。当サイトは 16 歳未満と認識している利用者の個人情報を、意図的に販売または共有することはありません。</span>
            <span class="i18n-en" lang="en">Requests to know, delete, correct, or opt out go through <a href="/contact">Contact</a>. We do not discriminate against anyone for making a request — no content or feature is withheld because of it. We do not knowingly sell or share the personal information of anyone we know to be under 16.</span>
          </p>
        </div>
      </section>

      <section id="data-we-use" class="privacy-section" aria-labelledby="data-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="data-heading">
              <span class="i18n-ja">取扱うデータ</span>
              <span class="i18n-en" lang="en">Data we use</span>
            </h2>
            <p>
              <span class="i18n-ja">機能ごとに目的を限定し、別用途へ自動転用しません。</span>
              <span class="i18n-en" lang="en">Each data category has a limited purpose and is not automatically repurposed.</span>
            </p>
          </div>
        </div>
        <dl class="privacy-practices">
          <div data-privacy-practice="display">
            <dt>
              <span class="i18n-ja">表示設定</span>
              <span class="i18n-en" lang="en">Display preferences</span>
            </dt>
            <dd>
              <span class="i18n-ja">表示言語と arXiv の表示形式は、ブラウザの localStorage に保存します。英語表示は共有可能な URL の<code>?lang=en</code>にも反映され、その URL は通常の配信リクエストとして Cloudflare に届きます。これらの設定を運営者のサーバーへ送信することはありません。</span>
              <span class="i18n-en" lang="en">Interface language and arXiv view mode are stored in localStorage. English mode is also reflected as <code>?lang=en</code> in shareable URLs, so Cloudflare receives it as ordinary delivery request data. These preferences are not sent to the operator's server.</span>
            </dd>
          </div>
          <div data-privacy-practice="search">
            <dt>
              <span class="i18n-ja">検索</span>
              <span class="i18n-en" lang="en">Search</span>
            </dt>
            <dd>
              <span class="i18n-ja">検索は、Pagefind の静的インデックスをブラウザ内で処理します。共有可能な検索 URL には<code>?q=</code>、<code>?tag=</code>、および記事を直接復元するための<code>?entry=</code>が含まれる場合があります。カテゴリ別 RSS は<code>/rss/&lt;category&gt;.xml</code>で配信します。これらのパスとクエリは、Cloudflare が通常の配信リクエストとして処理します。</span>
              <span class="i18n-en" lang="en">Pagefind searches a static index in the browser. Shareable search URLs can contain <code>?q=</code>, <code>?tag=</code>, and an exact-recovery <code>?entry=</code>. Category RSS is served at <code>/rss/&lt;category&gt;.xml</code>. Cloudflare processes these paths and queries as ordinary delivery requests.</span>
            </dd>
          </div>
          <div data-privacy-practice="rum">
            <dt>
              <span class="i18n-ja">パフォーマンス計測 (RUM)</span>
              <span class="i18n-en" lang="en">Performance measurement (RUM)</span>
            </dt>
            <dd>
              <span class="i18n-ja">本番サイトでは Cloudflare Web Analytics (RUM) を使用します。広告とは独立して、通常の閲覧時に<code>static.cloudflareinsights.com</code>のビーコンが読み込まれ、ブラウザの Performance API から得られるページ読み込み時間や応答性などの測定値、閲覧したページの URL、送信元 IP アドレスといった通常のリクエスト情報が<code>/cdn-cgi/rum</code>へ送信される場合があります。目的はサイトの性能と利用状況の把握です。保持期間と管理は Cloudflare のポリシーに従います。</span>
              <span class="i18n-en" lang="en">The production site uses Cloudflare Web Analytics (RUM). Independently of optional advertising consent, normal site use can load a beacon from <code>static.cloudflareinsights.com</code> and send performance measurements from browser Performance APIs, such as page-load and responsiveness data, together with the viewed page URL and ordinary request context such as source IP, to <code>/cdn-cgi/rum</code>. Its purpose is to understand site performance and usage. Retention and controls follow Cloudflare's policy.</span>
            </dd>
          </div>
          <div data-privacy-practice="delivery">
            <dt>
              <span class="i18n-ja">配信リクエスト</span>
              <span class="i18n-en" lang="en">Delivery requests</span>
            </dt>
            <dd>
              <span class="i18n-ja">Cloudflare Pages と Functions がサイトと API を配信します。URL のパスとクエリ、IP アドレス、ユーザーエージェント、リファラーなどの HTTP リクエスト情報を、配信・セキュリティ・不正利用対策のために Cloudflare が処理する場合があります。保持期間と管理は Cloudflare のポリシーに従います。</span>
              <span class="i18n-en" lang="en">Cloudflare Pages and Functions deliver the site and APIs. Cloudflare may process HTTP request metadata such as URL path and query, IP address, user agent, and referrer for delivery, security, and abuse prevention. Retention and controls follow Cloudflare's policy.</span>
            </dd>
          </div>
          <div data-privacy-practice="media">
            <dt>
              <span class="i18n-ja">外部メディア</span>
              <span class="i18n-en" lang="en">External media</span>
            </dt>
            <dd>
              <span class="i18n-ja">記事画像やファビコンは、広告とは独立して、元のサイトまたは画像配信サービスから直接読み込まれる場合があります。そのリクエストでは URL、IP アドレス、ブラウザ情報、リファラーが読み込み先へ届く場合があります。保持期間と削除の管理は各読み込み先が行い、このページの削除機能では消去できません。</span>
              <span class="i18n-en" lang="en">Independently of advertising, article images and favicons may load directly from source sites or image providers. Those requests may expose URL, IP address, browser information, and referrer to the destination. Each destination controls retention and deletion; this page's deletion control cannot remove that data.</span>
            </dd>
          </div>
          <div data-privacy-practice="retention">
            <dt>
              <span class="i18n-ja">保持期間</span>
              <span class="i18n-en" lang="en">Retention</span>
            </dt>
            <dd>
              <span class="i18n-ja">localStorage に保存した設定は、変更・消去するか、ブラウザの保存データを削除するまで保持されます。匿名いいねの Cookie は最長 1 年間です。D1 に保存する有効な識別子・投票・レート制限の各行には、現在のところ自動削除の期限を設定していません。これらはこのページの削除機能、または運用上の削除で消去します。第三者が保持する情報は、各サービスのポリシーに従います。</span>
              <span class="i18n-en" lang="en">Local preferences remain until changed, cleared, or removed with browser storage. The anonymous-like cookie lasts up to one year. D1 active-identity, vote, and rate-limit rows currently have no automatic expiry; they are removed by this page's deletion control or operational deletion. Third-party retention follows each provider's policy.</span>
            </dd>
          </div>
        </dl>
      </section>

      <section id="anonymous-reactions" class="privacy-section" aria-labelledby="reactions-heading">
        <div class="privacy-section-heading">
          <div>
            <h2 id="reactions-heading">
              <span class="i18n-ja">匿名いいね</span>
              <span class="i18n-en" lang="en">Anonymous likes</span>
            </h2>
            <p>
              <span class="i18n-ja">いいねを操作したブラウザにだけ、機能上必要な識別子を作成します。</span>
