---
/**
 * Decorative SVG thumbnail used as a fallback when an entry has no image.
 * Renders a category-tinted gradient with the category emoji and label.
 */
import { CATEGORY_META, type Category } from "../lib/data.ts";

export interface Props {
  category: Category;
  seed?: string;
  height?: string;
}

const { category, seed = "x", height = "240px" } = Astro.props;
const meta = CATEGORY_META.find((c) => c.slug === category);
const color = meta?.color ?? "#8a847e";
const emoji = meta?.emoji ?? "\u{1F4C4}";
const name = meta?.name ?? category;

const seedNum = Array.from(seed).reduce((a, c) => a + c.charCodeAt(0), 0);
const rotate = seedNum % 360;
const scale = 0.85 + (seedNum % 6) * 0.08;
const gradId = `g-${seed.replace(/[^a-z0-9]/gi, "")}`;
---

<div class="cat-thumb" style={`--cat-color:${color};height:${height}`}>
  <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color={color} stop-opacity="0.32" />
        <stop offset="100%" stop-color={color} stop-opacity="0.04" />
      </linearGradient>
    </defs>
    <rect width="320" height="180" fill="#1a1917" />
    <rect width="320" height="180" fill={`url(#${gradId})`} />
    <g opacity="0.10" transform={`rotate(${rotate} 160 90) scale(${scale})`}>
      <circle cx="40" cy="30" r="44" fill={color} />
      <circle cx="280" cy="150" r="56" fill={color} />
      <rect x="200" y="10" width="90" height="90" rx="18" fill={color} />
    </g>
    <text
      x="160"
      y="100"
      text-anchor="middle"
      dominant-baseline="middle"
      font-size="72"
      style="filter:drop-shadow(0 2px 6px rgba(0,0,0,0.45))"
    >{emoji}</text>
    <text
      x="160"
      y="148"
      text-anchor="middle"
      font-family="Inter, sans-serif"
      font-size="13"
      fill={color}
      opacity="0.75"
      letter-spacing="0.16em"
      font-weight="700"
    >{name.toUpperCase()}</text>
  </svg>
</div>

<style>
  .cat-thumb {
    width: 100%;
    overflow: hidden;
    background: #1a1917;
    border-bottom: 1px solid var(--border);
  }
  .cat-thumb svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
