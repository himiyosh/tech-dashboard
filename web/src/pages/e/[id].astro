        {!summaryAbsent && (
          <p class="ed-disclaim" data-generation-scope={summaryLanguageScope}>
            <span class="i18n-ja">{generationDisclosureJa}</span>
            <span class="i18n-en" lang="en">{generationDisclosureEn}</span>
