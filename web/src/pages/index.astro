---
import Portal from "../layouts/Portal.astro";
import Sidebar from "../components/Sidebar.astro";
import EntryCard from "../components/EntryCard.astro";
import CategoryThumb from "../components/CategoryThumb.astro";
import DailySummary from "../components/DailySummary.astro";
import LiveMetrics from "../components/LiveMetrics.astro";
import TickerBar from "../components/TickerBar.astro";
import TimelineRightRail from "../components/TimelineRightRail.astro";
import Pager from "../components/Pager.astro";
import ArxivIcon from "../components/icons/ArxivIcon.astro";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { sourceLabel } from "../lib/source-meta.ts";
import { STATS } from "../lib/stats.ts";
import {
  ALL_ENTRIES,
  ARXIV_ENTRIES,
  MAIN_TIMELINE_ENTRIES,
  PAGE_SIZE,
  CATEGORY_META,
  entryHref,
  featured,
  relativeTime,
  groupByDay,
  jstDayLabel,
  summaryForLang,
  summaryForLangWithFallback,
  titleForLangWithFallback,
  isDeterministicFallbackEntry,
  isLowSignalRelease,
  isOffTopicForHero,
} from "../lib/data.ts";

const currentPage = 1;
const primaryEntries = MAIN_TIMELINE_ENTRIES;
const arxivEntries = ARXIV_ENTRIES;
const totalPages = Math.max(1, Math.ceil(primaryEntries.length / PAGE_SIZE));
const pageEntries = primaryEntries.slice(0, PAGE_SIZE);
const dayGroups = groupByDay(pageEntries);

const feat = featured();

const now = new Date();
const ago = relativeTime(DASHBOARD_METRICS.generatedAt, now);

// Top 3 = importance x recency, but only entries with real summaries.
// Limit repeated source/category so the decision list is useful at a glance.
const rankedPool = primaryEntries
  .filter(
    (e) =>
      e.importance >= 2 &&
      !isDeterministicFallbackEntry(e) &&
      !isLowSignalRelease(e) &&
      !isOffTopicForHero(e),
  )
  .slice(0, 120);
const scoredTopCandidates = rankedPool
  .map((e) => {
    const ageHours = Math.max(
      0,
      (now.getTime() - new Date(e.publishedAt || e.collectedAt).getTime()) / 3600_000,
    );
    const sourceTypeBoost = e.sourceType === "release" || e.sourceType === "changelog" ? -8 : 0;
    const score = e.importance * 100 - ageHours * 0.6 + sourceTypeBoost;
    return { entry: e, score };
  })
  .sort((a, b) => b.score - a.score);
const topThree = (() => {
  const picked: typeof ALL_ENTRIES[number][] = [];
  const sourceCount = new Map<string, number>();
  const categoryCount = new Map<string, number>();
  for (const { entry } of scoredTopCandidates) {
    if ((sourceCount.get(entry.source) ?? 0) >= 1) continue;
    if ((categoryCount.get(entry.category) ?? 0) >= 2) continue;
    picked.push(entry);
    sourceCount.set(entry.source, (sourceCount.get(entry.source) ?? 0) + 1);
    categoryCount.set(entry.category, (categoryCount.get(entry.category) ?? 0) + 1);
    if (picked.length === 3) break;
  }
  if (picked.length < 3) {
    for (const { entry } of scoredTopCandidates) {
      if (picked.some((item) => item.id === entry.id)) continue;
      picked.push(entry);
      if (picked.length === 3) break;
    }
  }
  return picked;
})();
const medals = ["\u{1F947}", "\u{1F948}", "\u{1F949}"];

function topReason(entry: (typeof ALL_ENTRIES)[number]): { ja: string; en: string } {
  const category = CATEGORY_META.find((c) => c.slug === entry.category)?.name ?? entry.category;
  const type =
    entry.sourceType === "release" || entry.sourceType === "changelog"
      ? { ja: "公式リリース/変更履歴", en: "official release/changelog" }
      : entry.sourceType === "paper"
        ? { ja: "論文/研究", en: "paper/research" }
        : { ja: "公式/技術記事", en: "official/technical post" };
  const importance =
    entry.importance === 3
      ? { ja: "重要度 High", en: "High importance" }
      : { ja: "重要度 Medium", en: "Medium importance" };
  return {
    ja: `${importance.ja} · ${type.ja} · ${category}`,
    en: `${importance.en} · ${type.en} · ${category}`,
  };
}
---

<Portal pageKey="timeline">
  <section class="banner">
    <div class="banner-bg-grid"></div>
    <div class="banner-inner">
      <div class="banner-copy" data-reveal="hero-copy">
        <p class="banner-kicker">TECH UPDATE ROUTER</p>
        <h1 class="i18n-ja">
          今日読むべき技術更新を、<br />
          <span class="brand-accent">判断できる</span>形で。
        </h1>
        <h1 class="i18n-en" lang="en">
          Decide what to read today,<br />
          from one <span class="brand-accent">ranked</span> dashboard.
        </h1>
        <p class="tagline i18n-ja">
          Microsoft / GitHub、Anthropic、OpenAI、Google、AI Coding Tools などの
          公式情報・リリース・業界ニュースを 1 時間おきに収集し、要約と重要度で並べます。arXiv 論文は専用ページに分けました。
        </p>
        <p class="tagline i18n-en" lang="en">
          Official posts, releases, and industry news across Microsoft / GitHub, Anthropic, OpenAI, Google, and AI Coding Tools,
          collected hourly and ranked with summaries. arXiv papers now live in a dedicated lane.
        </p>
        <div class="banner-actions" aria-label="First actions">
          <a class="banner-cta primary" href="#today-priority">
            <span class="i18n-ja">今日の重要記事を見る</span>
            <span class="i18n-en" lang="en">View today's priorities</span>
          </a>
          <button type="button" class="banner-cta" data-search-trigger>
            <span class="i18n-ja">検索する</span>
            <span class="i18n-en" lang="en">Search</span>
          </button>
        </div>
        <div class="banner-quick-links" aria-label="Explore sections">
          <a href="/categories">
            <span class="quick-icon" aria-hidden="true">▦</span>
            <span class="i18n-ja">カテゴリ一覧</span>
            <span class="i18n-en" lang="en">Categories</span>
          </a>
          <a href="/arxiv">
            <span class="quick-icon paper" aria-hidden="true"><ArxivIcon /></span>
            <span class="i18n-ja">arXiv 論文</span>
            <span class="i18n-en" lang="en">arXiv papers</span>
          </a>
          <a href="/knowledge">
            <span class="quick-icon knowledge" aria-hidden="true">✦</span>
            <span class="i18n-ja">ナレッジ</span>
            <span class="i18n-en" lang="en">Knowledge</span>
          </a>
        </div>
      </div>
      <div class="banner-right" data-reveal="hero-panel">
        <div class="dynamic-orbit" aria-hidden="true">
          <span class="orbit-ring orbit-ring-a"></span>
          <span class="orbit-ring orbit-ring-b"></span>
          <span class="scan-beam"></span>
          <div class="orbit-core">
            <span>Hourly</span>
            <strong>Routing</strong>
            <small>ranked feed</small>
          </div>
          <span class="signal-node node-source">{DASHBOARD_METRICS.sourceCoverageLabel} sources</span>
          <span class="signal-node node-rank">rank</span>
          <span class="signal-node node-summary">AI summary</span>
          <span class="signal-node node-publish">publish</span>
        </div>
        <div class="banner-facts" aria-label="Dashboard overview">
          <div class="banner-fact">
            <strong class="i18n-ja">できること</strong>
            <strong class="i18n-en" lang="en">What it does</strong>
            <span class="i18n-ja">要約・重要度・出典から、読む/共有する判断を短時間で行えます。</span>
            <span class="i18n-en" lang="en">Use summaries, importance, and sources to decide what to read or share.</span>
          </div>
          <div class="banner-fact">
            <strong class="i18n-ja">集約ソース</strong>
            <strong class="i18n-en" lang="en">Sources</strong>
            <span class="i18n-ja">{DASHBOARD_METRICS.sourceCoverageLabel} sources · 公式 blog / release / paper / news</span>
            <span class="i18n-en" lang="en">{DASHBOARD_METRICS.sourceCoverageLabel} sources · official blogs, releases, papers, news</span>
          </div>
          <div class="banner-fact">
            <strong class="i18n-ja">更新頻度</strong>
            <strong class="i18n-en" lang="en">Cadence</strong>
            <span class="i18n-ja">毎時更新 · 最新 index は {ago}</span>
            <span class="i18n-en" lang="en">Hourly collection · latest index {ago}</span>
          </div>
          <div class="banner-filter-links" aria-label="Explore by filter">
            <a href="/categories">
              <span class="i18n-ja">カテゴリ</span><span class="i18n-en" lang="en">Categories</span>
            </a>
            <a href="/status">
              <span class="i18n-ja">ソース状況</span><span class="i18n-en" lang="en">Source status</span>
            </a>
            <a href="/archive">
              <span class="i18n-ja">期間別アーカイブ</span><span class="i18n-en" lang="en">Archive by month</span>
            </a>
            <a href="/arxiv">
              <span class="i18n-ja">arXiv 論文</span><span class="i18n-en" lang="en">arXiv papers</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TickerBar entries={primaryEntries} now={now} />

  <div class="layout">
    <Sidebar active="all" />

    <main>
        <section class="priority-section" id="today-priority" aria-labelledby="priority-heading">
        <div class="section-header primary section-header-stacked">
          <h2 id="priority-heading">
            <span class="i18n-ja">今日見るべきもの</span>
            <span class="i18n-en" lang="en">Today's decision list</span>
          </h2>
          <p class="section-note i18n-ja">
            短時間で読む優先度を決める領域です。重要度、更新鮮度、source type を優先して表示します。
          </p>
          <p class="section-note i18n-en" lang="en">
            A quick decision area for busy readers, prioritizing importance, recency, and source type.
          </p>
        </div>

      {feat && (() => {
        const featSumJa = summaryForLang(feat, "ja");
        const featSumEn = summaryForLangWithFallback(feat, "en");
        const featCat = CATEGORY_META.find((c) => c.slug === feat.category);
        const featCatColor = featCat?.color ?? "#5eead4";
        let featHost = "";
        try { featHost = new URL(feat.url).host.replace(/^www\./, ""); } catch {}
        const featFavicon = featHost
          ? `https://www.google.com/s2/favicons?sz=64&domain=${featHost}`
          : "";
        const featImg = feat.image?.src ?? "";
        return (
        <article class="featured" data-pagefind-body data-reveal="featured" style={`--cat-color:${featCatColor}`}>
          <div class:list={["featured-thumb", { "has-image": !!featImg }]}>
            {featImg && (
              <img
                src={featImg}
                alt={feat.image?.alt || feat.title}
                loading="lazy"
                decoding="async"
                onerror="this.closest('.featured-thumb')?.classList.add('failed')"
              />
            )}
            <div class="featured-thumb-fallback" aria-hidden="true">
              <CategoryThumb category={feat.category} seed={feat.id} height="100%" />
            </div>
          </div>
          <div class="featured-body">
            <div class="featured-label">
              <span class="i18n-ja">Featured · 注目</span>
              <span class="i18n-en" lang="en">Featured</span>
            </div>
            <h2 class="featured-title">
              <a href={entryHref(feat)}>
                {(() => {
                  const ja = titleForLangWithFallback(feat, "ja");
                  const en = titleForLangWithFallback(feat, "en");
                  return (
                    <>
                      <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                        {ja.isFallback && <span class="lang-badge">[en]</span>}
                        {ja.text}
                      </span>
                      <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                        {en.isFallback && <span class="lang-badge">[ja]</span>}
                        {en.text}
                      </span>
                    </>
                  );
                })()}
              </a>
            </h2>
            {featSumJa && <p class="featured-sum i18n-ja">{featSumJa}</p>}
            {featSumEn.text && (
              <p class="featured-sum i18n-en" lang={featSumEn.isFallback ? "ja" : "en"}>
                {featSumEn.isFallback && <span class="lang-badge">[ja]</span>}
                {featSumEn.text}
              </p>
            )}
            <div class="featured-meta">
              <span class="badge release">{feat.sourceType}</span>
              <span class="featured-src">
                {featFavicon && (
                  <img
                    class="featured-favicon"
                    src={featFavicon}
                    alt=""
                    width="16"
                    height="16"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.style.display='none'"
                  />
                )}
                <span>{sourceLabel(feat.source)}</span>
              </span>
              <span>·</span>
              <span>{relativeTime(feat.publishedAt, now)}</span>
            </div>
          </div>
        </article>
        );
      })()}

      <DailySummary entries={primaryEntries} stats={STATS} now={now} />

      {topThree.length > 0 && (
        <section class="top-rank" data-reveal="top-rank">
          <div class="top-rank-head">
            <span class="top-rank-title">🔥 Today's Top {topThree.length}</span>
            <span class="top-rank-sub">importance × recency</span>
          </div>
          <ol class="top-rank-list">
            {topThree.map((e, i) => {
              const meta = CATEGORY_META.find((c) => c.slug === e.category);
              const reason = topReason(e);
              return (
                <li class={`top-rank-item rank-${i + 1}`} style={`--cat-color:${meta?.color ?? "#8a847e"}`}>
                  <span class="medal" aria-hidden="true">{medals[i]}</span>
                  <span class="rank-cat" aria-hidden="true">{meta?.emoji ?? "\u{1F4C4}"}</span>
                  <a class="rank-title" href={entryHref(e)}>
                    {(() => {
                      const ja = titleForLangWithFallback(e, "ja");
                      const en = titleForLangWithFallback(e, "en");
                      return (
                        <>
                          <span class="i18n-ja" lang={ja.fallbackLang === "en" ? "en" : "ja"}>
                            {ja.isFallback && <span class="lang-badge">[en]</span>}
                            {ja.text}
                          </span>
                          <span class="i18n-en" lang={en.fallbackLang === "ja" ? "ja" : "en"}>
                            {en.isFallback && <span class="lang-badge">[ja]</span>}
                            {en.text}
                          </span>
                        </>
                      );
                    })()}
                  </a>
                  <span class="rank-meta">
                    <span class="rank-source">{sourceLabel(e.source)}</span>
                    <span class="rank-time mono">{relativeTime(e.publishedAt, now)}</span>
                  </span>
                  <span class="rank-reason i18n-ja">{reason.ja}</span>
                  <span class="rank-reason i18n-en" lang="en">{reason.en}</span>
                </li>
              );
            })}
          </ol>
        </section>
      )}
      </section>

      <section class="timeline-section" id="timeline" aria-labelledby="timeline-heading">
        <div class="section-header primary section-header-stacked">
          <h2 id="timeline-heading">
            <span class="i18n-ja">深掘り一覧</span>
            <span class="i18n-en" lang="en">Deep-dive timeline</span>
            <span class="count">{primaryEntries.length} timeline · {arxivEntries.length} arXiv moved · page {currentPage}/{totalPages}</span>
          </h2>
          <p class="section-note i18n-ja">
            arXiv 論文を分離した通常更新の一覧です。カテゴリ・タグ・検索で絞り込んで詳細へ進めます。
          </p>
          <p class="section-note i18n-en" lang="en">
            Browse the non-arXiv update stream by recency, then narrow with category, tags, or search.
          </p>
        </div>

        {pageEntries.length === 0 ? (
          <div class="empty-state">
            <strong class="i18n-ja">表示できる更新がありません。</strong>
            <strong class="i18n-en" lang="en">No updates are available.</strong>
            <p class="i18n-ja">次回の毎時収集後に再度確認するか、Status で source 更新状況を確認してください。</p>
            <p class="i18n-en" lang="en">Check again after the next hourly run, or open Status to inspect source freshness.</p>
            <a href="/status">Status</a>
          </div>
        ) : (
          dayGroups.map(({ key, items }) => (
            <>
              <div class="day-header">
                <span>{jstDayLabel(key, now)}</span>
                <span class="day-count">{items.length} entries</span>
              </div>
              {items.map((entry) => <EntryCard entry={entry} />)}
            </>
          ))
        )}

        <Pager currentPage={currentPage} totalPages={totalPages} baseHref="" />
      </section>
    </main>

    <TimelineRightRail entries={primaryEntries} now={now} label="Timeline insights" />
  </div>
  <LiveMetrics />
</Portal>
