---
import {
  ARXIV_ENTRIES,
  CATEGORY_META,
  relativeTime,
  tagHref,
  titleForLangWithFallback,
  type NormalizedEntry,
} from "../lib/data.ts";
import { entryDestination } from "../lib/entry-destination.ts";
import { sourceLabel } from "../lib/source-meta.ts";
import { ARXIV_SOURCE_INFO } from "../lib/arxiv-meta.ts";
import LanguageFallbackBadge from "./LanguageFallbackBadge.astro";
import ExternalLinkHint from "./ExternalLinkHint.astro";

interface Props {
  category: (typeof CATEGORY_META)[number];
  entries: readonly NormalizedEntry[];
  now?: Date;
}

const { category, entries, now = new Date() } = Astro.props as Props;

const countMap = <T extends string>(items: readonly T[]): Array<{ key: T; count: number }> => {
  const counts = new Map<T, number>();
  for (const item of items) counts.set(item, (counts.get(item) ?? 0) + 1);
  return [...counts.entries()]
    .sort(([, a], [, b]) => b - a)
    .map(([key, count]) => ({ key, count }));
};

const topSources = countMap(entries.slice(0, 160).map((entry) => entry.source)).slice(0, 5);
const topTags = countMap(entries.slice(0, 160).flatMap((entry) => entry.tags)).slice(0, 12);
const rankingSampleCount = Math.min(entries.length, 160);
const relatedCategories = CATEGORY_META.filter(
  (item) => item.group === category.group && item.slug !== category.slug,
).slice(0, 5);
const latest = entries[0] ?? null;
const latestTitleJa = latest ? titleForLangWithFallback(latest, "ja") : null;
const latestTitleEn = latest ? titleForLangWithFallback(latest, "en") : null;
const latestDestination = latest ? entryDestination(latest) : null;
const categoryInitial = category.initial;
---

<aside class="right category-side-panel" aria-label={`${category.name} insights`}>
  {category.slug === "research" && (
    <div class="side-card category-side-note">
      <div class="right-title">Research split</div>
      <p class="i18n-ja">arXiv 論文は件数が多いため、通常の研究カテゴリとは別に専用ページで確認できます。</p>
      <p class="i18n-en">High-volume arXiv papers are available in a dedicated lane separate from the Research timeline.</p>
      <div class="category-side-note-stats">
        <span><strong>{ARXIV_ENTRIES.length}</strong> arXiv</span>
        <span><strong>{entries.length}</strong> Research</span>
      </div>
      <a class="side-action" href="/arxiv/">
        <span class="i18n-ja">arXiv Papers を開く</span>
        <span class="i18n-en">Open arXiv Papers</span>
      </a>
    </div>
  )}

  <div class="side-card category-focus-card" style={`--cat-color:${category.color}`}>
    <div class="right-title">Category focus</div>
    <div class="category-focus-row">
      <span class="category-focus-mark">{categoryInitial}</span>
      <div>
        <strong>{category.name}</strong>
        <span>{entries.length} total entries</span>
      </div>
    </div>
    {latest ? (
      <a
        class="category-latest-link"
        href={latestDestination?.href}
        target={latestDestination?.target}
        rel={latestDestination?.rel}
        data-detail-destination={latestDestination?.external ? "source" : "internal"}
      >
        <span>Latest</span>
        <strong class="i18n-ja" lang={latestTitleJa?.fallbackLang === "en" ? "en" : "ja"}>
          {latestTitleJa?.isFallback && latestTitleJa.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={latestTitleJa.fallbackLang} variant="title" />
          )}
          {latestTitleJa?.text}
          {latestDestination?.external && <ExternalLinkHint lang="ja" />}
        </strong>
        <strong class="i18n-en" lang={latestTitleEn?.fallbackLang === "ja" ? "ja" : "en"}>
          {latestTitleEn?.isFallback && latestTitleEn.fallbackLang && (
            <LanguageFallbackBadge fallbackLang={latestTitleEn.fallbackLang} variant="title" />
          )}
          {latestTitleEn?.text}
          {latestDestination?.external && <ExternalLinkHint lang="en" />}
        </strong>
        <em data-relative-time data-datetime={latest.publishedAt}>{relativeTime(latest.publishedAt, now)}</em>
      </a>
    ) : (
      <p class="category-side-muted">
        <span class="i18n-ja">まだエントリがありません。</span>
        <span class="i18n-en">No entries are available yet.</span>
      </p>
    )}
  </div>

  {topSources.length > 0 && (
    <div class="side-card">
      <div class="right-title">Top sources</div>
      <p class="category-side-scope">
        <span class="i18n-ja">新着順の先頭 {rankingSampleCount} 件</span>
        <span class="i18n-en" lang="en">First {rankingSampleCount} entries by recency</span>
      </p>
      <div class="category-side-list">
        {topSources.map((source) => (
          <div class="category-source-row">
            <span>{sourceLabel(source.key)}</span>
            <strong title={`${source.count} entries`}>{source.count}<small> entries</small></strong>
          </div>
        ))}
      </div>
    </div>
  )}

  {topTags.length > 0 && (
    <div class="side-card">
      <div class="right-title">Trending tags</div>
      <p class="category-side-scope">
        <span class="i18n-ja">同じ先頭 {rankingSampleCount} 件</span>
        <span class="i18n-en" lang="en">The same first {rankingSampleCount} entries</span>
      </p>
      <div class="tag-cloud category-side-tags">
        {topTags.map((tag) => (
          <a class="tag" href={tagHref(tag.key)} aria-label={`${tag.key}, ${tag.count} entries`}>
            #{tag.key} <span class="c">{tag.count}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {category.slug === "research" && (
    <div class="side-card">
      <div class="right-title">arXiv codes</div>
      <div class="arxiv-code-list">
        {ARXIV_SOURCE_INFO.map((info) => (
          <a class="arxiv-code-item" href={`/arxiv/#source=${info.id}`}>
            <strong>{info.code}</strong>
            <span class="i18n-ja">{info.shortJa}</span>
            <span class="i18n-en">{info.title}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {relatedCategories.length > 0 && (
    <div class="side-card">
      <div class="right-title">Related categories</div>
      <div class="category-related-grid">
        {relatedCategories.map((item) => (
          <a href={`/c/${item.slug}`} style={`--cat-color:${item.color}`}>
            <span aria-hidden="true">{item.emoji}</span>
            <strong>{item.name}</strong>
          </a>
        ))}
      </div>
    </div>
  )}
</aside>

<style>
  .category-side-scope {
    margin: -2px 0 9px;
    color: var(--muted-2);
    font-size: 10px;
    line-height: 1.45;
  }

  .category-source-row strong small {
    color: var(--muted-2);
    font-size: 9px;
    font-weight: 500;
  }
</style>
