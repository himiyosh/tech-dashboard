---
import Portal from "../../../../layouts/Portal.astro";
import PageHero from "../../../../components/PageHero.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import EntryCard from "../../../../components/EntryCard.astro";
import Pager from "../../../../components/Pager.astro";
import TimelineRightRail from "../../../../components/TimelineRightRail.astro";
import {
  PAGE_SIZE,
  STATIC_TAG_PAGE_TAGS,
  GENERATED_AT,
  entriesForTagPage,
  groupByDay,
  jstDayLabel, jstDayLabelI18n,
  relativeTime,
  tagHref,
} from "../../../../lib/data.ts";
import {
  paginationPageNumbers,
  tagPath,
  totalPageCount,
} from "../../../../lib/route-inventory.ts";

export function getStaticPaths() {
  const out: Array<{
    params: { tag: string; page: string };
    props: { tag: string; page: number; total: number };
  }> = [];
  for (const tag of STATIC_TAG_PAGE_TAGS) {
    const entryCount = entriesForTagPage(tag).length;
    const total = totalPageCount(entryCount, PAGE_SIZE);
    for (const page of paginationPageNumbers(entryCount, PAGE_SIZE)) {
      out.push({
        params: { tag, page: String(page) },
        props: { tag, page, total },
      });
    }
  }
  return out;
}

interface Props {
  tag: string;
  page: number;
  total: number;
}

const { tag, page, total } = Astro.props as Props;
const all = entriesForTagPage(tag);
const start = (page - 1) * PAGE_SIZE;
const entries = all.slice(start, start + PAGE_SIZE);
const dayGroups = groupByDay(entries);
const now = new Date();
const tagBaseHref = tagHref(tag);

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Tags" },
  { label: `#${tag}`, href: tagBaseHref },
  { label: `Page ${page}` },
];
---

<Portal
  title={`#${tag} · p.${page} — TECH Dashboard`}
  canonicalPath={tagPath(tag, page)}
  description={`#${tag} タグの ${page}/${total} ページ目。全 ${all.length} 件のうち ${entries.length} 件を新着順・出典付き AI 要約で掲載します。`}
  descriptionEn={`Page ${page} of ${total} for #${tag}: ${entries.length} of ${all.length} tagged updates in recency order with sourced AI summaries.`}
  breadcrumb={breadcrumb}
>
  <PageHero
    className="page-hero-tag"
    kicker="Tag timeline"
    title={`#${tag}`}
    count={`page ${page}/${total}`}
    headingId="tag-heading"
    description="同じキーワードで束ねられた更新の続きです。カテゴリをまたいだ関連ニュースや実装トピックの追跡に使えます。"
    actions={[
      { href: tagBaseHref, label: "First page" },
      { href: "/categories", label: "Browse categories" },
      { href: "/archive", label: "Open archive" },
    ]}
    metrics={[
      {
        label: "Total",
        value: all.length,
        detail: `#${tag} の全掲載記事`,
        detailEn: `All listed entries tagged #${tag}`,
        scope: "tag-live-total",
      },
      {
        label: "Showing",
        value: entries.length,
        detail: "このページの件数",
        detailEn: "Entries on this page",
        scope: "tag-page-count",
      },
      {
        label: "Page",
        value: `${page}/${total}`,
        detail: "静的ページ位置",
        detailEn: "Static page position",
        scope: "tag-page-position",
      },
      {
        label: "Updated",
        value: relativeTime(GENERATED_AT, now),
        datetime: GENERATED_AT,
        detail: "一覧の更新時刻",
        detailEn: "List last updated",
        scope: "tag-snapshot",
      },
    ]}
  />

  <div class="layout">
    <Sidebar active="all" />

    <main>
      <div class="section-header primary">
        <h2>
          Entries
          <span class="count">page {page}/{total} · {all.length} total</span>
        </h2>
      </div>

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span><span class="i18n-ja">{jstDayLabelI18n(key, now).ja}</span><span class="i18n-en" lang="en">{jstDayLabelI18n(key, now).en}</span></span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={page} totalPages={total} baseHref={tagBaseHref} />
    </main>

    <TimelineRightRail entries={all} now={now} label={`#${tag} insights`} />
  </div>
</Portal>
