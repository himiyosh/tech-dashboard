---
// arXiv explore-shortcut icon: a paper/preprint document with a folded corner
// and two text lines. Sized at 1em so it matches the surrounding glyph icons
// (Categories ▦, Knowledge ✦) in each context, and inherits currentColor so the
// blue (--paper) idle / active theming keeps working.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className ? `arxiv-ic ${className}` : "arxiv-ic"}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
  <path d="M14 3v5h5" />
  <path d="M9 13h6M9 16.5h6" />
</svg>
