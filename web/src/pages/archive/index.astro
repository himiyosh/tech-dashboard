---
import Portal from "../../layouts/Portal.astro";
import PageHero from "../../components/PageHero.astro";
import Sidebar from "../../components/Sidebar.astro";
import {
  ARCHIVE_BROWSABLE_ENTRIES,
  ARCHIVE_GENERATED_AT,
  ARCHIVE_STORED_ENTRIES,
  ARCHIVE_TIER_DETAIL,
  ARCHIVE_TIER_SUMMARY,
  getMonth,
  getMonthSummaries,
} from "../../lib/archive.ts";
import { CATEGORY_META, relativeTime, type Category } from "../../lib/data.ts";
import { DASHBOARD_METRICS } from "../../lib/metrics.ts";

const baseMonths = getMonthSummaries();
const categoryBySlug = new Map(CATEGORY_META.map((category) => [category.slug, category]));
const maxMonthCount = Math.max(1, ...baseMonths.map((month) => month.count));

const months = baseMonths.map((month) => {
  const file = getMonth(month.month);
  const categoryCounts = new Map<Category, number>();
  for (const entry of file?.entries ?? []) {
    categoryCounts.set(entry.category, (categoryCounts.get(entry.category) ?? 0) + 1);
  }
  const topCategory = [...categoryCounts.entries()]
    .sort(([, a], [, b]) => (b ?? 0) - (a ?? 0))[0] as [Category, number] | undefined;
  const categoryMeta = topCategory ? categoryBySlug.get(topCategory[0]) : null;
  const exactPeakPercent = (month.count / maxMonthCount) * 100;
  const peakPercent = Math.round(exactPeakPercent * 10) / 10;
  return {
    ...month,
    barWidth: Math.max(6, Math.round(exactPeakPercent)),
    peakPercent,
    peakShareLabel: month.count > 0 && peakPercent < 1
      ? "<1"
      : String(peakPercent),
    topCategoryCount: topCategory?.[1] ?? 0,
    topCategoryLabel: categoryMeta?.name ?? "No category",
    topCategoryColor: categoryMeta?.color ?? "var(--accent)",
  };
});

const latestMonth = months[0] ?? null;
const peakMonth = months.reduce<typeof months[number] | null>(
  (acc, month) => (!acc || month.count > acc.count ? month : acc),
  null,
);

// Group by year for nicer rendering.
const byYear = new Map<string, typeof months>();
for (const m of months) {
  const y = m.month.slice(0, 4);
  const arr = byYear.get(y) ?? [];
  arr.push(m);
  byYear.set(y, arr);
}
const years = [...byYear.keys()].sort().reverse();
const yearTotals = new Map(
  years.map((year) => [
    year,
    byYear.get(year)!.reduce((sum, month) => sum + month.count, 0),
  ]),
);
const yearStoredTotals = new Map(
  years.map((year) => [
    year,
    byYear.get(year)!.reduce((sum, month) => sum + month.storedCount, 0),
  ]),
);
const storedHot = months.reduce((sum, month) => sum + month.hot, 0);
const storedWarm = months.reduce((sum, month) => sum + month.warm, 0);
const storedCold = months.reduce((sum, month) => sum + month.cold, 0);
const updatedLabel = relativeTime(ARCHIVE_GENERATED_AT);

---

<Portal
  pageKey="archive"
  title="Archive — TECH Dashboard"
  canonicalPath="/archive/"
  description={`${years.length} 年 ${months.length} か月分の AI 技術アップデートを月別に保管しています。hot ${storedHot} 件 / warm ${storedWarm} 件 / cold ${storedCold} 件の階層で、過去の発表と変更履歴をさかのぼれます。`}
  descriptionEn={`${months.length} archived months across ${years.length} years of AI technology updates, tiered as ${storedHot} hot, ${storedWarm} warm, and ${storedCold} cold entries for browsing past announcements and changelogs.`}
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Archive" }]}
>
  <PageHero
    className="page-hero-top-level page-hero-archive"
    kicker="Browse history"
    title="Archive"
    count={`${ARCHIVE_BROWSABLE_ENTRIES} 閲覧可能 · ${ARCHIVE_STORED_ENTRIES} 保存行`}
    countEn={`${ARCHIVE_BROWSABLE_ENTRIES} browsable · ${ARCHIVE_STORED_ENTRIES} stored`}
    headingId="archive-heading"
    description="要約付きのwarm/cold記事を月単位で閲覧できます。保存行には、live収録時点を統計用に残すhot snapshotも含まれます。"
    descriptionEn="Browse summary-ready warm and cold articles by month. Stored rows also include hot statistical snapshots from their live period."
    actions={[
      { href: "/", label: "Latest timeline" },
      { href: latestMonth ? `/archive/${latestMonth.month}` : "#archive-months", label: "Latest month" },
      { href: "#archive-months", label: "Browse months" },
    ]}
    metrics={[
      {
        label: "Browsable",
        value: ARCHIVE_BROWSABLE_ENTRIES,
        detail: "月別一覧で閲覧できる要約付き記事",
        detailEn: "Summary-ready entries shown in monthly lists",
        scope: "archive-browsable",
      },
      {
        label: "Stored rows",
        value: ARCHIVE_STORED_ENTRIES,
        detail: "live収録時点のhot snapshotを含む全履歴",
        detailEn: "Full history including hot snapshots from their live period",
        scope: "archive-stored",
      },
      {
        label: "Months",
        value: months.length,
        detail: "月次artifact数",
        detailEn: "Monthly artifacts",
        scope: "archive-month-count",
      },
      {
        label: "Live index",
        value: DASHBOARD_METRICS.timelineEntries,
        detail: "現在のTimeline",
        detailEn: "Current Timeline",
        scope: "timeline-live",
      },
      {
        label: "Latest month",
        value: latestMonth ? latestMonth.label : "none",
        detail: "最新archive月",
        detailEn: "Newest archive month",
        scope: "latest-month",
      },
      {
        label: "Updated",
        value: updatedLabel,
        datetime: ARCHIVE_GENERATED_AT,
        detail: "archive index snapshot",
        detailEn: "Archive index snapshot",
        scope: "archive-snapshot",
      },
    ]}
  />

  <div class="layout">
    <Sidebar />

    <main>
      {peakMonth && (
        <section class="archive-spotlight" aria-label="Archive highlights">
          <div>
            <span>Peak month</span>
            <strong>{peakMonth.label}</strong>
            <small>{peakMonth.count} browsable · {peakMonth.storedCount} stored</small>
          </div>
          <div>
            <span>Most recent archive</span>
            <strong>{latestMonth!.label}</strong>
            <small>{latestMonth!.hot} hot · {latestMonth!.warm} warm · {latestMonth!.cold} cold</small>
          </div>
          <div>
            <span>Storage mix</span>
            <strong>{storedHot} hot · {storedWarm} warm</strong>
            <small>{storedCold} cold · {ARCHIVE_STORED_ENTRIES} total</small>
            <small>
              <span class="i18n-ja">{ARCHIVE_TIER_SUMMARY.ja}</span>
              <span class="i18n-en" lang="en">{ARCHIVE_TIER_SUMMARY.en}</span>
            </small>
          </div>
        </section>
      )}

      {years.length > 0 && (
        <nav id="archive-months" class="year-nav" aria-label="Archive years">
          {years.map((year) => (
            <a href={`#year-${year}`}>
              {year}
              <span>{yearTotals.get(year)} browsable</span>
            </a>
          ))}
        </nav>
      )}

      {months.length === 0 && (
        <p class="archive-empty">
          まだアーカイブはありません。
        </p>
      )}

      {years.map((year) => (
        <section class="year-section" id={`year-${year}`}>
          <div class="year-header">
            <h3 class="year-head">{year}</h3>
            <span>
              {byYear.get(year)!.length} months · {yearTotals.get(year)} browsable · {yearStoredTotals.get(year)} stored
            </span>
          </div>
          <div class="month-grid">
            {byYear.get(year)!.map((m) => (
              <a
                href={`/archive/${m.month}`}
                class="month-card"
                data-peak-percent={m.peakPercent}
                data-visual-bar-width={m.barWidth}
                data-browsable-count={m.count}
                data-stored-count={m.storedCount}
              >
                <div class="month-card-top">
                  <div>
                    <div class="month-label">{m.label}</div>
                    <div class="month-count">
                      {m.count}
                      <small>{m.storedCount} stored</small>
                    </div>
                  </div>
                  <span class="month-share" title={`${m.peakPercent}% of peak month ${peakMonth?.label ?? ""}`}>
                    {m.peakShareLabel}% of peak
                  </span>
                </div>
                <div class="month-bar" aria-hidden="true">
                  <span style={`width:${m.barWidth}%;background:${m.topCategoryColor}`}></span>
                </div>
                <div class="month-category">
                  <span style={`background:${m.topCategoryColor}`}></span>
                  Top category · {m.topCategoryLabel} {m.topCategoryCount > 0 ? `· ${m.topCategoryCount} browsable` : ""}
                </div>
                <div class="month-meta">
                  <span class="tier hot">hot {m.hot}</span>
                  <span class="tier warm">warm {m.warm}</span>
                  <span class="tier cold">cold {m.cold}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>

    <aside class="right archive-insights">
      <div class="side-card archive-tier-help">
        <div class="rail-title">Archive tiers</div>
        <p>
          <span class="i18n-ja">{ARCHIVE_TIER_DETAIL.ja}</span>
          <span class="i18n-en" lang="en">{ARCHIVE_TIER_DETAIL.en}</span>
        </p>
      </div>
    </aside>
  </div>
</Portal>

<style>
  .archive-spotlight {
    display: grid;
    gap: 10px;
  }

  .archive-spotlight > div {
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
  }

  .archive-spotlight span {
    display: block;
    margin-bottom: 5px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive-spotlight strong {
    display: block;
    overflow: hidden;
    color: var(--text);
    font-size: 14.5px;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-spotlight {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 14px;
  }

  .archive-spotlight small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
  }

  .year-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 18px;
  }

  .year-nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 12px;
    text-decoration: none;
  }

  .year-nav a:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    color: var(--accent);
  }

  .year-nav span {
    color: var(--muted-2);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
  }

  .archive-empty {
    padding: 24px 0;
    color: var(--muted);
  }

  .archive-insights {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .archive-tier-help .rail-title {
    margin-bottom: 10px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .archive-tier-help p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .archive-tier-help strong {
    color: var(--text);
  }

  .year-section {
    margin-bottom: 32px;
  }

  .year-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
  }

  .year-head {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle, var(--muted));
    margin: 0 0 0 4px;
  }

  .year-header span {
    color: var(--muted-2);
    font-size: 11px;
  }

  .month-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  .month-card {
    display: block;
    min-height: 148px;
    padding: 14px 15px;
    background: var(--bg-2, var(--surface));
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }

  .month-card:hover {
    border-color: var(--accent, #5eead4);
    transform: translateY(-1px);
  }

  .month-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .month-label {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .month-count {
    font-size: 23px;
    font-weight: 600;
    margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }

  .month-count small {
    display: block;
    margin-top: 2px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.2;
  }

  .month-share {
    padding-top: 2px;
    color: var(--muted-2);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
  }

  .month-bar {
    height: 7px;
    margin-bottom: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--border) 42%, transparent);
  }

  .month-bar span {
    display: block;
    height: 100%;
    min-width: 6%;
    border-radius: inherit;
  }

  .month-category {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 18px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 11.5px;
  }

  .month-category span {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 999px;
  }

  .month-meta {
    display: flex;
    gap: 8px;
    font-size: 11px;
  }
  .tier {
    padding: 2px 6px;
    border-radius: 4px;
  }
  .tier.hot { background: rgba(52, 211, 153, 0.14); color: #34d399; }
  .tier.warm { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
  .tier.cold { background: rgba(96, 165, 250, 0.15); color: #60a5fa; }

  @media (max-width: 980px) {
    .archive-spotlight {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .year-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
