---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import KnowledgeCard from "../components/KnowledgeCard.astro";
import {
  KNOWLEDGE_ENTRIES,
  knowledgeBySource,
  MAIN_TIMELINE_ENTRIES,
  GENERATED_AT,
  relativeTime,
  type NormalizedEntry,
} from "../lib/data.ts";
import { sourceFaviconUrl } from "../lib/favicon.ts";
import { REACTION_CONTRACT_EN, REACTION_CONTRACT_JA } from "../lib/reaction-copy.ts";
import { KNOWLEDGE_RSS_HREF } from "../lib/rss.ts";
import { SOURCE_META } from "../lib/source-meta.ts";

const now = new Date();
const sourceLabel = (source: string): string =>
  SOURCE_META.find((item) => item.id === source)?.displayName ?? source;

// Knowledge sources, ordered alphabetically by display label (predictable A->Z,
// not by item count) so the Sources nav matches the rest of the site's
// category/source lists (LL-103).
const groups = knowledgeBySource().sort((a, b) =>
  sourceLabel(a.source).localeCompare(sourceLabel(b.source)),
);

const sourceFavicon = (group: { items: readonly NormalizedEntry[] }): string => {
  return sourceFaviconUrl(group.items[0]?.url ?? "");
};

/** Source-specific scope descriptions for the evergreen knowledge lane. */
const SOURCE_COPY: Record<string, { ja: string; en: string }> = {
  "anthropic-engineering": {
    ja: "Anthropicの設計・運用ディープダイブ。Claude Codeやエージェント開発の実践知見。",
    en: "Anthropic engineering deep dives on Claude Code, agent design, and production operations.",
  },
  "aws-ml-blog": {
    ja: "AWSの機械学習・生成AI実装。Bedrock、エージェント、運用アーキテクチャの実践例。",
    en: "AWS implementation guides for machine learning, Bedrock, agents, and production architecture.",
  },
  "github-blog-ai": {
    ja: "GitHub BlogのAI技術解説。開発ワークフロー、モデル活用、AI時代のソフトウェア開発。",
    en: "GitHub technical essays on AI development workflows, models, and software engineering.",
  },
  "github-copilot": {
    ja: "GitHub Copilot公式ブログ。CLI、カスタムエージェント、Copilot活用のhow-to。",
    en: "Official GitHub Copilot guides for CLI workflows, custom agents, and practical adoption.",
  },
  "google-cloud-blog": {
    ja: "Google CloudのAI・データ基盤。Gemini、BigQuery、エージェント実装の設計ガイド。",
    en: "Google Cloud guidance for Gemini, BigQuery, data platforms, and agent implementation.",
  },
  "meta-engineering": {
    ja: "Metaの大規模システムとML基盤。インフラ、モデル運用、性能改善の技術解説。",
    en: "Meta engineering deep dives on large-scale systems, ML infrastructure, and performance.",
  },
  "microsoft-foundry": {
    ja: "Microsoft Foundryのエージェント開発。設計、評価、メモリ、コスト管理の実践ガイド。",
    en: "Microsoft Foundry guidance for agent design, evaluation, memory, and cost management.",
  },
  "netflix-techblog": {
    ja: "Netflixの配信・データ・ML基盤。大規模サービス運用と信頼性設計の知見。",
    en: "Netflix engineering lessons on delivery, data, ML platforms, and service reliability.",
  },
};
const FALLBACK_SOURCE_COPY = {
  ja: "長期参照向けのエンジニアリング知見ソース。",
  en: "An engineering source selected for durable, long-term reference.",
};

const entryTime = (entry: NormalizedEntry): number =>
  Date.parse(entry.publishedAt ?? entry.collectedAt ?? "") || 0;

const countSince = (items: readonly NormalizedEntry[], days: number): number => {
  const cutoff = now.getTime() - days * 86_400_000;
  return items.filter((entry) => entryTime(entry) >= cutoff).length;
};

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Knowledge" },
];
---

<Portal
  pageKey="knowledge"
  title="Knowledge — ベストプラクティス & 知見 | TECH Dashboard"
  description="各社のエンジニアリングブログやベストプラクティスを、流れていくニュースとは別に蓄積するページです。時間が経っても価値が減らない知見をソース別にまとめています。"
  breadcrumb={breadcrumb}
  rssHref={KNOWLEDGE_RSS_HREF}
  rssTitle="TECH Dashboard | Knowledge & Best Practices"
>
  <PageHero
    className="page-hero-top-level page-hero-knowledge"
    accent="#34d399"
    kicker="Knowledge lane"
    title="Knowledge & Best Practices"
    count={`${KNOWLEDGE_ENTRIES.length} guides`}
    headingId="knowledge-heading"
    description="各社のエンジニアリングブログやベストプラクティスは、流れていくニュースとは別にここで蓄積します。アーカイブで消えず、いつでも参照できる「知見の置き場」です。"
    actions={[
      {
        href: KNOWLEDGE_RSS_HREF,
        label: "Knowledge RSSを購読",
        labelEn: "Subscribe to Knowledge RSS",
        mediaType: "application/rss+xml",
        mobilePriority: true,
      },
      { href: "/", label: "Main timeline" },
      { href: "#knowledge-sources", label: "Browse sources" },
      { href: "/about", label: "収集方針" },
    ]}
    metrics={[
      {
        label: "Guides",
        value: KNOWLEDGE_ENTRIES.length,
        detail: "現在のKnowledgeレーン",
        detailEn: "Current Knowledge lane",
        scope: "knowledge-live-guides",
      },
      {
        label: "Sources",
        value: groups.length,
        detail: "知見を掲載中のsource",
        detailEn: "Sources represented here",
        scope: "knowledge-source-groups",
      },
      {
        label: "Last 30d",
        value: countSince(KNOWLEDGE_ENTRIES, 30),
        detail: "直近30日のKnowledge記事",
        detailEn: "Knowledge entries in the last 30 days",
        scope: "knowledge-last-30d",
      },
      {
        label: "News timeline",
        value: MAIN_TIMELINE_ENTRIES.length,
        detail: "現在の主Timeline",
        detailEn: "Current main Timeline",
        scope: "timeline-live",
      },
      {
        label: "Updated",
        value: relativeTime(GENERATED_AT, now),
        datetime: GENERATED_AT,
        detail: "公開index snapshot",
        detailEn: "Published index snapshot",
        scope: "knowledge-snapshot",
      },
    ]}
  />

  <div class="layout lane-layout" style="--cat-color:#34d399">
    <aside class="lane-rail" aria-label="Knowledge navigation">
      <div class="lane-rail-id">
        <div class="lane-rail-icon" aria-hidden="true">✦</div>
        <h2>Knowledge</h2>
        <p>時間が経っても価値が減らない知見を、ニュースとは別に蓄積するレーンです。</p>
        <div class="lane-rail-stat">
          <strong>{KNOWLEDGE_ENTRIES.length}</strong>
          <span>guides</span>
        </div>
      </div>

      <div class="side-card">
        <div class="right-title">Sources</div>
        <div class="knowledge-source-list">
          {groups.map((group) => (
            <a class="knowledge-source-link" href={`#kg-${group.source}`}>
              <span class="kg-src-id">
                {sourceFavicon(group) && (
                  <img class="kg-src-favicon" src={sourceFavicon(group)} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                )}
                <strong>{sourceLabel(group.source)}</strong>
              </span>
              <span class="c">{group.items.length}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="side-card knowledge-note-card">
        <div class="right-title">Tip</div>
        <p>
          日々のリリース・アナウンスは <a href="/">Timeline</a> へ。ここは恒久的に読み返したい知見の置き場です。
        </p>
      </div>
    </aside>

    <main>
      <section class="knowledge-intro" aria-labelledby="knowledge-why-heading">
        <p class="section-kicker">Why a separate lane?</p>
        <h2 id="knowledge-why-heading">ニュースは流す、知見は貯める</h2>
        <p class="section-note">
          <span class="i18n-ja">
            ニュースは Timeline で流し、長く使える知見は <strong>evergreen</strong> としてこのページに蓄積します。
          </span>
          <span class="i18n-en" lang="en">
            News flows through Timeline while long-lived guides stay in this <strong>evergreen</strong> lane.
          </span>
        </p>
      </section>
      <p
        class="knowledge-reaction-note"
        data-reaction-explainer
        data-reaction-overview
        data-reaction-state="loading"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8.7 10.1 12 3.8c.4-.8 1.4-1.2 2.2-.8.7.3 1.1 1 .9 1.8l-1 4h4.6c1.4 0 2.5 1.3 2.2 2.7l-1.2 6.7c-.2 1.1-1.2 1.9-2.3 1.9H8.7v-10Z"></path>
          <path d="M3.2 10.1h5.5v10H3.2v-10Z"></path>
        </svg>
        <span class="i18n-ja">
          {REACTION_CONTRACT_JA}
          <a href="/privacy#anonymous-reactions">仕組みとプライバシー</a>
        </span>
        <span class="i18n-en" lang="en">
          {REACTION_CONTRACT_EN}
          <a href="/privacy#anonymous-reactions">How it works and privacy</a>
        </span>
      </p>

      {groups.length === 0 ? (
        <div class="empty-state">
          <strong>蓄積された知見はまだありません。</strong>
          <p>次回の収集後に、各社のエンジニアリングブログやベストプラクティスがここに貯まっていきます。</p>
          <a href="/status">Status</a>
        </div>
      ) : (
        <div id="knowledge-sources" class="knowledge-source-stack">
          {groups.map((group) => (
            <section class="knowledge-source-group" aria-labelledby={`kg-${group.source}`}>
              <div class="knowledge-source-head">
                <div class="knowledge-source-headings">
                  <h2 id={`kg-${group.source}`}>
                    {sourceFavicon(group) && (
                      <img class="kg-head-favicon" src={sourceFavicon(group)} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                    )}
                    {sourceLabel(group.source)}
                  </h2>
                  <p class="knowledge-source-desc">
                    <span class="i18n-ja">{(SOURCE_COPY[group.source] ?? FALLBACK_SOURCE_COPY).ja}</span>
                    <span class="i18n-en" lang="en">{(SOURCE_COPY[group.source] ?? FALLBACK_SOURCE_COPY).en}</span>
                  </p>
                </div>
                <div class="knowledge-source-meta">
                  <span class="knowledge-source-count">{group.items.length}</span>
                  <span class="knowledge-source-sub">guides · {countSince(group.items, 30)} in 30d</span>
                </div>
              </div>
              <div class="knowledge-card-grid">
                {group.items.map((entry) => (
                  <KnowledgeCard entry={entry} />
                ))}
              </div>
            </section>
          ))}
        </div>
      )}
    </main>
  </div>
</Portal>

<style>
  .knowledge-intro {
    margin-bottom: 1rem;
  }
  .knowledge-intro h2 {
    margin: 0.15rem 0 0.4rem;
    font-size: 1.05rem;
  }
  .knowledge-reaction-note {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    max-width: 74ch;
    margin: -0.15rem 0 1.15rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--reaction) 34%, var(--border));
    border-radius: 10px;
    background: color-mix(in srgb, var(--reaction) 7%, var(--surface));
    color: var(--text-2);
    font-size: 0.76rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .knowledge-reaction-note[hidden] {
    display: none;
  }
  .knowledge-reaction-note svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    margin-top: 0.05rem;
    fill: none;
    stroke: var(--reaction);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .knowledge-reaction-note a {
    color: var(--accent);
    font-weight: 700;
    text-underline-offset: 2px;
  }
  .knowledge-source-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .knowledge-source-group {
    border: 1px solid var(--border, rgba(148, 163, 184, 0.18));
    border-radius: 14px;
    background: var(--surface, rgba(255, 255, 255, 0.02));
    padding: 1rem 1rem 1.1rem;
  }
  .knowledge-source-group:has(.knowledge-source-head h2:target) {
    border-color: color-mix(in srgb, #34d399 48%, var(--border));
    box-shadow: 0 0 0 2px color-mix(in srgb, #34d399 18%, transparent);
  }
  .knowledge-source-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border, rgba(148, 163, 184, 0.16));
  }
  .knowledge-source-head h2 {
    margin: 0 0 0.25rem;
    font-size: 1.02rem;
    scroll-margin-top: 120px;
  }
  .knowledge-source-headings {
    min-width: 0;
  }
  .knowledge-source-desc {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted, #94a3b8);
    max-width: 60ch;
  }
  .knowledge-source-meta {
    text-align: right;
    flex-shrink: 0;
  }
  .knowledge-source-count {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: #34d399;
  }
  .knowledge-source-sub {
    font-size: 0.72rem;
    color: var(--text-muted, #94a3b8);
  }
  .knowledge-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  @media (max-width: 620px) {
    .knowledge-card-grid {
      grid-template-columns: 1fr;
    }
    .knowledge-reaction-note {
      margin-top: 0;
      margin-bottom: 0.9rem;
      padding: 0.6rem 0.65rem;
      font-size: 0.72rem;
    }
  }
  .knowledge-source-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .knowledge-source-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    font-size: 0.85rem;
    text-decoration: none;
    color: inherit;
    background: var(--surface, rgba(148, 163, 184, 0.06));
  }
  .knowledge-source-link:hover {
    background: rgba(52, 211, 153, 0.12);
  }
  .knowledge-source-link .c {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted, #94a3b8);
  }
  .kg-src-id {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }
  .kg-src-favicon {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .knowledge-source-link strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  .kg-head-favicon {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    vertical-align: -3px;
    margin-right: 7px;
  }
</style>
