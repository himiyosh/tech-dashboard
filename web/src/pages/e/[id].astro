                </span>
                <span class="ed-pn-time" data-relative-time data-datetime={next.publishedAt}>
                  {relativeTime(next.publishedAt, now)}
                </span>
              </span>
              <span class="ed-pn-arrow" aria-hidden="true">→</span>
            </a>
          ) : <span class="ed-pn-empty" aria-hidden="true"></span>}
