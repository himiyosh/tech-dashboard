---
import Portal from "../../layouts/Portal.astro";
import Sidebar from "../../components/Sidebar.astro";
import CategoryThumb from "../../components/CategoryThumb.astro";
import ArticleLike from "../../components/ArticleLike.astro";
import { SITE_URL } from "../../lib/site.ts";
import {
  ALL_ENTRIES,
  CATEGORY_META,
  adjacentInCategory,
  entriesBySource,
  entriesByTag,
  categoryImportanceStanding,
  importanceLabel,
  relatedEntries,
  relativeTime,
  sourceAvgImportance,
  latestListedCollectedAtForEntry,
  summaryForLang,
  summaryForLangWithFallback,
  titleForLang,
  titleForLangWithFallback,
  trendingTags,
  type NormalizedEntry,
} from "../../lib/data.ts";
import { bodyForEntry } from "../../lib/bodies.ts";
import { sourceFaviconUrl, sourceHost } from "../../lib/favicon.ts";
import { SOURCE_META, sourceAnchorId, sourceAuthority, sourceLabel } from "../../lib/source-meta.ts";
import { sourceFreshnessStatus } from "../../lib/freshness.ts";

export function getStaticPaths() {
  return ALL_ENTRIES.map((e) => ({
    params: { id: e.id },
    props: { entry: e },
  }));
}

interface Props { entry: NormalizedEntry; }
const { entry } = Astro.props as Props;

const titleJa = titleForLang(entry, "ja");
const titleEn = titleForLang(entry, "en");
const titleDisplay = titleJa || titleEn || entry.title;
const likeTitleJa = titleForLangWithFallback(entry, "ja");
const likeTitleEn = titleForLangWithFallback(entry, "en");
const summaryJaResult = summaryForLangWithFallback(entry, "ja");
const summaryJa = summaryJaResult.text;
const summaryEn = summaryForLangWithFallback(entry, "en");
// "Summary pending" only when there is no usable summary in ANY language.
// summaryForLangWithFallback cross-falls-back and blanks boilerplate / title
// echoes, so an English-source entry with a real EN summary is NOT treated as
// pending just because its JA summary has not been generated yet (LL-074).
const summaryAbsent = !summaryJa && !summaryEn.text;
// Body lives in data/bodies.json (LL-113), not on the entry. Render prose only
// when a real long-form body exists; otherwise the summary-first digest +
// read-original view is shown. Bodies are generated by a separate cloud worker
// (opus-4.8); entries without one simply have no key here.
const body = bodyForEntry(entry.id);
const hasRealBody = body !== null;

const catMeta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = catMeta?.color ?? "#8a847e";
const catName = catMeta?.name ?? entry.category;
const catEmoji = catMeta?.emoji ?? "\u{1F4C4}";

const srcMeta = SOURCE_META.find((s) => s.id === entry.source);
const srcDisplay = sourceLabel(entry.source);
const srcTier = srcMeta?.tier;
const srcAuthority = sourceAuthority(entry.source, entry.sourceType);
const srcAuthorityBadgeClass = ["badge", "authority", srcAuthority.kind].join(" ");
const srcAuthorityTitle = `${srcAuthority.en} source (${srcAuthority.ja})${srcTier ? ` · registry tier ${srcTier}` : ""}`;
const sourceStatusAnchor = srcMeta ? sourceAnchorId(entry.source) : null;
const sourceStatusHref = sourceStatusAnchor ? `/status#${sourceStatusAnchor}` : "/status";
const srcAvgImp = sourceAvgImportance(entry, 30);
const srcAvgTitle = `Average importance of this source's last 30 listed entries: ${srcAvgImp.toFixed(1)} out of 3 (1=Info, 2=Medium, 3=High)`;

const entryFavicon = sourceFaviconUrl(entry.url);

function splitJaPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[。！？])\s*/).map((x) => x.trim()).filter(Boolean);
}
function splitEnPoints(s: string): string[] {
  if (!s) return [];
  return s.split(/(?<=[.!?])\s+/).map((x) => x.trim()).filter(Boolean);
}
const pointsJa = summaryAbsent || summaryJaResult.isFallback ? [] : splitJaPoints(summaryJa);
const pointsEn = summaryAbsent ? [] : splitEnPoints(summaryEn.text);

const sourceTypeLabel: Record<NormalizedEntry["sourceType"], string> = {
  release: "リリース", changelog: "Changelog", paper: "論文",
  blog: "ブログ", community: "コミュニティ",
};
const importanceMeta = importanceLabel(entry.importance);
const halfLifeLabel: Record<string, { label: string; emoji: string; color: string }> = {
  news: { label: "短命 (ニュース)", emoji: "⏱️", color: "#f87171" },
  tutorial: { label: "中期 (チュートリアル)", emoji: "📘", color: "#fbbf24" },
  architecture: { label: "長期 (アーキテクチャ)", emoji: "🏛️", color: "#60a5fa" },
  fundamental: { label: "永続 (基礎知識)", emoji: "🌱", color: "#4ade80" },
};

const now = new Date();
const rel = relativeTime(entry.publishedAt, now);
const sameSource = entriesBySource(entry, 5);
const sameTag = entriesByTag(entry, 5);
const sameCategory = relatedEntries(entry, 6);
const tags = trendingTags(12);
const { prev, next } = adjacentInCategory(entry);
const categoryStanding = categoryImportanceStanding(entry);

const latestSourceCollectedAt = latestListedCollectedAtForEntry(entry);
const freshness = sourceFreshnessStatus(entry, latestSourceCollectedAt, now.getTime());
const stale = freshness.status === "stale" || freshness.status === "error";
const latestSourceRelative = relativeTime(latestSourceCollectedAt, now);
const staleDetail = `latest listed entry collected ${latestSourceRelative} · stale > ${freshness.threshold.staleHrs}h`;
const freshnessDetail = stale
  ? `source collection freshness · ${staleDetail}`
  : `source collection freshness · latest listed entry collected ${latestSourceRelative} · within ${freshness.threshold.staleHrs}h freshness threshold`;
const collectionFreshnessLabelJa = stale ? "収集元 更新遅延" : "収集元 更新OK";
const collectionFreshnessLabelEn = stale ? "Source feed stale" : "Source feed fresh";
const collectionFreshnessDescriptionId = `collection-freshness-description-${entry.id}`;
const collectionFreshnessDescriptionJa = sourceStatusAnchor
  ? `ソース収集の状態です。${freshnessDetail}。Status の ${srcDisplay} 行で詳細を確認できます。`
  : `ソース収集の状態です。${freshnessDetail}。要約の生成状態とは別です。`;
const collectionFreshnessDescriptionEn = sourceStatusAnchor
  ? `${freshnessDetail}. Opens the ${srcDisplay} row in Status for details.`
  : `${freshnessDetail}. This is separate from summary generation.`;

const bodyChars = (body?.bodyJa ?? "").length;
const readMinutes = bodyChars > 0 ? Math.max(1, Math.round(bodyChars / 500)) : 0;

// Split body and build TOC headings (use first ~24 chars of each paragraph as label).
const paragraphsJa: string[] = body?.bodyJa
  ? body.bodyJa.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];
const paragraphsEn: string[] = body?.bodyEn
  ? body.bodyEn.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean)
  : [];

function tocLabelJa(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^。．.!?！？]{1,40}[。．.!?！？]/);
  const label = (m?.[0] ?? trimmed).slice(0, 30);
  return label.length < trimmed.length ? label.replace(/[。．.!?！？]$/, "") + "…" : label;
}
function tocLabelEn(s: string): string {
  const trimmed = s.replace(/\s+/g, " ");
  const m = trimmed.match(/^[^.!?]{1,80}[.!?]/);
  const label = (m?.[0] ?? trimmed).slice(0, 60);
  return label.length < trimmed.length ? label.replace(/[.!?]$/, "") + "…" : label;
}

// Highlight tag mentions in body — server-side regex replace.
function escapeHtml(s: string): string {
  return s.replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] || c,
  );
}
function escapeRegex(s: string): string {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}
function highlightTags(html: string, tagList: string[]): string {
  if (tagList.length === 0) return html;
  // Sort by length desc to avoid prefix collisions.
  const sorted = [...new Set(tagList.map((t) => t.trim()).filter(Boolean))]
    .sort((a, b) => b.length - a.length);
  let out = html;
  for (const tag of sorted) {
    if (tag.length < 2) continue;
    const re = new RegExp(`\\b${escapeRegex(tag)}\\b`, "gi");
    const href = `/t/${encodeURIComponent(tag.toLowerCase())}`;
    out = out.replace(re, (match) => `<a class="kw" href="${href}">${escapeHtml(match)}</a>`);
  }
  return out;
}

const renderedJa = paragraphsJa.map((p, i) => ({
  id: `p-ja-${i + 1}`,
  label: tocLabelJa(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
const renderedEn = paragraphsEn.map((p, i) => ({
  id: `p-en-${i + 1}`,
  label: tocLabelEn(p),
  html: highlightTags(escapeHtml(p), entry.tags),
}));
// Backwards-compat alias: TOC defaults to JA when present, otherwise EN.
const renderedParagraphs = renderedJa.length > 0 ? renderedJa : renderedEn;

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: catName, href: `/c/${entry.category}` },
  { label: titleDisplay },
];
const pageTitle = `${titleDisplay} — TECH Dashboard`;
const pageDesc = (summaryAbsent ? titleDisplay : summaryJa || summaryEn.text || entry.title).slice(0, 160);
const ogImage = entry.image?.src ?? "";
const canonicalUrl = `${SITE_URL}/e/${entry.id}/`;
const shareUrl = summaryAbsent ? entry.url : canonicalUrl;
const importanceStandingJa =
  `${catName} ${categoryStanding.total}件中、同等以上 ${categoryStanding.sameOrHigher}件`;
const importanceStandingEn =
  `${categoryStanding.sameOrHigher} of ${categoryStanding.total} ${catName} entries are equal or higher`;
const tldrTitleJa = summaryJaResult.isFallback
  ? "English summary"
  : pointsJa.length > 1
    ? `${Math.min(pointsJa.length, 4)} 点サマリ`
    : "要点サマリ";
const tldrTitleEn = summaryEn.isFallback
  ? "Japanese-language summary"
  : pointsEn.length > 1
    ? `${Math.min(pointsEn.length, 4)} key points`
    : "Summary highlight";

function fmtDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat("ja-JP", {
      timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit",
      day: "2-digit", hour: "2-digit", minute: "2-digit",
    }).format(new Date(iso));
  } catch { return iso; }
}

const halfLifeMeta = entry.halfLife ? halfLifeLabel[entry.halfLife] : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: titleDisplay,
  description: pageDesc,
  url: canonicalUrl,
  datePublished: entry.publishedAt,
  dateModified: entry.collectedAt,
  inLanguage: entry.lang === "ja" ? "ja-JP" : "en",
  image: ogImage || undefined,
  author: { "@type": "Organization", name: srcDisplay, url: entry.url },
  publisher: { "@type": "Organization", name: "TECH Dashboard", url: SITE_URL },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  articleSection: catName,
  keywords: entry.tags.join(", "),
};
---

<Portal title={pageTitle} description={pageDesc} pageKey="timeline" breadcrumb={breadcrumb}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={titleDisplay} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={titleDisplay} />
    <meta name="twitter:description" content={pageDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta property="article:section" content={catName} />
    <meta property="article:published_time" content={entry.publishedAt} />
    <meta property="article:modified_time" content={entry.collectedAt} />
    {entry.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta data-pagefind-meta="title[content]" content={titleDisplay} />
    <meta data-pagefind-filter="category[content]" content={entry.category} />
    <meta data-pagefind-filter="source[content]" content={sourceLabel(entry.source)} />
    <meta data-pagefind-filter="sourceType[content]" content={entry.sourceType} />
    <meta data-pagefind-filter="authority[content]" content={srcAuthority.kind} />
    <meta data-pagefind-filter="importance[content]" content={String(entry.importance)} />
    <meta data-pagefind-filter="publishedDay[content]" content={entry.publishedAt.slice(0, 10)} />
    <meta data-pagefind-sort="published[content]" content={String(Date.parse(entry.publishedAt) || 0)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {/* Reading progress bar */}
  <div class="ed-progress" id="ed-progress" style={`--cat-color:${catColor}`}>
    <div class="ed-progress-bar"></div>
  </div>

  <div class="layout">
    <Sidebar active={entry.category} />

    <main class="entry-main" id="entry-main">
      <article class="entry-detail" data-pagefind-body style={`--cat-color:${catColor}`}>
        {/* HERO */}
        <div class="ed-hero" id="ed-hero">
          {entry.image?.src ? (
            <>
              <div class="ed-hero-skeleton"></div>
              <img
                class="ed-hero-img"
                src={entry.image.src}
                alt={entry.image.alt || titleDisplay}
                width={entry.image.width || 1200}
                height={entry.image.height || 630}
                loading="eager"
                decoding="async"
                onload="this.parentElement.classList.add('ed-hero-loaded')"
                onerror="this.parentElement.classList.add('ed-hero-failed')"
              />
              <div class="ed-hero-fallback">
                <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
              </div>
            </>
          ) : (
            <CategoryThumb category={entry.category} seed={entry.id} height="320px" />
          )}
          <div class="ed-hero-overlay">
            <a class="ed-cat-pill" href={`/c/${entry.category}`}>
              <span aria-hidden="true">{catEmoji}</span>
              <span>{catName}</span>
            </a>
            {entry.importance === 3 && <span class="ed-hot-pill">🔥 HOT</span>}
            {stale && (
              sourceStatusAnchor ? (
                <a
                  class="ed-stale-pill"
                  href={sourceStatusHref}
                  title={freshnessDetail}
                  aria-describedby={collectionFreshnessDescriptionId}
                >
                  <span class="i18n-ja">⚠ 収集元 更新遅延</span>
                  <span class="i18n-en" lang="en">⚠ Source feed stale</span>
                </a>
              ) : (
                <span
                  class="ed-stale-pill"
                  title={freshnessDetail}
                  aria-describedby={collectionFreshnessDescriptionId}
                >
                  <span class="i18n-ja">⚠ 収集元 更新遅延</span>
                  <span class="i18n-en" lang="en">⚠ Source feed stale</span>
                </span>
              )
            )}
          </div>
        </div>

        {/* TITLE */}
        <header class="ed-head">
          <h1 class="ed-title">
            <span class="i18n-ja">{titleJa || titleEn || entry.title}</span>
            <span class="i18n-en" lang="en">{titleEn || titleJa || entry.title}</span>
          </h1>
          <div class="ed-byline">
            {entryFavicon && (
              <img class="ed-favicon" src={entryFavicon} alt="" width="16" height="16" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
            )}
            <span class="ed-src-name">{srcDisplay}</span>
            <span
              class={srcAuthorityBadgeClass}
              data-source-authority={srcAuthority.kind}
              data-source-type={entry.sourceType}
              title={srcAuthorityTitle}
            >
              <span class="i18n-ja">{srcAuthority.ja}</span>
              <span class="i18n-en" lang="en">{srcAuthority.en}</span>
            </span>
            <span class="sep">·</span>
            <span class="ed-host">{sourceHost(entry.url)}</span>
            <span class="sep">·</span>
            <time class="ed-published" datetime={entry.publishedAt}>
              <span class="mono">{fmtDate(entry.publishedAt)}</span>
              <span class="sep">·</span>
              <span class="ed-rel">{rel}</span>
            </time>
            {readMinutes > 0 && (<>
              <span class="sep">·</span>
              <span class="ed-read">📖 {readMinutes} min</span>
            </>)}
          </div>
          <div class="ed-action-strip">
            {!summaryAbsent && (
              <a class="ed-header-cta" href={entry.url} target="_blank" rel="noopener nofollow">
                <span>元記事を読む</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            <button class="ed-share-btn" type="button" data-share-mode="url" data-title={titleDisplay} data-url={shareUrl}>
              <span aria-hidden="true">#</span> Copy link
            </button>
            <button class="ed-share-btn secondary" type="button" data-share-mode="title-url" data-title={titleDisplay} data-url={shareUrl}>
              <span aria-hidden="true">+</span> Copy title + URL
            </button>
            {sourceStatusAnchor ? (
              <a
                class={`ed-freshness ${stale ? "warn" : "ok"}`}
                data-freshness-scope="collection"
                href={sourceStatusHref}
                title={freshnessDetail}
                aria-describedby={collectionFreshnessDescriptionId}
              >
                <span class="i18n-ja">{collectionFreshnessLabelJa}</span>
                <span class="i18n-en" lang="en">{collectionFreshnessLabelEn}</span>
              </a>
            ) : (
              <span
                class={`ed-freshness ${stale ? "warn" : "ok"}`}
                data-freshness-scope="collection"
                title={freshnessDetail}
                aria-describedby={collectionFreshnessDescriptionId}
              >
                <span class="i18n-ja">{collectionFreshnessLabelJa}</span>
                <span class="i18n-en" lang="en">{collectionFreshnessLabelEn}</span>
              </span>
            )}
            <span id={collectionFreshnessDescriptionId} class="visually-hidden">
              <span class="i18n-ja">{collectionFreshnessDescriptionJa}</span>
              <span class="i18n-en" lang="en">{collectionFreshnessDescriptionEn}</span>
            </span>
          </div>
          <section
            class="ed-reaction-panel"
            data-reaction-surface
            aria-labelledby="ed-reaction-heading"
            hidden
          >
            <div class="ed-reaction-copy" data-reaction-explainer>
              <strong id="ed-reaction-heading">
                <span class="i18n-ja">この記事は参考になりましたか？</span>
                <span class="i18n-en" lang="en">Was this article useful?</span>
              </strong>
              <p>
                <span class="i18n-ja">
                  匿名の公開いいねです。記事は保存されず、掲載順位にも影響しません。
                  <a href="/about#reactions-privacy">仕組みとプライバシー</a>
                </span>
                <span class="i18n-en" lang="en">
                  This anonymous public like does not save the article or affect ranking.
                  <a href="/about#reactions-privacy">How it works and privacy</a>
                </span>
              </p>
            </div>
            <ArticleLike
              entryId={entry.id}
              variant="detail"
              articleTitleJa={likeTitleJa.text}
              articleTitleEn={likeTitleEn.text}
              articleTitleJaLang={likeTitleJa.isFallback ? likeTitleJa.fallbackLang : "ja"}
              articleTitleEnLang={likeTitleEn.isFallback ? likeTitleEn.fallbackLang : "en"}
            />
          </section>
        </header>

        {summaryAbsent && (
          <section class="ed-pending-summary" aria-labelledby="pending-summary-heading">
            <strong id="pending-summary-heading">
              <span class="i18n-ja">AI 要約 準備待ち</span>
              <span class="i18n-en" lang="en">Summary pending</span>
            </strong>
            <p>
              <span class="i18n-ja">このエントリには AI 要約がまだありません。共有前にタイトル、カテゴリ、原文を確認してください。</span>
              <span class="i18n-en" lang="en">This entry does not have an AI summary yet. Check the title, category, and original source before sharing.</span>
            </p>
            <a href={entry.url} target="_blank" rel="noopener nofollow">
              <span class="i18n-ja">原文を確認する</span>
              <span class="i18n-en" lang="en">Open original source</span>
            </a>
          </section>
        )}

        {/* TL;DR */}
        {!summaryAbsent && ((pointsJa.length > 0 || summaryJa) || (pointsEn.length > 0 || summaryEn.text)) && (
          <section
            class="ed-tldr"
            data-en-summary-fallback={summaryEn.isFallback ? summaryEn.fallbackLang : undefined}
          >
            <div class="ed-tldr-label">
              <span class="ai-badge">AI</span>
              <span class="ed-tldr-title i18n-ja">{tldrTitleJa}</span>
              <span class="ed-tldr-title i18n-en" lang="en">{tldrTitleEn}</span>
              <a class="ed-tldr-source" href={entry.url} target="_blank" rel="noopener nofollow">
                <span class="i18n-ja">原文で検証</span>
                <span class="i18n-en" lang="en">Verify source</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="ed-tldr-body i18n-ja">
              {pointsJa.length > 1 ? (
                <ul class="ed-tldr-list">
                  {pointsJa.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              ) : (
                <p class="ed-tldr-single" lang={summaryJaResult.fallbackLang === "en" ? "en" : "ja"}>{summaryJa}</p>
              )}
            </div>
            <div class="ed-tldr-body i18n-en">
              {pointsEn.length > 1 ? (
                <ul class="ed-tldr-list" lang="en">
                  {pointsEn.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              ) : (
                <p class="ed-tldr-single" lang={summaryEn.fallbackLang === "ja" ? "ja" : "en"}>{summaryEn.text}</p>
              )}
            </div>
          </section>
        )}

        {/* BODY */}
        {hasRealBody && (renderedJa.length > 0 || renderedEn.length > 0) ? (
          <section class="ed-body">
            {renderedJa.length > 0 && (
              <div class="ed-body-prose i18n-ja" lang="ja">
                {renderedJa.map((p, i) => {
                  const mid = Math.floor(renderedJa.length / 2);
                  const showQuote = pointsJa.length > 1 && i === mid && renderedJa.length >= 4;
                  const quote = pointsJa.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · 本記事のポイント</figcaption>
                        </figure>
                      )}
                      {i < renderedJa.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
            )}
            {renderedEn.length > 0 && (
              <div class="ed-body-prose i18n-en" lang="en">
                {renderedEn.map((p, i) => {
                  const mid = Math.floor(renderedEn.length / 2);
                  const showQuote = pointsEn.length > 1 && i === mid && renderedEn.length >= 4 && !summaryEn.isFallback;
                  const quote = pointsEn.slice().sort((a, b) => b.length - a.length)[0] ?? "";
                  return (
                    <Fragment>
                      <p id={p.id} set:html={p.html} />
                      {showQuote && quote && (
                        <figure class="ed-pullquote">
                          <span class="ed-pullquote-mark" aria-hidden="true">“</span>
                          <blockquote>{quote}</blockquote>
                          <figcaption>{catEmoji} {catName} · Key takeaway</figcaption>
                        </figure>
                      )}
                      {i < renderedEn.length - 1 && i % 3 === 2 && !showQuote && (
                        <div class="ed-divider" aria-hidden="true">
                          <span></span><span></span><span></span>
                        </div>
                      )}
                    </Fragment>
                  );
                })}
              </div>
