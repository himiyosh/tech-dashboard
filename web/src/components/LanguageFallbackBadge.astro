---
interface Props {
  fallbackLang: "ja" | "en";
  variant: "title" | "summary";
  class?: string;
}

const { fallbackLang, variant, class: className = "" } = Astro.props as Props;
const language = fallbackLang.toUpperCase();
const languageNameEn = fallbackLang === "ja" ? "Japanese" : "English";
const labelJa = variant === "title"
  ? `原題 ${language}`
  : `AI 要約 ${language}`;
const labelEn = variant === "title"
  ? `${languageNameEn} title`
  : `${languageNameEn} AI summary`;
---

<span
  class:list={["language-fallback-badge", className]}
  data-fallback-language={fallbackLang}
  data-fallback-kind={variant}
>
  <span class="i18n-ja" lang="ja">{labelJa}</span>
  <span class="i18n-en" lang="en">{labelEn}</span>
</span>

<style>
  .language-fallback-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 5px;
    margin-inline-end: 6px;
    border: 1px solid color-mix(in srgb, var(--cat-color, var(--accent)) 32%, var(--border));
    border-radius: 4px;
    background: color-mix(in srgb, var(--cat-color, var(--accent)) 8%, var(--bg-2));
    color: var(--text-2);
    font-family: ui-monospace, monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
    vertical-align: 0.12em;
    white-space: nowrap;
  }
</style>
