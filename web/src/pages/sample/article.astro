---
/**
 * Sample article preview — picks the first entry that has bodyJa and renders
 * it via the same /e/[id]/ template so the design preview is always in sync
 * with the real article page.
 */
import { ALL_ENTRIES } from "../../lib/data.ts";
import { entryDestination } from "../../lib/entry-destination.ts";
import Portal from "../../layouts/Portal.astro";

const target = ALL_ENTRIES.find((e) => (e.bodyJa ?? "").length > 200) ?? ALL_ENTRIES[0];
const targetHref = target ? entryDestination(target).href : "/";
---

<Portal title="Sample Article — TECH Dashboard">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>
  <main class="sample-redirect" data-pagefind-ignore>
    <h1>Sample Article</h1>
    <p>デザイン確認用のサンプル記事へ移動します。</p>
    <p><a href={targetHref}>記事を開く</a></p>
  </main>
  <script is:inline define:vars={{ targetHref }}>
    window.location.replace(targetHref);
  </script>
</Portal>

<style>
  .sample-redirect {
    max-width: 720px;
    margin: 80px auto;
    padding: 24px;
  }
</style>
