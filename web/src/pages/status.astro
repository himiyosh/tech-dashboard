    color: var(--danger);
  }

  .collection-failure-card {
    position: relative;
    overflow: hidden;
  }

  .collection-failure-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--danger);
  }

  .collection-failure-card.clear::before {
    background: var(--success);
  }

  .collection-failure-card.unknown::before {
    background: var(--muted-2);
  }

  .collection-failure-card > strong {
    display: block;
    margin-bottom: 6px;
    font-size: 20px;
  }

  .collection-failure-list {
    margin: 6px 0 0;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 11px;
    line-height: 1.5;
  }

  .category-health-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .status-insight-card {
    container-type: inline-size;
  }

  .category-health-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    align-items: start;
    padding-bottom: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .category-health-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .category-health-list li > span,
  .category-health-list small {
    min-width: 0;
  }

  .category-health-list li > span {
    color: var(--text);
    font-size: 12px;
  }

  .category-health-list small {
    color: var(--muted-2);
    font-size: 10.5px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  @container (min-width: 224px) {
    .category-health-list li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      align-items: center;
    }

    .category-health-list small {
      overflow-wrap: normal;
      white-space: nowrap;
    }
  }

  @media (max-width: 980px) {
    .status-hero,
    .status-detail-grid,
    .source-summary-grid {
      grid-template-columns: 1fr;
    }

    .status-hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .status-hero {
      padding: 14px;
    }

    .status-hero-grid {
      grid-template-columns: 1fr;
    }

    .source-item {
      align-items: flex-start;
    }

    .source-time-block {
      min-width: 72px;
    }

    .source-status-badge {
      display: none;
    }

    .status-filter,
    .category-filter {
      min-height: 44px;
    }
  }
</style>

<script>
  (() => {
    const statusButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-source-filter]"));
    const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
    const sourceList = document.getElementById("source-health-list");
    const items = Array.from(
      sourceList?.querySelectorAll<HTMLElement>("[data-source-activity-status]") ?? [],
    );
    const empty = document.getElementById("source-empty") as HTMLElement | null;
    const visibleCountNodes = Array.from(
      document.querySelectorAll<HTMLElement>("[data-visible-source-count]"),
    );
    let statusFilter =
      statusButtons.find((button) => button.classList.contains("is-active"))?.dataset.sourceFilter ?? "all";
    let categoryFilter = "all";

    const apply = () => {
      let visibleCount = 0;
      for (const button of statusButtons) {
        const active = button.dataset.sourceFilter === statusFilter;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      }
      for (const button of categoryButtons) {
        const active = button.dataset.categoryFilter === categoryFilter;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      }
      for (const item of items) {
        const itemStatus = item.dataset.sourceActivityStatus ?? "";
        const matchesStatus =
          statusFilter === "all" ||
          itemStatus === statusFilter ||
          (statusFilter === "limited" && itemStatus !== "recent");
        const matchesCategory = categoryFilter === "all" || item.dataset.sourceCategory === categoryFilter;
        const visible = matchesStatus && matchesCategory;
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      }
      if (empty) empty.hidden = visibleCount > 0;
      for (const node of visibleCountNodes) node.textContent = String(visibleCount);
    };
    for (const button of statusButtons) {
      button.addEventListener("click", () => {
        statusFilter = button.dataset.sourceFilter ?? "all";
        apply();
      });
    }
    for (const button of categoryButtons) {
      button.addEventListener("click", () => {
        categoryFilter = button.dataset.categoryFilter ?? "all";
        apply();
      });
    }
    apply();
  })();
</script>
