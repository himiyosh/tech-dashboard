---
import {
  ARTICLE_CHAT_PERSONAS,
  presentArticleChatTurn,
  type ArticleChatTurn,
} from "../lib/article-chat.ts";

interface Props {
  chat: readonly ArticleChatTurn[];
}

const { chat } = Astro.props;
const poko = ARTICLE_CHAT_PERSONAS.a;
const guide = ARTICLE_CHAT_PERSONAS.b;
---

<section class="ed-chat" aria-labelledby="ed-chat-heading" data-article-chat data-cast-art="original-provisional">
  {/* One per-page sprite: the characters are original interpretations, not approved reference assets. */}
  <svg class="ed-chat-sprite" aria-hidden="true" focusable="false">
    <symbol id="ed-chat-poko-art" viewBox="0 0 120 120">
      <path d="M37 94c-5 4-9 11-7 16 2 4 8 5 14 3l8-10m31-9c5 4 9 11 7 16-2 4-8 5-14 3l-8-10" fill="var(--important)" stroke="var(--border-strong)" stroke-width="3" stroke-linejoin="round" />
      <path d="M27 58c-8-2-12 4-12 11 0 5 3 9 9 9m69-20c8-2 12 4 12 11 0 5-3 9-9 9" fill="none" stroke="var(--border-strong)" stroke-width="5" stroke-linecap="round" />
      <path d="M60 14c26 0 46 21 46 52 0 27-19 42-46 42S14 93 14 66c0-31 20-52 46-52Z" fill="var(--important)" stroke="var(--border-strong)" stroke-width="3" />
      <ellipse cx="60" cy="84" rx="25" ry="17" fill="var(--text)" opacity=".44" />
      <ellipse cx="44" cy="55" rx="9" ry="12" fill="var(--text)" />
      <ellipse cx="76" cy="55" rx="9" ry="12" fill="var(--text)" />
      <circle cx="47" cy="57" r="4" fill="var(--bg-2)" />
      <circle cx="73" cy="57" r="4" fill="var(--bg-2)" />
      <circle cx="48" cy="55" r="1.5" fill="var(--text)" />
      <circle cx="74" cy="55" r="1.5" fill="var(--text)" />
      <circle cx="30" cy="71" r="5" fill="var(--danger)" opacity=".48" />
      <circle cx="90" cy="71" r="5" fill="var(--danger)" opacity=".48" />
      <path d="M56 72q4 5 8 0" fill="none" stroke="var(--bg-2)" stroke-width="2.5" stroke-linecap="round" />
      <path d="M94 6c6-5 14 2 10 8-2 3-6 3-6 7m0 5h.1" fill="none" stroke="var(--accent)" stroke-width="3.5" stroke-linecap="round" />
    </symbol>
    <symbol id="ed-chat-guide-art" viewBox="0 0 120 120">
      <path d="M40 102l-4 10m48-10 4 10" fill="none" stroke="var(--paper)" stroke-width="5" stroke-linecap="round" />
      <path d="M23 61c-7 1-11 7-10 15m84-15c7 1 11 7 10 15" fill="none" stroke="var(--paper)" stroke-width="5" stroke-linecap="round" />
      <path d="M35 14h46l16 16v67c0 7-6 12-13 12H35c-8 0-13-5-13-12V27c0-7 6-13 13-13Z" fill="var(--paper-bg)" stroke="var(--paper)" stroke-width="3" stroke-linejoin="round" />
      <path d="M81 15v16h15" fill="none" stroke="var(--paper)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M38 41h43" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" opacity=".7" />
      <ellipse cx="47" cy="61" rx="7" ry="9" fill="var(--text)" />
      <ellipse cx="72" cy="61" rx="7" ry="9" fill="var(--text)" />
      <circle cx="49" cy="63" r="3" fill="var(--bg-2)" />
      <circle cx="70" cy="63" r="3" fill="var(--bg-2)" />
      <path d="M54 77q6 5 12 0" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round" />
      <path d="M39 91h42" fill="none" stroke="var(--paper)" stroke-width="2.5" stroke-linecap="round" opacity=".7" />
    </symbol>
  </svg>
  <header class="ed-chat-head">
    <span class="ed-chat-duo" aria-hidden="true">
      <span class="ed-chat-face a" data-chat-character="poko"><svg viewBox="0 0 120 120" focusable="false"><use href="#ed-chat-poko-art" /></svg></span>
      <span class="ed-chat-face b" data-chat-character="tech-guide"><svg viewBox="0 0 120 120" focusable="false"><use href="#ed-chat-guide-art" /></svg></span>
    </span>
    <h2 class="ed-chat-h" id="ed-chat-heading">
      <span class="i18n-ja">{poko.nameJa}と<span class="ed-chat-cast-name">{guide.nameJa}</span></span>
      <span class="i18n-en" lang="en">{poko.nameEn} &amp; <span class="ed-chat-cast-name">{guide.nameEn}</span></span>
    </h2>
    <div class="ed-chat-notes">
      <p class="ed-chat-origin">
        <span class="ai-badge" aria-hidden="true">AI</span>
        <span class="i18n-ja">記事の読みどころを、要約と収集メタデータからAIが対話にしたものです。</span>
        <span class="i18n-en" lang="en">A generated dialogue on what matters, based on article summaries and collected metadata.</span>
      </p>
      <p class="ed-chat-provenance">
        <span class="i18n-ja">ポコの姿は文章設定から描いた試作絵。TECHガイドは当サイト独自の案内役。旧配役の台本は保存したまま、登場人物への呼びかけだけ表示時に整えます。</span>
        <span class="i18n-en" lang="en">Poko's art is an original draft based on a written character brief. TECH Guide is this site's own companion. Earlier scripts remain stored unchanged; only clear old speaker vocatives are adjusted for display.</span>
      </p>
    </div>
  </header>

  <ol class="ed-chat-list" role="list">
    {chat.map((turn, index) => {
      const persona = ARTICLE_CHAT_PERSONAS[turn.s];
      const text = presentArticleChatTurn(turn);
      const art = persona.artKey;
      const symbolId = art === "poko" ? "ed-chat-poko-art" : "ed-chat-guide-art";
      return (
        <li class={`ed-chat-turn ed-chat-${turn.s}`} data-speaker={turn.s} data-turn={index + 1}>
          <span class={`ed-chat-face ed-chat-face-outside ${turn.s}`} data-chat-character={art} aria-hidden="true">
            <svg viewBox="0 0 120 120" focusable="false"><use href={`#${symbolId}`} /></svg>
          </span>
          <div class="ed-chat-bubble">
            <span class="ed-chat-name">
              <span class={`ed-chat-face ed-chat-face-inline ${turn.s}`} data-chat-character={art} aria-hidden="true">
                <svg viewBox="0 0 120 120" focusable="false"><use href={`#${symbolId}`} /></svg>
              </span>
              <span class="i18n-ja">{persona.nameJa}</span>
              <span class="i18n-en" lang="en">{persona.nameEn}</span>
            </span>
            <span class="ed-chat-text i18n-ja" lang="ja">{text.ja}</span>
            <span class="ed-chat-text i18n-en" lang="en">{text.en}</span>
          </div>
        </li>
      );
    })}
  </ol>
</section>
