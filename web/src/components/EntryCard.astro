---
import {
  relativeTime,
  isNew,
  CATEGORY_META,
  summaryForLang,
  titleForLang,
  type NormalizedEntry,
} from "../lib/data.ts";

export interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;
const rel = relativeTime(entry.publishedAt);
const fresh = isNew(entry);

function badgeClass(t: NormalizedEntry["sourceType"]): string {
  if (t === "release" || t === "changelog") return "badge release";
  if (t === "paper") return "badge paper";
  return "badge";
}

function host(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
}

const summaryJa = summaryForLang(entry, "ja");
const summaryEn = summaryForLang(entry, "en");
const titleJa = titleForLang(entry, "ja");
const titleEn = titleForLang(entry, "en");

const catMeta = CATEGORY_META.find((c) => c.slug === entry.category);
const catColor = catMeta?.color ?? "#8a847e";
const catInitial = catMeta?.initial ?? "??";
const catName = catMeta?.name ?? entry.category;
const catEmoji = catMeta?.emoji ?? "\u{1F4C4}";

// Generate a deterministic pattern seed from the entry id
const patternSeed = entry.id.split("").reduce((a, c) => a + c.charCodeAt(0), 0);
const patternRotate = patternSeed % 360;
const patternScale = 0.8 + (patternSeed % 5) * 0.1;

// Source type icon character
function sourceIcon(t: string): string {
  if (t === "release") return "\u{1F680}";
  if (t === "changelog") return "\u{1F4CB}";
  if (t === "paper") return "\u{1F4D1}";
  if (t === "blog") return "\u{270D}\u{FE0F}";
  return "\u{1F4AC}";
}
const img = entry.image;
const hasUsableImage =
  !!img && typeof img.src === "string" && img.src.length > 0;
const thumbMark = hasUsableImage ? img!.source : "fallback";
---

<article
  class:list={["card", "has-thumb", { important: entry.importance === 3 }]}
  data-pagefind-body
  style={`--cat-color:${catColor}`}
>
  <div class="card-body">
    <div class="meta">
      {entry.importance === 3 && <span class="badge hot" title="重要リリース">🔥 HOT</span>}
      {fresh && <span class="badge new">NEW</span>}
      <span class={badgeClass(entry.sourceType)}>{entry.sourceType}</span>
      <span class="badge cat">{entry.category}</span>
      <span class="spacer"></span>
      <span class="mono">{rel}</span>
      <span>·</span>
      <span>{entry.source}</span>
    </div>
    <h3 class="title">
      <a href={entry.url} target="_blank" rel="noopener">
        <span class="i18n-ja">{titleJa}</span>
        <span class="i18n-en" lang="en">{titleEn}</span>
      </a>
    </h3>
    {(summaryJa || summaryEn) && (
      <div class="summary-stack">
        {summaryJa && (
          <p class="summary summary-ja i18n-ja" title={summaryJa}>
            <span class="ai-mark">AI要約</span>
            <span class="s-text">{summaryJa}</span>
          </p>
        )}
        {summaryEn && (
          <p class="summary summary-en i18n-en" title={summaryEn} lang="en">
            <span class="en-mark">EN</span>
            <span class="s-text">{summaryEn}</span>
          </p>
        )}
      </div>
    )}
    {entry.tags.length > 0 && (
      <div class="tag-row">
        {entry.tags.slice(0, 4).map((t) => (
          <a class="tag-chip" href={`/t/${t}`}>#{t}</a>
        ))}
      </div>
    )}
    <div class="url">
      <span>{host(entry.url)}</span>
      <span class="arrow">→</span>
    </div>
  </div>

  {hasUsableImage ? (
    <div class="card-thumb">
      <img src={img!.src} alt={img!.alt || titleJa} loading="lazy" decoding="async" />
      <span class="src-mark">{thumbMark}</span>
    </div>
  ) : (
    <div class="card-thumb fallback" style={`--cat-color:${catColor}`}>
      <svg viewBox="0 0 144 96" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id={`bg-${entry.id}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color={catColor} stop-opacity="0.30" />
            <stop offset="100%" stop-color={catColor} stop-opacity="0.05" />
          </linearGradient>
        </defs>
        <rect width="144" height="96" fill="#1a1917" />
        <rect width="144" height="96" fill={`url(#bg-${entry.id})`} />
        <g opacity="0.10" transform={`rotate(${patternRotate} 72 48) scale(${patternScale})`}>
          <circle cx="20" cy="15" r="18" fill={catColor} />
          <circle cx="130" cy="80" r="24" fill={catColor} />
          <rect x="90" y="5" width="40" height="40" rx="8" fill={catColor} />
        </g>
        <text
          x="72"
          y="54"
          text-anchor="middle"
          dominant-baseline="middle"
          font-size="40"
          style="filter:drop-shadow(0 2px 4px rgba(0,0,0,0.4))"
        >{catEmoji}</text>
        <text
          x="72"
          y="82"
          text-anchor="middle"
          font-family="system-ui, -apple-system, sans-serif"
          font-size="8.5"
          fill={catColor}
          opacity="0.7"
          letter-spacing="0.08em"
          font-weight="600"
        >{catName}</text>
        <text
          x="132"
          y="14"
          text-anchor="end"
          font-size="12"
          opacity="0.85"
        >{sourceIcon(entry.sourceType)}</text>
      </svg>
    </div>
  )}
</article>
