      {/* SAME CATEGORY */}
      {sameCategory.length > 0 && (
        <section class="ed-rel-block">
          <h2 class="ed-rel-h">
            <span class="ed-rel-h-emoji" style={`color:${catColor}`}>{laneEmoji}</span>
