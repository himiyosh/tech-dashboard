---
import {
  CATEGORY_META,
  categoryLabel,
  isPublishableEntry,
  jstDateKey,
  summaryForLangWithFallback,
  titleForLangWithFallback,
  type NormalizedEntry,
} from "../lib/data.ts";
import { entryDestination } from "../lib/entry-destination.ts";
import { effectiveImportance } from "../lib/release-signal.ts";
import { isDefaultMutedCategory } from "../lib/category-visibility.ts";
import {
  dailyBoardBaseDayKey,
  dailyBoardEmptyReason,
  dailyDisplayCount,
  dailyEntryCount,
} from "../lib/daily-summary.ts";
import { sourceLabel } from "../lib/source-meta.ts";
import type { DayBucket, StatsPayload } from "../lib/stats.ts";
import LanguageFallbackBadge from "./LanguageFallbackBadge.astro";
import ExternalLinkHint from "./ExternalLinkHint.astro";

export interface Props {
  /** All listable lanes used for activity totals and category statistics. */
  entries: readonly NormalizedEntry[];
  /** Main Timeline candidates used for the decision board. */
  boardEntries?: readonly NormalizedEntry[];
  stats?: StatsPayload;
  now?: Date;
}

const { entries, boardEntries = entries, stats, now = new Date() } = Astro.props;

// Last 7 days window (JST).
const days: string[] = [];
for (let i = 6; i >= 0; i--) {
  const d = new Date(now.getTime() - i * 86_400_000);
  days.push(jstDateKey(d.toISOString()));
}
const todayKey = days[days.length - 1];
const yKey = days[days.length - 2];

const liveEntriesByDay = new Map<string, NormalizedEntry[]>();
for (const entry of entries) {
  const key = jstDateKey(entry.publishedAt);
  const bucket = liveEntriesByDay.get(key) ?? [];
  bucket.push(entry);
  liveEntriesByDay.set(key, bucket);
}
const liveCountByDay = (key: string): number =>
  liveEntriesByDay.get(key)?.length ?? 0;
const currentDayLiveCount = dailyEntryCount(
  entries,
  todayKey,
  (entry) => jstDateKey(entry.publishedAt),
);
const liveCategoryCountsByDay = (key: string): Record<string, number> => {
  const counts: Record<string, number> = {};
  for (const entry of liveEntriesByDay.get(key) ?? []) {
    counts[entry.category] = (counts[entry.category] ?? 0) + 1;
  }
  return counts;
};
const statsDayByDate = new Map<string, DayBucket>(
  (stats?.byDay ?? []).map((dayBucket) => [dayBucket.date, dayBucket]),
);

// Per-day totals for sparkline. stats.json includes archive-backed history;
// the partial current JST day uses live entries because stats.byDay is
// archive-backed and grouped before the current publisher run completes.
const perDay = days.map((key) => {
  const statsDay = statsDayByDate.get(key);
  const isCurrentDay = key === todayKey;
  const liveCount = isCurrentDay ? currentDayLiveCount : liveCountByDay(key);
  return {
    key,
    count: dailyDisplayCount(key, todayKey, liveCount, statsDay?.count),
    byCategory: isCurrentDay
      ? liveCategoryCountsByDay(key)
      : statsDay?.byCategory,
  };
});
const maxDay = Math.max(1, ...perDay.map((d) => d.count));
const todayCount = perDay[perDay.length - 1]?.count ?? 0;
const yesterdayCount = perDay[perDay.length - 2]?.count ?? 0;
const weekCount = perDay.reduce((total, day) => total + day.count, 0);

// Per-category totals across the 7 days.
const weekKeys = new Set(days);
const catCounts = new Map<string, number>();
for (const day of perDay) {
  for (const [category, count] of Object.entries(day.byCategory ?? {})) {
    catCounts.set(category, (catCounts.get(category) ?? 0) + count);
  }
}
if (catCounts.size === 0) {
  const weekEntries = entries.filter((entry) =>
    weekKeys.has(jstDateKey(entry.publishedAt)),
  );
  for (const entry of weekEntries) {
    catCounts.set(entry.category, (catCounts.get(entry.category) ?? 0) + 1);
  }
}
const catRows = CATEGORY_META
  .filter((c) => catCounts.has(c.slug))
  .map((c) => ({
    ...c,
    n: catCounts.get(c.slug) ?? 0,
    displayName: c.slug === "research" ? "Research + arXiv" : c.shortLabel,
    href: c.slug === "research" ? "/categories/" : `/c/${c.slug}`,
  }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 8);

// Activity totals cover every lane, but the decision board must select its date
// from Timeline candidates so arXiv-only activity cannot pin it to an empty day.
const baseDayKey = dailyBoardBaseDayKey(
  todayKey,
  yKey,
  dailyEntryCount(boardEntries, todayKey, (entry) => jstDateKey(entry.publishedAt)),
  dailyEntryCount(boardEntries, yKey, (entry) => jstDateKey(entry.publishedAt)),
);
const baseDayBoardEntries = boardEntries.filter(
  (entry) => jstDateKey(entry.publishedAt) === baseDayKey,
);
const baseDayIsToday = baseDayKey === todayKey;
const baseDayDate = new Date(`${baseDayKey}T00:00:00+09:00`);
const baseDayLabelJa = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
}).format(baseDayDate);
const baseDayLabelEn = new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
}).format(baseDayDate);
const currentDayDate = new Date(`${todayKey}T00:00:00+09:00`);
const currentDayLabelJa = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  month: "numeric",
  day: "numeric",
}).format(currentDayDate);
const currentDayLabelEn = new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Tokyo",
  month: "short",
  day: "numeric",
}).format(currentDayDate);

// 主要な更新内容: importance desc → release/changelog 優先 → publishedAt desc で上位 12 件
const typeWeight = (t: string): number =>
  t === "release" || t === "changelog" ? 2 : t === "paper" ? 1 : 0;

/** Strip trailing version tokens to get a release "stem" for grouping siblings. */
function releaseStem(title: string): string {
  const stem = title
    .replace(/\b(?:january|february|march|april|may|june|july|august|september|october|november|december)\s+\d{4}\b/gi, "")
    .replace(/[\(\[]\s*version\s+v?\d+(?:\.\d+){0,3}(?:[-+][\w.]+)?\s*[\)\]]/gi, "")
    .replace(/\bversion\s+v?\d+(?:\.\d+){0,3}(?:[-+][\w.]+)?\b/gi, "")
    .replace(/\bv?\d+(?:\.\d+){1,3}(?:[-+][\w.]+)?\b/gi, "")
    .replace(/\b(release notes?|releases?|changelog|changes)\b/gi, "")
    .replace(/[\(\[\]\)]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
  return stem;
}

const publishableBaseDayEntries = baseDayBoardEntries.filter(isPublishableEntry);
const sortedToday = [...publishableBaseDayEntries].sort((a, b) => {
  const imp = effectiveImportance(b) - effectiveImportance(a);
  if (imp !== 0) return imp;
  const tw = typeWeight(b.sourceType) - typeWeight(a.sourceType);
  if (tw !== 0) return tw;
  return (b.publishedAt ?? "").localeCompare(a.publishedAt ?? "");
});

// Group successive release/changelog rows that share (source, stem).
// The board honors the Timeline category filter: rows in default-muted lanes
// are rendered but hidden (CSS), so a reader who enables that lane sees them
// in rank order. The visible cap therefore counts only unmuted rows, and the
// muted ones get their own smaller cap so the markup stays bounded.
const VISIBLE_BOARD_LIMIT = 10;
const MUTED_BOARD_LIMIT = 8;
type BoardItem = { entry: NormalizedEntry; siblingCount: number; muted: boolean };
const seenStems = new Map<string, number>(); // key -> first index in topUpdates
const sourceRows = new Map<string, number>();
const topUpdates: BoardItem[] = [];
let visibleRows = 0;
let mutedRows = 0;
for (const e of sortedToday) {
  const isRel = e.sourceType === "release" || e.sourceType === "changelog";
  let releaseKey = "";
  if (isRel) {
    releaseKey = `${e.source}::${releaseStem(e.title) || e.source}`;
    const idx = seenStems.get(releaseKey);
    if (idx !== undefined) {
      topUpdates[idx]!.siblingCount += 1;
      continue;
    }
  }
  if ((sourceRows.get(e.source) ?? 0) >= 2) continue;
  const muted = isDefaultMutedCategory(e.category);
  // Each lane fills its own budget; a full muted budget must not stop the scan
  // for further visible rows (and vice versa).
  if (muted ? mutedRows >= MUTED_BOARD_LIMIT : visibleRows >= VISIBLE_BOARD_LIMIT) {
    continue;
  }
  if (releaseKey) seenStems.set(releaseKey, topUpdates.length);
  topUpdates.push({ entry: e, siblingCount: 0, muted });
  sourceRows.set(e.source, (sourceRows.get(e.source) ?? 0) + 1);
  if (muted) mutedRows += 1;
  else visibleRows += 1;
  if (visibleRows >= VISIBLE_BOARD_LIMIT && mutedRows >= MUTED_BOARD_LIMIT) break;
}

const boardItems = topUpdates;
const boardVisibleCount = visibleRows;
const boardEmptyReason = dailyBoardEmptyReason(
  baseDayBoardEntries.length,
  boardItems.length,
);

const catColorOf = (slug: string): string =>
  CATEGORY_META.find((c) => c.slug === slug)?.color ?? "#8a847e";

---

<section
  class="digest"
  data-daily-summary
  data-base-day={baseDayKey}
  data-day-scope={baseDayIsToday ? "today" : "latest"}
>
  <div class="digest-head">
    <div class="title">
      <span class="eyebrow">Daily Summary</span>
      <h2 class="i18n-ja">{baseDayIsToday ? "今日の更新" : "直近の更新"}</h2>
      <h2 class="i18n-en" lang="en">{baseDayIsToday ? "Today's Updates" : "Latest Updates"}</h2>
      <time class="digest-date" datetime={baseDayKey} data-date-scope="article">
        <span class="i18n-ja">対象記事日 · {baseDayLabelJa}</span>
        <span class="i18n-en" lang="en">Article date · {baseDayLabelEn}</span>
      </time>
    </div>
    <div class="kpis">
      <div class="kpi">
        <span class="k i18n-ja">本日ここまで</span>
        <span class="k i18n-en" lang="en">Today so far</span>
        <time class="kpi-date" datetime={todayKey} data-date-scope="current">
          <span class="i18n-ja">現在日 JST · {currentDayLabelJa}</span>
          <span class="i18n-en" lang="en">Current day JST · {currentDayLabelEn}</span>
        </time>
        <span class="v">{todayCount}</span>
      </div>
      <div class="kpi">
        <span class="k">Yesterday</span>
        <span class="v">{yesterdayCount}</span>
      </div>
      <div class="kpi">
        <span class="k">7-day</span>
        <span class="v">{weekCount}</span>
      </div>
    </div>
  </div>

  <div class="digest-body">
    <div class="panel spark">
      <div class="panel-title">
        <span>Last 7 days</span>
        <span class="panel-sub">{weekCount} total</span>
      </div>
      <div class="bars" role="group" aria-label={`Last 7 days article counts, total ${weekCount}`}>
        {perDay.map((d, i) => (
          <div class="bar" title={`${d.key}: ${d.count}`} style={`--bar-index:${i}`}>
            <div class="fill" style={`height:${Math.round((d.count / maxDay) * 100)}%`}></div>
            <span class="n">{d.count}</span>
          </div>
        ))}
      </div>
      <div class="axis">
        {perDay.map((d, i) => (
          <span class:list={[{ today: i === perDay.length - 1 }]}>
            {d.key.slice(5).replace("-", "/")}
          </span>
        ))}
      </div>
      <p class="retention-note">
        <span class="i18n-ja">本日は JST ライブ、過去日は archive。Research は arXiv 込み。過去値は保持ポリシーで縮む場合があります。</span>
        <span class="i18n-en" lang="en">Today uses live JST; past days use archive totals. Research includes arXiv. Retention may shrink past counts.</span>
      </p>
      <table class="sr-only">
        <caption>Last 7 days article counts</caption>
        <thead>
          <tr><th scope="col">Date</th><th scope="col">Count</th></tr>
        </thead>
        <tbody>
          {perDay.map((d) => (
            <tr><td>{d.key}</td><td>{d.count}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="panel cats">
      <div class="panel-title">
        <span>Top categories + lanes</span>
        <span class="panel-sub">7d</span>
      </div>
      <ul class="cat-list">
        {catRows.map((c) => (
          <li>
            <a
              class="cat-link"
              href={c.href}
              style={`--cat-color:${c.color}`}
              title={c.slug === "research" ? "Combined Research and arXiv activity" : c.name}
            >
              <span class="dot"></span>
              <span class="name">{c.displayName}</span>
              <span class="bar-wrap">
                <span
                  class="bar-fill"
                  style={`width:${Math.round((c.n / (catRows[0]?.n ?? 1)) * 100)}%`}
                ></span>
              </span>
              <span class="n">{c.n}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel updates ticker-panel">
      <div class="panel-title">
        <span class="i18n-ja">{baseDayIsToday ? "今日の主要な更新" : "直近の主要な更新"}</span>
        <span class="i18n-en" lang="en">{baseDayIsToday ? "Today's top stories" : "Latest top stories"}</span>
        <span class="panel-sub">
          <span class="i18n-ja"><span data-board-count>{boardVisibleCount}</span> 件</span>
          <span class="i18n-en" lang="en"><span data-board-count>{boardVisibleCount}</span> items</span>
        </span>
        <span class="badge-legend">
          <span class="t-tag imp">★</span><span class="legend-label i18n-ja">重要</span><span class="legend-label i18n-en" lang="en">Important</span>
          <span class="t-tag rel">REL</span><span class="legend-label i18n-ja">リリース</span><span class="legend-label i18n-en" lang="en">Release</span>
        </span>
      </div>
      {boardEmptyReason ? (
        <p
          class="empty"
          data-empty-reason={boardEmptyReason}
        >
          {boardEmptyReason === "summary-pending" ? (
            <>
              <span class="i18n-ja">AI 要約済みの主要記事はまだありません。新着は下のタイムラインで確認できます。</span>
              <span class="i18n-en" lang="en">No summarized top stories yet. New entries remain available in the timeline below.</span>
            </>
          ) : (
            <>
              <span class="i18n-ja">まだ更新がありません。</span>
              <span class="i18n-en" lang="en">No updates yet.</span>
            </>
          )}
        </p>
      ) : (
        <ol class="board">
          {boardItems.map((item) => {
            const e = item.entry;
            const isRel = e.sourceType === "release" || e.sourceType === "changelog";
            const isImp = effectiveImportance(e) === 3;
            const jaResult = titleForLangWithFallback(e, "ja");
            const enResult = titleForLangWithFallback(e, "en");
            const summaryJa = summaryForLangWithFallback(e, "ja");
            const summaryEn = summaryForLangWithFallback(e, "en");
            const destination = entryDestination(e);
            return (
              <li
                style={`--cat-color:${catColorOf(e.category)}`}
                data-summary-state="ready"
                data-board-row
                data-category={e.category}
                data-catvis={item.muted ? "muted" : "visible"}
              >
                <a
                  href={destination.href}
                  target={destination.target}
                  rel={destination.rel}
                  data-detail-destination={destination.external ? "source" : "internal"}
                  class="b-row"
                >
                  <span class="b-num" aria-hidden="true"></span>
                  <span class="b-cat" title={categoryLabel(e.category)}>{categoryLabel(e.category)}</span>
                  <span class="b-tags">
                    {isImp && <span class="t-tag imp">★</span>}
                    {isRel && <span class="t-tag rel">REL</span>}
                    {item.siblingCount > 0 && (
                      <span class="t-tag more" title={`同シリーズ ${item.siblingCount + 1} 件をまとめて表示`}>+{item.siblingCount}</span>
                    )}
                  </span>
                  <span
                    class="b-title i18n-ja"
                    lang={jaResult.fallbackLang === "en" ? "en" : "ja"}
                  >
                    {jaResult.isFallback && jaResult.fallbackLang && (
                      <LanguageFallbackBadge fallbackLang={jaResult.fallbackLang} variant="title" />
                    )}
                    {jaResult.text}
                    {destination.external && <ExternalLinkHint lang="ja" />}
                  </span>
                  <span
                    class="b-title i18n-en"
                    lang={enResult.fallbackLang === "ja" ? "ja" : "en"}
                  >
                    {enResult.isFallback && enResult.fallbackLang && (
                      <LanguageFallbackBadge fallbackLang={enResult.fallbackLang} variant="title" />
                    )}
                    {enResult.text}
                    {destination.external && <ExternalLinkHint lang="en" />}
                  </span>
                  {summaryJa.text && (
                    <span
                      class="b-summary i18n-ja"
                      lang={summaryJa.fallbackLang === "en" ? "en" : "ja"}
                    >
                      {summaryJa.isFallback && summaryJa.fallbackLang && (
                        <LanguageFallbackBadge fallbackLang={summaryJa.fallbackLang} variant="summary" />
                      )}
                      {summaryJa.text}
                    </span>
                  )}
                  {summaryEn.text && (
                    <span
                      class="b-summary i18n-en"
                      lang={summaryEn.fallbackLang === "ja" ? "ja" : "en"}
                    >
                      {summaryEn.isFallback && summaryEn.fallbackLang && (
                        <LanguageFallbackBadge fallbackLang={summaryEn.fallbackLang} variant="summary" />
                      )}
                      {summaryEn.text}
                    </span>
                  )}
                  <span class="b-src">[{sourceLabel(e.source, e.url)}]</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="empty board-filtered-empty" data-board-filtered-empty>
          <span class="i18n-ja">表示中のカテゴリに該当する主要な更新はありません。上のフィルターでカテゴリを有効にすると表示されます。</span>
          <span class="i18n-en" lang="en">No top stories in the categories you are showing. Enable a category in the filter above to see them.</span>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .digest {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(94,234,212,0.035), transparent 34%), var(--surface);
    padding: 14px 16px 16px;
    margin-bottom: 18px;
    overflow: hidden;
    min-width: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .digest-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 14px; flex-wrap: wrap; margin-bottom: 12px;
  }
  .title .eyebrow {
    font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); font-weight: 700; display: block; margin-bottom: 4px;
  }
  .title h2 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .digest-date {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .kpis { display: flex; gap: 18px; }
  .kpi { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
  .kpi .k { font-size: 10.5px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .kpi-date {
    color: var(--muted-2);
    font-size: 9px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .kpi .v { font-size: 22px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; line-height: 1; }
  .kpi .d { font-size: 11px; font-family: ui-monospace, monospace; }
  .kpi .d[data-trend="up"] { color: var(--success); }
  .kpi .d[data-trend="down"] { color: var(--danger); }
  .kpi .d[data-trend="flat"] { color: var(--muted); }

  .digest-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    min-width: 0;
  }
  .digest-body .updates {
    grid-column: 1 / -1;
  }
  @media (max-width: 720px) {
    .digest-body { grid-template-columns: 1fr; }
  }
  .panel {
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    border-radius: 8px;
    padding: 10px 11px;
    min-width: 0;
  }
  .panel-title {
    font-size: 10.5px; color: var(--muted); letter-spacing: 0.08em;
    text-transform: uppercase; font-weight: 600; margin-bottom: 8px;
    display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
  }
  .panel-title .panel-sub {
    font-size: 10px; color: var(--muted-2);
    font-family: ui-monospace, monospace;
    text-transform: none; letter-spacing: 0;
  }
  .badge-legend {
    display: flex; align-items: center; gap: 3px;
    margin-left: auto;
    font-size: 9px; color: var(--muted-2);
    text-transform: none; letter-spacing: 0;
  }
  .badge-legend .t-tag { font-size: 8px; padding: 0 3px; }
  .badge-legend .legend-label { margin-right: 6px; }

  .spark {
    display: flex;
    flex-direction: column;
  }
  .spark .bars {
    display: flex; align-items: flex-end; gap: 4px;
    flex: none;
    height: 64px;
    min-height: 64px;
    margin-top: 10px;
  }
  .spark .bar {
    flex: 1; align-self: stretch; position: relative;
    display: flex; flex-direction: column-reverse;
    align-items: center;
  }
  .spark .fill {
    width: 100%;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    border-radius: 3px 3px 0 0;
    min-height: 2px;
    transform-origin: 50% 100%;
  }
  .spark .bar:last-child .fill {
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-bg);
  }
  .spark .n {
    position: absolute; top: -12px;
    font-size: 9.5px; color: var(--muted-2);
    font-family: ui-monospace, monospace;
  }
  .spark .axis {
    display: flex; justify-content: space-between;
    margin-top: 4px; font-size: 9.5px; color: var(--muted-2);
    font-family: ui-monospace, monospace;
  }
  .spark .axis .today { color: var(--accent); font-weight: 700; }

  .retention-note {
    margin-top: 6px;
    font-size: 10px;
    color: var(--muted-2);
    line-height: 1.35;
  }

  .cat-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px 8px;
  }
  .cat-link {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) 24px;
    grid-template-areas: "dot name number";
    align-items: center;
    column-gap: 4px;
    padding: 4px 4px 6px;
    border-radius: 5px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 11.5px;
    transition: background 0.12s;
    min-width: 0;
    position: relative;
  }
  .cat-link:hover { background: var(--surface); }
  .cat-link .dot {
    grid-area: dot;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cat-color, var(--muted));
  }
  .cat-link .name {
    grid-area: name;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cat-link .bar-wrap {
    position: absolute;
    left: 17px;
    right: 31px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--bg);
    overflow: hidden;
  }
  .cat-link .bar-fill {
    display: block; height: 100%;
    background: var(--cat-color, var(--accent));
    opacity: 0.75;
    min-width: 2px;
  }
  .cat-link .n {
    grid-area: number;
    text-align: right; font-variant-numeric: tabular-nums;
    color: var(--cat-color, var(--text));
    font-family: ui-monospace, monospace; font-size: 11px; font-weight: 700;
  }

  .digest[data-chart-state="idle"] .spark .fill {
    opacity: 0.28;
    transform: scaleY(0.04);
  }
  .digest[data-chart-state="idle"] .spark .n {
    opacity: 0;
    transform: translateY(4px);
  }
  .digest[data-chart-state="visible"] .spark .fill {
    animation: digest-bar-rise 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--bar-index, 0) * 42ms);
  }
  .digest[data-chart-state="visible"] .spark .n {
    animation: digest-count-in 240ms ease-out both;
    animation-delay: calc(120ms + var(--bar-index, 0) * 42ms);
  }
  @keyframes digest-bar-rise {
    from { opacity: 0.28; transform: scaleY(0.04); }
    to { opacity: 1; transform: scaleY(1); }
  }
  @keyframes digest-count-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .updates .empty { color: var(--muted); font-size: 12px; }

  .board-wrap {
    display: flex; flex-direction: column; gap: 10px;
  }

  /* Static LED board (top 10) */
  .board {
    list-style: none;
    margin: 0; padding: 8px 0;
    background: #0a0d0a;
    border: 1px solid #1a2a1a;
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    counter-reset: board;
  }
  .board::before {
    content: "";
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 3px 3px;
    pointer-events: none;
    mix-blend-mode: overlay;
  }
  .board > li {
    border-bottom: 1px dashed rgba(124, 255, 154, 0.08);
  }
  .board > li:last-child { border-bottom: none; }
  /* The board follows the Timeline category filter: rows in muted lanes are
   * rendered (so opting a lane back in reveals them in rank order) but hidden.
   * The hiding rule itself lives in portal.css because it needs the
   * [data-category-filter-scope] ancestor, which Astro's scoped styles would
   * rewrite into a never-matching selector. Visible rows renumber themselves
   * through a CSS counter so the list never shows gaps like 01, 03, 04. */
  .board > li:not([data-catvis="muted"]) {
    counter-increment: board;
  }
  .board .b-num::before {
    content: counter(board, decimal-leading-zero);
  }
  .board-filtered-empty { display: none; }
  .board:not(:has(> li:not([data-catvis="muted"]))) + .board-filtered-empty {
    display: block;
  }
  .board .b-row {
    display: grid;
    grid-template-columns: 22px 118px 68px minmax(0, 1fr) auto;
    grid-template-areas:
      "num cat tags title src"
      "num cat tags summary summary";
    column-gap: 10px;
    row-gap: 2px;
    align-items: center;
    padding: 8px 14px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 13.5px;
    line-height: 1.35;
    color: #7cff9a;
    text-decoration: none;
    text-shadow: 0 0 2px rgba(124,255,154,0.5), 0 0 6px rgba(124,255,154,0.2);
    transition: background 0.12s;
  }
  .board .b-row:hover {
    background: rgba(124, 255, 154, 0.06);
    color: #ffffff;
  }
  .board .b-num {
    grid-area: num;
    font-size: 11px; font-weight: 700;
    color: #ff8a2a;
    text-shadow: 0 0 4px rgba(255,138,42,0.6);
    letter-spacing: 0.08em;
    min-width: 20px;
  }
  .board .b-cat {
    grid-area: cat;
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--cat-color, #7cff9a);
    text-shadow: 0 0 4px color-mix(in srgb, var(--cat-color, #7cff9a) 60%, transparent);
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, var(--cat-color, #7cff9a) 50%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--cat-color, #7cff9a) 8%, transparent);
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .board .b-tags {
    grid-area: tags;
    display: inline-flex; gap: 4px;
    min-width: 28px;
  }
  .board .b-title {
    grid-area: title;
    font-weight: 700;
    color: #e8ffe9;
    text-shadow: 0 0 2px rgba(232,255,233,0.6), 0 0 8px rgba(124,255,154,0.25);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    min-width: 0;
  }
  .board .b-title.b-muted {
    color: #5ab075;
    opacity: 0.55;
    font-weight: 400;
    font-style: italic;
    text-shadow: none;
  }
  .board .b-src {
    grid-area: src;
    font-size: 10.5px;
    color: #5ab075;
    opacity: 0.85;
    white-space: nowrap;
  }
  .board .b-summary {
    grid-area: summary;
    font-size: 12px;
    color: #7cff9a;
    opacity: 0.78;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    min-width: 0;
  }
  @media (max-width: 720px) {
    /* Let the LED panel use as much horizontal space as possible. */
    .digest { padding: 12px 10px; border-radius: 12px; }
    .digest-head { gap: 10px; margin-bottom: 10px; }
    .kpis {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      width: 100%;
    }
    .kpi .v { font-size: 20px; }
    .panel { padding: 9px 10px; }
    .digest-body { gap: 10px; }
    .updates.panel {
      padding: 10px 0;
      border-left: none;
      border-right: none;
      border-radius: 6px;
    }

    .board { border-left: none; border-right: none; border-radius: 0; }

    /* Two-row layout: meta (num + cat + tags) on row 1, title on row 2. */
    .board .b-row {
      display: grid;
      grid-template-columns: auto auto 1fr auto;
      grid-template-areas:
        "num cat   .     tags"
        "title title title title";
      column-gap: 8px;
      row-gap: 2px;
      padding: 7px 10px;
      font-size: 13px;
      align-items: center;
    }
    .board .b-num { grid-area: num; font-size: 10.5px; min-width: 0; display: inline; }
    .board .b-cat {
      grid-area: cat;
      justify-self: start;
      min-width: 0;
      padding: 1px 5px;
      font-size: 9.5px;
      letter-spacing: 0.08em;
      max-width: min(42vw, 128px);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .board .b-tags { grid-area: tags; justify-self: end; align-self: center; }
    .board .b-summary { display: none; }
    .board .b-src { display: none; }

    .board .b-title {
      grid-area: title;
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip; /* hard cut at the right edge, no ellipsis */
      line-height: 1.4;
      font-size: 13.5px;
    }
  }

  /* Electronic-signboard (LED ticker) */
  .ticker-panel .panel-title .panel-sub::before {
    content: "● ";
    color: #ff3b30;
    animation: board-snapshot-pulse 900ms ease-out 1 both;
  }
  @keyframes board-snapshot-pulse {
    0% { opacity: 0.25; }
    55% { opacity: 1; }
  }

  .ticker {
    position: relative;
    overflow: hidden;
    background: #0a0d0a;
    border: 1px solid #1a2a1a;
    border-radius: 6px;
    padding: 10px 0;
    /* soft fade on edges */
    mask-image: linear-gradient(90deg, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 36px, #000 calc(100% - 36px), transparent 100%);
  }
  .ticker::before {
    /* scanline / dot-matrix overlay */
    content: "";
    position: absolute; inset: 0;
    background-image:
      radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 3px 3px;
    pointer-events: none;
    mix-blend-mode: overlay;
  }
  .ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 48px;
    white-space: nowrap;
    animation: ticker-scroll 300s linear infinite;
    will-change: transform;
  }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .digest[data-chart-state] .spark .fill,
    .digest[data-chart-state] .spark .n {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .ticker-panel .panel-title .panel-sub::before {
      animation: none;
    }
    .ticker-track {
      animation: none;
      transform: none;
      will-change: auto;
    }
  }

  .t-item {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: #7cff9a;
    text-decoration: none;
    text-shadow:
      0 0 2px rgba(124, 255, 154, 0.6),
      0 0 8px rgba(124, 255, 154, 0.25);
    padding: 0 4px;
    transition: color 0.15s;
  }
  .t-item:hover { color: #ffffff; text-shadow: 0 0 4px #7cff9a, 0 0 12px rgba(124,255,154,0.6); }
  .t-cat {
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cat-color, #7cff9a);
    text-shadow: 0 0 6px color-mix(in srgb, var(--cat-color, #7cff9a) 60%, transparent);
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, var(--cat-color, #7cff9a) 60%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--cat-color, #7cff9a) 10%, transparent);
  }
  .t-tag {
    font-size: 10px; font-weight: 700;
    padding: 1px 5px; border-radius: 3px;
  }
  .t-tag.rel {
    color: #000; background: #ffcc00;
    text-shadow: none;
    box-shadow: 0 0 6px rgba(255, 204, 0, 0.5);
  }
  .t-tag.imp {
    color: #000; background: #ff8a2a;
    text-shadow: none;
    box-shadow: 0 0 6px rgba(255, 138, 42, 0.5);
  }
  .t-tag.more {
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
  }
  .t-title {
    font-weight: 700;
    color: #e8ffe9;
    text-shadow: 0 0 2px rgba(232,255,233,0.7), 0 0 8px rgba(124,255,154,0.3);
  }
  .t-sep { opacity: 0.5; }
  .t-summary { color: #7cff9a; opacity: 0.92; }
  .t-src {
    font-size: 11px;
    color: #5ab075;
    opacity: 0.8;
  }
  .hi-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .hi-list a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    padding: 5px 6px;
    border-radius: 5px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 12.5px;
    transition: background 0.12s, color 0.12s;
    min-width: 0;
  }
  .hi-list a:hover { background: var(--surface); color: var(--text); }
</style>

<script>
  const digest = document.querySelector<HTMLElement>("[data-daily-summary]");

  if (digest) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      digest.dataset.chartState = "visible";
    } else {
      digest.dataset.chartState = "idle";
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          digest.dataset.chartState = "visible";
          observer.disconnect();
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      observer.observe(digest);
    }
  }
</script>
