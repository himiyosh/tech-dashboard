---
import Portal from "../layouts/Portal.astro";
import PageHero from "../components/PageHero.astro";
import Sidebar from "../components/Sidebar.astro";
import LiveMetrics from "../components/LiveMetrics.astro";
import {
  ALL_ENTRIES,
  CATEGORIES_BY_NAME,
  CATEGORY_META,
  relativeTime,
  type Category,
  type CategoryGroup,
} from "../lib/data.ts";
import { DASHBOARD_METRICS } from "../lib/metrics.ts";
import { REACTION_CONTRACT_EN, REACTION_CONTRACT_JA } from "../lib/reaction-copy.ts";
import { WORKER_HEALTH } from "../lib/data.ts";
import { deriveWorkerRunStatus } from "../lib/run-health.ts";

const now = new Date();
const lastUpdated = relativeTime(DASHBOARD_METRICS.generatedAt, now);
const workerLastRun = relativeTime(DASHBOARD_METRICS.workerLastRunAt, now);
// Shared aggregate run state (same derivation as the footer + Home + /status, LL-126).
const runStatus = deriveWorkerRunStatus({
  workerHealth: WORKER_HEALTH,
  fallbackPercent: DASHBOARD_METRICS.fallbackPercent,
  pendingSummaryEntries: DASHBOARD_METRICS.fallbackEntries,
});
const sourceTypes = [...new Set(ALL_ENTRIES.map((entry) => entry.sourceType))].sort();
const workerBatchCount = DASHBOARD_METRICS.workerBatchTotal;
const workerBatchCopy = workerBatchCount ? `${workerBatchCount} batch` : "multi-batch";
const groupSummary = CATEGORY_META.reduce<Record<CategoryGroup, number>>((acc, category) => {
  acc[category.group] = (acc[category.group] ?? 0) + 1;
  return acc;
}, {} as Record<CategoryGroup, number>);
const GROUP_LABEL: Record<CategoryGroup, string> = {
  microsoft: "Microsoft / GitHub",
  anthropic: "Anthropic",
  openai: "OpenAI",
  google: "Google",
  "coding-tools": "AI Coding Tools",
  "open-models": "Local & Open Models",
  "agent-tools": "Agent Tools & Protocols",
  research: "Research & Benchmarks",
  industry: "Industry & Policy",
};
const categoryLast30 = (category: Category) => {
  const cutoff = now.getTime() - 30 * 86_400_000;
  return ALL_ENTRIES.filter((entry) => entry.category === category && Date.parse(entry.publishedAt) >= cutoff).length;
};
const topCategories = CATEGORY_META.map((category) => ({
  ...category,
  last30: categoryLast30(category.slug),
})).sort((a, b) => b.last30 - a.last30).slice(0, 5);

const pipelineSteps = [
  {
    label: "Collect",
    title: "公式 feed と community feed を収集",
    body: `RSS、Atom、GitHub Releases、arXiv、HTML index から記事候補を取り込みます。Worker は source を ${workerBatchCopy} に分けて毎時 rotation します。`,
  },
  {
    label: "Normalize",
    title: "重複除去とカテゴリ正規化",
    body: "source、URL、publishedAt、category、importance、archiveTier を揃え、同一記事の重複を canonical URL ベースで抑えます。",
  },
  {
    label: "Summarize",
    title: "日本語で読み始められる形に変換",
    body: "タイトル、要約、タグ、重要度を生成し、KV cache を使って再生成を抑えます。原文への導線は記事詳細に残します。",
  },
  {
    label: "Publish",
    title: "静的サイトとして高速に配信",
    body: "差分がある場合だけ data artifact を commit し、Cloudflare Pages Git Integration が Astro build と Pagefind index を作成します。",
  },
];
---

<Portal pageKey="about" title="About - TECH Dashboard">
  <PageHero
    className="page-hero-top-level page-hero-about"
    kicker="About TECH Dashboard"
    title="About"
    count={`${DASHBOARD_METRICS.totalSourceCount} sources`}
    headingId="about-heading"
    description="TECH Dashboard は、AI coding と agent ecosystem の変化を毎日追うための日本語 dashboard です。公式発表、release note、研究、community feed を同じ情報設計に揃え、短時間で確認できます。"
    actions={[
      { href: "/rss.xml", label: "RSS" },
      { href: "/feed.json", label: "JSON Feed" },
      { href: "/status", label: "Status" },
      { href: "#reactions-privacy", label: "Likes & privacy" },
    ]}
    metrics={[
      { label: "Live entries", value: DASHBOARD_METRICS.timelineEntries },
      { label: "All time", value: DASHBOARD_METRICS.allTimeEntries },
      { label: "Sources", value: DASHBOARD_METRICS.totalSourceCount },
      { label: "Categories", value: DASHBOARD_METRICS.totalCategories },
      { label: "Archive", value: DASHBOARD_METRICS.archiveEntries },
      { label: "Last updated", value: lastUpdated },
    ]}
  />

  <div class="layout about-layout">
    <Sidebar />

    <main class="about-main">
      <section class="about-section-grid" aria-label="What this site covers">
        <article class="about-panel large">
          <span class="panel-kicker">Purpose</span>
          <h3>速く読むためではなく、見落とさないための dashboard</h3>
          <p>
            AI coding のニュースは、product blog、changelog、release、論文、community 記事に分散しています。
            このサイトではそれらをカテゴリ、重要度、source type、時系列で揃え、日次確認と後追い調査の両方で使えるようにしています。
          </p>
        </article>

        <article class="about-panel">
          <span class="panel-kicker">Freshness</span>
          <h3 data-worker-batch-total={workerBatchCount ?? "unknown"}>毎時 run、source は {workerBatchCopy} rotation</h3>
          <p>
            Worker は毎時起動し、{DASHBOARD_METRICS.totalSourceCount} sources を batch 分割して収集します。
            Status では batch、source registry、freshness、summarize 状態を確認できます。
          </p>
        </article>

        <article class="about-panel">
          <span class="panel-kicker">History</span>
          <h3>Archive と stats で長期推移を保持</h3>
          <p>
            live index から外れた記事も archive と stats に集約し、カテゴリ別の月次推移や記事数推移を後から確認できるようにしています。
          </p>
        </article>
      </section>

      <section class="pipeline-section" aria-labelledby="pipeline-heading">
        <div class="section-header primary compact">
          <h2 id="pipeline-heading">Pipeline</h2>
        </div>
        <div class="pipeline-grid">
          {pipelineSteps.map((step, index) => (
            <article class="pipeline-card">
              <span class="step-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="panel-kicker">{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="coverage-section" aria-labelledby="coverage-heading">
        <div class="section-header primary compact">
          <h2 id="coverage-heading">Coverage</h2>
        </div>
        <div class="coverage-grid">
          {CATEGORIES_BY_NAME.map((category) => (
            <a href={`/c/${category.slug}`} class="coverage-chip" style={`--category-color:${category.color}`}>
              <span class="coverage-chip-icon" aria-hidden="true">{category.emoji}</span>
              <strong>{category.name}</strong>
            </a>
          ))}
        </div>
      </section>

      <section class="about-note-panel trust-assumption">
        <h3>
          <span class="i18n-ja">利用時の前提</span>
          <span class="i18n-en" lang="en">Assumptions and caveats</span>
        </h3>
        <p>
          <span class="i18n-ja">
            タイトル、要約、タグ、重要度には機械生成の内容が含まれます。要約は読む優先度を判断するための補助です。
            共有前に原文を確認してください。要約待ちや翻訳表示にはラベルを付けています。
          </span>
          <span class="i18n-en" lang="en">
            Titles, summaries, tags, and importance may include machine-generated content. Summaries support triage.
            Confirm the original source before sharing. Pending and translated states are labeled.
          </span>
        </p>
      </section>
      <section class="about-note-panel sharing-checklist">
        <h3>
          <span class="i18n-ja">共有前チェック</span>
          <span class="i18n-en" lang="en">Sharing checklist</span>
        </h3>
        <p>
          <span class="i18n-ja">
            一覧と詳細には、AI 要約が準備待ちの新着を含む場合があります。Spotlight、優先度 Top 3、RSS、JSON Feed は要約準備済みの記事だけを扱います。
            要約はトリアージの補助です。要約待ちや翻訳表示のラベルを確認し、共有前に原文を確認してください。
          </span>
          <span class="i18n-en" lang="en">
            Public listing and detail pages may include newly collected entries while AI summary enrichment is pending.
            Spotlight, Ranked Top 3, RSS, and JSON Feed remain summary-ready-only. Summaries support triage.
            Check pending or translated labels, and confirm the original source before sharing.
          </span>
        </p>
        <p>
          <span class="i18n-ja">広告スクリプトは本番カスタムドメインでのみ読み込まれます。ローカル preview と pages.dev では UX と信頼性の監査を妨げません。</span>
          <span class="i18n-en" lang="en">The ad script loads only on the production custom domain. Local preview and pages.dev stay quiet for UX and trust audits.</span>
        </p>
      </section>
      <section id="reactions-privacy" class="about-note-panel reactions-privacy">
        <h3>
          <span class="i18n-ja">匿名いいねとプライバシー</span>
          <span class="i18n-en" lang="en">Anonymous likes and privacy</span>
        </h3>
        <p>
          <span class="i18n-ja">{REACTION_CONTRACT_JA}</span>
          <span class="i18n-en" lang="en">{REACTION_CONTRACT_EN}</span>
        </p>
        <p>
          <span class="i18n-ja">
            Knowledge と記事詳細の「いいね」は匿名の公開件数です。ブラウザごとの不透明な識別子を HttpOnly Cookie に保持し、
            server では HMAC-SHA256 化した値だけを D1 に保存します。IP address は Turnstile 検証にだけ使用し、D1 には保存しません。
          </span>
          <span class="i18n-en" lang="en">
            Likes on Knowledge cards and article detail pages are anonymous public counts. An opaque browser identifier is kept in an HttpOnly cookie,
            and only its HMAC-SHA256 digest is stored in D1. The IP address is used only for Turnstile verification and is not stored in D1.
          </span>
        </p>
        <p>
          <span class="i18n-ja">
            Cookie を削除した場合や別ブラウザでは別票として扱われます。いいねはお気に入りや記事保存ではなく、
            live index から外れた記事の URL 保持を保証しません。Featured、Top 3、importance、掲載順位にも影響しません。
          </span>
          <span class="i18n-en" lang="en">
            Clearing the cookie or using another browser creates a separate vote. A like is not a bookmark or saved article,
            and it does not guarantee that an article URL remains available after the entry leaves the live index.
            It does not affect Featured, Top 3, importance, or listing order.
          </span>
        </p>
      </section>
    </main>

    <aside class="right about-insights">
      <div class="side-card about-side-card">
        <div class="rail-title">Current run</div>
        <dl class="about-dl">
          <div>
            <dt>Run state</dt>
            <dd
              data-run-tone={runStatus.tone}
              data-metric="workerRunState"
              title={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
              aria-label={`Collection health: ${runStatus.runLabel}. ${runStatus.detail}`}
            ><span class={`dot ${runStatus.tone}`} aria-hidden="true"></span> {runStatus.statusText} · {runStatus.detail}</dd>
          </div>
          <div><dt>Worker</dt><dd data-metric="workerLastRunLabel">{workerLastRun}</dd></div>
          <div><dt>Batch</dt><dd data-metric="workerBatchLabel">{DASHBOARD_METRICS.workerBatchLabel}</dd></div>
          <div><dt>Source OK</dt><dd data-metric="workerSourceOkLabel">{DASHBOARD_METRICS.workerSourceOkLabel}</dd></div>
        </dl>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Recent volume</div>
        <dl class="about-dl">
          <div><dt>Last 24h</dt><dd data-metric="last24hEntries">{DASHBOARD_METRICS.last24hEntries}</dd></div>
          <div><dt>Last 7d</dt><dd data-metric="last7dEntries">{DASHBOARD_METRICS.last7dEntries}</dd></div>
          <div><dt>Last 30d</dt><dd data-metric="last30dEntries">{DASHBOARD_METRICS.last30dEntries}</dd></div>
          <div><dt>Archive months</dt><dd data-metric="archiveMonths">{DASHBOARD_METRICS.archiveMonths}</dd></div>
        </dl>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Hot categories</div>
        <ul class="about-rank-list">
          {topCategories.map((category) => (
            <li style={`--category-color:${category.color}`}>
              <span><i></i>{category.name}</span>
              <strong>{category.last30}</strong>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Source mix</div>
        <div class="source-type-list">
          {sourceTypes.map((type) => <span>{type}</span>)}
        </div>
      </div>

      <div class="side-card about-side-card">
        <div class="rail-title">Groups</div>
        <ul class="about-rank-list simple">
          {Object.entries(groupSummary).map(([group, count]) => (
            <li><span>{GROUP_LABEL[group as CategoryGroup] ?? group}</span><strong>{count}</strong></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
  <LiveMetrics />
</Portal>

<style>
  .about-main {
    min-width: 0;
  }

  .about-panel,
  .pipeline-card,
  .about-note-panel {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
  }

  .panel-kicker,
  .about-side-card .rail-title {
    display: block;
    margin-bottom: 5px;
    color: var(--muted-2);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  .about-panel {
    padding: 18px;
  }

  #reactions-privacy {
    scroll-margin-top: 120px;
  }

  #reactions-privacy:target {
    border-color: color-mix(in srgb, var(--know) 72%, var(--border));
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--know) 16%, transparent),
      0 14px 36px rgba(0, 0, 0, 0.16);
  }

  .about-panel.large {
    grid-row: span 2;
  }

  .about-panel h3,
  .pipeline-card h3,
  .about-note-panel h3 {
    margin: 0 0 8px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.4;
  }

  .about-panel p,
  .pipeline-card p,
  .about-note-panel p {
    margin: 0;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.75;
  }

  .pipeline-section,
  .coverage-section {
    margin-bottom: 20px;
  }

  .section-header.compact {
    margin-bottom: 10px;
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .pipeline-card {
    position: relative;
    padding: 16px;
    overflow: hidden;
  }

  .step-index {
    position: absolute;
    top: 10px;
    right: 12px;
    color: color-mix(in srgb, var(--accent) 42%, transparent);
    font-family: ui-monospace, monospace;
    font-size: 26px;
    font-weight: 700;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .coverage-chip {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px;
    border: 1px solid color-mix(in srgb, var(--category-color) 34%, var(--border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--category-color) 9%, transparent);
    color: var(--text-2);
    text-decoration: none;
  }

  .coverage-chip:hover {
    border-color: color-mix(in srgb, var(--category-color) 64%, var(--border));
    color: var(--text);
  }

  .coverage-chip-icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex: 0 0 auto;
    background: color-mix(in srgb, var(--category-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--category-color) 32%, transparent);
    font-size: 16px;
    line-height: 1;
  }

  .coverage-chip strong {
    overflow: hidden;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .about-note-panel {
    padding: 18px;
  }

  .about-insights {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .about-dl div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 62%, transparent);
  }

  .about-dl div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .about-dl dt {
    color: var(--muted);
    font-size: 11.5px;
  }

  .about-dl dd {
    margin: 0;
    color: var(--text);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .about-dl dd[data-run-tone] {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    text-align: right;
  }

  .about-dl dd .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted-2);
    flex: 0 0 auto;
  }

  .about-dl dd .dot.ok {
    background: var(--success);
  }

  .about-dl dd .dot.warn {
    background: var(--important);
  }

  .about-dl dd .dot.err {
    background: var(--danger);
  }

  .about-rank-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-rank-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--text-2);
    font-size: 12px;
  }

  .about-rank-list span {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 7px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .about-rank-list i {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--category-color);
  }

  .about-rank-list strong {
    color: var(--text);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .source-type-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .source-type-list span {
    padding: 4px 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
  }

  @media (max-width: 1120px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 980px) {
    .about-section-grid {
      grid-template-columns: 1fr;
    }

    .about-panel.large {
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
