---
import Portal from "../../layouts/Portal.astro";
import PageHero from "../../components/PageHero.astro";
import Sidebar from "../../components/Sidebar.astro";
import EntryCard from "../../components/EntryCard.astro";
import TrendChart from "../../components/TrendChart.astro";
import Pager from "../../components/Pager.astro";
import CategorySidePanel from "../../components/CategorySidePanel.astro";
import {
  CATEGORY_META,
  PAGE_SIZE,
  entriesFor,
  groupByDay,
  jstDayLabel,
  type Category,
} from "../../lib/data.ts";
import { categoryWeekOverWeek } from "../../lib/stats.ts";

export function getStaticPaths() {
  return CATEGORY_META.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

interface Props {
  category: (typeof CATEGORY_META)[number];
}

const { category } = Astro.props as Props;
const slug = category.slug as Category;
const categoryContextLabel = slug === "research" ? "Research" : category.name;
const all = entriesFor(slug);
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const entries = all.slice(0, PAGE_SIZE);
const dayGroups = groupByDay(entries);
const now = new Date();
const wow = categoryWeekOverWeek(slug);
const deltaSign = wow.deltaPct > 0 ? "+" : wow.deltaPct < 0 ? "-" : "";

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Categories", href: "/categories" },
  { label: category.name },
];
---

<Portal
  pageKey="categories"
  title={`${category.name} — TECH Dashboard`}
  breadcrumb={breadcrumb}
>
  <PageHero
    className="page-hero-category-detail"
    accent={category.color}
    kicker="Category detail"
    title={categoryContextLabel}
    count={`${all.length} total`}
    headingId="category-heading"
    description={`${categoryContextLabel} カテゴリの更新を、新着順・30日トレンド・関連記事として確認できます。`}
    descriptionEn={`Browse ${categoryContextLabel} updates by recency, 30-day trend, and related topics.`}
    actions={[
      { href: "/categories", label: "All categories" },
      { href: `/rss.xml?category=${slug}`, label: "RSS" },
      { href: "/status", label: "Source health" },
    ]}
    metrics={[
      {
        label: "Total",
        value: all.length,
        detail: "現在のlive index",
        detailEn: "Current live index",
        scope: "category-live-total",
      },
      {
        label: "Last 7d",
        value: wow.thisWeek,
        detail: "直近7日の掲載数",
        detailEn: "Entries in the latest 7 days",
        scope: "category-last-7d",
      },
      {
        label: "Vs prev 7d",
        value: `${deltaSign}${Math.abs(wow.deltaPct)}%`,
        detail: "その前の7日間と比較",
        detailEn: "Compared with the prior 7 days",
        scope: "category-week-over-week",
      },
      {
        label: "Avg/day",
        value: wow.avgPerDay,
        detail: "直近7日 ÷ 7",
        detailEn: "Latest 7 days divided by 7",
        scope: "category-avg-day",
      },
    ]}
  />

  <div class="layout">
    <Sidebar active={slug} />

    <main>
      {slug === "research" && (
        <section class="research-split-callout" aria-labelledby="research-split-heading">
          <div>
            <p class="section-kicker">Research navigation</p>
            <h2 id="research-split-heading">
              <span class="i18n-ja">Research は選定した論文・レポートを含みます</span>
              <span class="i18n-en">Research includes selected papers and reports</span>
            </h2>
            <p class="i18n-ja">このカテゴリでは選定した論文・レポートを扱い、専用の arXiv レーンでは論文だけをまとめて閲覧できます。</p>
            <p class="i18n-en">Browse selected papers and reports here, or use the dedicated arXiv lane for a papers-only view.</p>
          </div>
          <a href="/arxiv/">arXiv Papers</a>
        </section>
      )}

      <TrendChart category={slug} color={category.color} days={30} />

      <div
        class="section-header"
        style={`border-bottom:2px solid ${category.color}`}
      >
        <h2>
          All articles
          <span
            class="count"
            style={`background:${category.color}22;color:${category.color}`}
          >
            {all.length} total
          </span>
        </h2>
        <div class="sort">
          <span class="active">
            <span class="i18n-ja">新着順</span>
            <span class="i18n-en">Newest first</span>
          </span>
        </div>
      </div>

      {entries.length === 0 ? (
        <p style="color:var(--muted);padding:24px 0">
          <span class="i18n-ja">まだエントリがありません。</span>
          <span class="i18n-en">No entries are available yet.</span>
        </p>
      ) : (
        dayGroups.map(({ key, items }) => (
          <>
            <div class="day-header">
              <span>{jstDayLabel(key, now)}</span>
              <span class="day-count">{items.length} entries</span>
            </div>
            {items.map((entry) => <EntryCard entry={entry} />)}
          </>
        ))
      )}

      <Pager
        currentPage={currentPage}
        totalPages={totalPages}
        baseHref={`/c/${slug}`}
      />
    </main>

    <CategorySidePanel category={category} entries={all} now={now} />
  </div>
</Portal>

<style>
  .section-header .sort {
    display: flex;
    gap: 2px;
    padding: 2px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 11px;
  }
  .section-header .sort span {
    padding: 3px 10px;
    border-radius: 4px;
    color: var(--muted);
  }
  .section-header .sort span.active {
    background: var(--surface-2, var(--surface));
    color: var(--text);
  }
</style>
