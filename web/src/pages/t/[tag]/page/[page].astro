---
import Portal from "../../../../layouts/Portal.astro";
import PageHero from "../../../../components/PageHero.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import EntryCard from "../../../../components/EntryCard.astro";
import Pager from "../../../../components/Pager.astro";
import TimelineRightRail from "../../../../components/TimelineRightRail.astro";
import {
  PAGE_SIZE,
  STATIC_TAG_PAGE_TAGS,
  entriesForTagPage,
  groupByDay,
  jstDayLabel,
  relativeTime,
  tagHref,
} from "../../../../lib/data.ts";

export function getStaticPaths() {
  const out: Array<{
    params: { tag: string; page: string };
    props: { tag: string; page: number; total: number };
  }> = [];
  for (const tag of STATIC_TAG_PAGE_TAGS) {
    const total = Math.max(1, Math.ceil(entriesForTagPage(tag).length / PAGE_SIZE));
    for (let p = 2; p <= total; p++) {
      out.push({
        params: { tag, page: String(p) },
        props: { tag, page: p, total },
      });
    }
  }
  return out;
}

interface Props {
  tag: string;
  page: number;
  total: number;
}

const { tag, page, total } = Astro.props as Props;
const all = entriesForTagPage(tag);
const start = (page - 1) * PAGE_SIZE;
const entries = all.slice(start, start + PAGE_SIZE);
const dayGroups = groupByDay(entries);
const now = new Date();
const tagBaseHref = tagHref(tag);

const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "Tags" },
  { label: `#${tag}`, href: tagBaseHref },
  { label: `Page ${page}` },
];
---

<Portal title={`#${tag} · p.${page} — TECH Dashboard`} breadcrumb={breadcrumb}>
  <PageHero
    className="page-hero-tag"
    kicker="Tag timeline"
    title={`#${tag}`}
    count={`page ${page}/${total}`}
    headingId="tag-heading"
    description="同じキーワードで束ねられた更新の続きです。カテゴリをまたいだ関連ニュースや実装トピックの追跡に使えます。"
    actions={[
      { href: tagBaseHref, label: "First page" },
      { href: "/categories", label: "Browse categories" },
      { href: "/archive", label: "Open archive" },
    ]}
    metrics={[
      { label: "Total", value: all.length },
      { label: "Showing", value: entries.length },
      { label: "Page", value: `${page}/${total}` },
      { label: "Updated", value: relativeTime(all[0]?.collectedAt ?? all[0]?.publishedAt ?? null, now) },
    ]}
  />

  <div class="layout">
    <Sidebar active="all" />

    <main>
      <div class="section-header primary">
        <h2>
          Entries
          <span class="count">page {page}/{total} · {all.length} total</span>
        </h2>
      </div>

      {dayGroups.map(({ key, items }) => (
        <>
          <div class="day-header">
            <span>{jstDayLabel(key, now)}</span>
            <span class="day-count">{items.length} entries</span>
          </div>
          {items.map((entry) => <EntryCard entry={entry} />)}
        </>
      ))}

      <Pager currentPage={page} totalPages={total} baseHref={tagBaseHref} />
    </main>

    <TimelineRightRail entries={all} now={now} label={`#${tag} insights`} />
  </div>
</Portal>
